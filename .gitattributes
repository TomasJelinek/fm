* text=auto eol=lf
*.rs text eol=lf
*.slint text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.png binary
# Preserve verbatim upstream notices, including their whitespace.
plugins/**/notices/** -whitespace
# Preserve the imported image codec/font/license bytes from upstream archives.
vendor/image/** -text -whitespace
plugins/image-decoder/notices/** -text
plugins/image-decoder/fonts/OFL.txt -text -whitespace
plugins/image-decoder/fonts/*.ttf binary
