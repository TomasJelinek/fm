import { Theme } from "theme.slint";
import { ChartInfoButton } from "chart-info-button.slint";

export struct SpeedChartData {
    area: string, primary: string, verification: string,
    speed: string, verification-speed: string, scale: string, history: string,
    description: string, has-samples: bool, single-sample: bool, native-move: bool,
    point-x: float, point-y: float, verification-y: float
}

export component OperationSpeedChart inherits Rectangle {
    in property <SpeedChartData> chart;
    in property <bool> deletion;
    in property <bool> overall-progress;
    in property <bool> determinate;
    in property <float> progress;
    in property <string> progress-label;
    in property <string> waiting-label: "Waiting for activity";
    // A running Copy or Move's rates as its time estimate averages them ("187.0 MiB/s",
    // "—" until measured): the legend shows them instead of the latest interval. Empty
    // while the job does not run, and the verify rate unless copies are read back in
    // full: the legend then shows the chart's latest interval, which the backend sets
    // to zero once the job stops.
    in property <string> write-rate;
    in property <string> verify-rate;
    // The speeds a transfer's legend shows, and its accessible value reads.
    private property <string> shown-write: root.write-rate != "" ? root.write-rate
        : root.chart.speed == "" ? "0 B/s" : root.chart.speed;
    private property <string> shown-verify: root.verify-rate != "" ? root.verify-rate
        : root.chart.verification-speed == "" ? "0 B/s" : root.chart.verification-speed;
    private property <float> history-fraction: root.overall-progress && root.determinate
        ? clamp(root.progress, 0, 1) : 1;
    private property <bool> compact: root.height < 75px;
    // What the chart measures. job_speed_scale.rs keeps the scale steady (`Scale`).
    // Only the "i" button above the chart shows it.
    private property <string> explanation: root.deletion
        ? "Reported deleted items per second, including folders. System Trash may report only top-level items. The graph covers the entire operation from time zero; older intervals retain peak speeds. The scale rises at once to fit a faster speed and comes down one round step at a time, only after the speed stayed well below it for 10 seconds; an older peak above it is cut off at the top."
        : root.chart.native-move ? "Native renames per second. A whole renamed folder counts once; descendants are not enumerated and no content is copied. The graph retains the entire operation."
        : "Write: bytes written per second. Verify: destination readback and additional Move validation reads under the job's selected policy. The graph covers the entire operation from time zero; older intervals retain peak speeds. The scale rises at once to fit a faster speed and comes down one round step at a time, only after the speed stayed well below it for 10 seconds; an older peak above it is cut off at the top. While the job runs, the labels show its speeds averaged over the last few seconds, as its time estimate uses them (Verify only when copies are read back in full); otherwise they show the latest measured interval. They are speeds, not a completion percentage.";
    accessible-role: groupbox;
    accessible-label: root.deletion ? "Deletion speed" : "Transfer speed";
    // The backend's description names the latest interval; with the averaged rates
    // in the legend, the value reads those instead.
    accessible-value: root.write-rate == "" && root.verify-rate == "" ? root.chart.description
        : "Write: " + root.shown-write + ". Verify: " + root.shown-verify + ". " + root.chart.history + ".";
    min-width: 0px; min-height: 0px;
    VerticalLayout {
        spacing: root.compact ? 2px : 5px;
        HorizontalLayout {
            spacing: 8px; cross-axis-alignment: center;
            Rectangle { width: 8px; height: 8px; background: Theme.active-frame; }
            // Each label takes an equal share of the line whatever its value, so
            // neither moves while the speeds change; a share too narrow elides.
            Text {
                text: root.deletion ? "Deleted: " + (root.chart.speed == "" ? "0 items/s" : root.chart.speed)
                    : root.chart.native-move ? "Renamed: " + root.chart.speed
                    : "Write: " + root.shown-write;
                color: Theme.strong-text; font-size: Theme.small-font; overflow: elide;
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
            }
            if !root.deletion && !root.chart.native-move : Rectangle { width: 10px; height: 2px; background: Theme.pending-size; }
            if !root.deletion && !root.chart.native-move : Text {
                text: "Verify: " + root.shown-verify;
                color: Theme.strong-text; font-size: Theme.small-font; overflow: elide;
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
            }
            // At the chart's top right corner, above it: the chart's explanation.
            ChartInfoButton {
                text: root.explanation;
                // Wider with a larger font, so that it stays a few lines tall.
                popup-width: min(root.width, max(360px, Theme.small-font * 30));
            }
        }
        plot := Rectangle {
            vertical-stretch: 1; min-height: 14px; clip: true;
            background: Theme.pane-background; border-width: 1px; border-color: Theme.frame;
            if root.overall-progress : Rectangle {
                accessible-role: progress-indicator; accessible-label: "Overall progress";
                accessible-value: root.progress-label;
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width * (root.determinate ? clamp(root.progress, 0, 1) : 0);
                    height: parent.height; background: Theme.active-frame.with-alpha(0.16);
                }
            }
            // Grid lines are written out: a `for` is a generated component, even over a constant.
            Rectangle {
                x: 1px; y: parent.height * 1 / 4;
                width: parent.width - 2px; height: 1px; background: Theme.frame.with-alpha(0.35);
            }
            Rectangle {
                x: 1px; y: parent.height * 2 / 4;
                width: parent.width - 2px; height: 1px; background: Theme.frame.with-alpha(0.35);
            }
            Rectangle {
                x: 1px; y: parent.height * 3 / 4;
                width: parent.width - 2px; height: 1px; background: Theme.frame.with-alpha(0.35);
            }
            Rectangle {
                x: parent.width * 1 / 6; y: 1px;
                height: parent.height - 2px; width: 1px; background: Theme.frame.with-alpha(0.25);
            }
            Rectangle {
                x: parent.width * 2 / 6; y: 1px;
                height: parent.height - 2px; width: 1px; background: Theme.frame.with-alpha(0.25);
            }
            Rectangle {
                x: parent.width * 3 / 6; y: 1px;
                height: parent.height - 2px; width: 1px; background: Theme.frame.with-alpha(0.25);
            }
            Rectangle {
                x: parent.width * 4 / 6; y: 1px;
                height: parent.height - 2px; width: 1px; background: Theme.frame.with-alpha(0.25);
            }
            Rectangle {
                x: parent.width * 5 / 6; y: 1px;
                height: parent.height - 2px; width: 1px; background: Theme.frame.with-alpha(0.25);
            }
            if root.chart.has-samples : Path {
                x: 1px; y: 2px; width: max(1px, (parent.width - 2px) * root.history-fraction); height: parent.height - 4px;
                viewbox-width: 1000; viewbox-height: 100; fit: fill;
                commands: root.chart.area; fill: Theme.active-frame.with-alpha(root.overall-progress ? 0.65 : 0.25);
            }
            if root.chart.has-samples : Path {
                x: 1px; y: 2px; width: max(1px, (parent.width - 2px) * root.history-fraction); height: parent.height - 4px;
                viewbox-width: 1000; viewbox-height: 100; fit: fill;
                commands: root.chart.primary; fill: transparent;
                stroke: Theme.active-frame; stroke-width: 1.5px;
            }
            if root.chart.has-samples && !root.deletion && !root.chart.native-move : Path {
                x: 1px; y: 2px; width: max(1px, (parent.width - 2px) * root.history-fraction); height: parent.height - 4px;
                viewbox-width: 1000; viewbox-height: 100; fit: fill;
                commands: root.chart.verification; fill: transparent;
                stroke: Theme.pending-size; stroke-width: 1.5px;
            }
            // The two sample dots are hidden instead of conditional: an `if` is one
            // more generated component. The curves above stay conditional: tests
            // count the stroked paths in the chart's item tree.
            Rectangle {
                visible: root.chart.single-sample;
                x: clamp((parent.width - 2px) * root.history-fraction * root.chart.point-x / 1000 - 2px, 2px, parent.width - 6px);
                y: clamp(parent.height * root.chart.point-y / 100 - 2px, 2px, parent.height - 6px);
                width: 4px; height: 4px; border-radius: 2px; background: Theme.active-frame;
            }
            Rectangle {
                visible: root.chart.single-sample && !root.deletion && !root.chart.native-move;
                x: clamp((parent.width - 2px) * root.history-fraction * root.chart.point-x / 1000 - 2px, 2px, parent.width - 6px);
                y: clamp(parent.height * root.chart.verification-y / 100 - 2px, 2px, parent.height - 6px);
                width: 4px; height: 4px; border-radius: 2px;
                border-width: 1px; border-color: Theme.pending-size; background: Theme.pane-background;
            }
            // Inside the plot: a label longer than a narrow plot wraps instead of running
            // past its edges ("Waiting for another job in the same folders to finish").
            if !root.chart.has-samples && !root.compact : Text {
                x: 4px; y: 1px; width: max(0px, parent.width - 8px); height: max(0px, parent.height - 2px);
                text: root.waiting-label; color: Theme.secondary-text;
                horizontal-alignment: center; vertical-alignment: center;
                font-size: Theme.small-font; wrap: word-wrap;
            }
        }

        if !root.compact : HorizontalLayout {
            Text { text: root.chart.history; color: Theme.secondary-text; font-size: Theme.small-font; horizontal-stretch: 1; }
            Text { text: root.chart.scale == "" ? "" : "Scale: " + root.chart.scale; color: Theme.secondary-text; font-size: Theme.small-font; }
        }
    }
}
