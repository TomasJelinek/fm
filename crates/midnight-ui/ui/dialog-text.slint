import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Explicit content geometry keeps long descriptions scrollable from their first line.
export component DialogText inherits ScrollView {
    in property <string> text;
    in property <color> foreground: Theme.text;
    horizontal-scrollbar-policy: always-off;
    content-width: root.visible-width;
    content-height: max(root.visible-height, description.preferred-height);
    description := Text {
        x: 0px; y: 0px;
        width: max(0px, root.visible-width - 16px);
        height: self.preferred-height;
        text: root.text; wrap: word-wrap;
        horizontal-alignment: left; vertical-alignment: top;
        color: root.foreground; font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
}
