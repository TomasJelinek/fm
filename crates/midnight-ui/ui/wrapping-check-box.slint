import { HintedCheckBox } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { Tip } from "controls.slint";

// Keep native keyboard/accessibility semantics. The indicator owns a fixed,
// centered box instead of stretching the stock focus ring over a wrapped row.
export component WrappingCheckBox inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    in property <length> font-size: Theme.font-size;
    in property <length> control-height: Theme.control-height;
    callback toggled();
    // The pointer on the box or on its caption gives the box the theme's active frame,
    // 2px wide. Only the frame changes: the caption, the mark and the fill they are drawn
    // on keep their contrast in every theme (tests/hover_feedback.rs).
    private property <bool> hovered: root.enabled && (box-area.has-hover || caption-area.has-hover);
    min-width: 0px;
    height: max(root.control-height, caption.preferred-height);
    forward-focus: checkbox;
    HorizontalLayout {
        spacing: 6px; cross-axis-alignment: center;
        // Tracks the pointer above the native check box, which takes the clicks.
        box-area := TouchArea {
            width: 24px; height: root.height; horizontal-stretch: 0;
            enabled: root.enabled;
            indicator := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px; height: 18px; border-radius: 2px;
                background: root.checked && root.enabled ? Theme.active-header : Theme.secondary-surface;
                border-width: root.hovered ? 2px : 1px;
                border-color: root.enabled && (root.checked || root.hovered) ? Theme.active-frame : Theme.frame;
                // The mark and the focus ring are hidden instead of conditional:
                // an `if` is one more generated component.
                Path {
                    visible: root.checked;
                    x: 3px; y: 3px; width: 12px; height: 12px;
                    viewbox-width: 12; viewbox-height: 12;
                    commands: "M 1 6 L 4 9 L 11 2";
                    stroke: root.enabled ? Theme.text : Theme.muted-text;
                    stroke-width: 2px;
                }
            }
            Rectangle {
                visible: checkbox.has-focus && root.enabled;
                x: indicator.x - 3px; y: indicator.y - 3px;
                width: indicator.width + 6px; height: indicator.height + 6px;
                border-width: 2px; border-radius: 4px; border-color: Theme.active-frame;
            }
            // Hint-less on purpose: shares the one compiled native checkbox.
            checkbox := HintedCheckBox {
                width: parent.width; height: parent.height; opacity: 0;
                text: ""; checked <=> root.checked; enabled: root.enabled;
                accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
                font-size: root.font-size;
                toggled => { checkbox.focus(); root.toggled(); }
            }
        }
        caption := Text {
            text: root.text; color: root.enabled ? Theme.text : Theme.muted-text;
            font-family: Theme.effective-font-family; font-size: root.font-size;
            wrap: word-wrap;
            height: root.height; vertical-alignment: center;
            min-width: 0px; horizontal-stretch: 1;
            caption-area := TouchArea {
                enabled: root.enabled;
                clicked => { root.checked = !root.checked; checkbox.focus(); root.toggled(); }
            }
        }
    }
    Tip { text: root.hint; }
}
