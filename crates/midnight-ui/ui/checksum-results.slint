import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ChecksumDisplayRow {
    token: string, name: string, path: string, status: string, bytes: string,
    digests: string, sha256: string, sha512: string, md5: string, sha1: string,
    calculated: bool, error: bool,
}

component Columns inherits HorizontalLayout {
    in property <ChecksumDisplayRow> entry;
    in property <[bool]> algorithms;
    in property <bool> header;
    padding-left: 8px; padding-right: 8px; spacing: 12px;
    VerticalLayout {
        width: Theme.small-font * 24; spacing: 0px; alignment: center;
        Text { text: root.header ? "File / folder" : root.entry.name;
            color: root.entry.error ? Theme.error-text : Theme.text;
            font-size: Theme.small-font; font-weight: root.header ? 600 : 400; overflow: elide; }
        if !root.header: Text { text: root.entry.path; color: Theme.secondary-text;
            font-size: Theme.small-font; overflow: elide; }
    }
    Text { text: root.header ? "Bytes read" : root.entry.bytes; width: Theme.small-font * 11;
        color: Theme.secondary-text; font-size: Theme.small-font; overflow: elide;
        horizontal-alignment: right; vertical-alignment: center; }
    for enabled[index] in root.algorithms: Rectangle {
        visible: enabled;
        width: enabled ? Theme.small-font * (index == 1 ? 83 : index == 0 ? 43 : index == 2 ? 22 : 27) : 0px;
        Text {
            text: root.header ? ["SHA-256", "SHA-512", "MD5", "SHA-1"][index]
                : [root.entry.sha256, root.entry.sha512, root.entry.md5, root.entry.sha1][index];
            color: Theme.text; font-size: Theme.small-font;
            font-family: root.header ? Theme.font-family : "monospace";
            vertical-alignment: center; overflow: elide;
        }
    }
    Text { text: root.header ? "Status" : root.entry.status; width: Theme.small-font * 22;
        color: root.entry.error ? Theme.error-text : Theme.secondary-text;
        font-size: Theme.small-font; vertical-alignment: center; overflow: elide; }
}

// Like Salamander's checksum list: stable filename/size/hash columns with a
// synchronized header, plus a context menu for each calculated algorithm.
export component ChecksumResults inherits FocusScope {
    in property <length> surface-width;
    in property <length> surface-height;
    in property <[ChecksumDisplayRow]> rows;
    in property <[bool]> algorithms;
    in property <string> generation-token;
    in property <int> output-algorithm;
    in property <bool> copy-full-row;
    in-out property <int> selected-row: -1;
    callback copy-result(string, int, bool);
    private property <length> row-height: Theme.small-font * 2 + 12px;
    private property <length> table-width: Theme.small-font * (57
        + (root.algorithms[0] ? 43 : 0) + (root.algorithms[1] ? 83 : 0)
        + (root.algorithms[2] ? 22 : 0) + (root.algorithms[3] ? 27 : 0))
        + 16px + (2 + (root.algorithms[0] ? 1 : 0) + (root.algorithms[1] ? 1 : 0) + (root.algorithms[2] ? 1 : 0) + (root.algorithms[3] ? 1 : 0)) * 12px;
    private property <string> menu-token;
    private property <length> menu-x;
    private property <length> menu-y;
    changed generation-token => { menu.close(); root.menu-token = ""; }
    changed selected-row => {
        if root.selected-row >= 0 {
            if root.selected-row * root.row-height < -list.content-y {
                list.content-y = -root.selected-row * root.row-height;
            } else if (root.selected-row + 1) * root.row-height > -list.content-y + list.visible-height {
                list.content-y = list.visible-height - (root.selected-row + 1) * root.row-height;
            }
        }
    }
    function select-row(index: int) { root.selected-row = index; root.focus(); }
    function open-menu(index: int, x: length, y: length) {
        root.select-row(index);
        if index >= 0 && index < root.rows.length && root.rows[index].calculated {
            root.menu-token = root.rows[index].token;
            root.menu-x = x; root.menu-y = y; menu.show();
        }
    }
    function copy-menu(index: int, whole: bool) {
        // The token is captured when opening: a refreshed/recycled row cannot
        // redirect a pending action to a different run or file.
        root.copy-result(root.menu-token, index, whole); menu.close(); root.focus();
    }
    key-pressed(event) => {
        if event.text == Key.DownArrow { root.selected-row = min(root.rows.length - 1, root.selected-row + 1); return accept; }
        if event.text == Key.UpArrow { root.selected-row = max(0, root.selected-row - 1); return accept; }
        if event.text == Key.Home { root.selected-row = root.rows.length > 0 ? 0 : -1; return accept; }
        if event.text == Key.End { root.selected-row = root.rows.length - 1; return accept; }
        if event.modifiers.shift && event.text == Key.F10 {
            root.open-menu(root.selected-row, 12px,
                Theme.column-height + (root.selected-row + 1) * root.row-height + list.content-y);
            return accept;
        }
        if event.modifiers.control && (event.text == "c" || event.text == "C") {
            if root.selected-row >= 0 && root.selected-row < root.rows.length && root.rows[root.selected-row].calculated {
                root.copy-result(root.rows[root.selected-row].token, root.output-algorithm, root.copy-full-row);
            }
            return accept;
        }
        reject
    }
    Rectangle {
        x: 0px; y: 0px; width: parent.width;
        height: Theme.column-height; clip: true; background: Theme.header;
        Columns { x: list.content-x; width: list.content-width; height: parent.height;
            algorithms: root.algorithms; header: true; }
    }
    list := ListView {
        y: Theme.column-height; width: parent.width; height: max(0px, parent.height - self.y);
        content-width: max(self.visible-width, root.table-width);
        accessible-role: AccessibleRole.list; accessible-label: "Checksum results";
        accessible-item-count: root.rows.length;
        for row[index] in root.rows: Rectangle {
            width: list.content-width; height: root.row-height;
            background: root.selected-row == index ? Theme.cursor-background
                : mod(index, 2) == 1 ? Theme.alternate-row : Theme.pane-background;
            border-width: root.selected-row == index ? 1px : 0px; border-color: Theme.cursor-edge;
            accessible-role: list-item;
            accessible-label: row.name + " · " + row.path + " · " + row.bytes + " · " + row.status + " · " + row.digests;
            accessible-value: row.token;
            accessible-item-selectable: true;
            accessible-item-selected: root.selected-row == index;
            accessible-item-index: index;
            accessible-action-default => { root.select-row(index); }
            Columns { entry: row; algorithms: root.algorithms; }
            TouchArea {
                private property <string> pressed-token;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { self.pressed-token = row.token; }
                    if event.kind == PointerEventKind.cancel { self.pressed-token = ""; }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.right
                        && self.pressed-token == row.token && self.mouse-x >= 0px && self.mouse-x < self.width
                        && self.mouse-y >= 0px && self.mouse-y < self.height {
                        root.open-menu(index, self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                            self.absolute-position.y + self.mouse-y - root.absolute-position.y);
                    }
                }
                clicked => { if self.pressed-token == row.token { root.select-row(index); } }
            }
        }
    }
    menu := PopupWindow {
        x: clamp(root.absolute-position.x + root.menu-x, 4px, max(4px, root.surface-width - self.width - 4px)) - root.absolute-position.x;
        y: clamp(root.absolute-position.y + root.menu-y, 4px, max(4px, root.surface-height - self.height - 4px)) - root.absolute-position.y;
        width: min(240px, root.surface-width - 8px); height: min(root.surface-height - 8px, 5 * Theme.control-height + 20px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface; border-width: 1px; border-color: Theme.active-frame;
            ListView {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                horizontal-scrollbar-policy: always-off;
                for label[index] in ["SHA-256", "SHA-512", "MD5", "SHA-1", "full row"]: Button {
                    text: "Copy " + label; enabled: index == 4 || root.algorithms[index];
                    clicked => { root.copy-menu(index == 4 ? root.output-algorithm : index, index == 4); }
                }
            }
        }
    }
}
