import { ProgressIndicator } from "std-widgets.slint";
import { VScrollView } from "scroll-view.slint";
import { HintedComboBox, HintedActionButton } from "hinted-inputs.slint";
import { ThemedLineEdit } from "content-controls.slint";
import { Tip } from "controls.slint";
import { ErrorNotice, ErrorGlyph } from "error-notice.slint";
import { Theme } from "theme.slint";
import { CloseButton } from "close-button.slint";
import { ToolWindow } from "tool-window.slint";
import { DialogTabs } from "dialog-tabs.slint";
import { DialogFooter } from "dialog-footer.slint";
import { FallbackIcons, ActionButton } from "action-icons.slint";
import { ChecksumAlgorithmMenu, ChecksumDraft } from "checksum-controls.slint";
import { ChecksumResults, ChecksumDisplayRow, ChecksumColumnWidths } from "checksum-results.slint";
export { ChecksumDisplayRow, ChecksumDraft, ChecksumColumnWidths }

export component ChecksumWindow inherits ToolWindow {
    callback close-session();
    request-close => { root.close-session(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    public function begin() { root.focus-page(); }
    // Keyboard focus for the shown page: its results list, or the page's own key
    // handler (`page-keys`). A control that removes itself when used calls this first:
    // Slint leaves the focus on a removed item, and Escape would no longer close the
    // window.
    function focus-page() {
        if root.page == 0 && !root.show-details { results.focus(); } else { page-keys.focus(); }
    }
    title: "Checksums · Midnight Explorer";
    icon: FallbackIcons.checksums;
    in property <[ChecksumDisplayRow]> rows;
    in property <bool> running;
    in property <bool> stopping;
    in property <bool> saving;
    in property <bool> save-stopping;
    // The shown results are a verification's, while it runs and after it.
    in property <bool> verifying;
    in property <bool> picker-busy;
    in property <bool> has-captured-files: true;
    in property <bool> has-output;
    in property <bool> attention;
    in property <string> progress;
    // The running calculation's share done (negative: no bar), and whether it is
    // still listing its files.
    in property <float> progress-fraction: -1;
    in property <bool> progress-listing;
    in property <string> error;
    // The attention line: the error, a backend diagnostic or the limits reached.
    in property <string> issue;
    // What a save does, else what the last Copy left out (a note, not an error), else
    // where the last save went and what it replaced.
    in property <string> save-status;
    // Everything both lines summarize; shown in place of the page on request.
    in property <string> details;
    // Asked in the window instead of failing: partial results or an existing file.
    in property <string> save-prompt;
    in property <string> save-prompt-action: "Save";
    in property <string> generation-token;
    changed error => { root.attention-dismissed = false; }
    changed attention => { root.attention-dismissed = false; }
    changed generation-token => { root.attention-dismissed = false; root.show-details = false; }
    changed save-status => { root.save-status-dismissed = false; }
    in property <[bool]> output-available: [false, false, false, false, false];
    in-out property <string> manifest-path;
    in-out property <ChecksumDraft> draft;
    in-out property <int> output-algorithm;
    // The results' cursor (-1: none) and selection, as the presenter keeps them: whether
    // nothing is selected, the selected rows Copy writes (calculated ones) and those with a
    // checksum to copy, each also as text.
    in property <int> cursor-row: -1;
    in property <bool> selection-empty: true;
    in property <int> copy-lines;
    in property <string> copy-lines-text;
    in property <int> selected-hashes;
    in property <string> selected-hashes-text;
    // The row being calculated (-1: none); the results follow it while nothing is selected.
    in property <int> active-row: -1;
    out property <int> follow-scrolls: results.follow-scrolls;
    // Result column widths for this window's session.
    in-out property <ChecksumColumnWidths> column-widths <=> results.widths;
    // Calculate, Verify. The draft survives page switches.
    in-out property <int> page;
    changed page => {
        root.show-details = false;
        root.focus-page();
    }
    // Details replaces the page until Back; the page's draft survives.
    in-out property <bool> show-details;
    private property <bool> attention-dismissed;
    private property <bool> save-status-dismissed;
    private property <bool> has-algorithm: root.draft.md5 || root.draft.sha1 || root.draft.sha256 || root.draft.sha512 || root.draft.crc32;
    private property <bool> can-save: root.has-output && !root.running && !root.saving && !root.picker-busy && root.save-prompt == "" && root.output-available[root.output-algorithm];
    private property <bool> compact: root.height < 360px;
    // What the list says while it has no row.
    private property <bool> note-shown: root.page == 0 && root.rows.length == 0 && !root.show-details;
    private property <string> note: root.running
        ? (root.verifying ? "Verifying files…" : root.progress-listing ? "Listing files…" : "Calculating checksums…")
        : "Choose the checksums in the list above, then press Calculate.";
    callback calculate(ChecksumDraft);
    callback stop();
    // The results' selection: a click (index, Ctrl, Shift), a cursor key (index, Shift,
    // Ctrl), Space or Insert, Ctrl+A and Ctrl+D.
    callback pick-row(int, bool, bool);
    callback move-cursor(int, bool, bool);
    callback toggle-row(bool);
    callback select-all();
    callback deselect-all();
    // The context menu: the row's token, an output algorithm index, full rows, and whether
    // it acts on the whole selection.
    callback copy-result(string, int, bool, bool);
    // Ctrl+C and Ctrl+Shift+C: the selected rows' checksums (an output algorithm index)
    // or full rows.
    callback copy-selection(int, bool);
    // Copy the selected rows in checksum-file format (an output algorithm index).
    callback copy-checksum-file(int);
    callback browse-manifest(bool, int);
    callback verify-manifest(string);
    // Verify again the checksum file whose results are shown.
    callback verify-again();
    callback stop-save();
    callback confirm-save();
    callback cancel-save-prompt();
    callback copy-details();
    private property <string> algorithm-label: ["SHA-256", "SHA-512", "MD5", "SHA-1", "CRC32"][root.output-algorithm];
    // Copy says how many lines it copies when several rows are selected; below 460px it is
    // plain "Copy". The footer measures the caption: one that does not fit whole beside the
    // other actions takes Copy into More….
    private property <string> copy-caption: root.width < 460px ? "Copy"
        : "Copy " + (root.copy-lines > 1 ? root.copy-lines-text + " " : "") + root.algorithm-label;
    private property <string> copy-hint: root.copy-lines > 0
        ? "Copy the " + (root.copy-lines > 1 ? root.copy-lines-text + " selected rows" : "selected row")
            + " as a checksum file, in the list's order: the lines Save manifest… writes, named relative to the folder. Ctrl+C copies the selected checksums, Ctrl+Shift+C their full rows."
        : root.verifying
        ? "A verification's results are not copied as a checksum file. Select rows and press Ctrl+C to copy their checksums."
        : "Nothing to copy: no selected row has a calculated checksum. Click rows to select them (Ctrl+click adds one, Shift+click a range), or press Ctrl+A to select all.";
    function submit-verify() {
        if !root.running && !root.saving && !root.picker-busy && root.manifest-path != "" {
            root.verify-manifest(root.manifest-path);
        }
    }
    // Calculate as its button allows it, which offers Stop instead while one runs.
    private property <bool> can-calculate: !root.running && !root.stopping && !root.saving
        && !root.picker-busy && root.has-algorithm && root.has-captured-files;
    // Enter in the results or on the page itself starts the shown page's primary action:
    // Calculate, Verify on the Verify page, and for a verification's results that
    // verification again, of the same checksum file. Enter never replaces a
    // verification's results with calculated ones; that stays a Calculate press. Not
    // from the details, and not while a save question waits for its answer. Fields,
    // buttons, the page chooser and the algorithm menu keep their own Enter.
    function start-page-action() {
        if root.show-details || root.save-prompt != "" { return; }
        if root.page == 1 { root.submit-verify(); }
        else if root.verifying {
            if !root.running && !root.stopping && !root.saving && !root.picker-busy {
                root.verify-again();
            }
        }
        else if root.can-calculate { root.calculate(root.draft); }
    }
    // The page's key handler where no list takes the keys (Verify, Details). Below the
    // page, so a click on a blank part of the window focuses it; Escape goes on to the
    // window's handler.
    page-keys := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        // focus-page() focuses it; it is no Tab stop.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Return {
                // A held key starts nothing: only a new press does.
                if !event.repeat { root.start-page-action(); }
                return accept;
            }
            reject
        }
    }
    VerticalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding: root.compact ? 4px : 12px; spacing: root.compact ? 4px : 8px;
        HorizontalLayout {
            spacing: 8px; height: Theme.control-height + 4px;
            if root.width >= max(420px, Theme.font-size * 24): DialogTabs {
                labels: ["Calculate", "Verify"]; current-index <=> root.page;
                horizontal-stretch: 1;
            }
            if root.width < max(420px, Theme.font-size * 24): HintedComboBox {
                model: ["Calculate", "Verify"]; current-index <=> root.page;
                min-width: 0px; horizontal-stretch: 1;
                accessible-label: "Checksum page"; hint: "Calculate checksums or verify a checksum file.";
            }
            if root.page == 0: ChecksumAlgorithmMenu {
                draft <=> root.draft; algorithm <=> root.output-algorithm; available: root.output-available;
                busy: root.running || root.saving || root.picker-busy;
                width: min(max(120px, Theme.font-size * 10),
                    max(0px, root.width - (root.compact ? 8px : 24px) - 8px) * 0.48);
            }
        }
        if root.page == 0 && root.attention && !root.attention-dismissed: HorizontalLayout {
            spacing: 8px; height: max(32px, Theme.control-height); cross-axis-alignment: center;
            ErrorGlyph { width: 20px; height: 20px; }
            Text { text: root.issue != "" ? root.issue : root.verifying ? "Verification needs attention" : "Some results are incomplete";
                color: Theme.error-text; overflow: elide; vertical-alignment: center;
                min-width: 0px; horizontal-stretch: 1; }
            if !root.show-details: HintedActionButton {
                text: "Details"; hint: "Show the reason, every reported problem and the limits reached.";
                clicked => { root.show-details = true; root.focus-page(); }
            }
            CloseButton { label: "Dismiss checksum warning";
                hint: "Dismiss this notice.";
                width: Theme.control-height;
                clicked => { root.attention-dismissed = true; root.focus-page(); } }
        }
        Rectangle {
            vertical-stretch: 1; min-height: 18px; clip: true;
            background: Theme.pane-background; border-width: 1px; border-color: Theme.frame;
            // The note's lines at its width, to tell whether they fit below the headings.
            note-metrics := Text {
                visible: false; x: 12px; width: parent.width - 24px;
                text: root.note; wrap: word-wrap;
            }
            results := ChecksumResults {
                visible: root.page == 0 && !root.show-details;
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                // The empty list's note goes below the headings; where its lines do not fit
                // there (a short window), the headings make way for it.
                headings: !root.note-shown || self.height - Theme.column-height >= note-metrics.preferred-height;
                surface-width: root.width; surface-height: root.height;
                rows: root.rows; algorithms: root.output-available;
                generation-token: root.generation-token; output-algorithm: root.output-algorithm;
                cursor-row: root.cursor-row; selection-empty: root.selection-empty;
                selected-hashes: root.selected-hashes; selected-hashes-text: root.selected-hashes-text;
                active-row: root.active-row;
                pick-row(row, control, shift) => { root.pick-row(row, control, shift); }
                move-cursor(row, extend, keep) => { root.move-cursor(row, extend, keep); }
                toggle-row(advance) => { root.toggle-row(advance); }
                select-all => { root.select-all(); }
                deselect-all => { root.deselect-all(); }
                copy-selection(algorithm, whole) => { root.copy-selection(algorithm, whole); }
                copy-result(token, algorithm, whole, selection) => { root.copy-result(token, algorithm, whole, selection); }
                activate => { root.start-page-action(); }
            }
            // Never over the headings. Lines that do not fit even the whole frame (large
            // fonts in a short window) end in an ellipsis; the full text stays its label.
            if root.note-shown: Text {
                text: root.note;
                color: Theme.muted-text; wrap: word-wrap; overflow: elide;
                x: 12px; width: parent.width - 24px;
                y: results.y + results.rows-top; height: max(0px, parent.height - 1px - self.y);
                horizontal-alignment: center; vertical-alignment: center;
            }
            // The keyboard focus in the results: a ring over their frame, as a focused
            // field shows it. Hidden instead of conditional: an `if` is one more
            // generated component.
            Rectangle {
                visible: results.has-focus;
                border-width: 2px; border-color: Theme.active-frame;
            }
            if root.show-details: VScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                VerticalLayout {
                    padding: root.compact ? 8px : 16px; spacing: 8px; alignment: start;
                    Text { text: "Details"; color: Theme.strong-text; font-weight: 600; }
                    Text { text: root.details; color: Theme.text; wrap: word-wrap; }
                }
            }
            if root.page == 1 && !root.show-details: VScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                VerticalLayout {
                    padding: root.compact ? 8px : 16px; spacing: 12px; alignment: start;
                    Text { text: "Checksum file"; color: Theme.strong-text; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        // Themed, so that selected text uses the theme's selection colours.
                        ThemedLineEdit {
                            text <=> root.manifest-path; accessible-label: "Checksum file to verify";
                            enabled: !root.running && !root.saving && !root.picker-busy;
                            min-width: 0px; horizontal-stretch: 1; height: Theme.control-height;
                            accepted => { root.submit-verify(); }
                            Tip { text: "SFV, MD5, SHA-1, SHA-256 or SHA-512 manifest. Names are resolved relative to this file."; }
                        }
                        HintedActionButton { text: "…"; accessible-label: "Browse checksum file";
                            hint: "Choose a checksum file to verify."; width: Theme.control-height;
                            enabled: !root.running && !root.saving && !root.picker-busy;
                            clicked => { root.browse-manifest(true, root.output-algorithm); } }
                    }
                    Text { text: "SFV · MD5 · SHA-1 · SHA-256 · SHA-512";
                        color: Theme.secondary-text; wrap: word-wrap; font-size: Theme.small-font; }
                    if root.error != "": ErrorNotice { text: root.error; }
                }
            }
        }
        if root.save-prompt != "": HorizontalLayout {
            spacing: 8px; height: max(32px, Theme.control-height); cross-axis-alignment: center;
            Text { text: root.save-prompt; color: Theme.text; overflow: elide; vertical-alignment: center;
                min-width: 0px; horizontal-stretch: 1; }
            HintedActionButton {
                text: root.save-prompt-action; primary: true; fallback-icon: FallbackIcons.done;
                hint: "Go ahead and write the manifest.";
                clicked => { root.focus-page(); root.confirm-save(); }
            }
            HintedActionButton {
                text: "Cancel"; fallback-icon: FallbackIcons.close;
                hint: "Leave the manifest unwritten.";
                clicked => { root.focus-page(); root.cancel-save-prompt(); }
            }
        }
        if root.save-prompt == "" && root.save-status != "" && !root.save-status-dismissed: HorizontalLayout {
            spacing: 8px; height: max(32px, Theme.control-height); cross-axis-alignment: center;
            Text { text: root.save-status; color: Theme.text; overflow: elide; vertical-alignment: center;
                min-width: 0px; horizontal-stretch: 1; }
            if !root.show-details && !root.saving: HintedActionButton {
                text: "Details"; hint: "Show the saved file's full path, where a replaced file is kept and what a copy left out.";
                clicked => { root.show-details = true; root.focus-page(); }
            }
            if !root.saving: CloseButton { label: "Dismiss save notice";
                hint: "Dismiss this notice.";
                width: Theme.control-height;
                clicked => { root.save-status-dismissed = true; root.focus-page(); } }
        }
        if root.page == 0 && root.running && (root.progress-listing || root.progress-fraction >= 0): ProgressIndicator {
            progress: max(0, root.progress-fraction); indeterminate: root.progress-listing;
            height: 4px; accessible-label: "Checksum progress";
        }
        if !root.compact || root.page != 0 || !root.attention || root.attention-dismissed: Text {
            text: root.progress; color: root.attention ? Theme.error-text : Theme.secondary-text;
            font-size: Theme.small-font; overflow: elide; min-width: 0px;
            height: max(18px, Theme.small-font + 4px);
        }
        // Actions that do not fit whole beside Close move into More…: Copy details and Save…
        // first, then Copy; Back, Calculate or Stop and Verify always stay. `hidden` keeps
        // the conditions the buttons had.
        DialogFooter {
            dismiss-text: "Close"; dismiss-hint: "Close this checksum window (Escape). Running work is cancelled.";
            compact-height: root.compact; dismiss => { root.close-session(); }
            // One property per glyph: Slint 1.18.1 moves a value read twice in one literal
            // where one read is a branch of a condition, so the list reads each once.
            property <image> back-glyph: FallbackIcons.checksums;
            property <image> run-glyph: root.running ? FallbackIcons.close : FallbackIcons.checksums;
            property <image> save-glyph: root.saving ? FallbackIcons.close : FallbackIcons.save-again;
            property <image> verify-glyph: FallbackIcons.checksums;
            footer-actions: [
                { text: "Back", fallback-icon: self.back-glyph, hint: "Return to the page.",
                    shortcut: "", enabled: true, primary: false, drop: 0, hidden: !root.show-details },
                { text: "Copy details", fallback-icon: FallbackIcons.copy,
                    hint: "Copy these details, including full paths, to the clipboard.",
                    shortcut: "", enabled: true, primary: false, drop: 1, hidden: !root.show-details },
                // Not the default look over a verification's results: Enter verifies again.
                { text: root.stopping ? "Stopping…" : root.running ? "Stop" : "Calculate",
                    primary: !root.running && !root.verifying, fallback-icon: self.run-glyph,
                    enabled: !root.stopping && !root.saving && !root.picker-busy
                        && (root.running || (root.has-algorithm && root.has-captured-files)),
                    hint: root.running ? "Stop calculation and keep completed results."
                        : "Calculate the chosen checksums for the captured selection.",
                    shortcut: "", drop: 0, hidden: !(root.running || (root.page == 0 && !root.show-details)) },
                // Copies the selected rows only, also while a calculation runs; disabled, its
                // hint (also its accessible description) says why.
                { text: root.copy-caption, fallback-icon: FallbackIcons.copy,
                    enabled: root.copy-lines > 0 && root.output-available[root.output-algorithm],
                    hint: root.copy-hint,
                    shortcut: "", primary: false, drop: 2, hidden: !(root.page == 0 && !root.show-details) },
                { text: root.saving ? (root.save-stopping ? "Stopping…" : "Stop save") : root.width < 460px ? "Save…" : "Save manifest…",
                    fallback-icon: self.save-glyph,
                    enabled: root.saving ? !root.save-stopping : root.can-save,
                    hint: root.saving ? "Cancel writing the manifest."
                        : "Choose a file and save every calculated checksum of this run, whatever rows are selected (Copy takes the selected ones). An existing file is only replaced after you confirm.",
                    shortcut: "", primary: false, drop: 1,
                    hidden: !(root.page == 0 && !root.running && !root.show-details) },
                { text: "Verify", primary: true, fallback-icon: self.verify-glyph,
                    enabled: !root.saving && !root.picker-busy && root.manifest-path != "",
                    hint: "Read the checksum file and compare every listed file on background workers.",
                    shortcut: "", drop: 0, hidden: !(root.page == 1 && !root.running && !root.show-details) },
            ];
            footer-action(index) => {
                if index == 0 { root.show-details = false; root.focus-page(); }
                else if index == 1 { root.copy-details(); }
                else if index == 2 {
                    if root.running { root.stop(); } else { root.calculate(root.draft); root.page = 0; }
                }
                else if index == 3 { root.copy-checksum-file(root.output-algorithm); }
                else if index == 4 {
                    if root.saving { root.stop-save(); } else { root.browse-manifest(false, root.output-algorithm); }
                }
                else if index == 5 { root.submit-verify(); }
            }
        }
    }
}
