    callback keyboard-restore(string);
    callback keyboard-restore-all();
    callback window-key(KeyEvent) -> bool;
    callback window-key-release(KeyEvent);
    callback function-action(string, int);
    callback view-file(int, bool);
    callback compare-files(int);
    callback edit-file(int);
    in-out property <bool> control-layer;
    callback volume-key(KeyEvent) -> int;
    callback physical-shortcut(string, bool, bool, bool, bool) -> bool;
    in property <bool> native-alt-gr;
    in property <bool> native-digit-event;
    out property <int> volume-popup-pane: left.volume-popup-open ? 0 : right.volume-popup-open ? 1 : -1;
    out property <int> hot-path-popup-pane: left.hot-path-popup-open ? 0 : right.hot-path-popup-open ? 1 : -1;
    in property <string> file-menu-token;
    in property <length> file-menu-x;
    in property <length> file-menu-y;
    in property <bool> file-menu-mutable;
    callback file-menu-action(string, int);
    callback file-menu-dismissed(string);
    changed file-menu-token => {
        if root.file-menu-token != "" { root.drag-invalidate-targets(); file-menu.show(); }
        else { file-menu.close(); }
    }
    in property <[OperationRow]> operations;
    in property <string> operation-token;
    in property <string> operation-title;
    in property <string> operation-body;
    in property <string> operation-name;
    in property <int> operation-selection-end;
    in property <bool> operation-has-name;
    in property <bool> operation-dangerous;
    in property <image> operation-icon;
    in property <int> operation-kind;
    in property <string> operation-warning;
    in property <bool> network-available;
    callback mutation(int, int);
    callback confirm-operation(string, string);
    callback cancel-operation(string);
    callback cancel-job(string);
    callback copy-job-details(string);
    callback network-connections(bool);
    public function begin-operation() { operation-dialog.begin(); }
    public function show-operations() { root.drag-invalidate-targets(); operations-popup.show(); }
    in property <string> copy-token;
    in property <string> copy-body;
    in property <string> copy-name;
    in-out property <string> copy-latest;
    callback decide-copy(string, int, string);
    callback resolve-copy(string);
    public function show-copy-conflict() { root.drag-invalidate-targets(); operations-popup.close(); copy-popup.show(); }
    public function close-copy-conflict() { copy-popup.close(); }
    in property <string> copy-draft-token;
    in property <string> copy-draft-body;
    in property <string> copy-draft-destination;
    in property <int> copy-draft-selection-end;
    in property <string> copy-draft-error;
    callback confirm-copy-draft(string, string);
    callback cancel-copy-draft(string);
    public function show-copy-draft() { root.drag-invalidate-targets(); copy-draft-dialog.begin(); }
    in property <string> metadata-conflict-token;
    in property <string> metadata-conflict-body;
    callback decide-metadata-conflict(string, int);
    public function show-metadata-conflict() { root.drag-invalidate-targets(); operations-popup.close(); metadata-conflict-popup.show(); }
    public function close-metadata-conflict() { metadata-conflict-popup.close(); }
    in property <string> metadata-token;
    in property <string> metadata-revision;
    in property <bool> metadata-start-case;
    in property <string> metadata-summary;
    in property <string> metadata-preview-text;
    in property <[MetadataFileRow]> metadata-rows;
    in property <string> metadata-list-status;
    in property <bool> metadata-preview-current;
    in property <string> metadata-error;
    in property <bool> metadata-ready;
    in property <bool> metadata-busy;
