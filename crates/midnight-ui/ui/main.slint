    in property <bool> thumbnails-network: false;
    callback row-drag(int, int, string, float, float) -> bool;
    callback drag-moved(float, float);
    callback drag-released(float, float);
    callback drag-cancel();
    callback drag-escape() -> bool;
    callback drag-host-closed();
    callback drag-invalidate-targets();
    in property <bool> drag-active;
    in-out property <bool> touch-contact;
    callback release-drag-input();
    in property <int> drag-hover-pane: -1;
    in property <string> drag-label;
    in property <[string]> keyboard-actions;
    in property <int> keyboard-selected;
