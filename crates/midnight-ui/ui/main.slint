                retry-directory-elevated => { root.retry-directory-elevated(1); }
                row-context-menu(r, x, y, c, s) => { root.row-context-menu(1, r, x, y, c, s); }
                touch-contact: root.touch-contact;
                drop-highlight: root.drag-hover-pane == 1; drag-label: root.drag-label;
                drop-row: root.drag-hover-pane == 1 ? root.drag-hover-row : -1;
                drag-modifiers(c, s, link) => { root.drag-modifiers(c, s, link); }
                row-drag(r, identity, x, y) => { return root.row-drag(1, r, identity, x, y); }
                drag-moved(x, y) => { root.drag-moved(x, y); }
                drag-released(x, y) => { root.drag-released(x, y); }
                drag-cancelled => { root.drag-cancel(); }
                drive-context-menu(t, x, y, c, s) => { root.drive-context-menu(1, t, x, y, c, s); }
                key(k) => { root.key(1, k); } activate => { if root.active-pane != 1 { root.activate(1); } }
                bulk-selection(operation) => { root.bulk-selection(1, operation); }
                location(l) => { root.location(1, l); } properties => { root.properties(1); }
                attributes => { root.open-metadata(1, false); }
                search-query <=> root.right-search-query;
                search-context: root.right-search-context;
                search-pending: root.right-search-pending; search-count: root.right-search-count;
                search-edited(text) => { root.search-edited(1, text); }
                files-key(event, active, composing) => { return root.files-key(1, event, active, composing); }
                volume-key(event) => { return root.volume-key(event); }
                search-backspace(text, anchor, cursor) => { return root.search-backspace(text, anchor, cursor); }
                folder-sizes => { root.folder-sizes(1); } drive-letter(letter) => { return root.drive-letter(1, letter); }
                insert-path => { root.insert-path(1); } insert-name => { root.insert-name(); } drive-info => { root.drive-info(1); }
            }
            PanelSplitter {
                visible: !root.single-panel;
                x: panels.left-width; y: 0px; height: parent.height;
                fraction <=> root.panel-ratio;
                available-width: panels.usable; minimum-pane-width: panels.minimum-pane;
                centered => { root.panel-zoomed = false; }
                resized => { root.panel-zoomed = false; }
                committed(ratio) => { root.panel-split-changed(ratio); }
            }
            if root.compact-window && !root.panel-zoomed : Rectangle {
                x: panels.active-on-left ? panels.left-width + panels.gutter : 0px;
                width: panels.rail-width; height: parent.height;
                background: rail-touch.has-hover ? Theme.hover : Theme.secondary-surface;
                border-width: 1px; border-color: rail-focus.has-focus ? Theme.active-frame : Theme.frame;
                border-radius: 3px; forward-focus: rail-focus;
                accessible-role: button;
                accessible-label: root.active-pane == 0 ? "Activate right panel" : "Activate left panel";
                accessible-action-default => { root.activate(1 - root.active-pane); root.focus-files(); }
                Text {
                    text: panels.active-on-left ? "‹" : "›"; color: Theme.text;
                    font-size: Theme.font-size; horizontal-alignment: center; vertical-alignment: center;
                }
                rail-focus := FocusScope {
                    key-pressed(event) => {
                        if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift
                            && !event.modifiers.meta && (event.text == Key.Return || event.text == Key.Space) {
                            root.activate(1 - root.active-pane); root.focus-files(); return accept;
                        }
                        reject
                    }
                    rail-touch := TouchArea { clicked => { root.activate(1 - root.active-pane); root.focus-files(); } }
                }
                Tooltip { TipBody { text: "Activate other panel\n" + (root.active-pane == 0 ? root.right-path : root.left-path); } }
            }
        }
        if root.user-commands.length > 0 && !root.compact-window: UserCommandToolbar {
            commands: root.user-commands;
            execute(id, revision) => { root.execute-user-command(id, revision); }
            settings(id) => {
                if id != "" { UserCommandSettingsView.select(id); }
                root.options-topic-index = 9; root.show-options();
            }
            icon-visible(id, revision, visible) => { root.user-command-icon-visible(id, revision, visible); }
        }
        command-bar := Rectangle {
            height: root.compact-window ? min(32px, Theme.command-height) : Theme.command-height;
            background: Theme.secondary-surface; border-radius: 4px;
            border-width: 1px; border-color: command-input.has-focus ? Theme.active-frame : Theme.frame;
            HorizontalLayout {
                padding-top: 0px; padding-bottom: 0px;
                padding-left: Theme.touch ? 6px : 4px; padding-right: Theme.touch ? 6px : 4px;
                spacing: Theme.touch ? 6px : 5px;
                cross-axis-alignment: center;
                terminal-picker := TerminalControl {
                    height: command-bar.height;
                    model: root.terminal-choices; current-index: root.terminal-index;
                    windows-shells: root.windows-shells;
                    available: root.terminal-available; ready: root.terminal-ready;
                    action-icons: root.action-icons;
                    working-directory: root.command-directory; hint: root.command-hint;
                    selected(index) => { root.terminal-changed(index); root.focus-command(); }
                    launch => { root.open-terminal(); root.focus-command(); }
                    dismissed => { root.focus-command(); }
                }
                command-content := Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    height: command-bar.height;
                    // Retain the full prompt and useful typing space. A clipped
                    // prompt starts with its tail visible and explicit omission markers.
                    private property <length> editor-reserve: min(360px,
                        max(max(0px, self.width) * 0.5, min(320px, self.width - 120px)));
                    private property <length> prompt-width: root.command-directory == "" ? 0px
                        : min(root.command-path-natural-width, max(0px, self.width - self.editor-reserve));
                    cwd-scroll := ScrollView {
                        x: 0px; y: 0px;
                        width: command-content.prompt-width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        mouse-drag-pan-enabled: true;
                        content-width: max(self.visible-width, root.command-path-natural-width);
                        content-height: self.visible-height;
                        content-x: min(0px, self.visible-width - self.content-width);
                        changed content-width => { self.content-x = min(0px, self.visible-width - self.content-width); }
                        Rectangle {
                            width: cwd-scroll.content-width; height: cwd-scroll.visible-height;
                            full-cwd := Text {
                                x: 4px; width: self.preferred-width; height: parent.height;
                                text: root.command-prompt; wrap: no-wrap; overflow: clip;
                                color: Theme.secondary-text; font-size: Theme.small-font;
                                vertical-alignment: center;
                                accessible-label: "Working folder: " + root.command-directory;
                            }
                            TouchArea {
                                scroll-event(event) => {
                                    let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                                    if cwd-scroll.content-width > cwd-scroll.visible-width && delta != 0px {
                                        cwd-scroll.content-x = clamp(cwd-scroll.content-x + delta,
                                            min(0px, cwd-scroll.visible-width - cwd-scroll.content-width), 0px);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            Tooltip { TipBody { text: "Working folder: " + root.command-directory + "\nScroll or drag horizontally to view a long path."; } }
                        }
                    }
                    if cwd-scroll.content-x < -0.5px : Rectangle {
                        x: 0px; y: 0px; height: parent.height;
                        width: min(cwd-scroll.width, command-prefix.width + command-dots.preferred-width + 4px);
                        clip: true; background: Theme.secondary-surface;
                        command-prefix := Rectangle {
                            x: 4px; width: max(0px, min(100px, cwd-scroll.width * 0.3) - 4px);
                            height: parent.height; clip: true;
                            Text {
                                x: 0px; y: 0px;
                                width: self.preferred-width; height: parent.height;
                                text: root.command-directory; color: Theme.secondary-text;
                                font-size: Theme.small-font; vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        command-dots := OmissionText {
                            x: command-prefix.x + command-prefix.width; width: self.preferred-width;
                            height: parent.height; text: "..."; color: Theme.secondary-text;
                            font-size: Theme.small-font; vertical-alignment: center;
                            accessible-label: "Working folder path shortened";
                        }
                    }
                    if cwd-scroll.content-x > min(0px, cwd-scroll.visible-width - cwd-scroll.content-width) + 0.5px : Rectangle {
                        x: max(0px, cwd-scroll.width - self.width); height: parent.height;
                        width: right-command-dots.preferred-width + 4px;
                        background: Theme.secondary-surface;
                        right-command-dots := OmissionText {
                            width: parent.width; height: parent.height;
                            text: "..."; color: Theme.secondary-text;
                            font-size: Theme.small-font; vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    command-slot := Rectangle {
                        x: cwd-scroll.width;
                        width: max(0px, parent.width - self.x); height: parent.height; clip: true;
                        command-input := TextInput {
                            font-size: root.compact-window ? min(28px, Theme.font-size) : Theme.font-size;
                            private property <length> horizontal-offset;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.horizontal-offset));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: parent.height;
                            color: Theme.text; selection-background-color: Theme.selection-background;
                            selection-foreground-color: Theme.selection-text;
                            vertical-alignment: center; single-line: true;
                            accessible-label: "Command line";
                            cursor-position-changed(position) => {
                                if position.x + self.horizontal-offset < 0px { self.horizontal-offset = -position.x; }
                                else if position.x + self.horizontal-offset > parent.width - self.text-cursor-width {
                                    self.horizontal-offset = parent.width - position.x - self.text-cursor-width;
                                }
                            }
                            edited => { root.command-history-reset(); root.command-edited(self.text != ""); }
                        }
                        Tooltip { TipBody { text: root.command-hint + "\nWorking folder: " + root.command-directory
                            + "\n" + ShortcutHints.hint("Run command", "command.execute")
                            + "\n" + ShortcutHints.hint("Return to files", "command.focus-files")
                            + "\n" + ShortcutHints.hint("Append focused filename", "command.insert-name")
                            + "\n" + ShortcutHints.hint("Append focused full path", "command.insert-full-path")
                            + "\n" + ShortcutHints.hint("Insert active panel path", "command.insert-path")
                            + "\n" + ShortcutHints.hint("Insert left panel path", "command.insert-left-path")
                            + "\n" + ShortcutHints.hint("Insert right panel path", "command.insert-right-path"); } }
                    }
                }
                command-history-picker := CompactPicker {
                    width: Theme.touch ? 46px : 34px; minimum-control-width: 0px;
                    height: command-bar.height;
                    choices: root.command-history; model-revision: root.command-history-revision;
                    popup-above: true; popup-width: 620px; popup-align-right: true;
                    show-row-icons: false;
                    enabled: root.command-history.length > 0;
                    accessible-name: "Executed command history";
                    hint: "Executed command history\nPick a command to fill the editor without running it.";
                    selected-key(identity) => { root.command-history-choice(identity); root.focus-command(); }
                    dismissed => { root.focus-command(); }
                }
                FunctionButton {
                    height: command-bar.height; horizontal-stretch: 0;
                    native-icon: root.action-icons.run; fallback-icon: FallbackIcons.run;
                    text: root.compact-window ? "" : "Run";
                    compact-text: root.compact-window ? "" : "Run"; accessible-label: "Run";
                    enabled: root.terminal-ready && root.command-text != "";
                    hint: !root.terminal-available ? "A system terminal is unavailable."
                        : !root.terminal-ready ? "Waiting for the terminal to become ready."
                        : root.command-text == "" ? "Enter a command to run in the active panel’s folder."
                        : "Run with " + root.terminal-choices[root.terminal-index]
                            + "\nWorking folder: " + root.command-directory;
                    clicked => {
                        if root.submit-command(root.command-text) {
                            root.command-text = ""; root.command-edited(false);
                        }
                        root.focus-command();
                    }
                }
            }
        }
        function-bar := FunctionBar {
            can-measure-folders: root.active-pane == 0 ? root.left-can-measure-folders : root.right-can-measure-folders;
            compact: root.compact-window;
            can-target-cursor: root.active-pane == 0 ? root.left-can-target-cursor : root.right-can-target-cursor;
            can-target-selection: root.active-pane == 0 ? root.left-can-target-selection : root.right-can-target-selection;
            native-filesystem: root.active-pane == 0 ? root.left-native-filesystem : root.right-native-filesystem;
            icons: root.action-icons; pane: root.active-pane;
            modifiers: root.function-modifiers; network-available: root.network-available;
            searching: root.active-pane == 0 ? root.left-search-active : root.right-search-active;
            action(action, pane) => { root.function-action(action, pane); }
            jobs => { root.show-operations(); }
        }
        if !root.compact-window && root.desktop-feedback-important && root.desktop-status != "" : Text {
            text: root.desktop-status;
            color: Theme.secondary-text; font-size: Theme.hint-font;
            height: Theme.hint-font * 1.5; overflow: elide;
            accessible-label: root.desktop-status;
            Tooltip { TipBody { text: root.desktop-status; } }
        }
      }
    }
    custom-commands-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        forward-focus: custom-command-focus;
        TouchArea { clicked => { root.close-custom-commands(); } }
        Rectangle {
            x: 4px; y: min(root.height - self.height - 4px, toolbar.absolute-position.y + toolbar.height + 3px);
            width: max(0px, root.width - 8px); height: Theme.control-height + 8px;
            background: Theme.surface; border-width: 1px; border-color: Theme.active-frame; border-radius: 4px;
            custom-command-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-custom-commands(); return accept; }
                    reject
                }
                UserCommandToolbar {
                    x: 4px; y: 4px; width: max(0px, parent.width - 8px);
                    commands: root.user-commands; visible: root.custom-command-popup-open;
                    execute(id, revision) => {
                        if root.custom-command-context == root.toolbar-context {
                            root.close-custom-commands(); root.execute-user-command(id, revision);
                        }
                    }
                    settings(id) => {
                        if root.custom-command-context == root.toolbar-context {
                            root.close-custom-commands();
                            if id != "" { UserCommandSettingsView.select(id); }
                            root.options-topic-index = 9; root.show-options();
                        }
                    }
                    icon-visible(id, revision, visible) => { root.user-command-icon-visible(id, revision, visible); }
                }
            }
        }
    }
    file-menu := PopupWindow {
        width: min(root.width - 8px, max(230px, Theme.font-size * 12));
        height: min(root.height - 8px, Theme.control-height * 7 + 12px);
        x: clamp(root.file-menu-x, 4px, max(4px, root.width - self.width - 4px));
        y: clamp(root.file-menu-y, 4px, max(4px, root.height - self.height - 4px));
        close-policy: close-on-click-outside;
        forward-focus: menu-body;
        menu-body := FileActionMenu {
            token: root.file-menu-token;
            mutable-target: root.file-menu-mutable;
            action(token, action) => {
                file-menu.close(); root.file-menu-action(token, action); root.focus-files();
            }
            // Focus loss can run while Slint borrows its focus state. The Rust
            // callback retires this exact token and closes the popup next tick.
            dismissed(token) => { root.file-menu-dismissed(token); }
        }
    }
    metadata-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        metadata-popup-frame := DialogFrame {
            desired-width: max(640px, Theme.font-size * 28); desired-height: max(440px, Theme.font-size * 20);
            dismiss-on-outside: false;
            dismiss => { root.cancel-metadata(root.metadata-token); }
            metadata-body := MetadataDialog {
                move-dialog(dx, dy) => { metadata-popup-frame.move-by(dx, dy); }
                token: root.metadata-token; revision: root.metadata-revision;
                summary: root.metadata-summary; preview-text: root.metadata-preview-text;
                timestamp-example: root.metadata-timestamp-example;
                rows: root.metadata-rows; list-status: root.metadata-list-status;
                preview-current: root.metadata-preview-current;
                error: root.metadata-error; ready: root.metadata-ready; busy: root.metadata-busy;
                can-windows: root.metadata-can-windows; windows-mask: root.metadata-windows-mask;
                can-unix: root.metadata-can-unix; can-compress: root.metadata-can-compress;
                can-created: root.metadata-can-created; can-modified: root.metadata-can-modified;
                can-accessed: root.metadata-can-accessed; can-rename: root.metadata-can-rename;
                init => { self.begin(root.metadata-start-case); }
                changed token => { if self.token != "" { self.begin(root.metadata-start-case); } }
                preview(draft) => { root.preview-metadata(root.metadata-token, draft); }
                dirty => { root.dirty-metadata(root.metadata-token); }
                confirm(policy) => { root.confirm-metadata(root.metadata-token, root.metadata-revision, policy); }
                cancel => { root.cancel-metadata(root.metadata-token); }
                dismiss-hints => { root.dismiss-metadata-hints(); }
            }
        }
    }
    comparison-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        comparison-popup-frame := DialogFrame {
            desired-width: max(720px, Theme.font-size * 30); desired-height: max(560px, Theme.font-size * 24);
            dismiss-on-outside: false;
            dismiss => { root.cancel-comparison(); }
            CompareDirectoriesDialog {
                move-dialog(dx, dy) => { comparison-popup-frame.move-by(dx, dy); }
                model: root.comparison-view;
                private property <bool> opened: self.model.open;
                init => { self.begin(); }
                changed opened => { if self.opened { self.begin(); } }
                submit(size, time, names, tolerance, directories) => { root.submit-comparison(size, time, names, tolerance, directories); }
                cancel => { root.cancel-comparison(); }
            }
        }
    }

    options := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
      color-picker-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px;
        preferred-width: root.width; preferred-height: root.height;
        color-picker-frame := DialogFrame {
            // Popup WindowItem dimensions may retain their opening size. Anchor
            // the frame explicitly so Slint cannot center it in those old bounds.
            x: 0px; y: 0px; width: root.width; height: root.height;
            desired-width: max(480px, Theme.font-size * 22);
            desired-height: max(600px, Theme.font-size * 28);
            dismiss-on-outside: false; dim: true;
            changed visible => { if self.visible { self.reset(); } }
            color-picker-body := ColorPickerDialog {
                title: options-frame.picker-field == 0 ? "Foreground color" : "Background color";
                initial: options-frame.picker-initial; generation: options-frame.picker-generation;
                moved(dx, dy) => { color-picker-frame.move-by(dx, dy); }
                accepted(value) => {
                    ColorOptionsView.choose-color(options-frame.picker-field, value);
                    ColorOptionsView.picker-field = -1;
                }
                cancelled => { ColorOptionsView.picker-field = -1; }
            }
        }
      }
        options-frame := DialogFrame {
            private property <int> picker-field: ColorOptionsView.picker-field;
            private property <color> picker-initial;
            private property <int> picker-generation;
            changed picker-field => {
                if self.picker-field >= 0 && root.options-open {
                    self.picker-initial = self.picker-field == 0
                        ? (ColorOptionsView.preview-foreground-set ? ColorOptionsView.preview-foreground : Theme.text)
                        : (ColorOptionsView.preview-background-set ? ColorOptionsView.preview-background : Theme.pane-background);
                    self.picker-generation += 1;
                    color-picker-popup.show();
                } else { color-picker-popup.close(); }
            }
            desired-width: max(840px, Theme.font-size * 28); desired-height: max(660px, Theme.font-size * 23);
            changed body-left => { root.options-left = self.body-left; }
            changed body-top => { root.options-top = self.body-top; }
            changed body-width => { root.options-width = self.body-width; }
            changed body-height => { root.options-height = self.body-height; }
            dismiss-on-outside: false;
            dismiss => { root.cancel-options(); }
            options-body := OptionsBody {
                move-dialog(dx, dy) => { options-frame.move-by(dx, dy); }
                editor-default-label: root.editor-default-label; editor-executable: root.editor-executable;
                editor-arguments: root.editor-arguments; editor-revision: root.editor-revision; editor-error: root.editor-error;
                editor-apply(executable, arguments) => { root.editor-apply(executable, arguments); }
                editor-restore => { root.editor-restore(); }
                action-icons: root.action-icons;
                topic-index <=> root.options-topic-index;
                theme-index: root.theme-index; density-index: root.density-index;
                font-choices: root.font-choices; font-index: root.font-index; font-list-ready: root.font-list-ready;
                desktop-font-size: root.desktop-font-size; touch-font-size: root.touch-font-size;
                preferences-unsaved: root.preferences-unsaved;
                options-busy: root.options-busy; options-saving: root.options-committing;
                preferences-saving: root.preferences-saving; preferences-ready: root.preferences-ready;
                preferences-save-status: root.preferences-save-status; preferences-save-failed: root.preferences-save-failed;
                quick-search-filter: root.quick-search-filter; sizes-in-bytes: root.sizes-in-bytes;
                remember-command-history: root.remember-command-history;
                copy-checksum-verification: root.copy-checksum-verification;
                command-history-empty: root.command-history.length == 0;
                thumbnails-enabled: root.thumbnails-enabled;
                thumbnails-network: root.thumbnails-network;
                thumbnail-size: root.thumbnail-size;
                thumbnail-cache-location: root.thumbnail-cache-location;
                thumbnail-size-changed(size) => { root.thumbnail-size-changed(size); }
                thumbnail-options-changed(enabled, network, field) => { root.thumbnail-options-changed(enabled, network, field); }
                thumbnail-clear-cache => { root.thumbnail-clear-cache(); }
                preferences-changed(theme, density, field) => { root.preferences-changed(theme, density, field); }
                font-options-changed(family, desktop, touch, field) => { root.font-options-changed(family, desktop, touch, field); }
                search-filter-changed(value) => { root.search-filter-changed(value); }
                sizes-format-changed(value) => { root.sizes-format-changed(value); }
                remember-command-history-changed(value) => { root.remember-command-history-changed(value); }
                copy-verification-changed(value) => { root.copy-verification-changed(value); }
                command-history-clear => { root.command-history-clear(); }
                confirm => { root.options-accepted(); }
                reset => { root.options-reset(); }
                close => { root.cancel-options(); }
            }
        }
    }
    user-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - self.width) / 2; y: max(4px, root.height - self.height - 75px);
        width: min(root.width - 24px, max(340px, Theme.font-size * 18 + 24px));
        height: min(root.height - 8px, max(Theme.touch ? 280px : 220px, Theme.control-height * 5 + 90px));
        CommandMenuBody {
            dismissed => { user-menu.close(); }
            title: "User menu";
            item-count: 6;
            rows: [
                { native-icon: root.action-icons.terminal, fallback-icon: FallbackIcons.terminal, label: "Command line", hint: ShortcutHints.hint("Toggle command editor focus without running a command", "command.focus") },
                { native-icon: root.action-icons.bookmarks, fallback-icon: FallbackIcons.bookmarks, label: "Bookmarks and Hot Paths", hint: "Save, open or remove a favorite folder. Hot Paths provide ten numbered shortcuts." },
                { native-icon: root.action-icons.properties, fallback-icon: FallbackIcons.properties, label: "Properties" + (ShortcutHints.key("files.properties") == "" ? "" : " · " + ShortcutHints.key("files.properties")), hint: ShortcutHints.hint("Show Properties for selected items, or the focused file or folder", "files.properties") },
                { native-icon: root.action-icons.folder-sizes, fallback-icon: FallbackIcons.folder-sizes, label: "Calculate / cancel folder sizes", hint: ShortcutHints.hint("Measure selected folders, or all folders when nothing is selected; choose again to cancel", "panel.folder-sizes") },
                { fallback-icon: FallbackIcons.checksums, label: "Checksums", hint: ShortcutHints.hint("Calculate, save or verify SFV, MD5, SHA-1, SHA-256 and SHA-512", "files.checksums") },
                { native-icon: root.action-icons.close, fallback-icon: FallbackIcons.close, label: "Close", hint: "Close this dialog and return to the file manager." },
            ];
            selected(index) => {
                if index == 0 { user-menu.close(); root.focus-command(); }
                if index == 1 { user-menu.close(); if root.active-pane == 0 { left.open-bookmarks(); } else { right.open-bookmarks(); } }
                if index == 2 { user-menu.close(); root.properties(root.active-pane); }
                if index == 3 { user-menu.close(); root.folder-sizes(root.active-pane); }
                if index == 4 { user-menu.close(); root.calculate-checksums(root.active-pane); }
                if index == 5 { user-menu.close(); }
            }
        }
    }
    main-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: 0px; width: root.width; height: root.height;
        main-menu-frame := DialogFrame {
            desired-width: max(520px, Theme.font-size * 30); desired-height: 740px;
            dismiss-on-outside: true; dismiss => { main-menu.close(); root.focus-files(); }
            main-menu-body := MainMenuBody {
                can-measure-folders: root.active-pane == 0 ? root.left-can-measure-folders : root.right-can-measure-folders;
                icons: root.action-icons;
                generation: root.main-menu-generation;
                can-target-cursor: root.active-pane == 0 ? root.left-can-target-cursor : root.right-can-target-cursor;
                can-target-selection: root.active-pane == 0 ? root.left-can-target-selection : root.right-can-target-selection;
                native-filesystem: root.active-pane == 0 ? root.left-native-filesystem : root.right-native-filesystem;
                network-available: root.network-available;
                moved(dx, dy) => { main-menu-frame.move-by(dx, dy); }
                dismissed => { main-menu.close(); root.focus-files(); }
                action(action) => { main-menu.close(); root.function-action(action, root.active-pane); }
            }
        }
    }
    if root.drag-active && root.drag-feedback-state != 0 && !root.dialog-input-blocked
        && root.drag-x >= 0px && root.drag-y >= 0px && root.drag-x < root.width && root.drag-y < root.height : DragBadge {
        state: root.drag-feedback-state; label: root.drag-label;
        width: min(max(0px, root.width - 8px), self.preferred-width);
        x: max(4px, min(root.drag-x + 16px, root.width - self.width - 4px));
        y: max(4px, min(root.drag-y + 20px, root.height - self.height - 4px));
    }
    // Native owner-modal dialogs retain the main surface but gate its input.
    if root.dialog-input-blocked: TouchArea {
        width: root.width; height: root.height;
        scroll-event(event) => { accept }
    }
}
