    in property <string> metadata-conflict-token;
    in property <string> metadata-conflict-body;
    callback decide-metadata-conflict(string, int);
    public function show-metadata-conflict() { root.open-decision-window(true, false); }
    public function close-metadata-conflict() { root.close-decision-window(true); }
    in property <string> metadata-token;
    callback dismiss-metadata-hints();
    in property <string> metadata-revision;
    in property <bool> metadata-start-case;
    in property <string> metadata-summary;
