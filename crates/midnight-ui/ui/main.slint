    function close-custom-commands() {
        custom-commands-popup.close(); root.custom-command-popup-open = false; root.focus-files();
    }
    public function change-view-mode(pane: int, mode: int) {
        if pane == 0 { root.left-view-mode = mode; } else { root.right-view-mode = mode; }
        root.view-mode(pane, mode);
    }
    public function show-options() {
        if root.options-open { return; }
        root.drag-invalidate-targets();
        ColorOptionsView.picker-field = -1;
        ArchiveOptionsView.draft = "";
        root.options-opened();
        root.options-open = true;
    }
    public function cancel-options() {
        if root.options-committing { return; }
        root.options-cancelled();
        root.options-open = false;
    }
