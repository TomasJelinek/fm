    out property <length> right-list-grid-width: right.list-grid-width;
    public function remember-navigation-viewport(pane: int) {
        if pane == 0 { left.remember-navigation-viewport(); }
        else { right.remember-navigation-viewport(); }
    }
    public function finish-navigation-viewport(pane: int, failed: bool) {
        if pane == 0 { left.finish-navigation-viewport(failed); }
        else { right.finish-navigation-viewport(failed); }
    }
    public function scroll-selection(pane: int, delta: float) {
        if pane == 0 { left.scroll-selection(delta); }
        else { right.scroll-selection(delta); }
    }
