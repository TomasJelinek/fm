    }
    public function open-volume-menu(pane: int) {
        if pane == 0 { left.open-volumes(); } else { right.open-volumes(); }
    }
    public function commit-volume-shortcut(pane: int) {
        if pane == 0 { left.commit-volume-shortcut(); } else { right.commit-volume-shortcut(); }
    }
    public function apply-file-input-action(pane: int, action: int) {
        if pane == 0 { left.apply-input-action(action); } else { right.apply-input-action(action); }
    }
    public function show-app-menu(menu: int) {
        root.drag-invalidate-targets();
        if menu == 0 { help.show(); } else if menu == 1 { user-menu.show(); } else { main-menu.show(); }
    }
    public function show-options() { root.drag-invalidate-targets(); root.options-opened(); options.show(); }
    changed message-generation => { if root.message-generation != 0 { root.drag-invalidate-targets(); message.show(); } }
    changed command-text => { root.command-edited(root.command-text != ""); }
