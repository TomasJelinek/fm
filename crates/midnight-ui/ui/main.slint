                        }
                        root.focus-command();
                    }
                }
            }
        }
        FunctionBar {
            native-filesystem: root.active-pane == 0 ? root.left-native-filesystem : root.right-native-filesystem;
            icons: root.action-icons; pane: root.active-pane;
            control-layer: root.control-layer; network-available: root.network-available;
            searching: root.active-pane == 0 ? root.left-search-active : root.right-search-active;
            action(action, pane) => { root.function-action(action, pane); }
            options => { root.show-options(); }
            jobs => { root.show-operations(); }
        }
        if root.desktop-feedback-important && root.desktop-status != "" : Text {
