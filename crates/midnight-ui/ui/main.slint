    in property <bool> metadata-can-unix;
    in property <bool> metadata-can-compress;
    in property <bool> metadata-can-created;
    in property <bool> metadata-can-modified;
    in property <bool> metadata-can-accessed;
    in property <bool> metadata-can-rename;
    callback open-metadata(int, bool);
    callback preview-metadata(string, MetadataDraft);
    callback dirty-metadata(string);
    callback confirm-metadata(string, string, int);
    callback cancel-metadata(string);
    changed metadata-token => {
        if root.metadata-token != "" { root.drag-invalidate-targets(); metadata-popup.show(); }
        else { metadata-popup.close(); }
    }
    callback open-comparison();
    callback open-panel-filter(int);
    in property <ComparisonView> comparison-view;
    in property <PanelFilterView> panel-filter-view;
    in property <string> left-filter-label;
    in property <string> right-filter-label;
    callback submit-comparison(bool, bool, bool, string, bool);
    callback cancel-comparison();
    callback apply-panel-filter(int, bool, bool, string, bool);
    callback cancel-panel-filter();
    private property <bool> comparison-open: root.comparison-view.open;
    private property <bool> panel-filter-open: root.panel-filter-view.open;
    changed comparison-open => {
        if root.comparison-open { root.drag-invalidate-targets(); comparison-popup.show(); } else { comparison-popup.close(); }
    }
    changed panel-filter-open => {
        if root.panel-filter-open { root.drag-invalidate-targets(); panel-filter-popup.show(); } else { panel-filter-popup.close(); }
    }
    in property <ActionIcons> action-icons;
    in property <[NavigationChoiceRow]> navigation-choices;
    in property <int> navigation-revision;
    in property <int> left-navigation-index: -1;
    in property <int> right-navigation-index: -1;
    in property <string> application-version;
    in-out property <bool> panels-swapped;
    in-out property <float> panel-ratio: 0.5;
    in-out property <bool> panel-zoomed;
    public function toggle-panel-zoom(pane: int) {
        root.drag-invalidate-targets();
        root.activate(pane);
        root.panel-zoomed = !root.panel-zoomed;
        if pane == 0 { left.focus-list(); } else { right.focus-list(); }
    }
    public function swap-panels() {
        root.drag-invalidate-targets(); root.panels-swapped = !root.panels-swapped; root.focus-files();
    }
    title: "Midnight Explorer" + (root.application-version == "" ? "" : " " + root.application-version) + " — File Manager";
    icon: @image-url("../../../assets/branding/midnight-explorer.png");
    preferred-width: 1340px; preferred-height: 820px;
    min-width: 320px; min-height: 200px;
    // Switch presentation before fixed chrome consumes the usable file area.
    // Density and fonts never increase the native 320×200 minimum.
    private property <length> fixed-layout-height: 2 * Theme.window-padding
        + Theme.bottom-height + 2 * Theme.gap + Theme.command-height
        + Theme.control-height + 2 * Theme.toolbar-height + Theme.path-height
        + Theme.column-height + Theme.row-height + Theme.status-height + 12px
        + (Theme.touch ? Theme.control-height : 0px)
        + (root.left-filter-label != "" || root.right-filter-label != "" ? Theme.hint-font + 8px : 0px);
    out property <length> effective-minimum-height: 200px;
    out property <bool> compact-window: root.width < 640px || root.height < 360px
        || root.height < root.fixed-layout-height;
    private property <bool> single-panel: root.panel-zoomed || root.compact-window;
    background: Theme.window-background;
    default-font-family: Theme.font-family != "" ? Theme.font-family : "Segoe UI";
    default-font-size: Theme.font-size;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <int> active-pane;
    in property <bool> native-shortcuts-authoritative;
    in property <[TabRow]> left-tabs;
    in property <[TabRow]> right-tabs;
    in property <[BookmarkRow]> bookmarks;
    in property <[NavigationChoiceRow]> hot-path-choices;
    in property <[NavigationChoiceRow]> left-back-history;
    in property <[NavigationChoiceRow]> right-back-history;
    in property <[NavigationChoiceRow]> left-forward-history;
    in property <[NavigationChoiceRow]> right-forward-history;
    in property <int> history-revision;
    in property <[PathPartRow]> left-path-parts;
    in property <[PathPartRow]> right-path-parts;
    in property <[DetailRow]> left-details;
    in property <[DetailRow]> right-details;
    in property <string> left-free-space;
    in property <string> right-free-space;
    in property <string> left-bookmark-name;
    in property <string> right-bookmark-name;
    in property <bool> scroll-interaction-active;
    in-out property <int> theme-index <=> Theme.scheme;
    in-out property <int> left-view-mode;
    in-out property <int> right-view-mode;
    out property <int> left-view-columns: left.view-columns;
    out property <int> right-view-columns: right.view-columns;
    out property <int> left-view-rows: left.view-rows;
    out property <int> right-view-rows: right.view-rows;
    out property <length> left-view-row-height: left.row-height;
    out property <length> right-view-row-height: right.row-height;
    callback view-mode(int, int);
    in-out property <int> density-index <=> Theme.density;
    in property <[string]> font-choices;
    in property <int> font-index;
    in property <bool> font-list-ready;
    in-out property <int> desktop-font-size <=> Theme.desktop-font-size;
    in-out property <int> touch-font-size <=> Theme.touch-font-size;
    in property <bool> preferences-unsaved;
    out property <int> focused-pane: left.list-focused ? 0 : right.list-focused ? 1 : -1;
    out property <bool> shell-focused: shortcuts.has-focus;
    out property <length> left-pane-left: left.absolute-position.x;
    out property <length> left-pane-top: left.absolute-position.y;
    out property <length> left-pane-width: left.width;
    out property <length> left-pane-height: left.height;
    out property <length> right-pane-left: right.absolute-position.x;
    out property <length> right-pane-top: right.absolute-position.y;
    out property <length> right-pane-width: right.width;
    out property <length> right-pane-height: right.height;
    out property <int> left-visible-row-start: left.visible-row-start;
    out property <string> left-hovered-row: left.hovered-row;
    out property <string> right-hovered-row: right.hovered-row;
    out property <int> left-thumbnail-row-start: left.thumbnail-row-start;
    out property <int> left-thumbnail-row-end: left.thumbnail-row-end;
    out property <int> right-thumbnail-row-start: right.thumbnail-row-start;
    out property <int> right-thumbnail-row-end: right.thumbnail-row-end;
    out property <int> left-visible-row-end: left.visible-row-end;
    out property <int> right-visible-row-start: right.visible-row-start;
    out property <int> right-visible-row-end: right.visible-row-end;
    out property <length> left-list-visible-height: left.list-visible-height;
    out property <length> right-list-visible-height: right.list-visible-height;
    out property <length> left-list-left: left.list-left;
    out property <length> left-list-top: left.list-top;
    out property <length> left-list-width: left.list-width;
    out property <length> left-list-height: left.list-visible-height;
    out property <length> right-list-left: right.list-left;
    out property <length> right-list-top: right.list-top;
    out property <length> right-list-width: right.list-width;
    out property <length> right-list-height: right.list-visible-height;
    changed left-list-left => { root.drag-invalidate-targets(); }
    changed left-list-top => { root.drag-invalidate-targets(); }
    changed left-list-width => { root.drag-invalidate-targets(); }
    changed left-list-height => { root.drag-invalidate-targets(); }
    changed right-list-left => { root.drag-invalidate-targets(); }
    changed right-list-top => { root.drag-invalidate-targets(); }
    changed right-list-width => { root.drag-invalidate-targets(); }
    changed right-list-height => { root.drag-invalidate-targets(); }
    out property <length> left-path-left: left.path-left;
    out property <length> left-path-top: left.path-top;
    out property <length> left-path-width: left.path-width;
    out property <length> left-path-control-height: left.path-control-height;
    out property <string> left-path-draft: left.path-draft;
    out property <string> right-path-draft: right.path-draft;
    out property <string> left-highlighted-path: left.highlighted-path;
    out property <length> left-details-top: left.details-top;
    out property <length> left-details-left: left.details-left;
    in property <[FileRow]> left-rows;
    in property <[FileRow]> right-rows;
    in property <[LocationRow]> left-locations;
    in property <[LocationRow]> right-locations;
    in property <[string]> volumes;
    in property <[image]> volume-icons;
    in property <[string]> volume-short-labels;
    in property <[string]> volume-tooltips;
    in property <int> volumes-revision;
    in property <string> left-path;
    in property <string> right-path;
    in property <int> left-volume: -1;
    in property <int> right-volume: -1;
    in property <string> left-status;
    in property <string> right-status;
    in property <string> left-error;
    in property <string> right-error;
    in property <bool> left-loading;
    in property <bool> right-loading;
    in property <int> left-cursor: -1;
    in property <int> right-cursor: -1;
    in-out property <string> left-search-query;
    in-out property <string> right-search-query;
    in property <string> left-search-context;
    in property <string> right-search-context;
    in property <bool> left-search-pending;
    in property <bool> right-search-pending;
    in property <int> left-search-count;
    in property <int> right-search-count;
    in-out property <bool> quick-search-filter;
    in-out property <bool> sizes-in-bytes;
    in-out property <bool> remember-command-history: true;
    in-out property <int> options-topic-index;
    out property <bool> left-search-active: left.search-active;
    out property <bool> right-search-active: right.search-active;
    out property <string> left-search-preedit: left.search-preedit;
    out property <string> right-search-preedit: right.search-preedit;
    in property <int> left-sort;
    in property <int> right-sort;
    in property <bool> left-descending;
    in property <bool> right-descending;
    in property <bool> terminal-ready;
    in property <bool> terminal-available;
    in property <[string]> terminal-choices;
    in property <bool> windows-shells;
    in property <int> terminal-index;
    in property <[NavigationChoiceRow]> command-history;
    in property <int> command-history-revision;
    in property <string> command-hint;
    in property <string> desktop-status;
    in property <bool> desktop-feedback-important;
    in property <string> message-title;
    in property <string> message-body;
    in property <bool> message-error;
    callback copy-message();
    in property <int> message-generation;
    in-out property <string> command-text <=> command-input.text;
    out property <string> command-directory: root.active-pane == 0 ? root.left-path : root.right-path;
    out property <string> command-prompt: root.command-directory == "" ? "" : root.command-directory + ">";
    changed command-directory => { cwd-scroll.content-x = 0px; }
    out property <length> command-path-natural-width: full-cwd.preferred-width + 8px;
    out property <length> command-path-content-width: cwd-scroll.content-width;
    out property <length> command-path-width: cwd-scroll.width;
    out property <length> command-path-height: cwd-scroll.height;
    out property <length> command-path-left: cwd-scroll.absolute-position.x;
    out property <length> command-path-top: cwd-scroll.absolute-position.y;
    out property <length> command-path-text-left: full-cwd.absolute-position.x;
    out property <length> command-bar-top: command-bar.absolute-position.y;
    out property <length> command-bar-height: command-bar.height;
    out property <length> command-input-left: command-slot.absolute-position.x;
    out property <length> command-input-width: command-slot.width;
    out property <length> command-input-top: command-slot.absolute-position.y;
    out property <length> command-input-height: command-slot.height;
    out property <length> command-history-left: command-history-picker.absolute-position.x;
    out property <length> command-history-top: command-history-picker.absolute-position.y;
    out property <length> command-history-width: command-history-picker.width;
    out property <length> command-history-height: command-history-picker.height;
    out property <length> options-left: (root.width - root.options-width) / 2;
    out property <length> options-top: (root.height - root.options-height) / 2;
    out property <length> options-width: min(root.width - 24px, max(900px, Theme.font-size * 38));
    out property <length> options-height: min(root.height - 24px, max(720px, Theme.font-size * 30));
    out property <bool> command-focused: command-input.has-focus;
    // Slint 1.18.1 exposes these internal UTF-8 offsets; keep the pinned SDK and
    // the actual-key Unicode selection tests together when upgrading Slint.
    out property <int> command-anchor: command-input.anchor-position-byte-offset;
    out property <int> command-cursor: command-input.cursor-position-byte-offset;
    callback backend-ready();
    callback action(int, int);
    callback navigate(int, string);
    callback volume(int, int);
    callback sort(int, int);
    callback row-click(int, int, bool, bool);
    callback row-context-menu(int, int, float, float, bool, bool);
    callback drive-context-menu(int, string, float, float, bool, bool);
    callback file-clipboard(int, int);
    callback open(int, int);
    callback key(int, int);
    callback bulk-selection(int, int);
    callback activate(int);
    callback location(int, int);
    callback navigation-choice(int, string);
    callback path-part(int, string);
    callback path-copy(int, string);
    callback history-choice(int, bool, string);
    callback detail-copy(int, string);
    callback properties(int);
    callback folder-sizes(int);
    callback drive-letter(int, string) -> bool;
    callback search-edited(int, string);
    callback files-key(int, KeyEvent, bool, bool) -> int;
    callback search-backspace(string, int, int) -> SearchTextEdit;
    callback search-filter-changed(bool);
    callback sizes-format-changed(bool);
    callback remember-command-history-changed(bool);
    callback insert-path(int);
    callback insert-name();
    callback tab-new(int);
    callback tab-select(int, string);
    callback tab-close(int, string);
    callback tab-close-active(int);
    callback tab-cycle(int, int);
    callback tab-number(int, int);
    callback bookmark-add(int, string, int);
    callback bookmark-open(int, string);
    callback bookmark-remove(string);
    callback bookmark-assign(string, int);
    callback bookmark-slot(int, int);
    callback bookmark-jump(int, int);
    callback drive-info(int);
    callback submit-command(string) -> bool;
    callback command-history-choice(string);
    callback command-history-step(bool);
    callback command-history-reset();
    callback command-history-clear();
    callback exit();
    callback preferences-changed(int, int, int);
    callback font-options-changed(int, int, int, int);
    callback options-opened();
    in property <string> editor-default-label;
    in property <string> editor-executable;
    in property <string> editor-arguments;
    in property <string> editor-revision;
    in property <string> editor-error;
    callback editor-apply(string, string);
    callback editor-restore();
    callback terminal-changed(int);
    callback open-terminal();
    callback command-edited(bool);
    public function apply-preferences(theme: int, density: int) {
        Theme.scheme = theme;
        Theme.density = density;
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    public function apply-fonts(family: string, desktop: int, touch: int) {
        Theme.font-family = family;
        Theme.desktop-font-size = desktop;
        Theme.touch-font-size = touch;
    }
    public function focus-files() {
        if root.copy-draft-token != "" { copy-draft-dialog.focus-input(); }
        else if root.active-pane == 0 { left.focus-list(); } else { right.focus-list(); }
    }
    public function reset-files-input(pane: int) {
        if pane == 0 { left.reset-search-context(); } else { right.reset-search-context(); }
    }
    public function reveal-left() { left.reveal-cursor(); }
    public function reveal-right() { right.reveal-cursor(); }
    public function set-command(text: string, offset: int) {
        root.command-history-reset();
        root.set-history-command(text, offset);
    }
    public function set-history-command(text: string, offset: int) {
        command-input.text = text;
        command-input.focus();
        command-input.set-selection-offsets(offset, offset);
    }
    public function focus-command() { command-input.focus(); }
    public function execute-command() {
        if root.submit-command(root.command-text) { root.command-text = ""; root.command-edited(false); }
    }
    public function open-volume-menu(pane: int) {
        if pane == 0 { left.open-volumes(); } else { right.open-volumes(); }
    }
    public function commit-volume-shortcut(pane: int) {
        if pane == 0 { left.commit-volume-shortcut(); } else { right.commit-volume-shortcut(); }
    }
    public function take-location-choice(pane: int, index: int) -> string {
        return pane == 0 ? left.take-location-choice(index) : right.take-location-choice(index);
    }
    public function apply-file-input-action(pane: int, action: int) {
        if pane == 0 { left.apply-input-action(action); } else { right.apply-input-action(action); }
    }
    public function show-app-menu(menu: int) {
        root.drag-invalidate-targets();
        if menu == 0 { help.show(); } else if menu == 1 { user-menu.show(); } else { main-menu.show(); }
    }
    public function show-options() { root.drag-invalidate-targets(); root.options-opened(); options.show(); }
    public function capture-function-press(x: length, y: length) { function-bar.capture-press(x, y); }
    public function release-function-press() { function-bar.release-press(); }
    changed message-generation => { if root.message-generation != 0 { root.drag-invalidate-targets(); message.show(); } }
    changed command-text => { root.command-edited(root.command-text != ""); }
    shortcuts := FocusScope {
      min-width: 0px; min-height: 0px;
      preferred-width: 0px; preferred-height: 0px;
      capture-key-pressed(event) => {
        if event.text == Key.Escape && root.drag-escape() { return accept; }
        if root.window-key(event) { return accept; }
        reject
      }
      capture-key-released(event) => { root.window-key-release(event); reject }
      VerticalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding: root.compact-window ? 4px : Theme.window-padding;
        spacing: root.compact-window ? 2px : Theme.gap;
        panels := Rectangle {
            vertical-stretch: 1;
            private property <length> gutter: Theme.touch ? 12px : 6px;
            private property <length> usable: max(0px, self.width - self.gutter);
            private property <length> minimum-pane: min(286px, self.usable / 2);
            private property <length> rail-width: Theme.touch ? 44px : 28px;
            private property <bool> active-on-left: (root.active-pane == 0) != root.panels-swapped;
            private property <length> left-width: root.single-panel
                ? (self.active-on-left ? self.usable - self.rail-width : self.rail-width)
