    callback physical-shortcut(string, bool, bool, bool, bool) -> bool;
    in property <bool> native-alt-gr;
    in property <bool> native-digit-event;
    out property <int> volume-popup-pane: left.volume-popup-open ? 0 : right.volume-popup-open ? 1 : -1;
    in property <string> file-menu-token;
    in property <length> file-menu-x;
    in property <length> file-menu-y;
    in property <bool> file-menu-mutable;
    callback file-menu-action(string, int);
    callback file-menu-dismissed(string);
    changed file-menu-token => {
        if root.file-menu-token != "" { root.drag-invalidate-targets(); file-menu.show(); }
        else { file-menu.close(); }
    }
    in property <[OperationRow]> operations;
    in property <string> operation-token;
    in property <string> operation-title;
    in property <string> operation-body;
    in property <string> operation-name;
    in property <int> operation-selection-end;
