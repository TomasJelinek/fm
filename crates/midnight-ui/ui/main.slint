            color: Theme.secondary-text; font-size: Theme.hint-font;
            height: Theme.hint-font * 1.5; overflow: elide;
            accessible-label: root.desktop-status;
            Tooltip { TipBody { text: root.desktop-status; } }
        }
      }
    }
    Rectangle {
        visible: root.operation-token != "";
        width: root.width; height: root.height;
        background: #00000060;
        TouchArea {}
        operation-dialog := OperationDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(parent.width - 24px, 650px); height: min(parent.height - 24px, 420px);
            title: root.operation-title; body: root.operation-body;
            initial-name: root.operation-name; selection-end: root.operation-selection-end;
            has-name: root.operation-has-name; dangerous: root.operation-dangerous;
            native-icon: root.operation-icon; warning: root.operation-warning;
            fallback-icon: root.operation-kind == 0 ? FallbackIcons.rename
