export component MainWindow inherits Window {
    in property <bool> left-native-filesystem: true;
    in property <bool> right-native-filesystem: true;
    in property <bool> left-can-target-cursor;
    in property <bool> right-can-target-cursor;
    in property <bool> left-can-target-selection;
    in property <bool> right-can-target-selection;
