    callback refresh-jobs-window(bool);
    callback close-jobs-window();
    callback open-decision-window(bool, bool);
    callback refresh-decision-windows();
    callback close-decision-window(bool);
    callback close-decision-windows();
    public function show-operations() {
        root.operations-visible = true; root.refresh-jobs-window(true);
    }
    public function close-operations() {
        root.operations-visible = false;
        root.refresh-jobs-window(false);
    }
    in property <string> copy-token;
    in property <string> copy-body;
    in property <string> copy-name;
