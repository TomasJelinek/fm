    callback decide-copy(string, int, string);
    callback resolve-copy(string);
    callback defer-copy(string);
    public function show-copy-conflict() { root.open-decision-window(false, false); }
    public function close-copy-conflict() { root.close-decision-window(false); }
    in property <string> copy-draft-token;
    in property <bool> copy-draft-move;
