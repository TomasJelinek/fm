    callback search-edited(int, string);
    callback files-key(int, KeyEvent, bool, bool) -> int;
    callback search-backspace(string, int, int) -> SearchTextEdit;
    callback search-filter-changed(bool);
    callback sizes-format-changed(bool);
    callback remember-command-history-changed(bool);
    callback insert-path(int);
    callback insert-name();
    callback tab-new(int);
    callback tab-select(int, string);
    callback tab-close(int, string);
    callback tab-close-active(int);
    callback tab-cycle(int, int);
    callback tab-number(int, int);
    callback bookmark-add(int, string, int);
    callback bookmark-open(int, string);
    callback bookmark-remove(string);
    callback bookmark-assign(string, int);
    callback bookmark-slot(int, int);
    callback bookmark-jump(int, int);
    callback drive-info(int);
    callback submit-command(string) -> bool;
    callback command-history-choice(string);
    callback command-history-step(bool);
    callback command-history-reset();
    callback command-history-clear();
    callback exit();
    callback preferences-changed(int, int, int);
    callback font-options-changed(int, int, int, int);
    callback options-opened();
    in property <string> editor-default-label;
    in property <string> editor-executable;
    in property <string> editor-arguments;
    in property <string> editor-revision;
    in property <string> editor-error;
    callback editor-apply(string, string);
    callback editor-restore();
    callback terminal-changed(int);
    callback open-terminal();
    callback command-edited(bool);
    public function apply-preferences(theme: int, density: int) {
        Theme.scheme = theme;
        Theme.density = density;
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    public function apply-fonts(family: string, desktop: int, touch: int) {
        Theme.font-family = family;
        Theme.desktop-font-size = desktop;
        Theme.touch-font-size = touch;
    }
    public function focus-files() {
        if root.copy-draft-token != "" { copy-draft-dialog.focus-input(); }
        else if root.active-pane == 0 { left.focus-list(); } else { right.focus-list(); }
    }
    public function reset-files-input(pane: int) {
        if pane == 0 { left.reset-search-context(); } else { right.reset-search-context(); }
    }
    public function reveal-left() { left.reveal-cursor(); }
    public function reveal-right() { right.reveal-cursor(); }
    public function set-command(text: string, offset: int) {
        root.command-history-reset();
        root.set-history-command(text, offset);
