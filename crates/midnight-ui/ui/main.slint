    out property <length> options-width: min(root.width - 24px, max(900px, Theme.font-size * 38));
    out property <length> options-height: min(root.height - 24px, max(720px, Theme.font-size * 30));
    out property <bool> command-focused: command-input.has-focus;
    // Slint 1.18.1 exposes these internal UTF-8 offsets; keep the pinned SDK and
    // the actual-key Unicode selection tests together when upgrading Slint.
    out property <int> command-anchor: command-input.anchor-position-byte-offset;
    out property <int> command-cursor: command-input.cursor-position-byte-offset;
    callback backend-ready();
    callback action(int, int);
    callback navigate(int, string);
    callback volume(int, int);
