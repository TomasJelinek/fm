    }
    operation-frame := DialogFrame {
        visible: root.operation-token != "";
        width: root.width; height: root.height;
        desired-width: 650px; desired-height: 420px; dim: true;
        changed visible => { if self.visible { self.reset(); } }
        operation-dialog := OperationDialog {
            move-dialog(dx, dy) => { operation-frame.move-by(dx, dy); }
            title: root.operation-title; body: root.operation-body;
            initial-name: root.operation-name; selection-end: root.operation-selection-end;
            has-name: root.operation-has-name; dangerous: root.operation-dangerous;
            native-icon: root.operation-icon; warning: root.operation-warning;
            fallback-icon: root.operation-kind == 0 ? FallbackIcons.rename
                : root.operation-kind == 3 ? FallbackIcons.new-folder
                : root.operation-kind == 4 ? FallbackIcons.new-file : FallbackIcons.delete;
            confirm-text: root.operation-title;
            confirm(name) => { root.confirm-operation(root.operation-token, name); }
            cancel => { root.cancel-operation(root.operation-token); }
        }
    }
    operations-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        operations-popup-frame := DialogFrame {
            desired-width: max(820px, Theme.font-size * 32); desired-height: max(620px, Theme.font-size * 25);
            dismiss-on-outside: false;
            dismiss => { operations-popup.close(); root.focus-files(); }
            OperationsBody {
                move-dialog(dx, dy) => { operations-popup-frame.move-by(dx, dy); }
                rows: root.operations;
                cancel(id) => { root.cancel-job(id); }
                resolve(id) => { root.resolve-copy(id); }
                copy-details(id) => { root.copy-job-details(id); }
                close => { operations-popup.close(); root.focus-files(); }
            }
        }
    }
    copy-draft-frame := DialogFrame {
        visible: root.copy-draft-token != "";
        width: root.width; height: root.height;
        desired-width: max(620px, Theme.font-size * 26); desired-height: max(300px, Theme.font-size * 14); dim: true;
        changed visible => { if self.visible { self.reset(); } }
        copy-draft-dialog := OperationDialog {
            move-dialog(dx, dy) => { copy-draft-frame.move-by(dx, dy); }
            title: "Copy"; body: root.copy-draft-body; has-name: true;
            initial-name: root.copy-draft-destination; selection-end: root.copy-draft-selection-end;
            input-label: "Destination folder"; confirm-text: "Copy"; warning: root.copy-draft-error;
            native-icon: root.action-icons.copy; fallback-icon: FallbackIcons.copy;
            confirm(destination) => { root.confirm-copy-draft(root.copy-draft-token, destination); }
            cancel => { root.cancel-copy-draft(root.copy-draft-token); }
        }
    }
    copy-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: 0px; width: root.width; height: root.height;
        copy-popup-frame := DialogFrame {
            desired-width: max(600px, Theme.font-size * 25); desired-height: max(400px, Theme.font-size * 16);
            dismiss-on-outside: true;
            dismiss => { copy-popup.close(); root.focus-files(); }
            copy-dialog := CopyConflictDialog {
                move-dialog(dx, dy) => { copy-popup-frame.move-by(dx, dy); }
                body: root.copy-body; initial-name: root.copy-name; token: root.copy-token; native-icon: root.action-icons.copy;
                decide(choice, name) => { root.decide-copy(root.copy-token, choice, name); }
                later => { copy-popup.close(); root.focus-files(); }
            }
        }
    }
    file-menu := PopupWindow {
        width: min(root.width - 8px, max(230px, Theme.font-size * 12));
        height: min(root.height - 8px, Theme.control-height * 6 + 12px);
        x: clamp(root.file-menu-x, 4px, max(4px, root.width - self.width - 4px));
        y: clamp(root.file-menu-y, 4px, max(4px, root.height - self.height - 4px));
        close-policy: close-on-click-outside;
        forward-focus: menu-body;
        menu-body := FileActionMenu {
            token: root.file-menu-token;
            mutable-target: root.file-menu-mutable;
            action(token, action) => {
                file-menu.close(); root.file-menu-action(token, action); root.focus-files();
            }
            dismissed(token) => { file-menu.close(); root.file-menu-dismissed(token); }
        }
    }
    metadata-conflict-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        metadata-conflict-popup-frame := DialogFrame {
            desired-width: max(620px, Theme.font-size * 28); desired-height: max(440px, Theme.font-size * 18);
            dismiss-on-outside: false;
            dismiss => { metadata-conflict-popup.close(); root.focus-files(); }
            CopyConflictDialog {
                move-dialog(dx, dy) => { metadata-conflict-popup-frame.move-by(dx, dy); }
                token: root.metadata-conflict-token; body: root.metadata-conflict-body;
                native-icon: root.action-icons.properties; allow-alternate-name: false;
                decide(choice, name) => { root.decide-metadata-conflict(root.metadata-conflict-token, choice); }
                later => { metadata-conflict-popup.close(); root.focus-files(); }
            }
        }
    }
    metadata-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        metadata-popup-frame := DialogFrame {
            desired-width: max(860px, Theme.font-size * 32); desired-height: max(620px, Theme.font-size * 25);
            dismiss-on-outside: false;
            dismiss => { root.cancel-metadata(root.metadata-token); }
            metadata-body := MetadataDialog {
                move-dialog(dx, dy) => { metadata-popup-frame.move-by(dx, dy); }
                token: root.metadata-token; revision: root.metadata-revision;
                summary: root.metadata-summary; preview-text: root.metadata-preview-text;
                rows: root.metadata-rows; list-status: root.metadata-list-status;
                preview-current: root.metadata-preview-current;
                error: root.metadata-error; ready: root.metadata-ready; busy: root.metadata-busy;
                can-windows: root.metadata-can-windows; windows-mask: root.metadata-windows-mask;
                can-unix: root.metadata-can-unix; can-compress: root.metadata-can-compress;
                can-created: root.metadata-can-created; can-modified: root.metadata-can-modified;
                can-accessed: root.metadata-can-accessed; can-rename: root.metadata-can-rename;
                init => { self.begin(root.metadata-start-case); }
                changed token => { if self.token != "" { self.begin(root.metadata-start-case); } }
                preview(draft) => { root.preview-metadata(root.metadata-token, draft); }
                dirty => { root.dirty-metadata(root.metadata-token); }
                confirm(policy) => { root.confirm-metadata(root.metadata-token, root.metadata-revision, policy); }
                cancel => { root.cancel-metadata(root.metadata-token); }
            }
        }
    }
    comparison-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        comparison-popup-frame := DialogFrame {
            desired-width: max(720px, Theme.font-size * 30); desired-height: max(560px, Theme.font-size * 24);
            dismiss-on-outside: false;
            dismiss => { root.cancel-comparison(); }
            CompareDirectoriesDialog {
                move-dialog(dx, dy) => { comparison-popup-frame.move-by(dx, dy); }
                model: root.comparison-view;
                private property <bool> opened: self.model.open;
                init => { self.begin(); }
                changed opened => { if self.opened { self.begin(); } }
                submit(size, time, names, tolerance, directories) => { root.submit-comparison(size, time, names, tolerance, directories); }
                cancel => { root.cancel-comparison(); }
            }
        }
    }
    panel-filter-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        panel-filter-popup-frame := DialogFrame {
            desired-width: max(700px, Theme.font-size * 30); desired-height: max(480px, Theme.font-size * 24);
            dismiss-on-outside: false;
            dismiss => { root.cancel-panel-filter(); }
            PanelFilterDialog {
                move-dialog(dx, dy) => { panel-filter-popup-frame.move-by(dx, dy); }
                model: root.panel-filter-view;
                private property <bool> opened: self.model.open;
                init => { self.begin(); }
                changed opened => { if self.opened { self.begin(); } }
                apply(enabled, regex, expression, names) => { root.apply-panel-filter(root.panel-filter-view.pane, enabled, regex, expression, names); }
                cancel => { root.cancel-panel-filter(); }
            }
        }
    }
    options := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: 0px; width: root.width; height: root.height;
        options-frame := DialogFrame {
            desired-width: max(900px, Theme.font-size * 38); desired-height: max(720px, Theme.font-size * 30);
            changed body-left => { root.options-left = self.body-left; }
            changed body-top => { root.options-top = self.body-top; }
            changed body-width => { root.options-width = self.body-width; }
            changed body-height => { root.options-height = self.body-height; }
            dismiss-on-outside: true;
            dismiss => { options.close(); }
            options-body := OptionsBody {
                move-dialog(dx, dy) => { options-frame.move-by(dx, dy); }
                editor-default-label: root.editor-default-label; editor-executable: root.editor-executable;
                editor-arguments: root.editor-arguments; editor-revision: root.editor-revision; editor-error: root.editor-error;
                editor-apply(executable, arguments) => { root.editor-apply(executable, arguments); }
                editor-restore => { root.editor-restore(); }
                action-icons: root.action-icons;
                topic-index <=> root.options-topic-index;
                theme-index: root.theme-index; density-index: root.density-index;
                font-choices: root.font-choices; font-index: root.font-index; font-list-ready: root.font-list-ready;
                desktop-font-size: root.desktop-font-size; touch-font-size: root.touch-font-size;
                preferences-unsaved: root.preferences-unsaved;
                quick-search-filter: root.quick-search-filter; sizes-in-bytes: root.sizes-in-bytes;
                remember-command-history: root.remember-command-history;
                command-history-empty: root.command-history.length == 0;
                thumbnails-enabled: root.thumbnails-enabled;
                thumbnails-network: root.thumbnails-network;
                thumbnail-options-changed(enabled, network, field) => { root.thumbnail-options-changed(enabled, network, field); }
                thumbnail-clear-cache => { root.thumbnail-clear-cache(); }
                preferences-changed(theme, density, field) => { root.preferences-changed(theme, density, field); }
                font-options-changed(family, desktop, touch, field) => { root.font-options-changed(family, desktop, touch, field); }
                search-filter-changed(value) => { root.search-filter-changed(value); }
                sizes-format-changed(value) => { root.sizes-format-changed(value); }
                remember-command-history-changed(value) => { root.remember-command-history-changed(value); }
                command-history-clear => { root.command-history-clear(); }
                close => { options.close(); }
            }
        }
    }
    help := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: 0px; width: root.width; height: root.height;
        help-frame := DialogFrame {
            desired-width: max(620px, Theme.font-size * 24); desired-height: Theme.touch ? 600px : 490px;
            dismiss-on-outside: true;
            dismiss => { help.close(); }
            HelpBody {
                move-dialog(dx, dy) => { help-frame.move-by(dx, dy); } close-icon: root.action-icons.close; close => { help.close(); } }
        }
    }
    user-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - self.width) / 2; y: max(4px, root.height - self.height - 75px);
        width: min(root.width - 24px, max(340px, Theme.font-size * 18 + 24px));
        height: min(root.height - 8px, max(Theme.touch ? 280px : 220px, Theme.control-height * 5 + 90px));
        CommandMenuBody {
            dismissed => { user-menu.close(); }
            title: "User menu";
            item-count: 5;
            rows: [
                { native-icon: root.action-icons.terminal, fallback-icon: FallbackIcons.terminal, label: "Command line", hint: ShortcutHints.hint("Toggle command editor focus without running a command", "command.focus") },
                { native-icon: root.action-icons.bookmarks, fallback-icon: FallbackIcons.bookmarks, label: "Bookmarks and Hot Paths", hint: "Save, open or remove a favorite folder. Hot Paths provide ten numbered shortcuts." },
                { native-icon: root.action-icons.properties, fallback-icon: FallbackIcons.properties, label: "Properties" + (ShortcutHints.key("files.properties") == "" ? "" : " · " + ShortcutHints.key("files.properties")), hint: ShortcutHints.hint("Show Properties for selected items, or the focused file or folder", "files.properties") },
                { native-icon: root.action-icons.folder-sizes, fallback-icon: FallbackIcons.folder-sizes, label: "Calculate / cancel folder sizes", hint: ShortcutHints.hint("Measure selected folders, or all folders when nothing is selected; choose again to cancel", "panel.folder-sizes") },
                { native-icon: root.action-icons.close, fallback-icon: FallbackIcons.close, label: "Close", hint: "Close this dialog and return to the file manager." },
            ];
            selected(index) => {
                if index == 0 { user-menu.close(); root.focus-command(); }
                if index == 1 { user-menu.close(); if root.active-pane == 0 { left.open-bookmarks(); } else { right.open-bookmarks(); } }
                if index == 2 { user-menu.close(); root.properties(root.active-pane); }
                if index == 3 { user-menu.close(); root.folder-sizes(root.active-pane); }
                if index == 4 { user-menu.close(); }
            }
        }
    }
    main-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: root.width - self.width - 15px; y: max(4px, root.height - self.height - 75px);
        width: min(root.width - 24px, max(300px, Theme.font-size * 14 + 24px));
        height: min(root.height - 8px, max(Theme.touch ? 330px : 260px, Theme.control-height * 5 + 90px));
        CommandMenuBody {
            dismissed => { main-menu.close(); }
            title: "Menu";
            item-count: 5;
            rows: [
                { native-icon: root.action-icons.options, fallback-icon: FallbackIcons.options, label: "Options", hint: "Choose panel behavior, appearance, command history and keyboard shortcuts." },
                { native-icon: root.action-icons.refresh, fallback-icon: FallbackIcons.refresh, label: "Refresh active folder", hint: ShortcutHints.hint("Read the active folder again", "panel.refresh") },
                { native-icon: root.action-icons.help, fallback-icon: FallbackIcons.help, label: "Keyboard help" + (ShortcutHints.key("app.help") == "" ? "" : " · " + ShortcutHints.key("app.help")), hint: "Show current keyboard shortcuts and usage help." },
                { native-icon: root.action-icons.about, fallback-icon: FallbackIcons.about, label: "About Midnight Explorer", hint: "Show application and Slint version information." },
                { native-icon: root.action-icons.exit, fallback-icon: FallbackIcons.exit, label: "Exit", hint: ShortcutHints.hint("Close the file manager", "app.exit") },
            ];
            selected(index) => {
                if index == 0 { main-menu.close(); root.show-options(); }
                if index == 1 { main-menu.close(); root.action(root.active-pane, 3); }
                if index == 2 { main-menu.close(); help.show(); }
                if index == 3 { main-menu.close(); about.show(); }
                if index == 4 { main-menu.close(); root.exit(); }
            }
        }
    }
    message := PopupWindow {
        close-policy: no-auto-close;
        x: 0px; y: 0px; width: root.width; height: root.height;
        message-frame := DialogFrame {
            desired-width: max(600px, Theme.font-size * 45); desired-height: max(360px, Theme.font-size * 26);
            dismiss-on-outside: false;
            dismiss => { message.close(); }
            message-body := NoticeDialog {
                move-dialog(dx, dy) => { message-frame.move-by(dx, dy); }
                title: root.message-title; body: root.message-body; error: root.message-error;
                generation: root.message-generation;
                copy-details => { root.copy-message(); }
                close => { message.close(); }
            }
        }
    }
    about := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px; y: 0px; width: root.width; height: root.height;
        about-frame := DialogFrame {
            desired-width: 360px; desired-height: Theme.touch ? 320px : 270px;
            dismiss-on-outside: true;
            dismiss => { about.close(); }
            Rectangle {
                background: Theme.surface; border-radius: 8px; border-color: Theme.active-frame; border-width: 1px;
                init => { about-close.focus(); }
                FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape { about.close(); return accept; }
                    reject
                }
                VerticalLayout {
                    padding: 8px; spacing: 6px;
                    DialogHeader { title: "Midnight Explorer · File Manager"; text-size: 18px; compact: true; dragged(dx, dy) => { about-frame.move-by(dx, dy); } }
                    Text { text: "A focused, two-pane file browser."; color: Theme.secondary-text; }
                    ScrollView { min-height: 0px; vertical-stretch: 1; AboutSlint {} }
                    about-close := HintedActionButton { native-icon: root.action-icons.close; fallback-icon: FallbackIcons.close; text: "Close"; min-height: Theme.control-height; hint: "Close this dialog and return to the file manager."; clicked => { about.close(); } }
                }
                }
            }
        }
    }
}
