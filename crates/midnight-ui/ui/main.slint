            private property <length> right-width: self.usable - self.left-width;
            left := FilePane {
                minimal: root.compact-window;
                can-target-selection: root.left-can-target-selection;
                native-filesystem: root.left-native-filesystem;
                filter-label: root.left-filter-label;
                filter => { root.open-panel-filter(0); }
                visible: !root.single-panel || root.active-pane == 0;
                view-mode: root.left-view-mode; view-mode-label: "Left panel view mode"; sort-label: "Left panel sort";
                view-mode-selected(mode) => { root.left-view-mode = mode; root.view-mode(0, mode); }
                mutation(action) => { root.mutation(0, action); }
                x: root.panels-swapped ? panels.left-width + panels.gutter : 0px;
                width: root.panels-swapped ? panels.right-width : panels.left-width;
                y: 0px; height: parent.height; clip: true;
                action-icons: root.action-icons; choices: root.navigation-choices;
                choice-index: root.left-navigation-index; choice-revision: root.navigation-revision;
                navigation-choice(identity) => { root.navigation-choice(0, identity); }
                tabs: root.left-tabs; bookmarks: root.bookmarks; bookmark-name: root.left-bookmark-name;
                hot-path-choices: root.hot-path-choices;
                back-history: root.left-back-history; forward-history: root.left-forward-history;
                history-revision: root.history-revision; path-parts: root.left-path-parts; details: root.left-details; free-space: root.left-free-space;
                sizes-in-bytes: root.sizes-in-bytes;
                path-part(identity) => { root.path-part(0, identity); }
                path-copy(identity) => { root.path-copy(0, identity); }
                history-choice(forward, identity) => { root.history-choice(0, forward, identity); }
                detail-copy(identity) => { root.detail-copy(0, identity); }
                viewport-width: root.width; viewport-height: root.height;
                tab-new => { root.tab-new(0); } tab-select(id) => { root.tab-select(0, id); } tab-close(id) => { root.tab-close(0, id); }
                bookmark-add(name, slot) => { root.bookmark-add(0, name, slot); } bookmark-open(id) => { root.bookmark-open(0, id); }
                bookmark-remove(id) => { root.bookmark-remove(id); }
                bookmark-assign(id, slot) => { root.bookmark-assign(id, slot); }
                scroll-interaction-active: root.scroll-interaction-active;
                active: root.active-pane == 0; rows: root.left-rows; volumes: root.volumes; volume-index: root.left-volume;
                locations: root.left-locations;
                volume-short-labels: root.volume-short-labels;
                volume-icons: root.volume-icons;
                volume-tooltips: root.volume-tooltips;
                volumes-revision: root.volumes-revision;
                path: root.left-path; status: root.left-status; error: root.left-error; loading: root.left-loading;
                cursor-index: root.left-cursor; sort-column: root.left-sort; descending: root.left-descending;
                action(a) => { root.action(0, a); } navigate(p) => { root.navigate(0, p); } volume(v) => { root.volume(0, v); }
                sort(c) => { root.sort(0, c); } row-click(r, c, s) => { root.row-click(0, r, c, s); } open(r) => { root.open(0, r); }
                row-context-menu(r, x, y, c, s) => { root.row-context-menu(0, r, x, y, c, s); }
                touch-contact: root.touch-contact;
                drop-highlight: root.drag-hover-pane == 0; drag-label: root.drag-label;
                row-drag(r, identity, x, y) => { return root.row-drag(0, r, identity, x, y); }
                drag-moved(x, y) => { root.drag-moved(x, y); }
                drag-released(x, y) => { root.drag-released(x, y); }
                drag-cancelled => { root.drag-cancel(); }
                drive-context-menu(t, x, y, c, s) => { root.drive-context-menu(0, t, x, y, c, s); }
                key(k) => { root.key(0, k); } activate => { if root.active-pane != 0 { root.activate(0); } }
                bulk-selection(operation) => { root.bulk-selection(0, operation); }
                location(l) => { root.location(0, l); } properties => { root.properties(0); }
                attributes => { root.open-metadata(0, false); }
                search-query <=> root.left-search-query;
                search-context: root.left-search-context;
                search-pending: root.left-search-pending; search-count: root.left-search-count;
                search-edited(text) => { root.search-edited(0, text); }
                files-key(event, active, composing) => { return root.files-key(0, event, active, composing); }
                volume-key(event) => { return root.volume-key(event); }
                search-backspace(text, anchor, cursor) => { return root.search-backspace(text, anchor, cursor); }
                folder-sizes => { root.folder-sizes(0); } drive-letter(letter) => { return root.drive-letter(0, letter); }
                insert-path => { root.insert-path(0); } insert-name => { root.insert-name(); } drive-info => { root.drive-info(0); }
            }
            right := FilePane {
                minimal: root.compact-window;
                can-target-selection: root.right-can-target-selection;
                native-filesystem: root.right-native-filesystem;
                filter-label: root.right-filter-label;
                filter => { root.open-panel-filter(1); }
                visible: !root.single-panel || root.active-pane == 1;
                view-mode: root.right-view-mode; view-mode-label: "Right panel view mode"; sort-label: "Right panel sort";
                view-mode-selected(mode) => { root.right-view-mode = mode; root.view-mode(1, mode); }
                mutation(action) => { root.mutation(1, action); }
                x: root.panels-swapped ? 0px : panels.left-width + panels.gutter;
                width: root.panels-swapped ? panels.left-width : panels.right-width;
                y: 0px; height: parent.height; clip: true;
                action-icons: root.action-icons; choices: root.navigation-choices;
                choice-index: root.right-navigation-index; choice-revision: root.navigation-revision;
                navigation-choice(identity) => { root.navigation-choice(1, identity); }
                tabs: root.right-tabs; bookmarks: root.bookmarks; bookmark-name: root.right-bookmark-name;
                hot-path-choices: root.hot-path-choices;
                back-history: root.right-back-history; forward-history: root.right-forward-history;
                history-revision: root.history-revision; path-parts: root.right-path-parts; details: root.right-details; free-space: root.right-free-space;
                sizes-in-bytes: root.sizes-in-bytes;
                path-part(identity) => { root.path-part(1, identity); }
                path-copy(identity) => { root.path-copy(1, identity); }
                history-choice(forward, identity) => { root.history-choice(1, forward, identity); }
                detail-copy(identity) => { root.detail-copy(1, identity); }
                viewport-width: root.width; viewport-height: root.height;
                tab-new => { root.tab-new(1); } tab-select(id) => { root.tab-select(1, id); } tab-close(id) => { root.tab-close(1, id); }
                bookmark-add(name, slot) => { root.bookmark-add(1, name, slot); } bookmark-open(id) => { root.bookmark-open(1, id); }
                bookmark-remove(id) => { root.bookmark-remove(id); }
                bookmark-assign(id, slot) => { root.bookmark-assign(id, slot); }
                scroll-interaction-active: root.scroll-interaction-active;
                active: root.active-pane == 1; rows: root.right-rows; volumes: root.volumes; volume-index: root.right-volume;
                locations: root.right-locations;
                volume-short-labels: root.volume-short-labels;
                volume-icons: root.volume-icons;
                volume-tooltips: root.volume-tooltips;
                volumes-revision: root.volumes-revision;
                path: root.right-path; status: root.right-status; error: root.right-error; loading: root.right-loading;
                cursor-index: root.right-cursor; sort-column: root.right-sort; descending: root.right-descending;
                action(a) => { root.action(1, a); } navigate(p) => { root.navigate(1, p); } volume(v) => { root.volume(1, v); }
                sort(c) => { root.sort(1, c); } row-click(r, c, s) => { root.row-click(1, r, c, s); } open(r) => { root.open(1, r); }
                row-context-menu(r, x, y, c, s) => { root.row-context-menu(1, r, x, y, c, s); }
                touch-contact: root.touch-contact;
                drop-highlight: root.drag-hover-pane == 1; drag-label: root.drag-label;
                row-drag(r, identity, x, y) => { return root.row-drag(1, r, identity, x, y); }
                drag-moved(x, y) => { root.drag-moved(x, y); }
                drag-released(x, y) => { root.drag-released(x, y); }
                drag-cancelled => { root.drag-cancel(); }
                drive-context-menu(t, x, y, c, s) => { root.drive-context-menu(1, t, x, y, c, s); }
                key(k) => { root.key(1, k); } activate => { if root.active-pane != 1 { root.activate(1); } }
                bulk-selection(operation) => { root.bulk-selection(1, operation); }
                location(l) => { root.location(1, l); } properties => { root.properties(1); }
                attributes => { root.open-metadata(1, false); }
                search-query <=> root.right-search-query;
                search-context: root.right-search-context;
                search-pending: root.right-search-pending; search-count: root.right-search-count;
                search-edited(text) => { root.search-edited(1, text); }
                files-key(event, active, composing) => { return root.files-key(1, event, active, composing); }
                volume-key(event) => { return root.volume-key(event); }
                search-backspace(text, anchor, cursor) => { return root.search-backspace(text, anchor, cursor); }
                folder-sizes => { root.folder-sizes(1); } drive-letter(letter) => { return root.drive-letter(1, letter); }
                insert-path => { root.insert-path(1); } insert-name => { root.insert-name(); } drive-info => { root.drive-info(1); }
            }
            PanelSplitter {
                visible: !root.compact-window;
                x: panels.left-width; y: 0px; height: parent.height;
                fraction <=> root.panel-ratio;
                available-width: panels.usable; minimum-pane-width: panels.minimum-pane;
                centered => { root.panel-zoomed = false; }
                resized => { root.panel-zoomed = false; }
            }
            if root.single-panel : Rectangle {
                x: panels.active-on-left ? panels.left-width + panels.gutter : 0px;
                width: panels.rail-width; height: parent.height;
                background: rail-touch.has-hover ? Theme.hover : Theme.secondary-surface;
                border-width: 1px; border-color: rail-focus.has-focus ? Theme.active-frame : Theme.frame;
                border-radius: 3px; forward-focus: rail-focus;
                accessible-role: button;
                accessible-label: root.active-pane == 0 ? "Activate right panel" : "Activate left panel";
                accessible-action-default => { root.activate(1 - root.active-pane); root.focus-files(); }
                Text {
                    text: panels.active-on-left ? "‹" : "›"; color: Theme.text;
                    font-size: Theme.font-size; horizontal-alignment: center; vertical-alignment: center;
                }
                rail-focus := FocusScope {
                    key-pressed(event) => {
                        if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift
                            && !event.modifiers.meta && (event.text == Key.Return || event.text == Key.Space) {
                            root.activate(1 - root.active-pane); root.focus-files(); return accept;
                        }
                        reject
                    }
                    rail-touch := TouchArea { clicked => { root.activate(1 - root.active-pane); root.focus-files(); } }
                }
                Tooltip { TipBody { text: "Activate other panel\n" + (root.active-pane == 0 ? root.right-path : root.left-path); } }
            }
        }
        command-bar := Rectangle {
            height: root.compact-window ? min(32px, Theme.command-height) : Theme.command-height;
            background: Theme.secondary-surface; border-radius: 4px;
            border-width: 1px; border-color: command-input.has-focus ? Theme.active-frame : Theme.frame;
            HorizontalLayout {
                padding-top: 0px; padding-bottom: 0px;
                padding-left: Theme.touch ? 6px : 4px; padding-right: Theme.touch ? 6px : 4px;
                spacing: Theme.touch ? 6px : 5px;
                cross-axis-alignment: center;
                terminal-picker := TerminalControl {
                    height: command-bar.height;
                    model: root.terminal-choices; current-index: root.terminal-index;
                    windows-shells: root.windows-shells;
                    available: root.terminal-available; ready: root.terminal-ready;
                    action-icons: root.action-icons;
                    working-directory: root.command-directory; hint: root.command-hint;
                    selected(index) => { root.terminal-changed(index); root.focus-command(); }
                    launch => { root.open-terminal(); root.focus-command(); }
                    dismissed => { root.focus-command(); }
                }
                command-content := Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    height: command-bar.height;
                    private property <length> gap: Theme.touch ? 6px : 5px;
                    // Keep typing useful with wide native fonts; long cwd text
                    // remains complete inside its horizontally pannable viewport.
                    private property <length> editor-reserve: min(360px,
                        max(max(0px, self.width) * 0.5, min(320px, self.width - 120px)));
                    private property <length> prompt-width: root.command-directory == "" ? 0px
                        : min(root.command-path-natural-width, max(0px, self.width - self.editor-reserve - self.gap));
                    cwd-scroll := ScrollView {
                        x: 0px; y: 0px;
                        width: command-content.prompt-width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        mouse-drag-pan-enabled: true;
                        content-width: max(self.visible-width, root.command-path-natural-width);
                        content-height: self.visible-height;
                        Rectangle {
                            width: cwd-scroll.content-width; height: cwd-scroll.visible-height;
                            full-cwd := Text {
                                x: 4px; width: self.preferred-width; height: parent.height;
                                text: root.command-prompt; wrap: no-wrap; overflow: clip;
                                color: Theme.secondary-text; font-size: Theme.small-font;
                                vertical-alignment: center;
                                accessible-label: "Working folder: " + root.command-directory;
                            }
                            TouchArea {
                                scroll-event(event) => {
                                    let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                                    if cwd-scroll.content-width > cwd-scroll.visible-width && delta != 0px {
                                        cwd-scroll.content-x = clamp(cwd-scroll.content-x + delta,
                                            min(0px, cwd-scroll.visible-width - cwd-scroll.content-width), 0px);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            Tooltip { TipBody { text: "Working folder: " + root.command-directory + "\nScroll or drag horizontally to view a long path."; } }
                        }
                    }
                    command-slot := Rectangle {
                        x: cwd-scroll.width > 0px ? cwd-scroll.width + command-content.gap : 0px;
                        width: max(0px, parent.width - self.x); height: parent.height; clip: true;
                        command-input := TextInput {
                            font-size: root.compact-window ? min(28px, Theme.font-size) : Theme.font-size;
                            private property <length> horizontal-offset;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.horizontal-offset));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: parent.height;
                            color: Theme.text; selection-background-color: Theme.selection-background;
                            selection-foreground-color: Theme.selection-text;
                            vertical-alignment: center; single-line: true;
                            accessible-label: "Command line";
                            cursor-position-changed(position) => {
                                if position.x + self.horizontal-offset < 0px { self.horizontal-offset = -position.x; }
                                else if position.x + self.horizontal-offset > parent.width - self.text-cursor-width {
                                    self.horizontal-offset = parent.width - position.x - self.text-cursor-width;
                                }
                            }
                            edited => { root.command-history-reset(); root.command-edited(self.text != ""); }
                        }
                        Tooltip { TipBody { text: root.command-hint + "\nWorking folder: " + root.command-directory
                            + "\n" + ShortcutHints.hint("Run command", "command.execute")
                            + "\n" + ShortcutHints.hint("Return to files", "command.focus-files")
                            + "\n" + ShortcutHints.hint("Append focused filename", "command.insert-name")
                            + "\n" + ShortcutHints.hint("Insert active panel path", "command.insert-path")
                            + "\n" + ShortcutHints.hint("Insert left panel path", "command.insert-left-path")
                            + "\n" + ShortcutHints.hint("Insert right panel path", "command.insert-right-path"); } }
                    }
                }
                command-history-picker := CompactPicker {
                    width: Theme.touch ? 46px : 34px; minimum-control-width: 0px;
                    height: command-bar.height;
                    choices: root.command-history; model-revision: root.command-history-revision;
                    popup-above: true; popup-width: 620px; popup-align-right: true;
                    show-row-icons: false;
                    enabled: root.command-history.length > 0;
                    accessible-name: "Executed command history";
                    hint: "Executed command history\nPick a command to fill the editor without running it.";
                    selected-key(identity) => { root.command-history-choice(identity); root.focus-command(); }
                    dismissed => { root.focus-command(); }
                }
                FunctionButton {
                    height: command-bar.height; horizontal-stretch: 0;
                    native-icon: root.action-icons.run; fallback-icon: FallbackIcons.run;
                    text: root.compact-window ? "" : "Run";
                    compact-text: root.compact-window ? "" : "Run"; accessible-label: "Run";
                    enabled: root.terminal-ready && root.command-text != "";
                    hint: !root.terminal-available ? "A system terminal is unavailable."
                        : !root.terminal-ready ? "Waiting for the terminal to become ready."
                        : root.command-text == "" ? "Enter a command to run in the active panel’s folder."
                        : "Run with " + root.terminal-choices[root.terminal-index]
                            + "\nWorking folder: " + root.command-directory;
                    clicked => {
                        if root.submit-command(root.command-text) {
                            root.command-text = ""; root.command-edited(false);
                        }
                        root.focus-command();
                    }
                }
            }
        }
        function-bar := FunctionBar {
            compact: root.compact-window;
            can-target-cursor: root.active-pane == 0 ? root.left-can-target-cursor : root.right-can-target-cursor;
            can-target-selection: root.active-pane == 0 ? root.left-can-target-selection : root.right-can-target-selection;
            native-filesystem: root.active-pane == 0 ? root.left-native-filesystem : root.right-native-filesystem;
            icons: root.action-icons; pane: root.active-pane;
            control-layer: root.control-layer; network-available: root.network-available;
            searching: root.active-pane == 0 ? root.left-search-active : root.right-search-active;
            action(action, pane) => { root.function-action(action, pane); }
            options => { root.show-options(); }
            jobs => { root.show-operations(); }
        }
        if !root.compact-window && root.desktop-feedback-important && root.desktop-status != "" : Text {
            text: root.desktop-status;
            color: Theme.secondary-text; font-size: Theme.hint-font;
            height: Theme.hint-font * 1.5; overflow: elide;
            accessible-label: root.desktop-status;
            Tooltip { TipBody { text: root.desktop-status; } }
