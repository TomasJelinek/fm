import { ShortcutHints } from "shortcut-hints.slint";
import { PathEditor } from "path-editor.slint";
import { Theme } from "theme.slint";
import { Tip } from "controls.slint";
import { PathPartRow } from "navigation-models.slint";
import { PathToken } from "path-token.slint";
import { OmissionText } from "path-text.slint";
import { PathCollapse } from "path-collapse.slint";

// Stands for omitted components; it edits the complete path. Its tooltip names what it
// stands for.
component PathOmission inherits Rectangle {
    in property <string> names;
    in property <length> text-size;
    in property <bool> highlighted;
    callback activated();
    // Lit by a hovered later component (whose prefix it is part of) or by its own hover.
    private property <bool> lit: root.highlighted || area.has-hover;
    background: root.lit ? Theme.hover : transparent;
    border-radius: 2px;
    accessible-role: button; accessible-label: "Edit full folder path";
    accessible-action-default => { root.activated(); }
    OmissionText {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        color: root.lit ? Theme.accent : Theme.text; font-size: root.text-size;
        horizontal-alignment: center; vertical-alignment: center;
    }
    area := TouchArea { clicked => { root.activated(); } }
    Tip { text: root.names; }
}

// Ends the open path editor: a click, or Enter or Space with keyboard focus, does
// what Enter in the editor does.
component PathGoButton inherits Rectangle {
    in property <length> text-size;
    callback clicked();
    width: max(32px, caption.preferred-width + 16px);
    border-radius: 3px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.active-frame : Theme.frame;
    background: area.pressed ? Theme.selection-background : area.has-hover ? Theme.hover : Theme.secondary-surface;
    accessible-role: button; accessible-label: "Go";
    accessible-description: "Open the path: a folder, or a file's folder with the cursor on the file";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    caption := Text {
        text: "Go"; font-size: root.text-size;
        color: area.pressed ? Theme.selection-text : Theme.text;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift
                && !event.modifiers.meta && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked(); return accept;
            }
            reject
        }
        area := TouchArea { clicked => { root.clicked(); } }
    }
    Tip { text: "Go (Enter): open the folder, or the file's folder with the cursor on the file. Escape cancels."; }
}

// Paths are parsed by the backend. Each token contains a whole component,
// preserving its Unicode shaping; the UI never reconstructs an operation path.
export component PathNavigation inherits Rectangle {
    in property <int> pane-id;
    in property <length> text-size: Theme.font-size;
    in property <string> path;
    in property <[PathPartRow]> parts;
    // The component that a shortened path keeps whole besides the last one: in an
    // archive, the archive's own name (-1: none).
    in property <int> anchor: -1;
    in property <string> hint;
    in-out property <string> text <=> editor.text;
    out property <bool> has-focus: editor.has-focus;
    out property <string> highlighted-prefix: root.hovered-index >= 0 && root.hovered-index < root.parts.length
        ? root.parts[root.hovered-index].prefix : "";
    private property <bool> edit-mode;
    private property <int> hovered-index: -1;
    private property <int> revision;
    // A path that does not fit shows whole components only, as `PathCollapse` decides;
    // at least 32px stay free for opening the editor. The last component, when even it
    // alone is too wide, is shortened at its end.
    private property <int> count: collapse.count;
    private property <length> room: collapse.room;
    private property <length> omission-width: collapse.omission-width;
    private property <length> full-width: collapse.full-width;
    private property <bool> collapsed: collapse.collapsed;
    // The editor holds the whole path that the parts join into (a native or archive
    // path), or only the location's own caption (Network, whose parts are the captions
    // of its ancestors). A marker's tooltip names what it stands for: the whole path,
    // which it edits, or else the chain through the last part it omits.
    private property <bool> editor-holds-path: root.count == 0
        || root.path == root.parts[root.count - 1].prefix;
    private property <length> suffix-room: collapse.suffix-room;
    callback navigate(string);
    callback selected-part(string);
    callback copy-part(string);
    callback cancelled();
    callback editing-started();
    border-width: 1px; border-radius: 3px;
    border-color: root.has-focus ? Theme.active-frame : Theme.frame;
    background: Theme.surface;
    changed path => {
        editor.invalidate-paste();
        editor.text = root.path; root.hovered-index = -1;
    }
    changed parts => {
        root.revision += 1; root.hovered-index = -1;
    }
    init => { editor.text = root.path; }
    public function focus-editor() {
        editor.invalidate-paste();
        root.editing-started();
        root.edit-mode = true; editor.text = root.path; editor.focus();
    }
    public function finish-edit() {
        editor.invalidate-paste();
        root.edit-mode = false; editor.text = root.path;
    }
    collapse := PathCollapse {
        parts: root.parts; anchor: root.anchor; text-size: root.text-size;
        trail-width: trail.width; reserve: 32px;
    }
    trail := Rectangle {
        visible: !root.edit-mode;
        x: 3px; y: 1px; width: parent.width - 6px; height: parent.height - 2px;
        clip: true;
        HorizontalLayout {
            spacing: 0px; alignment: start;
            if root.parts.length == 0 : Text {
                text: root.path; color: Theme.text; font-size: root.text-size;
                vertical-alignment: center; overflow: elide;
                min-width: 0px; horizontal-stretch: 1;
            }
            for part[index] in root.parts : Rectangle {
                // This component and every later one, as shown.
                private property <length> suffix-width: index == 0 ? root.full-width
                    : root.full-width - parent-metrics.preferred-width;
                private property <bool> shown: collapse.shown(index, self.suffix-width);
                // An omitted component that a shown one follows ends a run of omitted
                // components (at the start of the trail, after the leading ones, or after
                // the anchor), and its place holds the marker that stands for the run.
                // The next component's suffix is measured from this one's prefix.
                private property <bool> ends-omission: collapse.ends-omission(index, self.shown,
                    own-metrics.preferred-width);
                visible: self.shown || self.ends-omission;
                width: self.shown ? token.width : self.ends-omission ? root.omission-width : 0px;
                height: trail.height;
                parent-metrics := Text {
                    visible: false; font-size: root.text-size;
                    text: root.collapsed && index > 0 ? root.parts[index - 1].prefix : "";
                }
                // Only an omitted component measures its own prefix.
                own-metrics := Text {
                    visible: false; font-size: root.text-size;
                    text: root.collapsed && !parent.shown ? part.prefix : "";
                }
                token := PathToken {
                    visible: parent.shown;
                    x: 0px; y: 0px; height: parent.height;
                    width: index == root.count - 1
                        ? min(self.natural-width, max(0px, root.collapsed ? root.suffix-room : root.room))
                        : self.natural-width;
                    part: part; revision: root.revision; text-size: root.text-size;
                    highlighted: root.hovered-index >= index;
                    selected(identity) => { root.selected-part(identity); }
                    copied(identity) => { root.copy-part(identity); }
                    hovered(over) => {
                        if over { root.hovered-index = index; }
                        else if root.hovered-index == index { root.hovered-index = -1; }
                    }
                }
                if self.ends-omission : PathOmission {
                    x: 0px; y: 0px; width: root.omission-width; height: parent.height;
                    names: root.editor-holds-path ? root.path : part.prefix;
                    text-size: root.text-size;
                    // A hovered later component's prefix includes the omitted ones.
                    highlighted: root.hovered-index > index;
                    activated => { root.focus-editor(); }
                }
            }
            // Keeps at least 32px free after the components; the edit area starts here.
            edit-slot := Rectangle { min-width: 32px; horizontal-stretch: 1; height: trail.height; }
        }
        // Everything right of the components, to the bar's end, opens the editor. The
        // layout gives its last item only its preferred width, so the area is placed
        // from that item's start rather than inside the layout.
        Rectangle {
            x: edit-slot.x; y: 0px; width: max(0px, trail.width - self.x); height: trail.height;
            background: edit-area.has-hover ? Theme.hover : transparent;
            border-radius: 2px;
            accessible-role: button; accessible-label: "Edit folder path";
            accessible-action-default => { root.focus-editor(); }
            edit-area := TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.focus-editor(); } }
            Tip { text: ShortcutHints.hint("Enter a folder or file path", "panel.path") + ". Enter or Go opens the folder, or the file's folder with the cursor on the file; Escape cancels."; }
        }
    }
    FocusScope {
        visible: root.edit-mode;
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        forward-focus: editor;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.finish-edit(); root.cancelled(); return accept; }
            reject
        }
        editor := PathEditor {
            pane-id: root.pane-id;
            font-size: root.text-size;
            x: 0px; y: 0px; width: max(1px, parent.width - go.width - 2px); height: parent.height;
            hint: root.hint;
            accepted => { root.navigate(self.text); }
        }
        // Follows the editor in the focus chain: Tab reaches it.
        go := PathGoButton {
            x: parent.width - self.width - 1px; y: 1px; height: max(0px, parent.height - 2px);
            text-size: root.text-size;
            clicked => { root.navigate(editor.text); }
        }
    }
}
