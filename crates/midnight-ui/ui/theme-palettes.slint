        }
        // Gruvbox Dark
        if index == 5 {
            return {
                light: false,
                window-background: #1d2021,
                pane-background: #282828,
                alternate-row: #2d2b29,
                surface: #3a3632,
                secondary-surface: #242424,
                header: #3c3836,
                active-header: #50402f,
                frame: #a3917f,
                active-frame: #fabd2f,
                hover: #4b4137,
                text: #ebdbb2,
                strong-text: #fbf1c7,
                secondary-text: #e0cfad,
                muted-text: #bdae93,
                pending-size: #fabd2f,
                accent: #fabd2f,
                directory-text: #b8dba0,
                selected-text: #fbf1c7,
                search-match: #8fd6bd,
                compression-mark: #bbd7db,
                cursor-background: #55482e,
                inactive-cursor: #3c3836,
                selected-background: #435038,
                selected-edge: #b8bb26,
                cursor-edge: #fabd2f,
                error-background: #4a2927,
                error-text: #ffafa0,
                selection-background: #504945,
                selection-text: #fbf1c7,
            };
        }
        // Catppuccin Mocha
        if index == 6 {
            return {
                light: false,
                window-background: #11111b,
                pane-background: #1e1e2e,
                alternate-row: #232335,
                surface: #2a2a40,
                secondary-surface: #181825,
                header: #37374d,
                active-header: #46355e,
                frame: #858ba4,
                active-frame: #cba6f7,
                hover: #403c56,
                text: #cdd6f4,
                strong-text: #f5e0dc,
                secondary-text: #c5cfe9,
                muted-text: #a6adc8,
                pending-size: #f9e2af,
                accent: #cba6f7,
                directory-text: #b7d7fa,
                selected-text: #f9e2af,
                search-match: #94e2d5,
                compression-mark: #b4befe,
                cursor-background: #493b62,
                inactive-cursor: #3c3e55,
                selected-background: #414767,
                selected-edge: #f2cdcd,
                cursor-edge: #cba6f7,
                error-background: #432737,
                error-text: #f6a3bd,
                selection-background: #524264,
                selection-text: #f5e0dc,
            };
        }
        // Solarized Light
        if index == 7 {
            return {
                light: true,
                window-background: #eee8d5,
                pane-background: #fdf6e3,
                alternate-row: #f5eedb,
                surface: #e4dcc5,
                secondary-surface: #f3ecd9,
                header: #dad3bd,
                active-header: #c3d9ce,
                frame: #777c6c,
                active-frame: #286f73,
                hover: #dce3d7,
                text: #073642,
                strong-text: #002b36,
                secondary-text: #294b53,
                muted-text: #586e75,
                pending-size: #694a00,
                accent: #00585e,
                directory-text: #124f5a,
                selected-text: #073642,
                search-match: #773553,
                compression-mark: #1f5379,
                cursor-background: #b9d2c5,
                inactive-cursor: #e2e3d3,
                selected-background: #ccd9ba,
                selected-edge: #476f18,
                cursor-edge: #006d74,
                error-background: #f7ded5,
