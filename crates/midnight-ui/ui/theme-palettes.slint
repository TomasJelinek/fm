// Adapted semantic palettes; references and contrast rules are in the theme design.
export struct ThemeColors {
    light: bool,
    window-background: color,
    pane-background: color,
    alternate-row: color,
    surface: color,
    secondary-surface: color,
    header: color,
    active-header: color,
    frame: color,
    active-frame: color,
    hover: color,
    text: color,
    strong-text: color,
    secondary-text: color,
    muted-text: color,
    pending-size: color,
    accent: color,
    directory-text: color,
    selected-text: color,
    search-match: color,
    compression-mark: color,
    cursor-background: color,
    inactive-cursor: color,
    selected-background: color,
    selected-edge: color,
    cursor-edge: color,
    error-background: color,
    error-text: color,
    // Selected text: a calm fill and the colour that all selected text takes on it.
    // The inactive pair is a dimmer fill shown while its window is inactive. Contrast
    // and visibility rules: docs/theme-provenance.md#text-selection.
    selection-background: color,
    selection-text: color,
    inactive-selection-background: color,
    inactive-selection-text: color,
}

export global ThemePalettes {
    // Display order is independent from the stable persisted palette IDs.
    out property <[string]> dark-names: [
        "Afterimage", "Amber Terminal", "Banker’s Lamp", "Bindery", "Blue", "Carbon Black",
        "Carbon Green", "Catppuccin Mocha", "Chronometer", "Dark", "Deep Ocean", "Dracula",
        "Drawing Office", "Graphite Contrast", "Gruvbox Dark", "High Contrast Dark",
        "Mastering Room", "Nord", "Norton Commander", "One Dark", "Pencil Lead", "Pewter",
        "Plum Smoke", "Red Lacquer", "Rosé Pine", "Slate Blue", "Slate Teal", "Slate Violet",
        "Tokyo Night", "Warm Ash"
    ];
    out property <[int]> dark-ids: [
        29, 13, 36, 37, 0, 42, 8, 6, 38, 1, 19, 3, 31, 20, 5, 21, 34, 4, 12, 10, 41, 44, 45, 26, 11,
        23, 24, 25, 9, 43
    ];
    out property <[string]> light-names: [
        "Canary Copy", "Catppuccin Latte", "Faience", "Field Survey", "High Contrast Light", "Iris",
        "Last Train", "Letterhead", "Light", "Overprint", "Paper Contrast", "Rosé Pine Dawn",
        "Sandstone Contrast", "Solarized Light", "Titanium", "Verdant Light"
    ];
    out property <[int]> light-ids: [
        40, 15, 28, 33, 22, 39, 30, 32, 2, 27, 17, 16, 18, 7, 35, 14
