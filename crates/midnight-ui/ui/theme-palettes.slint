    // Stable palette ID to its position in the corresponding appearance picker.
    out property <[int]> positions: [
        4, 9, 8, 11, 17, 14, 7, 13, 6, 28, 19, 24, 18, 1, 15, 1, 11, 10, 12, 10, 13, 15, 4, 25, 26,
        27, 23, 9, 2, 0, 6, 12, 7, 3, 16, 14, 2, 3, 8, 5, 0, 20, 5, 29, 21, 22
    ];
