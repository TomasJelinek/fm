// Adapted semantic palettes; references and contrast rules are in the theme design.
export struct ThemeColors {
    light: bool,
    window-background: color,
    pane-background: color,
    alternate-row: color,
    surface: color,
    secondary-surface: color,
    header: color,
    active-header: color,
    frame: color,
    active-frame: color,
    hover: color,
    text: color,
    strong-text: color,
    secondary-text: color,
    muted-text: color,
    pending-size: color,
    accent: color,
    directory-text: color,
    selected-text: color,
    search-match: color,
    compression-mark: color,
    cursor-background: color,
    inactive-cursor: color,
    selected-background: color,
    selected-edge: color,
    cursor-edge: color,
    error-background: color,
    error-text: color,
    selection-background: color,
    selection-text: color,
}

export global ThemePalettes {
    out property <[string]> names: [
        "Blue", "Dark", "Light", "Dracula", "Nord", "Gruvbox Dark",
        "Catppuccin Mocha", "Solarized Light"
    ];
    pure public function colors(index: int) -> ThemeColors {
        // Dark
        if index == 1 {
            return {
                light: false,
                window-background: #171717,
                pane-background: #202020,
                alternate-row: #252525,
                surface: #323232,
                secondary-surface: #242424,
                header: #383838,
                active-header: #424242,
                frame: #7c7c7c,
                active-frame: #929292,
                hover: #454545,
                text: #dedede,
                strong-text: #f0f0f0,
                secondary-text: #c7c7c7,
                muted-text: #a3a3a3,
                pending-size: #ffd27f,
                accent: #d4d4d4,
                directory-text: #e0e0e0,
                selected-text: #ffffff,
                search-match: #7cebdc,
                compression-mark: #a8ceff,
                cursor-background: #525252,
                inactive-cursor: #383838,
                selected-background: #4b4b4b,
                selected-edge: #b8b8b8,
                cursor-edge: #bdbdbd,
                error-background: #402d2d,
                error-text: #ffc3c3,
                selection-background: #555555,
                selection-text: #ffffff,
            };
        }
        // Light
        if index == 2 {
            return {
                light: true,
                window-background: #eeeeee,
                pane-background: #ffffff,
                alternate-row: #f6f6f6,
                surface: #dfdfdf,
                secondary-surface: #f1f1f1,
                header: #d9d9d9,
                active-header: #cccccc,
                frame: #797979,
                active-frame: #696969,
                hover: #d4d4d4,
                text: #303030,
                strong-text: #202020,
                secondary-text: #404040,
                muted-text: #666666,
                pending-size: #684000,
                accent: #454545,
                directory-text: #353535,
                selected-text: #202020,
                search-match: #8c196f,
                compression-mark: #174e8a,
                cursor-background: #bfbfbf,
                inactive-cursor: #e1e1e1,
                selected-background: #c8c8c8,
                selected-edge: #626262,
                cursor-edge: #555555,
                error-background: #ffebee,
                error-text: #842434,
                selection-background: #cccccc,
                selection-text: #202020,
