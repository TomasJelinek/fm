                pane-background: #282e39,
                alternate-row: #323a48,
                surface: #3b4555,
                secondary-surface: #2b3240,
                header: #3b4252,
                active-header: #354b5f,
                frame: #8596aa,
                active-frame: #88c0d0,
                hover: #414d60,
                text: #e5e9f0,
                strong-text: #eceff4,
                secondary-text: #d8deea,
                muted-text: #b1bfd0,
                pending-size: #ebcb8b,
                accent: #8fcedc,
                directory-text: #c5e3ee,
                selected-text: #fff1bf,
                search-match: #a3e4d7,
                compression-mark: #c3dbff,
                cursor-background: #3d536a,
                inactive-cursor: #3c4352,
                selected-background: #3d5660,
                selected-edge: #ebcb8b,
                cursor-edge: #88c0d0,
                error-background: #492f3a,
                error-text: #f6b2bc,
                selection-background: #465a70,
                selection-text: #eceff4,
