                strong-text: #ffffff,
                secondary-text: #d9edf3,
                muted-text: #c8e3ea,
                pending-size: #ffe7af,
                accent: #a5edf4,
                directory-text: #b3edf6,
                selected-text: #fff1b8,
                search-match: #f2d5ff,
                compression-mark: #d6e8ff,
                cursor-background: #1b3c4c,
                inactive-cursor: #132e3c,
                selected-background: #352b19,
                selected-edge: #ffe19c,
                cursor-edge: #86e7f0,
                error-background: #3c1822,
                error-text: #ffdbe1,
                selection-background: #a5edf4,
                selection-text: #091923,
            };
        }
        // Graphite Contrast: original palette; contrast targets in docs/THEME_PROVENANCE.md.
        if index == 20 {
            return {
                light: false,
                window-background: #151316,
                pane-background: #1b181b,
                alternate-row: #221f22,
                surface: #272327,
                secondary-surface: #1d1a1d,
                header: #302930,
                active-header: #382d34,
                frame: #a798a4,
                active-frame: #ffccad,
                hover: #3b3038,
                text: #f8f3f6,
                strong-text: #ffffff,
                secondary-text: #e8dce4,
                muted-text: #ddcbd7,
                pending-size: #ffe6ad,
                accent: #ffdbc4,
                directory-text: #d2e9ff,
                selected-text: #fff0be,
                search-match: #ccf2e3,
                compression-mark: #e9dcff,
                cursor-background: #40313a,
                inactive-cursor: #302730,
                selected-background: #1b2c40,
                selected-edge: #ffdc9a,
                cursor-edge: #ffccad,
                error-background: #401e26,
                error-text: #ffdae1,
                selection-background: #ffdbc4,
                selection-text: #20191e,
            };
        }
        // High Contrast Dark: original palette; contrast targets in docs/THEME_PROVENANCE.md.
        if index == 21 {
            return {
                light: false,
                window-background: #000000,
                pane-background: #000000,
                alternate-row: #080808,
                surface: #080808,
                secondary-surface: #000000,
                header: #101010,
                active-header: #181818,
                frame: #ffffff,
                active-frame: #ffffff,
                hover: #202020,
                text: #ffffff,
                strong-text: #ffffff,
                secondary-text: #ffffff,
                muted-text: #eeeeee,
                pending-size: #ffffbb,
                accent: #bfffff,
                directory-text: #bfffff,
                selected-text: #ffffbb,
                search-match: #ffffff,
                compression-mark: #ffffff,
                cursor-background: #202020,
                inactive-cursor: #151515,
                selected-background: #181818,
                selected-edge: #ffffbb,
                cursor-edge: #ffffff,
                error-background: #180000,
                error-text: #ffffff,
                selection-background: #ffffff,
                selection-text: #000000,
            };
        }
        // High Contrast Light: original palette; contrast targets in docs/THEME_PROVENANCE.md.
        if index == 22 {
            return {
                light: true,
                window-background: #ffffff,
                pane-background: #ffffff,
                alternate-row: #fafafa,
                surface: #ffffff,
                secondary-surface: #ffffff,
                header: #f5f5f5,
                active-header: #eeeeee,
                frame: #000000,
                active-frame: #000000,
                hover: #e8e8e8,
                text: #000000,
                strong-text: #000000,
                secondary-text: #000000,
                muted-text: #181818,
                pending-size: #201000,
                accent: #001820,
                directory-text: #001820,
                selected-text: #000000,
                search-match: #180018,
                compression-mark: #000000,
                cursor-background: #e8e8e8,
                inactive-cursor: #f2f2f2,
                selected-background: #eeeeee,
                selected-edge: #000000,
                cursor-edge: #000000,
                error-background: #fff5f5,
                error-text: #200000,
                selection-background: #000000,
                selection-text: #ffffff,
            };
        }
        // Slate variants share charcoal surfaces and warm selection; focus carries the variant hue.
        if index >= 23 && index <= 25 {
            let accent = index == 24 ? #67d7c4 : index == 25 ? #c5a3f1 : #72b8eb;
            let active-header = index == 24 ? #243a35 : index == 25 ? #342e40 : #263844;
            let cursor = index == 24 ? #29443f : index == 25 ? #3b354b : #2c4050;
            let selected = #453a2a;
            return {
                light: false,
                window-background: #16191e,
                pane-background: #1f2228,
                alternate-row: #242830,
                surface: #282d35,
                secondary-surface: #1b1e24,
                header: #16191e,
                active-header: active-header,
                frame: #858f9e,
                active-frame: accent,
                hover: #343b45,
                text: #edf1f5,
                strong-text: #ffffff,
                secondary-text: #cdd6e0,
                muted-text: #b5c0ce,
                pending-size: #ffe0a3,
                accent: accent,
                directory-text: #d6e6f4,
                selected-text: #ffffff,
                search-match: #9ee6d2,
                compression-mark: #cad8ff,
                cursor-background: cursor,
                inactive-cursor: #30353e,
                selected-background: selected,
                selected-edge: #e9c17b,
                cursor-edge: accent,
                error-background: #432b32,
                error-text: #ffd4dc,
                selection-background: accent,
                selection-text: #16191e,
            };
        }
        // Blue
        return {
            light: false,
            window-background: #0e141e,
            pane-background: #151c26,
            alternate-row: #19212d,
            surface: #283546,
            secondary-surface: #1a2330,
            header: #2d3c4f,
            active-header: #2b4564,
            frame: #6b7e99,
            active-frame: #8fbcff,
            hover: #33445a,
            text: #dce5f2,
            strong-text: #eef4ff,
            secondary-text: #c2d1e5,
            muted-text: #a3b3ca,
            pending-size: #ffd27f,
            accent: #8fbcff,
            directory-text: #d5e6ff,
            selected-text: #ffd892,
            search-match: #7cebdc,
            compression-mark: #a8ceff,
            cursor-background: #28568a,
            inactive-cursor: #344052,
            selected-background: #4a3924,
            selected-edge: #e0b769,
            cursor-edge: #6bacff,
            error-background: #39262d,
            error-text: #ffb7bd,
            selection-background: #315b86,
            selection-text: #ffffff,
        };
    }
}
