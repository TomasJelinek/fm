            return {
                light: false,
                window-background: #171717,
                pane-background: #202020,
                alternate-row: #252525,
                surface: #323232,
                secondary-surface: #242424,
                header: #383838,
                active-header: #424242,
                frame: #7c7c7c,
                active-frame: #929292,
                hover: #454545,
                text: #dedede,
                strong-text: #f0f0f0,
