        // Dracula
        if index == 3 {
            return {
                light: false,
                window-background: #191a23,
                pane-background: #282a36,
                alternate-row: #2c2e3b,
                surface: #37394b,
                secondary-surface: #252733,
                header: #3c3e50,
                active-header: #4b3b66,
                frame: #858aa4,
                active-frame: #bd93f9,
                hover: #514763,
                text: #f8f8f2,
                strong-text: #ffffff,
                secondary-text: #e8e8f0,
                muted-text: #b9bacb,
                pending-size: #ffcf93,
                accent: #d7baff,
                directory-text: #c7e8ff,
                selected-text: #f1fa8c,
                search-match: #8be9fd,
                compression-mark: #b6d9ff,
                cursor-background: #514064,
                inactive-cursor: #383447,
                selected-background: #4d425e,
                selected-edge: #ffb86c,
                cursor-edge: #bd93f9,
                error-background: #422b38,
                error-text: #ffb5c2,
                selection-background: #534265,
                selection-text: #ffffff,
