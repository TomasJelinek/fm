import { FallbackIcons } from "action-icons.slint";
import { HintedCheckBox, HintedActionButton, HintedComboBox } from "hinted-inputs.slint";
import { LineEdit } from "std-widgets.slint";
import { VScrollView } from "scroll-view.slint";
import { ListView } from "vlist-view.slint";
import { TipBody } from "controls.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogTabs } from "dialog-tabs.slint";
import { ListHeader } from "list-header.slint";

// Shared presentation metadata. Filesystem/thumbnailer rows have no viewer controls.
export struct ViewerPluginRow {
    id: string,
    name: string,
    description: string,
    kind: string,
    version: string,
    status: string,
    location: string,
    enabled: bool,
    configurable: bool,
    fallback: bool,
}

export global ViewerPluginsView {
    in property <string> revision;
    in property <[ViewerPluginRow]> rows;
    in property <[ViewerPluginRow]> filesystem-rows;
    in property <int> filesystem-selected: -1;
    in property <string> filesystem-error;
    in property <string> filesystem-diagnostics;
    in property <[ViewerPluginRow]> archive-rows;
    in property <int> archive-selected: -1;
    in property <[ViewerPluginRow]> thumbnailer-rows;
    in property <int> thumbnailer-selected: -1;
    in property <string> thumbnailer-error;
    in property <bool> thumbnailer-settings-ready;
    in-out property <string> thumbnailer-extensions;
    in property <bool> thumbnailer-extension-override;
    in property <string> thumbnailer-extension-error;
    in property <bool> pending;
    // What the last Rescan found, shown beside it; empty before one finishes.
    in property <string> rescan-status;
    in property <bool> settings-ready;
    in property <bool> restart-needed;
    in property <string> error;
    in property <int> selected: -1;
    // The selected viewer's draft or saved list. The editor binds two-way: native
    // input detaches a one-way binding, and the editor outlives selection changes.
    in-out property <string> extensions;
    in property <bool> extension-override;
    in property <string> extension-error;
    in property <int> extension-feedback-section: -1;
    in property <string> extension-feedback-revision;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    callback refresh();
    callback toggle(string, bool);
    callback select(int);
    callback select-filesystem(int);
    callback select-archive(int);
    callback select-thumbnailer(int);
    callback edit-thumbnailer-extensions(string);
    callback reset-thumbnailer-extensions();
    callback edit-extensions(string);
    callback reset-extensions();
    callback move(int);
}

component PluginCatalogList inherits Rectangle {
    in property <[ViewerPluginRow]> rows;
    in property <int> selected: -1;
    in property <int> visible-rows: 8;
    in property <bool> viewer-controls;
    in property <string> label;
    callback selected-row(int);
    callback toggled(string, bool);
    callback reveal-row(length, length);
    private property <length> row-height: Theme.control-height + 2px;
    private property <int> count: root.rows.length;
    // All viewer rows share the page's scroll area.
    height: root.row-height * max(1, root.viewer-controls ? root.count : min(root.visible-rows, root.count)) + 2px;
    background: Theme.pane-background; border-width: 1px;
    border-color: focus.has-focus ? Theme.active-frame : Theme.frame;
    clip: true; forward-focus: focus;
    accessible-role: AccessibleRole.list; accessible-label: root.label; accessible-item-count: root.count;
    changed selected => { root.reveal(); }
    changed count => { root.reveal(); }
    function reveal() {
        if root.selected < 0 { return; }
        let top = root.selected * root.row-height;
        if root.viewer-controls {
            root.reveal-row(root.absolute-position.y + 1px + top, root.row-height);
            return;
        }
        if top < -list.content-y { list.content-y = -top; }
        else if top + root.row-height > -list.content-y + list.visible-height {
            list.content-y = min(0px, list.visible-height - top - root.row-height);
        }
    }
    function choose(index: int) { focus.focus(); root.selected-row(index); }
    focus := FocusScope {
        key-pressed(event) => {
            if root.count == 0 { return reject; }
            if event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.Home || event.text == Key.End {
                let next = event.text == Key.Home ? 0 : event.text == Key.End ? root.count - 1
                    : clamp(root.selected + (event.text == Key.DownArrow ? 1 : -1), 0, root.count - 1);
                root.choose(next); return accept;
            }
            reject
        }
        list := ListView {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            vertical-scrollbar-policy: root.viewer-controls ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
            changed visible-height => { root.reveal(); }
            for plugin[index] in root.rows : Rectangle {
                width: list.visible-width; height: root.row-height;
                private property <bool> selected: index == root.selected;
                private property <string> label: plugin.name + (plugin.version == "" ? "" : " · " + plugin.version);
                background: self.selected ? Theme.selected-background
                    : area.has-hover ? Theme.hover : Theme.pane-background;
                accessible-role: list-item; accessible-label: self.label;
                accessible-item-index: index; accessible-item-selectable: true;
                accessible-item-selected: self.selected;
                accessible-action-default => { root.choose(index); }
                if root.viewer-controls : HintedCheckBox {
                    x: 4px; width: Theme.control-height; height: parent.height;
                    text: ""; accessible-label: parent.label;
                    checked: plugin.enabled;
                    enabled: plugin.configurable && ViewerPluginsView.settings-ready;
                    hint: plugin.id == "" ? "Select this unavailable package for details."
                        : "Enable " + plugin.name + " after restart.";
                    toggled => { root.toggled(plugin.id, self.checked); }
                }
                Text {
                    x: root.viewer-controls ? Theme.control-height + 10px : 8px;
                    width: max(0px, parent.width - self.x - 8px
                        - (list.content-height > list.visible-height ? FluentScrollMetrics.overlay-size : 0px));
                    height: parent.height; vertical-alignment: center;
                    text: parent.label; font-size: Theme.font-size; overflow: elide;
                    color: parent.selected ? Theme.selected-text : Theme.text;
                }
                area := TouchArea {
                    x: root.viewer-controls ? Theme.control-height + 4px : 0px;
                    width: parent.width - self.x;
                    clicked => { root.choose(index); }
                }
            }
        }
    }
}

component PluginCatalog inherits VerticalLayout {
    in property <[ViewerPluginRow]> rows;
    in property <int> selected: -1;
    in property <int> visible-rows: 8;
    in property <string> label;
    in property <string> error;
    in property <string> empty-text;
    private property <ViewerPluginRow> current: root.rows[root.selected];
    callback selected-row(int);
    spacing: 8px; alignment: start;
    Text { text: root.label; color: Theme.strong-text; font-size: Theme.font-size; }
    PluginCatalogList {
        rows: root.rows; selected: root.selected; visible-rows: root.visible-rows;
        label: root.label;
        selected-row(index) => { root.selected-row(index); }
    }
    @children
    if root.selected >= 0 : VerticalLayout {
        spacing: 6px; alignment: start;
        Text {
            text: root.current.name + (root.current.version == "" ? "" : " · " + root.current.version);
            color: Theme.strong-text; font-size: Theme.font-size; font-weight: 600; wrap: word-wrap;
        }
        Text { text: root.current.kind; color: Theme.text; font-size: Theme.small-font; wrap: word-wrap; }
        if root.current.id != "" : Text {
            text: "ID: " + root.current.id; color: Theme.secondary-text; font-size: Theme.small-font; wrap: char-wrap;
        }
        if root.current.description != "" : Text {
            text: root.current.description; color: Theme.text; font-size: Theme.small-font; wrap: word-wrap;
        }
        Text { text: root.current.status; color: Theme.text; font-size: Theme.small-font; wrap: word-wrap; }
        if root.current.location != "" : Text {
            text: root.current.location; color: Theme.secondary-text; font-size: Theme.small-font; wrap: char-wrap;
        }
    }
    if ViewerPluginsView.pending && root.error == "" && root.rows.length == 0 : Text {
        text: "Refreshing plugin catalogs…"; color: Theme.secondary-text; font-size: Theme.font-size; wrap: word-wrap;
    }
    if root.error != "" : ErrorNotice { text: root.error; }
    if !ViewerPluginsView.pending && root.error == "" && root.rows.length == 0 : Text {
        text: root.empty-text; color: Theme.secondary-text; font-size: Theme.font-size; wrap: word-wrap;
    }
}

component PluginExtensionEditor inherits VerticalLayout {
    in-out property <string> extensions;
    in property <bool> thumbnailer;
    in property <bool> settings-ready;
    in property <bool> extension-override;
    in property <string> error;
    in property <string> feedback-revision;
    in property <length> page-extent;
    callback edited(string);
    callback reset();
    callback reveal(length, length);
    spacing: 6px; alignment: start;
    HorizontalLayout {
        spacing: 6px;
        Text { text: "Associated extensions"; color: Theme.strong-text; font-size: Theme.font-size; vertical-alignment: center; horizontal-stretch: 1; }
        HintedActionButton {
            text: "Reset";
            accessible-label: root.thumbnailer ? "Reset thumbnailer extensions" : "Reset viewer extensions";
            enabled: root.extension-override && root.settings-ready;
            hint: root.thumbnailer ? "Restore this thumbnailer's extensions from its installed manifest."
                : "Restore this viewer's extensions from its installed manifest.";
            clicked => { root.reset(); }
        }
    }
    extension-editor := LineEdit {
        text <=> root.extensions; min-width: 0px;
        accessible-label: root.thumbnailer ? "Thumbnailer extensions" : "Viewer extensions";
        enabled: root.settings-ready;
        edited => { root.edited(self.text); }
        Tooltip { TipBody {
            text: root.thumbnailer ? "An empty list disables this thumbnailer's extension matches. Select OK to save."
                : "Separate extensions with spaces, commas or semicolons. Enter rs, .rs or *.rs. An empty list removes specific matches. Select OK to save.";
        } }
    }
    if root.error != "" : Text {
        private property <string> feedback: root.feedback-revision;
        private property <length> page-extent: root.page-extent;
        text: root.error;
        accessible-role: text; accessible-label: self.text;
        color: Theme.error-text; font-size: Theme.small-font; wrap: word-wrap;
        init => { self.reveal(); }
        changed feedback => { self.reveal(); }
        changed height => { self.reveal(); }
        changed page-extent => { self.reveal(); }
        function reveal() {
            let top = extension-editor.absolute-position.y;
            root.reveal(top, self.absolute-position.y + self.height - top);
        }
    }
}

export component PluginOptions inherits Rectangle {
    in property <length> available-height: 580px;
    private property <int> section;
    private property <string> extension-feedback-revision: ViewerPluginsView.extension-feedback-revision;
    private property <bool> compact-tabs: root.width < max(440px, Theme.font-size * 32);
    callback open-archive-associations();
    changed extension-feedback-revision => {
        if ViewerPluginsView.extension-feedback-section >= 0 {
            root.section = ViewerPluginsView.extension-feedback-section;
        }
    }
    function reveal-in-page(top: length, height: length) {
        let viewport-height = plugin-scroll.visible-height;
        if viewport-height <= 0px || height <= 0px { return; }
        let y = top - plugin-scroll.absolute-position.y;
        let bottom = y + min(height, viewport-height);
        let shift = y < 0px ? -y : min(0px, viewport-height - bottom);
        if shift != 0px {
            plugin-scroll.content-y = clamp(plugin-scroll.content-y + shift,
                min(0px, viewport-height - plugin-scroll.content-height), 0px);
        }
    }
    // Give the installed catalog the space it needs first. Details share the
    // page's scrolling area; they must not reserve hundreds of empty pixels.
    private property <int> visible-rows: max(2, floor(
        (root.available-height - 3 * Theme.control-height - 24px) / (Theme.control-height + 2px)));
    private property <ViewerPluginRow> selected: ViewerPluginsView.rows[ViewerPluginsView.selected];
    height: max(0px, root.available-height);
    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        spacing: 8px;
    plugin-scroll := VScrollView {
        min-height: 0px; vertical-stretch: 1;
        content-width: self.visible-width;
        VerticalLayout {
            spacing: 8px; alignment: start;
            padding-right: FluentScrollMetrics.overlay-size;
    if !root.compact-tabs : DialogTabs { labels: ["Viewers", "Filesystems", "Archives", "Thumbnailers"]; current-index <=> root.section; }
    if root.compact-tabs : HintedComboBox {
        accessible-label: "Plugin type"; model: ["Viewers", "Filesystems", "Archives", "Thumbnailers"];
        current-index <=> root.section; hint: "Choose the installed plugin category.";
    }
    if root.section == 0 : VerticalLayout {
        spacing: 8px; alignment: start;
        ListHeader {
            title: "Viewer priority";
            hint: "Higher viewers take precedence when their extensions overlap.";
            enabled: ViewerPluginsView.settings-ready;
            show-add: false; show-remove: false;
            can-move-up: ViewerPluginsView.can-move-up;
            can-move-down: ViewerPluginsView.can-move-down;
            action-labels: ["", "", "Move viewer up", "Move viewer down"];
            action-hints: ["", "", "Prefer this viewer for shared extensions.", "Give this viewer lower priority for shared extensions."];
            action(index) => { if index == 2 { ViewerPluginsView.move(-1); } else if index == 3 { ViewerPluginsView.move(1); } }
        }
        PluginCatalogList {
            rows: ViewerPluginsView.rows; selected: ViewerPluginsView.selected;
            viewer-controls: true; label: "Viewer priority";
            selected-row(index) => { ViewerPluginsView.select(index); }
            toggled(id, enabled) => { ViewerPluginsView.toggle(id, enabled); }
            reveal-row(top, height) => {
                if ViewerPluginsView.extension-error == "" { root.reveal-in-page(top, height); }
            }
        }
        if ViewerPluginsView.selected >= 0 : VerticalLayout {
            spacing: 6px; alignment: start;
            PluginExtensionEditor {
                extensions <=> ViewerPluginsView.extensions;
                settings-ready: root.selected.configurable && ViewerPluginsView.settings-ready;
                extension-override: ViewerPluginsView.extension-override;
                error: ViewerPluginsView.extension-error;
                feedback-revision: root.extension-feedback-revision;
                page-extent: plugin-scroll.content-height;
                edited(text) => { ViewerPluginsView.edit-extensions(text); }
                reset => { ViewerPluginsView.reset-extensions(); }
                reveal(top, height) => { root.reveal-in-page(top, height); }
            }
            if root.selected.fallback : Text {
                text: "This viewer remains the fallback for unassociated files.";
                color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap;
            }
            if root.selected.description != "" : Text {
                text: root.selected.description; color: Theme.text; font-size: Theme.small-font; wrap: word-wrap;
            }
            Text { text: root.selected.status; color: Theme.text; font-size: Theme.small-font; wrap: word-wrap; }
            Text { text: root.selected.location; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
        }
        if ViewerPluginsView.restart-needed : Text {
            text: "Restart required to apply your viewer choices.";
            color: Theme.accent; font-size: Theme.small-font; wrap: word-wrap;
        }
        if !ViewerPluginsView.pending && ViewerPluginsView.error == "" && ViewerPluginsView.rows.length == 0 : Text {
            text: "No viewer plugins are installed beside this application.";
            color: Theme.secondary-text; font-size: Theme.font-size; wrap: word-wrap;
        }
    }
    if root.section == 1 : PluginCatalog {
        rows: ViewerPluginsView.filesystem-rows; selected: ViewerPluginsView.filesystem-selected;
        visible-rows: root.visible-rows; label: "Filesystem plugins";
        error: ViewerPluginsView.filesystem-error;
        empty-text: "No filesystem plugins are installed beside this application.";
        selected-row(index) => { ViewerPluginsView.select-filesystem(index); }
    }
    if root.section == 2 : VerticalLayout {
        spacing: 8px; alignment: start;
        PluginCatalog {
            rows: ViewerPluginsView.archive-rows; selected: ViewerPluginsView.archive-selected;
            visible-rows: root.visible-rows; label: "Archive plugins";
            error: ViewerPluginsView.filesystem-error;
            empty-text: "No archive plugins are installed beside this application.";
            selected-row(index) => { ViewerPluginsView.select-archive(index); }
        }
        HintedActionButton {
            text: root.compact-tabs ? "Associations…" : "Archive associations…";
            accessible-label: "Archive associations…";
            hint: "Choose which file types open as archive folders.";
            clicked => { root.open-archive-associations(); }
        }
    }
    if (root.section == 1 || root.section == 2) && ViewerPluginsView.filesystem-diagnostics != "" : VerticalLayout {
        spacing: 6px;
        Text { text: "Filesystem and archive package diagnostics"; color: Theme.strong-text; font-size: Theme.font-size; wrap: word-wrap; }
        ErrorNotice {
            text: ViewerPluginsView.filesystem-diagnostics;
            context-key: root.section == 1 ? "filesystem-packages" : "archive-packages";
        }
    }
    if root.section == 3 : PluginCatalog {
        rows: ViewerPluginsView.thumbnailer-rows; selected: ViewerPluginsView.thumbnailer-selected;
        visible-rows: root.visible-rows; label: "Thumbnailer plugins";
        error: ViewerPluginsView.thumbnailer-error;
        empty-text: "No thumbnailer plugins are installed beside this application.";
        selected-row(index) => { ViewerPluginsView.select-thumbnailer(index); }
        if ViewerPluginsView.thumbnailer-selected >= 0 : PluginExtensionEditor {
            thumbnailer: true;
            extensions <=> ViewerPluginsView.thumbnailer-extensions;
            settings-ready: ViewerPluginsView.thumbnailer-settings-ready;
            extension-override: ViewerPluginsView.thumbnailer-extension-override;
            error: ViewerPluginsView.thumbnailer-extension-error;
            feedback-revision: root.extension-feedback-revision;
            page-extent: plugin-scroll.content-height;
            edited(text) => { ViewerPluginsView.edit-thumbnailer-extensions(text); }
            reset => { ViewerPluginsView.reset-thumbnailer-extensions(); }
            reveal(top, height) => { root.reveal-in-page(top, height); }
        }
    }
    if ViewerPluginsView.error != "" : ErrorNotice { text: ViewerPluginsView.error; }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        // A rescan that changes nothing still says what it found.
        Text {
            horizontal-stretch: 1; vertical-alignment: center;
            text: ViewerPluginsView.rescan-status;
            color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap;
        }
        HintedActionButton {
            text: ViewerPluginsView.pending ? "Rescanning…" : "Rescan all plugins";
            enabled: !ViewerPluginsView.pending;
            fallback-icon: FallbackIcons.refresh;
            hint: "Rescan all installed viewer, filesystem, archive and thumbnailer packages.";
            clicked => { ViewerPluginsView.refresh(); }
        }
    }
    }
}
