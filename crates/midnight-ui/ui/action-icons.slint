import { Theme } from "theme.slint";
import { LocationRole } from "navigation-models.slint";

// Named fields keep UI meaning independent of the native enum's declaration order.
export struct ActionIcons {
    network: image,
    back: image,
    forward: image,
    parent: image,
    refresh: image,
    open-path: image,
    bookmarks: image,
    terminal: image,
    options: image,
    run: image,
    tab-add: image,
    close-tab: image,
    remove-bookmark: image,
    add-bookmark: image,
    help: image,
    rename: image,
    view: image,
    find: image,
    edit: image,
    copy: image,
    move-item: image,
    new-folder: image,
    new-file: image,
    delete: image,
    user-menu: image,
    menu: image,
    save-again: image,
    done: image,
    close: image,
    properties: image,
    folder-sizes: image,
    about: image,
    exit: image,
    sort-ascending: image,
    sort-descending: image,
}

// Original fallbacks are used only when a semantic host icon is absent.
// Colored command artwork has separate neutral outlines for light/dark themes.
export global FallbackIcons {
    out property <image> checksums: Theme.light ? @image-url("icons/checksums.svg") : @image-url("icons/checksums-dark.svg");
    out property <image> compare-files: Theme.light ? @image-url("icons/compare-files.svg") : @image-url("icons/compare-files-dark.svg");
    out property <image> compare-directories: Theme.light ? @image-url("icons/compare-directories.svg") : @image-url("icons/compare-directories-dark.svg");
    out property <image> filter: Theme.light ? @image-url("icons/filter.svg") : @image-url("icons/filter-dark.svg");
    out property <image> find: Theme.light ? @image-url("icons/find.svg") : @image-url("icons/find-dark.svg");
    out property <image> drive: @image-url("icons/drive.svg");
    out property <image> network: @image-url("icons/network.svg");
    out property <image> home: @image-url("icons/home.svg");
    out property <image> desktop: @image-url("icons/desktop.svg");
    out property <image> documents: @image-url("icons/documents.svg");
    out property <image> downloads: @image-url("icons/downloads.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> forward: @image-url("icons/forward.svg");
    out property <image> parent: @image-url("icons/parent.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> open-path: @image-url("icons/open-path.svg");
    out property <image> bookmarks: Theme.light ? @image-url("icons/star.svg") : @image-url("icons/star-dark.svg");
    out property <image> terminal: @image-url("icons/terminal.svg");
    out property <image> options: Theme.light ? @image-url("icons/settings.svg") : @image-url("icons/settings-dark.svg");
    out property <image> run: @image-url("icons/run.svg");
    out property <image> tab-add: @image-url("icons/add.svg");
    out property <image> close-tab: @image-url("icons/close.svg");
    out property <image> remove-bookmark: @image-url("icons/close.svg");
    out property <image> add-bookmark: Theme.light ? @image-url("icons/bookmark-add.svg") : @image-url("icons/bookmark-add-dark.svg");
    out property <image> help: Theme.light ? @image-url("icons/help.svg") : @image-url("icons/help-dark.svg");
    out property <image> rename: @image-url("icons/rename.svg");
    out property <image> view: Theme.light ? @image-url("icons/view.svg") : @image-url("icons/view-dark.svg");
    out property <image> edit: @image-url("icons/edit.svg");
    out property <image> copy: Theme.light ? @image-url("icons/copy.svg") : @image-url("icons/copy-dark.svg");
    out property <image> move-item: Theme.light ? @image-url("icons/move.svg") : @image-url("icons/move-dark.svg");
    out property <image> new-folder: @image-url("icons/folder-add.svg");
    out property <image> new-file: @image-url("icons/file-add.svg");
    out property <image> make-file-list: @image-url("icons/file-list.svg");
    out property <image> delete: @image-url("icons/delete.svg");
    out property <image> user-menu: @image-url("icons/user-menu.svg");
    out property <image> menu: @image-url("icons/menu.svg");
    out property <image> save-again: @image-url("icons/save.svg");
    out property <image> done: @image-url("icons/done.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> properties: @image-url("icons/properties.svg");
    out property <image> attributes: Theme.light ? @image-url("icons/attributes.svg") : @image-url("icons/attributes-dark.svg");
    out property <image> folder-sizes: Theme.light ? @image-url("icons/folder-sizes.svg") : @image-url("icons/folder-sizes-dark.svg");
    out property <image> about: @image-url("icons/about.svg");
    out property <image> exit: @image-url("icons/exit.svg");
    out property <image> sort-ascending: @image-url("icons/sort-ascending.svg");
    out property <image> sort-descending: @image-url("icons/sort-descending.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    // Every labelled button carries an icon, so a call site that names none gets the
    // one its label implies. Symbol captions (+, −, ‹, ›, 1:1) are their own icon;
    // viewer and comparator view toggles have no common glyph and stay without one,
    // as does Panel filter's Show all, whose smallest footer has no room for it.
    pure public function for-label(label: string) -> image {
        return label == "OK" || label == "Apply" || label == "Apply shortcut" || label == "Use color" || label == "Save"
                || label == "Apply colors" || label == "Assign" || label == "Replace"
                || label == "Keep shortcuts" || label == "Keep custom shortcuts" ? FallbackIcons.done
            : label == "Cancel" || label == "Close" || label == "Remove" || label == "Cancel job" || label == "Cancel operation"
                || label == "Clear" ? FallbackIcons.close
            : label == "Browse…" || label == "Browse image…" || label == "Change icon…" || label == "Insert file" ? FallbackIcons.open-path
            : label == "Open" || label == "Resume" || label == "Play" ? FallbackIcons.run
            : label == "Pause" ? FallbackIcons.pause
            : label == "Copy details" || label == "Copy as" ? FallbackIcons.copy
            : label == "Add" || label == "Add current" || label == "Insert value" ? FallbackIcons.tab-add
            : label == "Reset" || label == "Retry" || label == "Retry with authorization" || label == "Refresh"
                || label == "Discard changes" || label == "Restore command" || label == "Restore defaults"
                || label == "Restore all defaults" || label == "Reset shortcuts" || label == "Reset all shortcuts"
                || label == "Leave permissions unchanged" ? FallbackIcons.refresh
            : label == "Skip" || label == "Skip all" || label == "Skip all this error type" ? FallbackIcons.forward
            : label == "Decide later" ? FallbackIcons.back
            : label == "Details" || label == "Fewer details" || label == "Resolve"
                || label == "Show built-in checkbox" ? FallbackIcons.view
            : label == "Associations…" || label == "Archive associations…" ? FallbackIcons.options
            : label == "Jobs" ? FallbackIcons.menu
            : label == "Replace · keep original" || label == "Replace all · keep originals" ? FallbackIcons.save-again
            : label == "Merge folders" || label == "Merge all folders" ? FallbackIcons.new-folder
            : label == "Delete" ? FallbackIcons.delete : @image-url("");
    }
    pure public function is-colored(icon: image) -> bool {
        return icon == FallbackIcons.checksums || icon == FallbackIcons.compare-files || icon == FallbackIcons.compare-directories
            || icon == FallbackIcons.filter || icon == FallbackIcons.find || icon == FallbackIcons.bookmarks || icon == FallbackIcons.options
            || icon == FallbackIcons.add-bookmark || icon == FallbackIcons.help || icon == FallbackIcons.view || icon == FallbackIcons.copy
            || icon == FallbackIcons.move-item || icon == FallbackIcons.attributes || icon == FallbackIcons.folder-sizes || icon == FallbackIcons.make-file-list;
    }
}

// The one style of action glyphs (labelled buttons, toolbar and function keys) in every
// window and on every platform: a monochrome glyph in the theme's dimmed foreground.
export global ActionGlyph {
    pure public function tint(enabled: bool) -> color {
        return enabled ? Theme.secondary-text : Theme.muted-text;
    }
}

export component NativeActionImage inherits Image {
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <bool> action-enabled: true;
    // An action glyph: the bundled glyph, tinted like every other action glyph. Host
    // artwork, which differs per platform and icon theme, shows only where no glyph
    // exists (the application logo) and then keeps its own colors.
    in property <bool> glyph;
    private property <bool> native-available: native-icon.width > 0 && native-icon.height > 0;
    private property <bool> fallback-available: fallback-icon.width > 0 && fallback-icon.height > 0;
    private property <bool> tinted-glyph: root.glyph && root.fallback-available;
    source: root.tinted-glyph || !root.native-available ? root.fallback-icon : root.native-icon;
    // Transparent is Slint's uncolored-image default; host RGB and alpha survive.
    colorize: root.tinted-glyph ? ActionGlyph.tint(root.action-enabled)
        : root.native-available || (root.action-enabled && FallbackIcons.is-colored(root.fallback-icon))
        ? transparent : root.action-enabled ? Theme.text : Theme.muted-text;
    opacity: !root.tinted-glyph && root.native-available && !root.action-enabled ? 0.45 : 1;
    image-fit: contain;
}

// The icon/caption row is one shared component: every button type that inherits
// ActionButton gets a copy of its root, and would repeat this content inline.
component ActionButtonContent inherits HorizontalLayout {
    in property <string> text;
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <bool> compact;
    in property <length> font-size;
    in property <length> vertical-padding;
    in property <bool> removal-icon;
    in property <bool> destructive;
    in property <bool> enabled;
    // Close dismisses; it is never the red window-close cross, so it ignores native artwork.
    private property <bool> closing: root.text == "Close";
    private property <image> glyph: root.closing ? FallbackIcons.exit : root.fallback-icon.width > 0 ? root.fallback-icon : FallbackIcons.for-label(root.text);
    // The same glyph style on every platform and in every window: the bundled glyph,
    // tinted with the theme's dimmed foreground. Host artwork (often colored, and
    // different per platform) stands in only where no glyph exists, tinted the same way.
    private property <image> artwork: root.closing || root.glyph.width > 0 ? root.glyph : root.native-icon;
    private property <bool> has-icon: root.artwork.width > 0 && root.artwork.height > 0;
    private property <color> foreground: !root.enabled ? Theme.muted-text
        : root.destructive ? Theme.error-text : Theme.text;
    padding-left: root.compact ? 4px : 12px;
    padding-right: root.compact ? 4px : 12px;
    padding-top: root.vertical-padding; padding-bottom: root.vertical-padding;
    spacing: 4px; alignment: center; cross-axis-alignment: center;
    if root.has-icon: Image {
        source: root.artwork; image-fit: contain;
        width: Theme.icon-size; height: Theme.icon-size;
        // Removal and destructive actions keep the error color of their caption.
        colorize: root.enabled && (root.removal-icon || root.destructive) ? Theme.error-text
            : ActionGlyph.tint(root.enabled);
        accessible-role: none;
    }
    if root.text != "": Text {
        text: root.text; color: root.foreground;
        font-family: Theme.effective-font-family; font-size: root.font-size;
        horizontal-alignment: center; vertical-alignment: center;
        accessible-role: none;
    }
}

// The stock Button's input/focus behavior, with application-owned paint.
// Fluent's stock primary brush follows the OS accent rather than our palette.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <bool> primary;
    in property <bool> compact;
    in property <length> font-size: Theme.font-size;
    in property <length> control-height: Theme.control-height;
    in property <length> minimum-control-height: 32px;
    in property <length> vertical-padding: 5px;
    in property <bool> removal-icon;
    in property <bool> destructive;
    in property <bool> enabled: true;
    in property <bool> focusable: true;
    out property <bool> has-focus: input.has-focus;
    out property <bool> pressed: root.enabled && pointer.pressed;
    callback clicked();
    min-width: max(32px, content.min-width);
    min-height: max(root.minimum-control-height, root.control-height, content.min-height);
    horizontal-stretch: 0; vertical-stretch: 0;
    forward-focus: input;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activate(); } }
    function activate() {
        // A focused scope still receives Enter after it becomes disabled.
        if !root.enabled { return; }
        if root.focusable { input.focus(); }
        root.clicked();
    }
    background: !root.enabled ? Theme.secondary-surface
        : root.destructive ? Theme.error-background
        : root.pressed ? Theme.cursor-background
        : root.primary ? Theme.active-header
        : pointer.has-hover ? Theme.hover : Theme.secondary-surface;
    border-radius: 4px;
    border-width: root.has-focus && root.enabled ? 2px : 1px;
    border-color: !root.enabled ? Theme.frame
        : root.destructive ? Theme.error-text
        : root.has-focus || root.primary ? Theme.active-frame : Theme.frame;
    content := ActionButtonContent {
        text: root.text; native-icon: root.native-icon; fallback-icon: root.fallback-icon;
        compact: root.compact; font-size: root.font-size; vertical-padding: root.vertical-padding;
        removal-icon: root.removal-icon; destructive: root.destructive; enabled: root.enabled;
    }
    // The focus scope of Fluent's Button (button.slint, i-focus-scope) without the
    // Button around it, which was instantiated hidden at every use: zero width, so
    // it never takes a click, and Space or Return activate.
    input := FocusScope {
        // Explicit placement keeps the scope out of content sizing.
        x: 0px; y: 0px;
        width: 0px; height: root.height;
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.activate(); return accept; }
            reject
        }
    }
    pointer := TouchArea {
        enabled: root.enabled;
        clicked => { root.activate(); }
    }
}

export component LocationImage inherits NativeActionImage {
    in property <LocationRole> kind;
    fallback-icon: root.kind == LocationRole.home ? FallbackIcons.home
        : root.kind == LocationRole.desktop ? FallbackIcons.desktop
        : root.kind == LocationRole.documents ? FallbackIcons.documents
        : root.kind == LocationRole.downloads ? FallbackIcons.downloads
        : root.kind == LocationRole.hot-path ? FallbackIcons.bookmarks
        : root.kind == LocationRole.folder ? FallbackIcons.documents
        : root.kind == LocationRole.recycle-bin ? FallbackIcons.delete
        : root.kind == LocationRole.network ? FallbackIcons.network : FallbackIcons.drive;
}
