import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { LocationRole } from "navigation-models.slint";

// Named fields keep UI meaning independent of the native enum's declaration order.
export struct ActionIcons {
    network: image,
    back: image,
    forward: image,
    parent: image,
    refresh: image,
    open-path: image,
    bookmarks: image,
    terminal: image,
    options: image,
    run: image,
    tab-add: image,
    close-tab: image,
    remove-bookmark: image,
    add-bookmark: image,
    help: image,
    rename: image,
    view: image,
    edit: image,
    copy: image,
    move-item: image,
    new-folder: image,
    new-file: image,
    delete: image,
    user-menu: image,
    menu: image,
    save-again: image,
    done: image,
    close: image,
    properties: image,
    folder-sizes: image,
    about: image,
    exit: image,
    sort-ascending: image,
    sort-descending: image,
}

// Embedded, monochrome fallbacks are used only when a semantic host icon is absent.
export global FallbackIcons {
    out property <image> drive: @image-url("icons/drive.svg");
    out property <image> network: @image-url("icons/network.svg");
    out property <image> home: @image-url("icons/home.svg");
    out property <image> desktop: @image-url("icons/desktop.svg");
    out property <image> documents: @image-url("icons/documents.svg");
    out property <image> downloads: @image-url("icons/downloads.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> forward: @image-url("icons/forward.svg");
    out property <image> parent: @image-url("icons/parent.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> open-path: @image-url("icons/open-path.svg");
    out property <image> bookmarks: @image-url("icons/star.svg");
    out property <image> terminal: @image-url("icons/terminal.svg");
    out property <image> options: @image-url("icons/settings.svg");
    out property <image> run: @image-url("icons/run.svg");
    out property <image> tab-add: @image-url("icons/add.svg");
    out property <image> close-tab: @image-url("icons/close.svg");
    out property <image> remove-bookmark: @image-url("icons/close.svg");
    out property <image> add-bookmark: @image-url("icons/bookmark-add.svg");
    out property <image> help: @image-url("icons/help.svg");
    out property <image> rename: @image-url("icons/rename.svg");
    out property <image> view: @image-url("icons/view.svg");
    out property <image> edit: @image-url("icons/edit.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> move-item: @image-url("icons/move.svg");
    out property <image> new-folder: @image-url("icons/folder-add.svg");
    out property <image> new-file: @image-url("icons/file-add.svg");
    out property <image> delete: @image-url("icons/delete.svg");
    out property <image> user-menu: @image-url("icons/user-menu.svg");
    out property <image> menu: @image-url("icons/menu.svg");
    out property <image> save-again: @image-url("icons/save.svg");
    out property <image> done: @image-url("icons/done.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> properties: @image-url("icons/properties.svg");
    out property <image> folder-sizes: @image-url("icons/folder-sizes.svg");
    out property <image> about: @image-url("icons/about.svg");
    out property <image> exit: @image-url("icons/exit.svg");
    out property <image> sort-ascending: @image-url("icons/sort-ascending.svg");
    out property <image> sort-descending: @image-url("icons/sort-descending.svg");
}

export component NativeActionImage inherits Image {
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <bool> action-enabled: true;
    private property <bool> native-available: native-icon.width > 0 && native-icon.height > 0;
    source: root.native-available ? root.native-icon : root.fallback-icon;
    // Transparent is Slint's uncolored-image default; host RGB and alpha survive.
    colorize: root.native-available ? transparent : root.action-enabled ? Theme.text : Theme.muted-text;
    image-fit: contain;
}

export component ActionButton inherits Button {
    in property <image> native-icon;
    in property <image> fallback-icon;
    private property <bool> native-available: native-icon.width > 0 && native-icon.height > 0;
    icon: root.native-available ? root.native-icon : root.fallback-icon;
    icon-size: Theme.icon-size;
    colorize-icon: !root.native-available;
}

export component LocationImage inherits NativeActionImage {
    in property <LocationRole> kind;
    fallback-icon: root.kind == LocationRole.home ? FallbackIcons.home
        : root.kind == LocationRole.desktop ? FallbackIcons.desktop
        : root.kind == LocationRole.documents ? FallbackIcons.documents
        : root.kind == LocationRole.downloads ? FallbackIcons.downloads
        : root.kind == LocationRole.hot-path ? FallbackIcons.bookmarks
        : root.kind == LocationRole.network ? FallbackIcons.network : FallbackIcons.drive;
}
