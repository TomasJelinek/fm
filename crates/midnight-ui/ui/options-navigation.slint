import { Theme } from "theme.slint";
import { VScrollView } from "scroll-view.slint";

// Pages in the order users look for settings (docs/developer/DIALOG_ERGONOMICS.md,
// "Options page order"): behavior and appearance, how panels show files, archives,
// the programs for files and Custom Commands, keys, then the plugin catalog.
// Each page keeps its topic identity, which asynchronous pickers, validation results
// and the Custom Commands shortcut use; the removed Command topic (2) shows General.
export global OptionsTopics {
    out property <[string]> titles: ["General", "Appearance", "Colors", "Previews", "Archives", "Editors", "Comparators", "Custom Commands", "Keyboard", "Plugins"];
    // The topic identity of each listed page.
    out property <[int]> ids: [0, 1, 8, 6, 7, 4, 10, 9, 3, 5];
    // The list position of each topic identity.
    out property <[int]> positions: [0, 1, 0, 8, 5, 9, 3, 4, 2, 7, 6];
    public pure function topic(index: int) -> int {
        return index >= 0 && index < root.ids.length ? root.ids[index] : 0;
    }
    public pure function index(topic: int) -> int {
        return topic >= 0 && topic < root.positions.length ? root.positions[topic] : 0;
    }
}

export component OptionsNavigation inherits Rectangle {
    in-out property <int> selected;
    private property <int> focus-request: -1;
    // The entry the keyboard is on, or on its way to: the arrows, Home and End move
    // from here (U-D29), not from the page shown, which Tab leaves behind. A key that
    // comes before the focus has moved continues from where the last one went.
    private property <int> current: -1;
    private property <length> row-height: max(Theme.control-height, Theme.font-size * 1.5 + 10px);
    background: Theme.secondary-surface; border-radius: 4px;
    changed selected => { root.reveal-selected(); }
    changed row-height => { root.reveal-selected(); }
    function reveal-selected() {
        let top = 6px + OptionsTopics.index(root.selected) * (root.row-height + 4px);
        if top < -topics.content-y { topics.content-y = -top; }
        else if top + root.row-height + 6px > -topics.content-y + topics.visible-height {
            topics.content-y = min(0px, topics.visible-height - top - root.row-height - 6px);
        }
    }
    topics := VScrollView {
        min-height: 0px;
        changed visible-height => { root.reveal-selected(); }
    VerticalLayout {
        padding: 6px; spacing: 4px; alignment: start;
        for label[index] in OptionsTopics.titles : Rectangle {
            private property <bool> focus-requested: root.focus-request == index;
            changed focus-requested => { if self.focus-requested { tab-focus.focus(); } }
            height: root.row-height;
            background: root.selected == OptionsTopics.topic(index) ? Theme.selected-background
                : area.has-hover ? Theme.hover : transparent;
            border-radius: 3px;
            border-width: tab-focus.has-focus ? 1px : 0px; border-color: Theme.active-frame;
            accessible-role: button; accessible-label: label;
            accessible-checkable: true; accessible-checked: root.selected == OptionsTopics.topic(index);
            accessible-action-default => { root.selected = OptionsTopics.topic(index); }
            forward-focus: tab-focus;
            Text {
                x: 10px; width: parent.width - 20px;
                text: label; font-size: Theme.font-size; overflow: elide;
                color: root.selected == OptionsTopics.topic(index) ? Theme.selected-text : Theme.text;
                font-weight: root.selected == OptionsTopics.topic(index) ? 600 : 400; vertical-alignment: center;
            }
            tab-focus := FocusScope {
                // However the entry got the keyboard (Tab, Shift+Tab, a click, a key).
                focus-gained(reason) => { root.current = index; root.focus-request = index; }
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space { root.selected = OptionsTopics.topic(index); return accept; }
                    let from = root.current >= 0 ? root.current : index;
                    let last = OptionsTopics.titles.length - 1;
                    let to = event.text == Key.DownArrow || event.text == Key.RightArrow ? min(from + 1, last)
                        : event.text == Key.UpArrow || event.text == Key.LeftArrow ? max(from - 1, 0)
                        : event.text == Key.Home ? 0
                        : event.text == Key.End ? last
                        : -1;
                    if to < 0 { return reject; }
                    // The focus and the page shown move together.
                    root.current = to;
                    root.focus-request = to;
                    root.selected = OptionsTopics.topic(to);
                    accept
                }
                area := TouchArea { clicked => { tab-focus.focus(); root.focus-request = index; root.selected = OptionsTopics.topic(index); } }
            }
        }
    }
    }
}
