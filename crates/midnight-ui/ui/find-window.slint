import { ScrollView } from "scroll-view.slint";
import { FieldButton, HintedLineEdit, HintedActionButton, HintedComboBox, HistoryLineEdit } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { PathText } from "path-text.slint";
import { FallbackIcons } from "action-icons.slint";
import { ErrorNotice } from "error-notice.slint";
import { ToolWindow } from "tool-window.slint";
import { FindResults, FindRow, FindColumnWidths } from "find-results.slint";
import { DialogFooter } from "dialog-footer.slint";
import { WrappingCheckBox } from "wrapping-check-box.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";
import { FindAdvanced } from "find-advanced.slint";
import { FindRootsPicker, FindRootRow } from "find-roots.slint";
import { FindSyntaxHelp } from "find-help.slint";
import { FindStatusLine } from "find-status.slint";

export { FindRow, FindRootRow, FindColumnWidths }
export struct FindDraft {
    masks: string, mode: int, recursive: bool, name-case: bool,
    content-enabled: bool, content: string, content-case: bool, whole-words: bool,
    modified-enabled: bool, modified-seconds: int, duplicates: bool,
    content-regex: bool, archives: bool,
}

// Match the query controls while preserving touch and intrinsic content sizing: as tall
// as the query's fields and pickers (`row-height`), or as its caption needs.
component FindActionButton inherits HintedActionButton {
    in property <length> row-height;
    minimum-control-height: 0px;
    vertical-padding: Theme.touch ? 5px : 4px;
    height: max(self.min-height, root.row-height);
}

export component FindWindow inherits ToolWindow {
    callback close-session();
    request-close => { root.close-session(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    title: "Find files · Midnight Explorer";
    preferred-width: 780px; preferred-height: 560px;
    in property <[FindRow]> rows;
    in property <[string]> mask-history;
    in-out property <string> filename-mask: "*.*";
    // User actions own the draft; host initialization never marks it as edited.
    out property <bool> filename-mask-edited;
    in property <string> found-count: "" + root.rows.length;
    // The query's one control height, for its stock fields and pickers, its buttons and
    // the folders picker: the density's control height, the stock field's minimum (32 px
    // in the Fluent style) or what a line of text and the field's padding need.
    private property <length> query-height: max(Theme.control-height, 32px,
        caption-probe.preferred-height + 12px);
    // One line of a button's caption, for the query height.
    caption-probe := Text { visible: false; accessible-role: none; text: "Ag"; font-size: Theme.font-size; }
    // One line of the status in its small font.
    status-probe := Text { visible: false; accessible-role: none; text: "Ag"; font-size: Theme.small-font; }
    // Whether each shown result is selected; the host keeps the selection.
    in property <[bool]> marks;
    in property <int> selected-count;
    // The current search, so that a new one closes the results' context menu.
    in property <string> generation;
    in property <[FindRootRow]> roots;
    private property <int> selected-root;
    private property <int> current-root: root.roots.length == 0 ? -1
        : max(0, min(root.selected-root, root.roots.length - 1));
    // Ticked roots, counted by the host.
    in property <int> searched-roots;
    // The host's answer to Add: the added folder, or the listed one that was ticked
    // again. Choose it and finish the entry; focus leaves the closed entry.
    public function root-added(index: int) {
        root.selected-root = index;
        root.adding = false;
        roots.focus();
    }
    in property <bool> running;
    in property <bool> feeding;
    in property <bool> stopping;
    in property <bool> duplicate-results;
    in property <string> progress;
    in property <string> current-directory;
    in property <int> sort-column;
    in property <bool> sort-descending;
    callback sort(int);
    in property <string> error;
    in property <string> details;
    in property <bool> attention;
    private property <bool> narrow: root.width < max(620px, Theme.font-size * 30);
    private property <bool> compact-query: root.height < 360px;
    private property <int> name-row: root.narrow && !root.compact-query ? 1 : 0;
    private property <string> folders-label: "Search folders" + (root.roots.length > 1
        ? " (" + (root.searched-roots < root.roots.length
            ? root.searched-roots + " of " : "") + root.roots.length + ")" : "");
    // The label on its own row of a narrow window, at the width it gets there. A short
    // query area squeezes its grid toward the rows' minimum heights, so the label keeps
    // this natural height as its minimum instead of collapsing to nothing.
    folders-label-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, query-scroll.visible-width - FluentScrollMetrics.overlay-size);
        text: root.folders-label; wrap: word-wrap;
        font-size: Theme.font-size; font-weight: 600;
    }
    // A running compact search hides the query area, so its status moves under the results.
    private property <bool> inline-status: root.height >= 360px
        || (!root.show-details && (Theme.font-size <= 20px || root.running));
    // Otherwise a short window with large text shows the status in the query area, on
    // its last line below the scrolled form, where it stays in view.
    private property <bool> query-status: !root.inline-status && !root.show-details && root.progress != "";
    private property <length> query-status-height: root.query-status ? max(18px, Theme.small-font + 4px) + 3px : 0px;
    in-out property <int> selected-row: -1;
    in-out property <bool> show-details;
    private property <bool> show-advanced;
    // Add shows a one-line folder entry under the Search folders picker.
    private property <bool> adding;
    private property <string> new-root-text;
    // Syntax help covers the results while the query stays editable.
    in-out property <bool> show-help;
    in-out property <FindColumnWidths> column-widths <=> results.widths;
    // Hiding the query editor must not leave the native window without a key
    // recipient: Escape remains available while Details replaces that editor.
    changed show-details => { root.focus-content(); }
    callback search(FindDraft);
    callback stop();
    callback add-root(string);
    callback browse-root();
    callback remove-root(int);
    callback toggle-root(int, bool);
    callback reveal(string);
    // Show the results as a list in the panel that opened this Find, then close it.
    callback feed-panel();
    callback file-action(string, int);
    callback action-key(KeyEvent, string) -> bool;
    // Selection requests from the results (see `FindResults`).
    callback select-row(int, bool, bool);
    callback move-cursor(int, bool, bool);
    callback toggle-mark(bool);
    callback select-all();
    callback deselect-all();
    callback menu-row(int);
    // Copy names (0), full paths (1) or row details (2) of the results an action on
    // this row acts on.
    callback copy-results(string, int);
    in property <string> view-hint;
    in property <string> edit-hint;
    // The current bindings of View and Edit, shown in the context menu.
    in property <string> view-keys;
    in property <string> edit-keys;
    private property <bool> selected-file: root.selected-row >= 0
        && root.selected-row < root.rows.length && !root.rows[root.selected-row].directory
        && !root.rows[root.selected-row].in-archive;
    // Archive members open from their archive (Go to file), never directly.
    private property <bool> selected-native: root.selected-row >= 0
        && root.selected-row < root.rows.length && !root.rows[root.selected-row].in-archive;
    public function act-selected(action: int) {
        if root.selected-row >= 0 && root.selected-row < root.rows.length {
            root.file-action(root.rows[root.selected-row].token, action);
        }
    }
    public function reveal-selected() {
        if root.selected-row >= 0 && root.selected-row < root.rows.length {
            root.reveal(root.rows[root.selected-row].token);
        }
    }
    // A footer action, as a button or from More…, by its index in `footer-actions`.
    function footer-chosen(index: int) {
        if index == 0 { if root.running { root.stop(); } else { root.submit(); } }
        else if index == 1 { root.reveal-selected(); }
        else if index == 2 { root.act-selected(0); }
        else if index == 3 { root.act-selected(2); }
        else if index == 4 { root.act-selected(3); }
        else if index == 5 || index == 6 { root.copy-details(); }
        else if index == 7 { root.show-details = false; }
    }
    // How many footer actions show as buttons, and how many are in More….
    out property <int> footer-buttons: find-footer.shown-actions;
    out property <int> footer-overflow: find-footer.overflow-actions;
    callback copy-details();
    public function begin() { masks.focus-line(); }
    public function start-adding() {
        // The entry is created empty and focuses itself.
        root.new-root-text = "";
        root.adding = true;
    }
    // Slint does not move focus off a destroyed item: closing an overlay that may
    // hold focus hands it to a control that stays.
    function close-adding() {
        root.adding = false;
        // Search folders cannot take focus while a search runs; the results can.
        if root.running { results.focus(); } else { roots.focus(); }
    }
    function close-help() {
        root.show-help = false;
        results.focus();
    }
    public function submit() {
        if root.running || !advanced.valid { return; }
        root.show-help = false;
        root.search({masks: masks.text, mode: mode.current-index, recursive: recursive.checked, name-case: names.checked,
            content-enabled: content-enabled.checked, content: content.text, content-case: content-case.checked,
            whole-words: advanced.whole-words, modified-enabled: advanced.modified-enabled,
            modified-seconds: advanced.modified-seconds, duplicates: advanced.duplicates,
            content-regex: content-regex.checked, archives: advanced.archives && !advanced.duplicates});
    }
    FocusScope {
        min-width: 0px; min-height: 0px;
        preferred-width: 0px; preferred-height: 0px;
        // A key router, not a Tab stop. A click on empty space still focuses it rather
        // than the window's outer scope, which would close the window on Escape.
        focus-on-tab-navigation: false;
        // F1 and Escape bubble here from the query editors and the results; the open
        // help handles its own. Escape closes an open overlay before the window.
        key-pressed(event) => {
            if event.text == Key.F1 { root.show-help = !root.show-help; return accept; }
            if event.text == Key.Escape && root.adding { root.close-adding(); return accept; }
            if event.text == Key.Escape && root.show-help { root.show-help = false; return accept; }
            reject
        }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            padding: root.height < 360px ? 4px : 12px; spacing: root.height < 360px ? 3px : 6px;
            Rectangle {
                // Compact running searches give their disabled query area to
                // results. The instantiated editor/draft remains unchanged.
                height: root.height < 360px && root.running && !root.show-details ? 0px
                    : root.height < 360px ? max(max(Theme.control-height, masks.preferred-height) + 8px, root.height * 0.32)
                        + root.query-status-height
                    : root.show-details ? root.height * 0.45 : min(root.height * 0.60, query-form.preferred-height + 2px);
                clip: true;
              query-scroll := ScrollView {
                visible: !root.show-details;
                // At the top of the query area: without a y, a shorter view is centred
                // and its lower part runs under the status line below it.
                y: 0px;
                height: parent.height - root.query-status-height;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                query-form := VerticalLayout {
                    padding-right: FluentScrollMetrics.overlay-size;
                    spacing: root.narrow ? 8px : 10px; alignment: start;
                    GridLayout {
                        spacing: 6px;
                        name-label := Text {
                            row: 0; col: 0; colspan: root.name-row == 1 ? 2 : 1;
                            text: root.compact-query ? "Query" : mode.current-index == 2 ? "Expression" : "File name";
                            color: Theme.strong-text; font-size: Theme.font-size; font-weight: 600;
                            vertical-alignment: center; min-width: 0px; wrap: root.compact-query ? no-wrap : word-wrap;
                        }
                        HorizontalLayout {
                            row: root.name-row; col: root.name-row == 1 ? 0 : 1; colspan: root.name-row == 1 ? 2 : 1;
                            spacing: 4px;
                            masks := HistoryLineEdit {
                                text <=> root.filename-mask;
                                entries: root.mask-history;
                                enabled: !root.running; accessible-name: "File name masks";
                                min-width: root.compact-query ? Theme.font-size * 4 : 0px;
                                horizontal-stretch: 1; height: root.query-height;
                                hint: mode.current-index == 2 ? "Typed metadata predicate, never a script. Example: kind = file and size >= 1MiB. Unknown metadata does not match comparisons."
                                    : mode.current-index == 1 ? "Bounded regular expression over the native filename."
                                    : "* any text, ? one character, ; separates masks, | exclusions. Example: *.rs;*.toml|target*. *.* includes extensionless names. Down opens recent masks.";
                                edited(text) => { root.filename-mask-edited = true; }
                                chosen(index) => {
                                    root.filename-mask-edited = true;
                                    root.filename-mask = root.mask-history[index];
                                }
                                accepted => { root.submit(); }
                            }
                            // The field's list button: a drawn chevron, which every font
                            // shows, square at the query's height.
                            FieldButton {
                                text: "Filename mask history"; fallback-icon: FallbackIcons.chevron-down;
                                accessible-label: "Filename mask history";
                                width: root.query-height; height: root.query-height;
                                hint: "Choose a previously used filename mask (Down in the filename field).";
                                enabled: !root.running && root.mask-history.length > 0;
                                clicked => { masks.open-list(); }
                            }
                        }
                        HorizontalLayout {
                            row: root.narrow ? root.name-row + 1 : 0; col: root.narrow ? 0 : 2;
                            spacing: 6px;
                            mode := HintedComboBox {
                                model: ["Masks", "Regex", "Expression"]; enabled: !root.running;
                                accessible-label: "Find match mode"; min-width: 0px;
                                height: root.query-height;
                                preferred-width: max(120px, Theme.font-size * 9);
                                horizontal-stretch: 1;
                            }
                            FindActionButton {
                                row-height: root.query-height;
                                text: "Help"; fallback-icon: FallbackIcons.help;
                                hint: "Syntax help with examples for the chosen mode (F1). Click an example to use it.";
                                clicked => { root.show-help = !root.show-help; }
                            }
                        }
                        names := WrappingCheckBox {
                            row: root.narrow ? root.name-row + 1 : 1; col: 1; colspan: root.narrow ? 1 : 2;
                            text: "Match name case"; enabled: !root.running;
                        }
                        // Labels and buttons stay on the picker's line while the Add entry is open.
                        VerticalLayout {
                            row: root.narrow ? root.name-row + 2 : 2; col: 0; colspan: root.narrow ? 2 : 1;
                            alignment: start;
                            Text {
                                // On the folders picker's centre: as tall as the query's controls.
                                min-height: root.narrow ? folders-label-measure.preferred-height : root.query-height;
                                text: root.folders-label;
                                color: Theme.strong-text; font-size: Theme.font-size; font-weight: 600;
                                vertical-alignment: center; min-width: 0px; wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            row: root.narrow ? root.name-row + 3 : 2; col: root.narrow ? 0 : 1;
                            spacing: 6px; alignment: start; horizontal-stretch: 1;
                            roots := FindRootsPicker {
                                roots: root.roots; current-index: root.current-root;
                                enabled: !root.running;
                                accessible-name: "Search folders";
                                height: root.query-height;
                                hint: "Folders this Find can search. Ticked folders are searched; click a name to choose it for Remove.";
                                selected(index) => { root.selected-root = index; }
                                toggled(index, searched) => { root.toggle-root(index, searched); }
                            }
                            // Narrow windows give the path its own line, Browse and OK under it.
                            if root.adding: GridLayout {
                                spacing: 6px;
                                HintedLineEdit {
                                    row: 0; col: 0; colspan: root.narrow ? 3 : 1;
                                    enabled: !root.running; horizontal-stretch: 1; min-width: 0px;
                                    height: root.query-height;
                                    accessible-label: "Folder to add";
                                    placeholder-text: "Absolute folder path";
                                    hint: "Type an absolute folder path and press Enter, or choose one with Browse.";
                                    init => { self.focus(); }
                                    edited(text) => { root.new-root-text = text; }
                                    accepted(text) => { if text != "" { root.add-root(text); } }
                                }
                                Rectangle { row: root.narrow ? 1 : 0; col: 0; horizontal-stretch: 1; }
                                FindActionButton {
                                row-height: root.query-height;
                                    row: root.narrow ? 1 : 0; col: 1; horizontal-stretch: 0;
                                    text: "Browse…"; fallback-icon: FallbackIcons.open-path;
                                    enabled: !root.running;
                                    hint: "Choose a folder with the system folder chooser.";
                                    clicked => { root.browse-root(); }
                                }
                                FindActionButton {
                                row-height: root.query-height;
                                    row: root.narrow ? 1 : 0; col: 2; horizontal-stretch: 0;
                                    text: "OK"; enabled: !root.running && root.new-root-text != "";
                                    hint: "Add the typed folder to Search folders.";
                                    clicked => { root.add-root(root.new-root-text); }
                                }
                            }
                        }
                        VerticalLayout {
                            row: root.narrow ? root.name-row + 3 : 2; col: root.narrow ? 1 : 2;
                            alignment: start;
                            // Narrow windows stack Add over Remove to keep the grid inside the window.
                            GridLayout {
                                spacing: 6px;
                                FindActionButton {
                                row-height: root.query-height;
                                    row: 0; col: 0;
                                    text: "Add"; fallback-icon: FallbackIcons.tab-add;
                                    enabled: !root.running;
                                    hint: "Add another folder: type its path or browse for it. Existing folders keep their original native path, including names that cannot be typed.";
                                    clicked => { if root.adding { root.adding = false; } else { root.start-adding(); } }
                                }
                                FindActionButton {
                                row-height: root.query-height;
                                    row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
                                    text: "Remove"; fallback-icon: FallbackIcons.close;
                                    enabled: !root.running && root.roots.length > 0;
                                    hint: "Remove the chosen folder from this Find.";
                                    clicked => { root.remove-root(root.current-root); }
                                }
                            }
                        }
                        recursive := WrappingCheckBox {
                            row: root.narrow ? root.name-row + 4 : 3; col: root.narrow ? 0 : 1; colspan: 2;
                            text: "Subfolders"; checked: true; enabled: !root.running;
                            hint: "Recurse into ordinary folders. Links, junctions and mount boundaries are excluded and counted.";
                        }
                        content-enabled := WrappingCheckBox {
                            row: root.narrow ? root.name-row + 5 : 4; col: 0; colspan: root.narrow ? 2 : 1;
                            text: "Containing text"; enabled: !root.running;
                            hint: "Search text, or a regular expression, in UTF-8 or BOM-marked UTF-16 files. Unsupported encodings are reported, not silently skipped.";
                        }
                        // Top-aligned: the option boxes beside it take two lines.
                        VerticalLayout {
                            row: root.narrow ? root.name-row + 6 : 4; col: root.narrow ? 0 : 1; colspan: root.narrow ? 2 : 1;
                            alignment: start; horizontal-stretch: 1;
                            content := HintedLineEdit {
                                enabled: !root.running && content-enabled.checked;
                                min-width: 0px; min-height: Theme.control-height; horizontal-stretch: 1;
                                accessible-label: "Text to find";
                                hint: content-regex.checked
                                    ? "Regular expression, matched within each line on a backend worker. Example: TODO|FIXME, or ^fn \\w+. An invalid pattern is explained in the details."
                                    : "Literal text, read incrementally on a backend worker.";
                                accepted => { root.submit(); }
                            }
                        }
                        GridLayout {
                            row: root.narrow ? root.name-row + 7 : 4; col: root.narrow ? 0 : 2; colspan: root.narrow ? 2 : 1;
                            spacing: 6px;
                            content-case := WrappingCheckBox {
                                row: 0; col: 0;
                                text: "Match case"; enabled: !root.running && content-enabled.checked;
                            }
                            WrappingCheckBox {
                                row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
                                text: "Whole words"; checked <=> advanced.whole-words;
                                enabled: !root.running && content-enabled.checked;
                                hint: "Match the containing text only at word boundaries.";
                            }
                            content-regex := WrappingCheckBox {
                                row: root.narrow ? 2 : 1; col: 0; colspan: root.narrow ? 1 : 2;
                                text: "Regular expression";
                                enabled: !root.running && content-enabled.checked;
                                hint: "Treat the containing text as a bounded regular expression, matched within each line (lines longer than 1 MiB are matched in overlapping windows). Match case and Whole words still apply.";
                            }
                        }
                    }
                    GridLayout {
                        spacing: 8px;
                        FindActionButton {
                                row-height: root.query-height;
                            row: 0; col: 0;
                            text: root.show-advanced ? "Fewer options" : "More options";
                            fallback-icon: FallbackIcons.options;
                            clicked => { root.show-advanced = !root.show-advanced; }
                        }
                        Text {
                            row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1; colspan: root.narrow ? 3 : 1;
                            visible: !root.show-advanced && advanced.summary != "";
                            text: advanced.summary;
                            color: advanced.valid ? Theme.secondary-text : Theme.error-text;
                            font-size: Theme.small-font; wrap: word-wrap; min-width: 0px;
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                        // A results action, kept out of the full footer: right above the list.
                        FindActionButton {
                                row-height: root.query-height;
                            row: 0; col: 2;
                            text: "Feed to panel"; fallback-icon: FallbackIcons.make-file-list;
                            enabled: !root.running && !root.feeding && root.rows.length > 0;
                            hint: "Show the results as a list in the panel that opened this Find, and close this window. Selected results arrive marked there. View, Edit, Copy, Move, Delete and selection there act on the real files; Backspace returns to the folder.";
                            clicked => { root.feed-panel(); }
                        }
                    }
                    advanced := FindAdvanced {
                        visible: root.show-advanced;
                        height: root.show-advanced ? self.preferred-height : 0px;
                        enabled: !root.running; narrow: root.narrow;
                        content-enabled: content-enabled.checked;
                        submit => { root.submit(); }
                    }
                    if root.error != "": FindStatusLine {
                        text: root.error; error: true; wrap: true;
                        max-height: Theme.font-size * 4.5;
                        details => { root.show-details = true; }
                    }
                }
              }
              // Short windows with large text have no status line under the results.
              if root.query-status: FindStatusLine {
                  x: 0px; y: parent.height - self.height; width: parent.width;
                  height: root.query-status-height - 3px;
                  text: root.progress; count: root.found-count; error: root.attention; font-size: Theme.small-font;
                  details => { root.show-details = true; }
              }
              if root.show-details: ScrollView {
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding-right: FluentScrollMetrics.overlay-size; spacing: 6px; alignment: start;
                    if root.error != "": ErrorNotice { text: root.error; }
                    if root.height < 360px && root.current-directory != "": Text {
                        text: root.current-directory; color: Theme.secondary-text; wrap: char-wrap;
                    }
                    if root.height < 360px && root.progress != "": Text {
                        text: root.progress; color: Theme.secondary-text; wrap: word-wrap;
                    }
                    Text { text: root.details; color: Theme.secondary-text; wrap: word-wrap; }
                }
              }
            }
            Rectangle {
                vertical-stretch: 1; min-height: root.rows.length == 0 ? Theme.font-size + 6px : 20px; clip: true;
                background: Theme.pane-background; border-color: Theme.frame; border-width: 1px;
                results := FindResults {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    rows: root.rows; selected-row <=> root.selected-row;
                    marks: root.marks; selected-count: root.selected-count;
                    generation: root.generation;
                    surface-width: root.width; surface-height: root.height;
                    view-keys: root.view-keys; edit-keys: root.edit-keys;
                    duplicates: root.duplicate-results;
                    show-header: root.rows.length > 0
                        || self.height >= Theme.column-height + Theme.font-size + 8px;
                    sort-column: root.sort-column; descending: root.sort-descending;
                    sort(column) => { root.sort(column); }
                    reveal(token) => { root.reveal(token); }
                    action-key(event) => {
                        if root.selected-row >= 0 && root.selected-row < root.rows.length {
                            return root.action-key(event, root.rows[root.selected-row].token);
                        }
                        false
                    }
                    select-row(row, toggle, range) => { root.select-row(row, toggle, range); }
                    move-cursor(row, extend, keep) => { root.move-cursor(row, extend, keep); }
                    toggle-mark(advance) => { root.toggle-mark(advance); }
                    select-all => { root.select-all(); }
                    deselect-all => { root.deselect-all(); }
                    menu-row(row) => { root.menu-row(row); }
                    copy-results(token, kind) => { root.copy-results(token, kind); }
                    file-action(token, action) => { root.file-action(token, action); }
                }
                // The results show that they have the keyboard, with a text field's
                // focus frame drawn over their edge.
                Rectangle {
                    border-width: results.has-focus ? 2px : 0px;
                    border-color: Theme.active-frame;
                }
                if root.rows.length == 0: Text {
                    x: 1px; y: results.header-height + 1px;
                    width: max(0px, parent.width - 2px);
                    height: max(0px, parent.height - self.y - 1px);
                    visible: self.height >= Theme.font-size + 4px;
                    text: root.running ? "Searching…" : "No results"; color: Theme.muted-text;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                if root.show-help: FindSyntaxHelp {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    mode: mode.current-index; enabled: !root.running;
                    init => { self.focus(); }
                    use-example(query) => { root.filename-mask-edited = true; masks.text = query; masks.focus-line(); }
                    close => { root.close-help(); }
                }
            }
            if root.current-directory != "" && root.inline-status: PathText {
                text: root.current-directory; foreground: Theme.secondary-text;
                font-size: Theme.small-font; height: max(18px, Theme.small-font + 4px);
            }
            if root.progress != "" && root.inline-status: FindStatusLine {
                // As tall as its line of text at the font (a large font's line is taller
                // than the font size and 4 px).
                height: max(18px, Theme.small-font + 4px, status-probe.preferred-height);
                text: root.progress; count: root.found-count; error: root.attention; font-size: Theme.small-font;
                details => { root.show-details = true; }
            }
            find-footer := DialogFooter {
                compact-height: root.height < 350px;
                compact-controls: true;
                dismiss-text: "Close";
                dismiss-hint: "Close this Find window and cancel its search (Escape).";
                dismiss => { root.close-session(); }
                // The query's actions, or the details' (details open from the error or
                // status line; Back returns to the query). Actions that do not fit whole
                // beside Close move into More…, by their `drop` rank: Copy details, Open,
                // Edit, View, then Go to file; on the details page Copy, then Find or Stop.
                footer-actions: [
                    { text: root.running ? "Stop" : "Find", hint: "", shortcut: "", hidden: false,
                        fallback-icon: root.running ? FallbackIcons.close : FallbackIcons.find,
                        enabled: !root.stopping && (root.running || advanced.valid), primary: !root.running,
                        drop: root.show-details ? 2 : 0 },
                    { text: "Go to file", fallback-icon: FallbackIcons.open-path, shortcut: "Enter", primary: false, drop: 5,
                        hint: "Show the result under the cursor in the panel that opened this Find (Enter).",
                        enabled: root.selected-row >= 0 && root.selected-row < root.rows.length, hidden: root.show-details },
                    { text: "View", fallback-icon: FallbackIcons.view, hint: root.view-hint, shortcut: root.view-keys,
                        enabled: root.selected-file, primary: false, drop: 4, hidden: root.show-details },
                    { text: "Edit", fallback-icon: FallbackIcons.edit, hint: root.edit-hint, shortcut: root.edit-keys,
                        enabled: root.selected-file, primary: false, drop: 3, hidden: root.show-details },
                    { text: "Open", fallback-icon: FallbackIcons.run, shortcut: "", enabled: root.selected-native, primary: false, drop: 2,
                        hint: "Open the selected file with its system association. This may run a program. Folders and archive members use Go to file.",
                        hidden: root.show-details },
                    { text: "Copy details", fallback-icon: FallbackIcons.copy, shortcut: "", enabled: true, primary: false, drop: 1,
                        hint: "Copy the search's progress, errors and counts to the clipboard.", hidden: root.show-details },
                    { text: "Copy", fallback-icon: FallbackIcons.copy, shortcut: "", enabled: true, primary: false, drop: 1,
                        hint: "Copy the details, including full paths, to the clipboard.", hidden: !root.show-details },
                    // Each glyph once: Slint 1.18 moves a global read twice in one literal
                    // where one read is a branch of a condition (Find or Stop above).
                    { text: "Back", fallback-icon: FallbackIcons.back, hint: "Return to the query.", shortcut: "",
                        enabled: true, primary: false, drop: 0, hidden: !root.show-details },
                ];
                footer-action(index) => { root.footer-chosen(index); }
            }
        }
    }
}
