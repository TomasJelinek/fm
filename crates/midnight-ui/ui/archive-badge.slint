import { Theme } from "theme.slint";

// Muted corner chevron: discoverable without covering the associated artwork.
export component ArchiveBadge inherits Rectangle {
    // No opaque tile: selection and the host icon remain visible underneath.
    background: transparent;
    accessible-role: none;
    Path {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        viewbox-width: 12; viewbox-height: 12;
        commands: "M 4 2 L 8 6 L 4 10";
        stroke: Theme.secondary-text; stroke-width: 1.25px;
    }
}
