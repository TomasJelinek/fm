import { Theme } from "theme.slint";

// Original compact zipper: a conventional archive cue, without a filled badge.
export component ArchiveBadge inherits Rectangle {
    // No opaque tile: selection and the host icon remain visible underneath.
    background: transparent;
    accessible-role: none;
    private property <string> zipper: "M 2 1 L 4 1 M 4 3 L 6 3 M 2 5 L 4 5 M 4 7 L 6 7 M 2.5 9 L 5.5 9 L 5.5 12 L 2.5 12 Z";
    // A narrow contour keeps the teeth readable over arbitrary system artwork.
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 8; viewbox-height: 14;
        commands: root.zipper;
        stroke: Theme.pane-background; stroke-width: 2.5px;
    }
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 8; viewbox-height: 14;
        commands: root.zipper;
        stroke: Theme.secondary-text; stroke-width: 1px;
    }
}
