import { Theme } from "theme.slint";
import { PathText } from "path-text.slint";
import { DialogText } from "dialog-text.slint";
import { ErrorGlyph } from "error-notice.slint";
import { JobIssue } from "jobs-dialog.slint";

// One error of a job. Collapsed, it shows its reason and its path shortened in the
// middle; a click, Return or Space shows the whole path and message in place.
component JobIssueRow inherits Rectangle {
    in property <JobIssue> issue;
    in property <bool> expanded;
    callback toggle();
    border-radius: 3px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.active-frame;
    background: area.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.issue.title;
    accessible-description: root.expanded ? "Hide this error's path and message."
        : "Show this error's path and message.";
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.toggle(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == Key.Return || event.text == Key.Space) {
                root.toggle(); return accept;
            }
            reject
        }
        area := TouchArea { clicked => { focus.focus(); root.toggle(); } }
    }
    // The texts take no input: a click anywhere on the row reaches the area below.
    VerticalLayout {
        padding: 4px; padding-left: 6px; spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.expanded ? "−" : "+"; width: Theme.font-size;
                color: Theme.error-text; font-size: Theme.font-size;
                horizontal-alignment: center; accessible-role: none;
            }
            Text {
                text: root.issue.title; color: Theme.error-text; font-size: Theme.font-size;
                horizontal-stretch: 1; min-width: 0px; accessible-role: none;
                wrap: root.expanded ? TextWrap.word-wrap : TextWrap.no-wrap; overflow: elide;
            }
        }
        if !root.expanded && root.issue.path != "" : PathText {
            text: root.issue.path; tail: root.issue.path-tail;
            foreground: Theme.secondary-text; font-size: Theme.small-font;
        }
        if root.expanded : VerticalLayout {
            padding-left: Theme.font-size + 6px; spacing: 4px;
            if root.issue.path != "" : Text {
                text: "Path"; color: Theme.secondary-text; font-size: Theme.small-font;
            }
            if root.issue.path != "" : Text {
                text: root.issue.path; color: Theme.text; font-size: Theme.font-size;
                wrap: char-wrap; min-width: 0px;
            }
            Text {
                text: root.issue.detail; color: Theme.text; font-size: Theme.font-size;
                wrap: word-wrap; min-width: 0px;
            }
        }
    }
}

// The errors a job reported: a count that opens the first error, then one row per
// error. One row is open at a time, kept by its place in the list, so a progress
// update that rebuilds the list keeps it open.
export component JobIssueList inherits VerticalLayout {
    in property <[JobIssue]> issues;
    in property <string> summary;
    in-out property <int> expanded: -1;
    function toggle(index: int) {
        if index < root.issues.length {
            root.expanded = root.expanded == index ? -1 : index;
        }
    }
    spacing: 2px; alignment: start;
    Rectangle {
        border-radius: 3px;
        border-width: summary-focus.has-focus ? 1px : 0px;
        border-color: Theme.active-frame;
        background: summary-area.has-hover && root.issues.length > 0 ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: root.summary;
        accessible-description: root.expanded == 0 ? "Hide the first error's path and message."
            : "Show the first error's path and message.";
        accessible-enabled: root.issues.length > 0;
        accessible-action-default => { root.toggle(0); }
        forward-focus: summary-focus;
        summary-focus := FocusScope {
            enabled: root.issues.length > 0;
            key-pressed(event) => {
                if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                    && (event.text == Key.Return || event.text == Key.Space) {
                    root.toggle(0); return accept;
                }
                reject
            }
            summary-area := TouchArea {
                enabled: root.issues.length > 0;
                clicked => { summary-focus.focus(); root.toggle(0); }
            }
        }
        HorizontalLayout {
            padding: 4px; spacing: 8px;
            ErrorGlyph { width: Theme.font-size + 4px; height: self.width; }
            Text {
                text: root.summary; color: Theme.error-text; font-size: Theme.font-size;
                font-weight: 600; wrap: word-wrap; vertical-alignment: center;
                horizontal-stretch: 1; min-width: 0px; accessible-role: none;
            }
        }
    }
    for issue[index] in root.issues : JobIssueRow {
        issue: issue;
        expanded: index == root.expanded;
        toggle => { root.toggle(index); }
    }
}

// A job's full details (counters, source, destination, diagnostics and every
// informational note) in a box of their own that scrolls.
export component JobDetails inherits Rectangle {
    in property <string> text;
    background: Theme.secondary-surface; border-color: Theme.frame;
    border-width: 1px; border-radius: 3px;
    accessible-role: groupbox; accessible-label: "Details";
    VerticalLayout {
        padding: 8px;
        DialogText { text: root.text; vertical-stretch: 1; min-height: 0px; }
    }
}
