import { Button, ScrollView } from "std-widgets.slint";
import { HintedCheckBox, HintedLineEdit } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogHeader } from "dialog-frame.slint";

export struct PanelFilterView {
    open: bool, pane: int, enabled: bool, regex: bool,
    expression: string, case-sensitive: bool, busy: bool, error: string,
}

export component PanelFilterDialog inherits Rectangle {
    in property <PanelFilterView> model;
    callback apply(bool, bool, string, bool);
    callback cancel();
    callback move-dialog(length, length);
    changed width => { if root.width < 400px { cancel-button.focus(); } }
    changed height => { if root.height < 350px { cancel-button.focus(); } }
    public function begin() {
        enabled.checked = root.model.enabled;
        regex.checked = root.model.regex;
        expression.text = root.model.expression;
        names.checked = root.model.case-sensitive;
        expression.focus();
    }
    background: Theme.surface; border-radius: 8px;
    border-width: 1px; border-color: Theme.active-frame;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: root.height < 280px ? 8px : 20px; spacing: root.height < 280px ? 4px : 12px;
            DialogHeader { title: "Panel file filter"; compact: root.height < 280px;
                dragged(dx, dy) => { root.move-dialog(dx, dy); } }
            ScrollView {
                min-height: 0px; vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 12px; alignment: start;
                    enabled := HintedCheckBox {
                        text: "Enable persistent file filter"; enabled: !root.model.busy; min-height: Theme.control-height;
                        hint: "Save an independent filter for this panel. It follows the panel across folders and combines with quick search.";
                    }
                    regex := HintedCheckBox {
                        text: "Use regular expression"; enabled: !root.model.busy; min-height: Theme.control-height;
                        hint: "Rust regular expression syntax. A match anywhere in the filename is included; use ^ and $ for a whole name.";
                    }
                    expression := HintedLineEdit {
                        enabled: !root.model.busy; accessible-label: "File filter expression"; min-height: Theme.control-height;
                        hint: "Masks: * matches any text, ? one character, ; separates masks, | starts exclusions, ;; means a literal semicolon. Example: *.txt;*.md|secret*. *.* includes extensionless files. Maximum 4096 UTF-8 bytes.";
                    }
                    names := HintedCheckBox {
                        text: "Case sensitive"; enabled: !root.model.busy; min-height: Theme.control-height;
                        hint: "Compare Unicode letters with exact case. Native filenames are never changed.";
                    }
                    Text { text: "Directories remain visible."; color: Theme.text; font-size: Theme.font-size; wrap: word-wrap; }
                    if root.model.busy: Text { text: "Validating filter…"; color: Theme.text; font-size: Theme.font-size; wrap: word-wrap; }
                    if root.model.error != "": ErrorNotice { text: root.model.error; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Button { text: "Apply"; enabled: !root.model.busy; min-height: Theme.control-height;
                    clicked => { root.apply(enabled.checked, regex.checked, expression.text, names.checked); } }
                cancel-button := Button { text: "Cancel"; min-height: Theme.control-height; clicked => { root.cancel(); } }
            }
        }
    }
}
