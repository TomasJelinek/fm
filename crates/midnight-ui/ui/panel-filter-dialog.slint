import { WrappingCheckBox } from "wrapping-check-box.slint";
import { ScrollView } from "std-widgets.slint";
import { HintedActionButton, HintedComboBox, HintedLineEdit } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { FallbackIcons } from "action-icons.slint";

export struct PanelFilterView {
    open: bool, pane: int, enabled: bool, mode: int,
    expression: string, case-sensitive: bool, busy: bool, error: string,
}

export component PanelFilterDialog inherits Rectangle {
    in property <PanelFilterView> model;
    callback apply(bool, int, string, bool);
    callback cancel();
    callback clear();
    callback help();
    callback move-dialog(length, length);
    changed width => { if root.width < 400px { footer.focus-dismiss(); } }
    changed height => { if root.height < 280px { footer.focus-dismiss(); } }
    public function begin() {
        mode.current-index = root.model.mode;
        expression.text = root.model.expression;
        names.checked = root.model.case-sensitive;
        if root.width < 400px || root.height < 280px { footer.focus-dismiss(); }
        else { expression.focus(); }
    }
    background: Theme.surface; border-radius: 8px;
    border-width: 1px; border-color: Theme.active-frame;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.F1 { root.help(); return accept; }
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: root.height < 280px ? 8px : 16px; spacing: root.height < 280px ? 4px : 8px;
            DialogHeader { title: "Panel filter"; fallback-icon: FallbackIcons.filter; compact: root.height < 280px;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); } }
            ScrollView {
                min-height: 0px; vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 8px; alignment: start;
                    mode := HintedComboBox {
                        model: ["Masks", "Regex", "Expression"]; enabled: !root.model.busy; min-height: Theme.control-height;
                        accessible-label: "Filter mode";
                        hint: "Masks and Regex match names and keep folders visible. Expression tests captured metadata and can also filter folders.";
                    }
                    expression := HintedLineEdit {
                        enabled: !root.model.busy; accessible-label: "File filter expression"; min-height: Theme.control-height;
                        preferred-height: Theme.control-height; vertical-stretch: 0;
                        placeholder-text: mode.current-index == 2 ? "kind = file and size >= 10MiB"
                            : mode.current-index == 1 ? "\\.(txt|md)$" : "*.txt;*.md";
                        accepted => { root.apply(true, mode.current-index, expression.text, names.checked); }
                        hint: mode.current-index == 2 ? "Typed expression, for example kind = file and size >= 10MiB. Maximum 4096 UTF-8 bytes. No scripts or file-content reads."
                            : mode.current-index == 1 ? "Rust regular expression syntax. A match anywhere in the filename is included; use ^ and $ for a whole name. Maximum 4096 UTF-8 bytes."
                            : "Masks: * matches any text, ? one character, ; separates masks, | starts exclusions, ;; means a literal semicolon. Example: *.txt;*.md|secret*. *.* includes extensionless files. Maximum 4096 UTF-8 bytes.";
                    }
                    names := WrappingCheckBox {
                        text: "Case sensitive"; enabled: !root.model.busy; min-height: Theme.control-height;
                        hint: "Compare Unicode letters with exact case. Native filenames are never changed.";
                    }
                    if root.model.busy: Text { text: "Validating filter…"; color: Theme.text; font-size: Theme.font-size; wrap: word-wrap; }
                    if root.model.error != "": ErrorNotice { text: root.model.error; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                HintedActionButton {
                    text: "Help"; fallback-icon: FallbackIcons.help;
                    hint: "Examples and supported filter syntax (F1).";
                    min-height: Theme.control-height; horizontal-stretch: 0;
                    clicked => { root.help(); }
                }
                footer := DialogFooter {
                    compact-height: root.height < 280px;
                    dismiss => { root.cancel(); }
                    if root.model.enabled : HintedActionButton {
                        text: "Show all"; min-height: Theme.control-height;
                        hint: "Remove this panel's applied filter.";
                        clicked => { root.clear(); }
                    }
                    HintedActionButton {
                        text: "OK"; primary: true; enabled: !root.model.busy;
                        min-width: 72px; min-height: Theme.control-height;
                        hint: "Apply the filter to this panel.";
                        clicked => { root.apply(true, mode.current-index, expression.text, names.checked); }
                    }
                }
            }
        }
    }
}
