import { Theme } from "theme.slint";
import { FunctionButton } from "function-button.slint";
import { FunctionSlot } from "function-models.slint";
import { ShortcutHints } from "shortcut-hints.slint";
import { ActionIcons, FallbackIcons } from "action-icons.slint";
import { ScrollView } from "std-widgets.slint";
import { ActionAvailability } from "action-availability.slint";

export component FunctionBar inherits Rectangle {
    private property <image> no-native-icon;
    in property <ActionIcons> icons;
    in property <bool> control-layer;
    in property <bool> network-available;
    in property <bool> native-filesystem: true;
    in property <bool> can-measure-folders: root.native-filesystem;
    in property <bool> searching;
    in property <int> pane;
    in property <bool> compact;
    in property <bool> can-target-cursor;
    in property <bool> can-target-selection;
    callback action(string, int);
    callback jobs();
    private property <[string]> normal-actions: ["app.help", "files.rename", "files.view", "files.edit", "files.copy-to", "files.move-to", "files.create-directory", "files.trash", "app.user-menu", "app.main-menu", "network.connect", "network.disconnect"];
    private property <[string]> pressed-actions;
    private property <int> pressed-pane;
    private property <bool> pointer-snapshot;
    private property <bool> press-cancelled;
    pure function enabled-action(action: string) -> bool {
        return ActionAvailability.enabled(action, root.native-filesystem, root.can-target-cursor,
            root.can-target-selection, root.network-available, root.can-measure-folders);
    }
    pure function capture-action(index: int) -> string {
        let action = root.control-layer ? ShortcutHints.control(index, root.searching).action : root.normal-actions[index];
        return root.enabled-action(action) ? action : "";
    }
    public function capture-press(x: length, y: length) {
        root.press-cancelled = false;
        root.pointer-snapshot = x >= root.absolute-position.x && x < root.absolute-position.x + keys.width
            && y >= root.absolute-position.y && y < root.absolute-position.y + root.height;
        if root.pointer-snapshot {
            // Snapshot values now, before Flickable forwards a delayed pointer-down.
            root.pressed-pane = root.pane;
            root.pressed-actions = [root.capture-action(0), root.capture-action(1), root.capture-action(2),
                root.capture-action(3), root.capture-action(4), root.capture-action(5), root.capture-action(6),
                root.capture-action(7), root.capture-action(8), root.capture-action(9), root.capture-action(10), root.capture-action(11)];
        }
    }
    public function release-press() { root.pointer-snapshot = false; }
    public function cancel-press() { root.press-cancelled = true; }
    private property <length> cell-width: max(root.compact ? 36px : 0px, (root.width - 48px) / 13);
    private property <length> key-width: max(Theme.touch ? 44px : 40px, root.cell-width);
    height: root.compact ? min(32px, Theme.bottom-height) : Theme.bottom-height;
    min-width: 0px;
    keys := ScrollView {
        x: 0px; y: 0px;
        width: max(0px, root.width - root.cell-width - 4px); height: root.height;
        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;
        content-width: max(self.visible-width, 12 * root.key-width + 44px);
        content-height: self.visible-height;
        Rectangle {
            width: keys.content-width; height: keys.visible-height;
            for label[index] in ["Help", "Rename", "View", "Edit", "Copy", "Move", "Create dir", "Delete", "User menu", "Menu", "Connect", "Disconnect"] : FunctionButton {
                // Modifier changes must not move the pressed cell before pointer-up.
                preferred-width: self.min-width;
                min-width: 0px; width: root.key-width; height: root.height;
                x: index * (root.key-width + 4px);
                private property <string> normal-action: root.normal-actions[index];
                private property <FunctionSlot> control: ShortcutHints.control(index, root.searching);
                private property <int> icon-role: root.control-layer ? self.control.icon : index;
                action-id: root.control-layer ? self.control.action : self.normal-action;
                pane: root.pane;
                pointer-snapshot: root.pointer-snapshot;
                press-cancelled: root.press-cancelled;
                snapshot-action: root.pressed-actions[index]; snapshot-pane: root.pressed-pane;
                native-icon: self.icon-role == 0 ? root.icons.help : self.icon-role == 1 ? root.icons.rename
                    : self.icon-role == 2 ? root.icons.view : self.icon-role == 3 ? root.icons.edit
                    : self.icon-role == 4 ? root.icons.copy : self.icon-role == 5 ? root.icons.move-item
                    : self.icon-role == 6 ? root.icons.new-folder : self.icon-role == 7 ? root.icons.delete
                    : self.icon-role == 8 ? root.icons.user-menu : self.icon-role == 10 || self.icon-role == 11 ? root.icons.network
                    : self.icon-role == 12 || self.icon-role == 15 ? root.no-native-icon : self.icon-role == 13 ? root.icons.sort-ascending
                    : self.icon-role == 14 ? root.icons.refresh : root.icons.menu;
                fallback-icon: self.icon-role == 0 ? FallbackIcons.help : self.icon-role == 1 ? FallbackIcons.rename
                    : self.icon-role == 2 ? FallbackIcons.view : self.icon-role == 3 ? FallbackIcons.edit
                    : self.icon-role == 4 ? FallbackIcons.copy : self.icon-role == 5 ? FallbackIcons.move-item
                    : self.icon-role == 6 ? FallbackIcons.new-folder : self.icon-role == 7 ? FallbackIcons.delete
                    : self.icon-role == 8 ? FallbackIcons.user-menu : self.icon-role == 10 || self.icon-role == 11 ? FallbackIcons.network
                    : self.icon-role == 12 ? FallbackIcons.attributes : self.icon-role == 13 ? FallbackIcons.sort-ascending
                    : self.icon-role == 14 ? FallbackIcons.refresh : self.icon-role == 15 ? FallbackIcons.checksums : FallbackIcons.menu;
                text: root.control-layer ? (self.control.action == "" ? "Ctrl+F" + (index + 1) : self.control.key + " " + self.control.label)
                    : ShortcutHints.caption(label, self.normal-action);
                caption: root.control-layer && self.control.action != "" ? "F" + (index + 1) + " " + self.control.label : self.text;
                // The held Ctrl layer supplies the modifier; keep F1…F12 readable in compact cells.
                compact-text: root.control-layer ? "F" + (index + 1)
                    : ShortcutHints.key(self.normal-action) == "" ? label : ShortcutHints.key(self.normal-action);
                enabled: root.enabled-action(self.action-id);
                hint: root.control-layer ? (self.control.action == "" ? "Ctrl+F" + (index + 1) + " is unassigned. Configure it in Options → Keyboard." : self.control.hint)
                    : ShortcutHints.hint(label, self.normal-action) + (index == 0 ? " · current keyboard shortcuts and usage help" : index == 1 ? " · rename the focused entry" : index == 2 ? " · open the focused file in an installed viewer" : index == 3 ? " · edit the focused file in your external editor" : index == 4 ? " · copy selection with checksum verification in the background" : index == 5 ? " · move up to 64 files; verify each destination before removing its source" : index == 6 ? " · create a folder or nested path" : index == 7 ? " · move selection to Trash; " + ShortcutHints.hint("permanent deletion requires confirmation", "files.delete") : index == 8 ? " · commands, properties and folder sizes" : index == 9 ? " · options, refresh, help and exit" : " · system network drive dialog");
                activated(action, pane) => { root.action(action, pane); }
            }
        }
    }
    FunctionButton {
        min-width: 0px; width: root.cell-width; height: root.height;
        x: root.width - root.cell-width;
        press-cancelled: root.press-cancelled;
        native-icon: root.icons.menu; fallback-icon: FallbackIcons.menu; text: "Jobs";
        hint: "Operation queue, progress and cancellation.";
        clicked => { root.jobs(); }
    }
}
