import { Theme } from "theme.slint";
import { Tip } from "controls.slint";
import { PathText } from "path-text.slint";
import { MenuCheck } from "checksum-controls.slint";
import { ListView } from "scroll-view.slint";
import { PopupList } from "popup-list.slint";

// One listed search folder: `label` is display text only; the host keeps the native path.
export struct FindRootRow { label: string, searched: bool }

// Search folders. Each row has a checkbox (search this folder) and a name
// (choose it, e.g. for Remove). Ticking keeps the list open so several folders
// can be toggled in one visit.
export component FindRootsPicker inherits Rectangle {
    in property <[FindRootRow]> roots;
    in property <int> current-index: -1;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <string> accessible-name;
    callback selected(int);
    callback toggled(int, bool);
    private property <int> pending: 0;
    private property <length> row-height: Theme.control-height;
    out property <bool> popup-open;
    changed enabled => { if !root.enabled && root.popup-open { root.close(); } }
    public function open() {
        if !root.enabled || root.roots.length == 0 { return; }
        root.pending = max(0, min(root.current-index, root.roots.length - 1));
        root.popup-open = true;
        popup.show();
    }
    function close() {
        popup.close();
        root.popup-open = false;
        focus.focus();
    }
    function toggle(index: int) {
        if root.enabled && index >= 0 && index < root.roots.length {
            root.toggled(index, !root.roots[index].searched);
        }
    }
    function choose(index: int) {
        root.close();
        if root.enabled && index >= 0 && index < root.roots.length { root.selected(index); }
    }
    min-width: 0px;
    height: Theme.control-height;
    border-width: 1px; border-radius: 4px;
    border-color: focus.has-focus ? Theme.active-frame : Theme.frame;
    background: area.has-hover && root.enabled ? Theme.hover : Theme.surface;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.roots.length
        ? root.roots[root.current-index].label : "";
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-open;
    accessible-action-expand => { root.open(); }
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 6px;
        cross-axis-alignment: center;
        if root.current-index >= 0 && root.current-index < root.roots.length: MenuCheck {
            checked: root.roots[root.current-index].searched; enabled: root.enabled;
        }
        PathText {
            horizontal-stretch: 1; height: root.height;
            text: root.current-index >= 0 && root.current-index < root.roots.length
                ? root.roots[root.current-index].label : "";
            foreground: root.enabled ? Theme.text : Theme.muted-text; font-size: Theme.font-size;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            colorize: root.enabled ? Theme.secondary-text : Theme.muted-text;
            width: 9px; height: 6px; image-fit: contain;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " "
                || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.open(); return accept;
            }
            reject
        }
        area := TouchArea {
            enabled: root.enabled;
            clicked => { focus.focus(); root.open(); }
        }
    }
    Tip { text: root.hint; }
    popup := PopupWindow {
        private property <length> wanted: min(360px, root.roots.length * root.row-height + 10px);
        private property <length> below: PopupList.room-below(root.absolute-position.y, root.height);
        private property <length> above: PopupList.room-above(root.absolute-position.y);
        // Below the picker unless only above has room; never taller than that room.
        private property <bool> opens-above: self.below < self.wanted && self.above > self.below;
        x: 0px; y: self.opens-above ? -self.height : root.height;
        width: max(root.width, 320px);
        height: min(self.wanted, self.opens-above ? self.above : self.below);
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            focus-changed-event => { root.popup-open = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.pending = min(root.roots.length - 1, root.pending + 1); return accept;
                }
                if event.text == Key.UpArrow { root.pending = max(0, root.pending - 1); return accept; }
                if event.text == Key.Home { root.pending = 0; return accept; }
                if event.text == Key.End { root.pending = root.roots.length - 1; return accept; }
                if event.text == " " { root.toggle(root.pending); return accept; }
                if event.text == Key.Return { root.choose(root.pending); return accept; }
                if event.text == Key.Escape || event.text == Key.Tab { root.close(); return accept; }
                reject
            }
            Rectangle {
                background: Theme.surface; border-width: 1px;
                border-color: Theme.active-frame; border-radius: 4px;
                ListView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    content-y: PopupList.reveal(root.pending, root.roots.length, root.row-height, self.visible-height);
                    // Wheel and scrollbar input assign content-y, which detaches the
                    // binding above; keyboard browsing must still reveal its row.
                    private property <int> browsed-index: root.pending;
                    changed browsed-index => {
                        self.content-y = PopupList.reveal(self.browsed-index, root.roots.length, root.row-height, self.visible-height);
                    }
                    for row[index] in root.roots: Rectangle {
                        height: root.row-height;
                        background: index == root.pending || name-area.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 16px; height: 16px;
                                accessible-role: checkbox; accessible-label: row.label;
                                accessible-checked: row.searched; accessible-enabled: root.enabled;
                                accessible-action-default => { root.toggle(index); }
                                MenuCheck { x: 0px; y: 0px; checked: row.searched; enabled: root.enabled; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: root.row-height;
                                accessible-role: button; accessible-label: row.label;
                                accessible-enabled: root.enabled;
                                accessible-action-default => { root.choose(index); }
                                PathText {
                                    x: 0px; width: max(0px, parent.width - 18px); height: parent.height;
                                    text: row.label; font-size: Theme.font-size;
                                    foreground: row.searched ? Theme.text : Theme.secondary-text;
                                }
                                Text {
                                    // The current folder, as in single-choice pickers.
                                    x: parent.width - self.width; height: parent.height;
                                    visible: index == root.current-index;
                                    text: "✓"; color: Theme.accent; vertical-alignment: center;
                                }
                            }
                        }
                        name-area := TouchArea {
                            x: 34px; width: max(0px, parent.width - self.x);
                            enabled: root.enabled;
                            clicked => { root.choose(index); }
                        }
                        TouchArea {
                            x: 0px; width: 34px; enabled: root.enabled;
                            clicked => { root.pending = index; root.toggle(index); }
                        }
                        Tip {
                            text: row.label + (row.searched ? "\nSearched. " : "\nNot searched. ")
                                + "Tick to include this folder; click its name to choose it.";
                        }
                    }
                }
            }
        }
    }
}
