import { Theme } from "theme.slint";
import { TipBody } from "controls.slint";

export global PathPasteView {
    callback request(int);
    callback invalidate(int);
    callback observe(int);
}

// This editor owns Paste's keyboard and menu routes. Other LineEdits keep their
// standard clipboard behavior; only explicit path paste requests reach the backend.
export component PathEditor inherits Rectangle {
    in property <int> pane-id;
    in property <length> font-size: Theme.font-size;
    in property <string> hint;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    out property <string> preedit: input.preedit-text;
    callback accepted();
    forward-focus: input;
    background: Theme.surface;
    min-width: 1px;
    changed text => { PathPasteView.observe(root.pane-id); }
    changed has-focus => { PathPasteView.observe(root.pane-id); }
    changed preedit => { PathPasteView.observe(root.pane-id); }
    public function invalidate-paste() { PathPasteView.invalidate(root.pane-id); }
    function paste-path() {
        input.focus();
        PathPasteView.request(root.pane-id);
    }
    ContextMenuArea {
        Menu {
            MenuItem { title: @tr("Undo"); activated => { input.undo(); } }
            MenuItem { title: @tr("Redo"); activated => { input.redo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Cut"); activated => { input.cut(); } }
            MenuItem { title: @tr("Copy"); activated => { input.copy(); } }
            MenuItem { title: @tr("Paste"); activated => { root.paste-path(); } }
            MenuItem { title: @tr("Select All"); activated => { input.select-all(); } }
        }
        viewport := Rectangle {
            x: 7px; y: 0px; width: max(1px, parent.width - 14px); height: parent.height;
            clip: true;
            input := TextInput {
                private property <length> computed-x;
                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(1px, parent.width - self.text-cursor-width, self.preferred-width);
                height: parent.height;
                font-size: root.font-size;
                font-family: Theme.font-family;
                color: Theme.text;
                selection-foreground-color: Theme.selection-text;
                selection-background-color: Theme.selection-background;
                single-line: true;
                vertical-alignment: center;
                accessible-label: "Folder path";
                accepted => { root.accepted(); }
                edited => { PathPasteView.invalidate(root.pane-id); }
                cursor-position-changed(position) => {
                    PathPasteView.observe(root.pane-id);
                    if position.x + self.computed-x < 4px { self.computed-x = 4px - position.x; }
                    else if position.x + self.computed-x > parent.width - self.text-cursor-width - 4px {
                        self.computed-x = parent.width - position.x - self.text-cursor-width - 4px;
                    }
                }
                key-pressed(event) => {
                    if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                        && !event.modifiers.meta && (event.text == "v" || event.text == "V") {
                        root.paste-path(); return accept;
                    }
                    if event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt
                        && !event.modifiers.meta && event.text == Key.Insert {
                        root.paste-path(); return accept;
                    }
                    reject
                }
            }
        }
    }
    Tooltip { TipBody { text: root.hint; } }
}
