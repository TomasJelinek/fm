import { ActionButton } from "action-icons.slint";
import { CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { TipBody } from "controls.slint";

// Child-free call sites reuse the same native widget and popup implementation.
export component HintedCheckBox inherits CheckBox {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

export component HintedComboBox inherits ComboBox {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

export component HintedLineEdit inherits LineEdit {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

// Only formerly tipped call sites use this wrapper; plain buttons stay unchanged.
export component HintedActionButton inherits ActionButton {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}
