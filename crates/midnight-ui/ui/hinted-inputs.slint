import { ActionButton } from "action-icons.slint";
import { CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { Tip, TipBody, TooltipPlacement } from "controls.slint";
import { ListView } from "vlist-view.slint";
import { PopupList } from "popup-list.slint";
import { Theme } from "theme.slint";

// Child-free call sites reuse the same native widget and popup implementation.
// Use these without a hint as well: the plain stock widget next to its hinted
// wrapper is compiled as a second copy. Stock widgets accept no child but a
// Tooltip, so these three cannot host the shared Tip.
export component HintedCheckBox inherits CheckBox {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

export component HintedComboBox inherits ComboBox {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

export component HintedLineEdit inherits LineEdit {
    in property <string> hint;
    if root.hint != "": Tooltip { TipBody { text: root.hint; } }
}

// The shared edit line (HintedLineEdit: inline clear, focus underline, hint) with a
// dropdown of recent entries, newest first. Down or Alt+Down in the line opens it; Up,
// Down, Home and End browse; Return or a click chooses an entry and `chosen(index)`
// lets the owner fill the line and whatever else the entry restores. Choosing applies
// nothing. Escape (or Tab) closes the list and returns to the line; the next Escape
// reaches the owner. Stock widgets accept no child but a Tooltip, so the list opens
// from this wrapper, below the line (above it when there is more room there).
export component HistoryLineEdit inherits Rectangle {
    in-out property <string> text <=> edit.text;
    in property <string> placeholder-text <=> edit.placeholder-text;
    in property <string> hint <=> edit.hint;
    in property <bool> enabled: true;
    // Names the text input; the list's rows carry their own labels.
    in property <string> accessible-name;
    // Entry labels, newest first.
    in property <[string]> entries;
    in property <length> popup-min-width: 320px;
    out property <bool> list-open;
    out property <bool> has-focus: edit.has-focus;
    callback accepted(string);
    callback edited(string);
    callback chosen(int);
    private property <int> browsed;
    // Set while `close-list()` closes the list itself.
    private property <bool> closing;
    private property <length> row-height: Theme.control-height;
    public function focus-line() { edit.focus(); }
    public function select-all() { edit.select-all(); }
    public function open-list() {
        if root.enabled && root.entries.length > 0 {
            root.browsed = 0;
            root.list-open = true;
            list.show();
        }
    }
    function close-list() {
        root.closing = true;
        list.close();
        root.closing = false;
        root.list-open = false;
        edit.focus();
    }
    function choose(index: int) {
        root.close-list();
        if root.enabled && index >= 0 && index < root.entries.length { root.chosen(index); }
    }
    changed enabled => { if !root.enabled && root.list-open { root.close-list(); } }
    changed entries => { if root.list-open { root.close-list(); } }
    min-width: 0px;
    min-height: edit.min-height;
    preferred-height: edit.preferred-height;
    horizontal-stretch: 1; vertical-stretch: 0;
    accessible-role: none;
    forward-focus: edit;
    edit := HintedLineEdit {
        width: parent.width; height: parent.height;
        enabled: root.enabled; accessible-label: root.accessible-name;
        accessible-expandable: root.entries.length > 0;
        accessible-expanded: root.list-open;
        accessible-action-expand => { root.open-list(); }
        key-pressed(event) => {
            if event.text == Key.DownArrow && !event.modifiers.control && !event.modifiers.shift
                && !event.modifiers.meta && root.entries.length > 0 {
                root.open-list();
                return accept;
            }
            reject
        }
        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
    }
    list := PopupWindow {
        private property <length> wanted: root.entries.length * root.row-height + 10px;
        private property <length> below: PopupList.room-below(root.absolute-position.y, root.height);
        private property <length> above: PopupList.room-above(root.absolute-position.y);
        private property <bool> opens-above: self.below < self.wanted && self.above > self.below;
        x: clamp(root.absolute-position.x, 8px,
            max(8px, TooltipPlacement.surface-width - self.width - 8px)) - root.absolute-position.x;
        y: self.opens-above ? -self.height : root.height;
        width: min(max(root.width, root.popup-min-width), max(1px, TooltipPlacement.surface-width - 16px));
        height: min(360px, self.opens-above ? self.above : self.below, self.wanted);
        close-policy: close-on-click-outside;
        forward-focus: list-keys;
        list-keys := FocusScope {
            focus-changed-event => { if !root.closing { root.list-open = self.has-focus; } }
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.browsed = min(root.entries.length - 1, root.browsed + 1);
                    return accept;
                }
                if event.text == Key.UpArrow { root.browsed = max(0, root.browsed - 1); return accept; }
                if event.text == Key.Home { root.browsed = 0; return accept; }
                if event.text == Key.End { root.browsed = root.entries.length - 1; return accept; }
                if event.text == Key.Return { root.choose(root.browsed); return accept; }
                if event.text == Key.Escape || event.text == Key.Tab { root.close-list(); return accept; }
                reject
            }
            Rectangle {
                background: Theme.surface; border-width: 1px;
                border-color: Theme.active-frame; border-radius: 4px;
                ListView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    content-y: PopupList.reveal(root.browsed, root.entries.length, root.row-height, self.visible-height);
                    // Wheel and scrollbar input assign content-y, which detaches the
                    // binding above; keyboard browsing must still reveal its row.
                    private property <int> browsed-index: root.browsed;
                    changed browsed-index => {
                        self.content-y = PopupList.reveal(self.browsed-index, root.entries.length,
                            root.row-height, self.visible-height);
                    }
                    for label[index] in root.entries : Rectangle {
                        height: root.row-height;
                        background: index == root.browsed || row-area.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: label;
                        accessible-action-default => { root.choose(index); }
                        Text {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text: label; color: Theme.text; font-size: Theme.font-size;
                            vertical-alignment: center; overflow: elide; accessible-role: none;
                        }
                        row-area := TouchArea { clicked => { root.choose(index); } }
                    }
                }
            }
        }
    }
}

// Only formerly tipped call sites use this wrapper; plain buttons stay unchanged.
export component HintedActionButton inherits ActionButton {
    in property <string> hint;
    // A button that shows its glyph alone names its action on the tooltip's first line.
    Tip { text: !root.glyph-only ? root.hint : root.hint == "" ? root.text : root.text + "\n" + root.hint; }
}
