import { HScrollView, VScrollView } from "scroll-view.slint";
import { Theme } from "theme.slint";
import { HintedActionButton, HintedComboBox } from "hinted-inputs.slint";
import { ThemedLineEdit } from "content-controls.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogText } from "dialog-text.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";
import { WrappingCheckBox } from "wrapping-check-box.slint";
import { FormNote } from "form-note.slint";
import { Tip } from "controls.slint";


export component OperationDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> policy;
    // The Copy/Move form (`EmbeddedOperation` passes `kind < 0`). `body` is its first
    // line, which names what is copied and ends where the destination field takes over;
    // `body-hint` (where the items come from) is that line's tooltip and `policy` the
    // primary action's. The options grid follows the field, and one note at most sits
    // under the control it concerns instead of a warning above the summary.
    in property <bool> transfer;
    in property <string> body-hint;
    in property <bool> wait-visible;
    in-out property <bool> wait-checked;
    // The Copy/Move link choice: index 0 copies the files links point to, 1 keeps links
    // as links. The presenter sets the entries, the hint that says why the default was
    // chosen and explains both (the box's tooltip; `link-reason` is its accessible
    // description), and what keeping links does where it cannot work (the note under it).
    in property <bool> links-visible;
    in-out property <int> link-choice;
    in property <[string]> link-choices;
    in property <string> link-hint;
    in property <string> link-reason;
    in property <string> link-warning;
    callback link-chosen(int);
    in property <string> initial-name;
    in property <string> input-label;
    in property <int> selection-end;
    in property <bool> has-name;
    in property <bool> dangerous;
    in property <string> confirm-text;
    in property <bool> confirm-enabled: true;
    in-out property <string> value <=> name.text;
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <string> warning;
    // The Copy/Move form's `warning` is about the link choice (what keeping links does
    // there), and sits under it; otherwise under the destination. Other forms show their
    // warning above the summary.
    in property <bool> warning-about-links;
    in property <bool> option-visible;
    in property <bool> option-enabled: true;
    in-out property <bool> option-checked;
    in property <string> option-label;
    in property <string> option-hint;
    callback confirm(string);
    callback cancel();
    callback move-dialog(length, length);
    // A destructive question about a name (a new empty file over an existing one) is
    // never answered from the name field: Enter there armed it, so a second or held
    // Enter must not replace the file. Only the confirm button itself does. Editing
    // the name lets Enter submit the new name again.
    private property <string> armed-name;
    private property <bool> replace-armed: root.dangerous && root.has-name
        && name.text == root.armed-name;
    changed dangerous => { root.armed-name = root.dangerous && root.has-name ? name.text : ""; }
    // The question names the file, so a new warning means a newly armed name.
    changed warning => { root.armed-name = root.dangerous && root.has-name ? name.text : ""; }
    private property <bool> compact: root.height < 280px;
    // The name field keeps the stock field's 32 px and the theme's control height; a
    // form without a name gives the hidden field no room.
    private property <length> name-height: !root.has-name ? 0px
        : max(32px, Theme.control-height, Theme.font-size + 12px);
    // Enter asked for a confirmation that an empty name refused: the form says why
    // under the field until a name is typed.
    private property <bool> name-requested;
    private property <bool> name-missing: root.name-requested && root.has-name && name.text == "";
    private property <string> name-reason: "Type the "
        + (root.input-label == "" ? "name" : root.input-label.to-lowercase()) + " first.";
    changed name-missing => {
        if root.name-missing { root.reveal-middle(name.y, name.height + root.row-spacing + Theme.font-size * 3); }
    }
    private property <length> regular-row-spacing: 12px;
    private property <length> row-spacing: root.compact ? 4px : root.regular-row-spacing;
    // What the other forms' DialogText draws: the compact layout moves the warning into
    // the summary, the regular layout shows it separately above.
    private property <string> summary: (root.compact && root.warning != "" ? root.warning + "\n\n" : "") + root.body;
    pure function form-padding(is-compact: bool) -> length {
        return is-compact ? 8px : 16px;
    }
    // The width DialogText draws the summary at: inside the form padding on both
    // sides, the scroll bar's column, which the form's scroll view leaves free, and
    // DialogText's 16px: its own bar's column and 2px.
    pure function summary-width(is-compact: bool) -> length {
        return max(1px, root.width - 2 * root.form-padding(is-compact) - FluentScrollMetrics.overlay-size - 16px);
    }
    // The Copy/Move form's spacing: 6 px inside a block (the first line and the field, a
    // control and its note, the options' rows) and 16 px between the destination and the
    // options; the compact layout tightens them to 4 and 8 px.
    private property <length> block-gap: root.compact ? 4px : 6px;
    private property <length> section-gap: root.compact ? 8px : 16px;
    // The width of the form's content: inside the form padding on both sides and the
    // scroll bar's column, which the form's scroll view leaves free.
    pure function content-width(is-compact: bool) -> length {
        return max(1px, root.width - 2 * root.form-padding(is-compact) - FluentScrollMetrics.overlay-size);
    }
    private property <bool> any-option: root.links-visible || root.option-visible || root.wait-visible;
    private property <string> wait-label: "Wait for earlier transfers";
    // The link choice's box is as wide as its longest entry: the Fluent box's 11 px
    // padding on either side, its 12 px arrow and the 8 px before it, 12 px to spare, and
    // its 160 px minimum.
    private property <length> combo-width: max(160px,
        max(first-choice-measure.preferred-width, second-choice-measure.preferred-width) + 54px);
    private property <length> combo-height: max(32px, Theme.control-height);
    // The one note the Copy/Move form shows, first of: why Enter with an empty
    // destination did nothing, why the form does not start (`warning`), and what keeping
    // links does where none can be stored.
    private property <string> note-text: root.name-missing ? root.name-reason
        : root.warning != "" ? root.warning
        : root.links-visible ? root.link-warning : "";
    // A note about the link choice sits under it (in the regular layout); the others,
    // and every note of the compact layout, under the destination, near the top.
    private property <bool> links-note: root.transfer && root.note-text != "" && root.links-visible
        && !root.name-missing && (root.warning == "" || root.warning-about-links);
    private property <bool> note-under-links: root.links-note && !root.compact;
    private property <bool> field-note: root.transfer && root.note-text != "" && !root.note-under-links;
    // Notes about the link choice warn; the others refuse.
    private property <bool> note-error: !root.links-note;
    // A note's glyph, as FormNote sizes it, and the width that glyph and the note's insets
    // take from its text (8 px before the glyph, after it and at the end).
    private property <length> note-glyph: max(16px, round(Theme.font-size * 1.1 / 1px) * 1px);
    private property <length> note-chrome: root.note-glyph + 24px;
    changed note-text => {
        if root.transfer && root.note-text != "" {
            if root.note-under-links {
                root.reveal-middle(options.y + links-box.y,
                    links-box.height + root.block-gap + note-measure.preferred-height + 12px);
            } else {
                root.reveal-middle(name.y,
                    name.height + root.block-gap + note-measure.preferred-height + 12px);
            }
            // The keyboard stays where it was: Slint drops the focus of a control
            // scrolled out of view at the next key.
            root.reveal-focused();
        }
    }
    function reveal-middle(top: length, extent: length) {
        if top < -middle.content-y { middle.content-y = -top; }
        else if top + extent > -middle.content-y + middle.visible-height {
            middle.content-y = middle.visible-height - top - extent;
        }
        middle.content-y = clamp(middle.content-y,
            min(0px, middle.visible-height - middle.content-height), 0px);
    }
    function focus-name() {
        root.reveal-middle(name.y, name.height);
        name.focus();
    }
    function focus-option() {
        root.reveal-middle(options.y + option-box.y, option-box.height);
        option.focus();
    }
    function focus-directory-links() {
        root.reveal-middle(options.y + links-box.y + follow-links.y, follow-links.height);
        follow-links.focus();
    }
    function focus-wait() {
        root.reveal-middle(options.y + wait-box.y, wait-box.height);
        wait-option.focus();
    }
    function reveal-focused() {
        if name.has-focus { root.reveal-middle(name.y, name.height); }
        else if follow-links.has-focus { root.reveal-middle(options.y + links-box.y + follow-links.y, follow-links.height); }
        else if option.has-focus { root.reveal-middle(options.y + option-box.y, option-box.height); }
        else if wait-option.has-focus { root.reveal-middle(options.y + wait-box.y, wait-box.height); }
    }
    function focus-primary() {
        // A Fluent button's zero-width focus point sits at its left edge.
        // Keep keyboard input outside the scrolled content when that edge can
        // be clipped; Slint drops keys before ancestor capture in that case.
        primary-focus.focus();
    }
    // The form's own Tab cycle, in the order the controls are shown: 0 the header's
    // close button, 1 the name, 2 the link choice, 3 the option, 4 the wait option,
    // 5 Cancel and 6 the primary action. Hidden and disabled stops are skipped.
    pure function stop-available(stop: int) -> bool {
        return stop == 0 ? header.close-focusable
            : stop == 1 ? root.has-name
            : stop == 2 ? root.links-visible
            : stop == 3 ? root.option-visible && root.option-enabled
            : stop == 4 ? root.wait-visible
            : stop == 5 || (stop == 6 && confirm-button.enabled);
    }
    // The first stop at or after `start`, or -1. Cancel is always a stop.
    pure function stop-from(start: int) -> int {
        return start <= 0 && root.stop-available(0) ? 0
            : start <= 1 && root.stop-available(1) ? 1
            : start <= 2 && root.stop-available(2) ? 2
            : start <= 3 && root.stop-available(3) ? 3
            : start <= 4 && root.stop-available(4) ? 4
            : start <= 5 ? 5
            : start <= 6 && root.stop-available(6) ? 6 : -1;
    }
    // The last stop at or before `end`, or -1.
    pure function stop-until(end: int) -> int {
        return end >= 6 && root.stop-available(6) ? 6
            : end >= 5 ? 5
            : end >= 4 && root.stop-available(4) ? 4
            : end >= 3 && root.stop-available(3) ? 3
            : end >= 2 && root.stop-available(2) ? 2
            : end >= 1 && root.stop-available(1) ? 1
            : end >= 0 && root.stop-available(0) ? 0 : -1;
    }
    pure function focused-stop() -> int {
        return header.close-has-focus ? 0 : name.has-focus ? 1 : follow-links.has-focus ? 2
            : option.has-focus ? 3 : wait-option.has-focus ? 4
            : cancel-button.has-focus ? 5 : primary-focus.has-focus ? 6 : -1;
    }
    function focus-stop(stop: int) {
        if stop == 0 { header.focus-close(); }
        else if stop == 1 { root.focus-name(); }
        else if stop == 2 { root.focus-directory-links(); }
        else if stop == 3 { root.focus-option(); }
        else if stop == 4 { root.focus-wait(); }
        else if stop == 6 { root.focus-primary(); }
        else { cancel-button.focus(); }
    }
    // Tab and Shift+Tab move to the next or previous stop and wrap around.
    function move-focus(forward: bool) {
        let current = root.focused-stop();
        let next = forward ? root.stop-from(current + 1) : root.stop-until(current - 1);
        root.focus-stop(next >= 0 ? next : forward ? root.stop-from(0) : root.stop-until(6));
    }
    // Size the initial presentation from its actual wrapped text, measured at the
    // regular layout's width: the compact layout follows the height it decides.
    // Resizing remains independent in DialogFrame; editing never recreates the input.
    out property <length> preferred-dialog-height: root.transfer ? root.transfer-height : root.classic-height;
    private property <length> classic-height: clamp(
        42px + max(36px, Theme.font-size * 1.2 + 6px)
        + min(280px, summary-measure.preferred-height)
        + (root.has-name ? max(Theme.control-height, name.preferred-height) + root.regular-row-spacing : 0px)
        + (root.has-name && root.input-label != "" ? Theme.font-size * 1.5 + root.regular-row-spacing : 0px)
        + max(32px, confirm-button.preferred-height) + 36px, 220px, 640px);
    // The Copy/Move form in its regular layout, block by block as the form lays it out:
    // the padding, the header and the gaps around the middle; the first line and its
    // gap, the field and its note; the options' heading after its gap, then each shown
    // row with the gap above it; and the actions' row.
    private property <length> transfer-height: clamp(
        2 * root.form-padding(false) + header.regular-height + 2 * root.regular-row-spacing
        + first-line-measure.preferred-height + 6px + root.name-height
        + (root.transfer && root.note-text != "" && !root.links-note
            ? 6px + max(root.note-glyph, note-measure.preferred-height) + 12px : 0px)
        + (root.any-option ? 16px + options-heading-measure.preferred-height : 0px)
        + (root.links-visible ? 6px + root.combo-height
            + (root.links-note ? 6px + max(root.note-glyph, note-measure.preferred-height) + 12px : 0px) : 0px)
        + (root.option-visible ? 6px + max(Theme.control-height, option-caption-measure.preferred-height) : 0px)
        + (root.wait-visible ? 6px + max(Theme.control-height, wait-caption-measure.preferred-height) : 0px)
        + max(32px, Theme.control-height, cancel-button.min-height, confirm-button.preferred-height),
        220px, 640px);
    // The dialog height counts the summary at its regular-layout width, a warning
    // included as the compact layout draws it (standing in for the separate warning
    // text). It cannot follow `compact`, which depends on that height.
    summary-measure := Text {
        visible: false; accessible-role: none;
        width: root.summary-width(false);
        text: (root.warning != "" ? root.warning + "\n\n" : "") + root.body;
        font-size: Theme.font-size; wrap: word-wrap;
    }
    // The summary box fits exactly what DialogText draws, in either layout; nothing
    // that decides the dialog height reads this measure.
    drawn-summary := Text {
        visible: false; accessible-role: none;
        width: root.summary-width(root.compact);
        text: root.summary;
        font-size: Theme.font-size; wrap: word-wrap;
    }
    // The Copy/Move form's texts at the regular layout's width (a note's glyph and
    // insets take `note-chrome` of it; a note under the destination and one under the
    // link box are equally wide).
    first-line-measure := Text {
        visible: false; accessible-role: none;
        width: root.content-width(false);
        text: root.body; font-size: Theme.font-size; wrap: word-wrap;
    }
    note-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.content-width(false) - root.note-chrome);
        text: root.note-text; font-size: Theme.font-size; wrap: word-wrap;
    }
    options-heading-measure := Text {
        visible: false; accessible-role: none;
        text: "Options"; font-size: Theme.font-size; font-weight: 600;
    }
    first-choice-measure := Text {
        visible: false; accessible-role: none;
        text: root.link-choices[0]; font-size: Theme.font-size;
    }
    second-choice-measure := Text {
        visible: false; accessible-role: none;
        text: root.link-choices[1]; font-size: Theme.font-size;
    }
    // A check box's caption wraps beside its 24 px box and 6 px gap.
    option-caption-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.content-width(false) - 30px);
        text: root.option-label; font-size: Theme.font-size; wrap: word-wrap;
    }
    wait-caption-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.content-width(false) - 30px);
        text: root.wait-label; font-size: Theme.font-size; wrap: word-wrap;
    }
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
    public function begin() {
        middle.content-y = 0px;
        root.name-requested = false;
        name.text = root.initial-name;
        if root.has-name { root.focus-name(); name.set-selection-offsets(0, root.selection-end); }
        else { root.focus-primary(); }
    }
    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            // A held key confirms nothing: only a new press answers a question.
            if event.repeat && ((event.text == Key.Return && !cancel-button.has-focus)
                    || (event.text == Key.Space && primary-focus.has-focus)) {
                return accept;
            }
            // Enter confirms from the input, option or primary action. Keep
            // focused Cancel and the header close button's own key handlers.
            if (event.text == Key.Return && (primary-focus.has-focus || (name.has-focus && !root.replace-armed)
                    || option.has-focus || follow-links.has-focus || wait-option.has-focus || confirm-button.has-focus))
                || (event.text == Key.Space && primary-focus.has-focus) {
                if confirm-button.enabled { root.confirm(name.text); }
                // An empty name cannot be confirmed: say so, where it is typed.
                else if root.has-name && name.text == "" { root.name-requested = true; root.focus-name(); }
                return accept;
            }
            // Enter in the name field of an armed replacement waits for the button.
            if event.text == Key.Return && name.has-focus { return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                root.move-focus(!event.modifiers.shift && event.text != Key.Backtab);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: root.form-padding(root.compact); spacing: root.row-spacing;
            header := DialogHeader {
                title: root.title; native-icon: root.native-icon; fallback-icon: root.fallback-icon;
                compact: root.compact;
                text-size: Theme.font-size * 1.2;
                foreground: root.dangerous ? Theme.error-text : Theme.text;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            middle := VScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, form.min-height);
                changed height => { root.reveal-focused(); }
                changed content-height => { root.reveal-focused(); }
                form := VerticalLayout {
                    height: middle.content-height;
                    // The Copy/Move form spaces its blocks itself.
                    spacing: root.transfer ? 0px : root.row-spacing; alignment: start;
                    if !root.transfer && root.warning != "" && !root.compact : Text {
                        text: root.warning; color: Theme.error-text; font-weight: 600;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                    if !root.transfer : Rectangle {
                        height: min(280px, drawn-summary.preferred-height);
                        background: transparent; clip: true;
                        DialogText {
                            x: 0px;
                            y: 0px; width: parent.width; height: parent.height;
                            text: root.summary;
                            min-height: 0px;
                        }
                    }
                    // Copy/Move: what is copied, ending where the destination field
                    // takes over ("Copy “report.pdf” (1.2 MiB) to:").
                    if root.transfer : VerticalLayout {
                        padding-bottom: root.block-gap;
                        Text {
                            text: root.body; color: Theme.text;
                            font-size: Theme.font-size; wrap: word-wrap;
                            // Every wrapped line counts in the scrolled extent.
                            min-height: self.preferred-height;
                            accessible-description: root.body-hint;
                            Tip { text: root.body-hint; }
                        }
                    }
                    if !root.transfer && root.has-name && root.input-label != "" && !root.compact : Text {
                        text: root.input-label; color: Theme.text; font-size: Theme.font-size;
                    }
                    // The themed field: its selected text uses the theme's selection
                    // colours, which the stock LineEdit does not let a host set.
                    name := ThemedLineEdit {
                        min-height: root.name-height; preferred-height: root.name-height;
                        max-height: root.name-height;
                        visible: root.has-name;
                        accessible-label: root.input-label == "" ? root.title : root.input-label;
                        accessible-description: root.name-missing ? root.name-reason
                            : root.field-note && !root.links-note ? root.note-text : "";
                        changed has-focus => { if self.has-focus { root.reveal-middle(self.y, self.height); } }
                        accepted => { if root.confirm-enabled && self.text != "" { root.confirm(self.text); } }
                    }
                    if !root.transfer && root.name-missing : Text {
                        text: root.name-reason; color: Theme.error-text;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                    if root.field-note : VerticalLayout {
                        padding-top: root.block-gap;
                        FormNote { text: root.note-text; error: root.note-error; }
                    }
                    // Copy/Move: the options, one group in one column under its heading,
                    // every control at the form's left edge. The link box has no caption:
                    // both its entries name links, and its accessible name is "Links". A
                    // form without options keeps no room for it.
                    options := VerticalLayout {
                        // Each row carries the gap above it, so a row left out keeps
                        // no gap either.
                        padding-top: root.any-option ? root.section-gap : 0px;
                        if root.any-option : Text {
                            text: "Options"; color: Theme.strong-text;
                            font-size: Theme.font-size; font-weight: 600;
                            min-height: self.preferred-height;
                        }
                        links-box := Rectangle {
                            visible: root.links-visible;
                            height: root.links-visible ? root.block-gap + root.combo-height : 0px;
                            follow-links := HintedComboBox {
                                x: 0px; y: root.block-gap;
                                width: min(root.combo-width, parent.width);
                                height: root.combo-height;
                                model: root.link-choices;
                                current-index <=> root.link-choice;
                                hint: root.link-hint;
                                enabled: root.links-visible;
                                accessible-label: "Links";
                                accessible-description: root.link-warning != "" ? root.link-warning : root.link-reason;
                                selected => { root.link-chosen(self.current-index); }
                                changed has-focus => { if self.has-focus { root.reveal-middle(options.y + links-box.y + self.y, self.height); } }
                            }
                        }
                        if root.note-under-links : VerticalLayout {
                            padding-top: root.block-gap;
                            FormNote { text: root.note-text; error: false; }
                        }
                        option-box := Rectangle {
                            visible: root.option-visible;
                            height: root.option-visible ? root.block-gap + option.height : 0px;
                            option := WrappingCheckBox {
                                x: 0px; y: root.block-gap;
                                width: parent.width;
                                text: root.option-label; hint: root.option-hint;
                                enabled: root.option-visible && root.option-enabled;
                                checked <=> root.option-checked;
                                changed has-focus => { if self.has-focus { root.reveal-middle(options.y + option-box.y, option-box.height); } }
                            }
                        }
                        wait-box := Rectangle {
                            visible: root.wait-visible;
                            height: root.wait-visible ? root.block-gap + wait-option.height : 0px;
                            wait-option := WrappingCheckBox {
                                x: 0px; y: root.block-gap;
                                width: parent.width;
                                text: root.wait-label;
                                hint: "Start only after the Copy and Move jobs that are unfinished when you confirm. Later jobs and Delete do not hold it back.";
                                enabled: root.wait-visible;
                                checked <=> root.wait-checked;
                                changed has-focus => { if self.has-focus { root.reveal-middle(options.y + wait-box.y, wait-box.height); } }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                cancel-button := HintedActionButton { text: "Cancel"; hint: "Leave files unchanged (Escape)."; clicked => { root.cancel(); } }
                Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    height: max(32px, Theme.control-height + (root.compact ? 12px : 0px), confirm-button.preferred-height);
                    primary-scroll := HScrollView {
                        // Positioned, so that its minimum size stays out of the parent's layout info.
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: as-needed;
                        HorizontalLayout { alignment: end;
                            confirm-button := HintedActionButton {
                                primary: true; destructive: root.dangerous;
                                // The operation's own glyph, as in the dialog header; a
                                // compact form trims the padding that the glyph needs.
                                fallback-icon: root.fallback-icon; compact: root.compact;
                                text: root.confirm-text; enabled: root.confirm-enabled && (!root.has-name || name.text != "");
                                accessible-role: none;
                                // Copy/Move: what the job verifies, which its policy says.
                                hint: root.transfer && root.policy != "" ? root.policy
                                    : !root.dangerous ? root.confirm-text
                                    : root.has-name ? "Replace the existing file with an empty file. The original file is kept in a recovery folder."
                                    : "Permanently delete the confirmed targets. This cannot be undone.";
                                clicked => { primary-focus.focus(); root.confirm(name.text); }
                            }
                        }
                    }
                    primary-focus := FocusScope {
                        x: max(0px, parent.width - confirm-button.width);
                        width: min(parent.width, confirm-button.width); height: parent.height;
                        enabled: confirm-button.enabled;
                        focus-on-click: false; focus-on-tab-navigation: false;
                        // This stationary semantic button owns keyboard focus
                        // and accessibility; the native caption owns pointer input.
                        accessible-role: button;
                        accessible-label: root.confirm-text;
                        accessible-enabled: confirm-button.enabled;
                        accessible-action-default => { if confirm-button.enabled { primary-focus.focus(); root.confirm(name.text); } }
                    }
                    Rectangle {
                        x: primary-focus.x;
                        width: primary-focus.width; height: parent.height;
                        background: transparent; border-radius: 3px;
                        border-width: primary-focus.has-focus ? 2px : 0px;
                        border-color: Theme.active-frame; accessible-role: none;
                    }
                }
            }
        }
    }
}
