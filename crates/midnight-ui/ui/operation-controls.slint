import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HintedActionButton, HintedCheckBox } from "hinted-inputs.slint";
import { DialogHeader, DialogWindowStyle } from "dialog-frame.slint";
import { NativeActionImage } from "action-icons.slint";
import { DialogText } from "dialog-text.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";


export component OperationDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> initial-name;
    in property <string> input-label;
    in property <int> selection-end;
    in property <bool> has-name;
    out property <length> input-height: root.has-name ? name.height : 0px;
    in property <bool> dangerous;
    in property <string> confirm-text;
    in property <bool> confirm-enabled: true;
    in-out property <string> value <=> name.text;
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <string> warning;
    in property <bool> option-visible;
    in property <bool> option-enabled: true;
    in-out property <bool> option-checked;
    in property <string> option-label;
    in property <string> option-hint;
    callback confirm(string);
    callback cancel();
    callback move-dialog(length, length);
    private property <bool> compact: root.height < 280px;
    private property <bool> summary-icon-visible: DialogWindowStyle.native-titlebar
        && (root.native-icon.width > 0 || root.fallback-icon.width > 0);
    private property <length> summary-icon-size: root.compact ? 24px : 32px;
    function focus-primary() {
        // A Fluent button's zero-width focus point sits at its left edge.
        // Keep keyboard input outside the scrolled content when that edge can
        // be clipped; Slint drops keys before ancestor capture in that case.
        primary-focus.focus();
    }
    // Size the initial presentation from its actual wrapped summary. Resizing
    // remains independent in DialogFrame; editing never recreates the input.
    out property <length> preferred-dialog-height: clamp(
        32px + (DialogWindowStyle.native-titlebar ? 0px : max(36px, Theme.font-size * 1.2 + 6px))
        + min(280px, max(summary-measure.preferred-height, root.summary-icon-visible ? root.summary-icon-size : 0px))
        + (root.has-name ? max(Theme.control-height, name.preferred-height) + 12px : 0px)
        + (root.has-name && root.input-label != "" ? Theme.font-size * 1.5 + 12px : 0px)
        + (root.option-visible ? max(Theme.control-height, option.preferred-height) + 24px : 0px)
        + max(32px, confirm-button.preferred-height) + 36px, 220px, 640px);
    summary-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 48px - (root.summary-icon-visible ? root.summary-icon-size + 8px : 0px));
        text: (root.warning != "" ? root.warning + "\n\n" : "") + root.body;
        font-size: Theme.font-size; wrap: word-wrap;
    }
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
    public function begin() {
        name.text = root.initial-name;
        if root.has-name { name.focus(); name.set-selection-offsets(0, root.selection-end); }
        else { root.focus-primary(); }
    }
    public function focus-input() {
        if root.has-name { name.focus(); } else { root.focus-primary(); }
    }
    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            // Enter confirms from the input, option or primary action. Keep
            // focused Cancel and the header close button's own key handlers.
            if (event.text == Key.Return && (primary-focus.has-focus || name.has-focus || option.has-focus || confirm-button.has-focus))
                || (event.text == Key.Space && primary-focus.has-focus) {
                if confirm-button.enabled { root.confirm(name.text); }
                return accept;
            }
            if event.text == Key.Tab || event.text == Key.Backtab {
                if event.modifiers.shift || event.text == Key.Backtab {
                    if name.has-focus { if confirm-button.enabled { root.focus-primary(); } else { cancel-button.focus(); } }
                    else if cancel-button.has-focus {
                        if root.option-visible && root.option-enabled { option.focus(); }
                        else if root.has-name { name.focus(); }
                        else if confirm-button.enabled { root.focus-primary(); }
                        else { cancel-button.focus(); }
                    }
                    else if option.has-focus {
                        if root.has-name { name.focus(); }
                        else if confirm-button.enabled { root.focus-primary(); }
                        else { cancel-button.focus(); }
                    }
                    else { cancel-button.focus(); }
                } else {
                    if name.has-focus {
                        if root.option-visible && root.option-enabled { option.focus(); }
                        else { cancel-button.focus(); }
                    }
                    else if option.has-focus { cancel-button.focus(); }
                    else if cancel-button.has-focus && confirm-button.enabled { root.focus-primary(); }
                    else if root.has-name { name.focus(); }
                    else if root.option-visible && root.option-enabled { option.focus(); }
                    else { cancel-button.focus(); }
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 8px : 16px; spacing: root.compact ? 4px : 12px;
            DialogHeader {
                title: root.title; native-icon: root.native-icon; fallback-icon: root.fallback-icon;
                compact: root.compact; text-size: Theme.font-size * 1.2;
                foreground: root.dangerous ? Theme.error-text : Theme.text;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            if root.warning != "" && !root.compact : Text {
                text: root.warning; color: Theme.error-text; font-weight: 600;
                font-size: Theme.font-size; wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1; min-height: 0px; background: transparent; clip: true;
                // The OS titlebar replaces the embedded header, but the action
                // artwork still belongs beside the operation summary.
                if root.summary-icon-visible : NativeActionImage {
                    x: 0px; y: 0px; width: root.summary-icon-size;
                    height: min(root.summary-icon-size, parent.height);
                    native-icon: root.native-icon; fallback-icon: root.fallback-icon;
                }
                DialogText {
                    x: root.summary-icon-visible ? root.summary-icon-size + 8px : 0px;
                    y: 0px; width: max(0px, parent.width - self.x); height: parent.height;
                    text: (root.compact && root.warning != "" ? root.warning + "\n\n" : "") + root.body;
                    min-height: 0px;
                }
            }
            if root.has-name && root.input-label != "" && !root.compact : Text {
                text: root.input-label; color: Theme.text; font-size: Theme.font-size;
            }
            VerticalLayout {
                spacing: root.option-visible ? (root.compact ? 4px : 12px) : 0px;
                alignment: start; vertical-stretch: 0;
                name := LineEdit {
                    max-height: max(Theme.control-height, self.preferred-height);
                    vertical-stretch: 0;
                    visible: root.has-name;
                    accessible-label: root.input-label == "" ? root.title : root.input-label;
                    accepted => { if root.confirm-enabled && self.text != "" { root.confirm(self.text); } }
                }
                ScrollView {
                    visible: root.option-visible; min-width: 0px;
                    height: root.option-visible ? max(Theme.control-height, option.preferred-height) + FluentScrollMetrics.overlay-size : 0px;
                    horizontal-scrollbar-policy: as-needed; vertical-scrollbar-policy: always-off;
                    HorizontalLayout {
                        option := HintedCheckBox {
                            text: root.option-label; hint: root.option-hint;
                            enabled: root.option-visible && root.option-enabled;
                            checked <=> root.option-checked;
                            font-size: Theme.font-size;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                cancel-button := HintedActionButton { text: "Cancel"; hint: "Leave files unchanged (Escape)."; clicked => { root.cancel(); } }
                Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    height: max(32px, Theme.control-height + (root.compact ? 12px : 0px), confirm-button.preferred-height);
                    primary-scroll := ScrollView {
                        width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: as-needed; vertical-scrollbar-policy: always-off;
                        HorizontalLayout { alignment: end;
                            confirm-button := HintedActionButton {
                                primary: true;
                                text: root.confirm-text; enabled: root.confirm-enabled && (!root.has-name || name.text != "");
                                accessible-role: none;
                                hint: root.dangerous ? "Permanently delete the confirmed targets. This cannot be undone." : root.confirm-text;
                                clicked => { primary-focus.focus(); root.confirm(name.text); }
                            }
                        }
                    }
                    primary-focus := FocusScope {
                        x: max(0px, parent.width - confirm-button.width);
                        width: min(parent.width, confirm-button.width); height: parent.height;
                        enabled: confirm-button.enabled;
                        focus-on-click: false; focus-on-tab-navigation: false;
                        // This stationary semantic button owns keyboard focus
                        // and accessibility; the native caption owns pointer input.
                        accessible-role: button;
                        accessible-label: root.confirm-text;
                        accessible-enabled: confirm-button.enabled;
                        accessible-action-default => { if confirm-button.enabled { primary-focus.focus(); root.confirm(name.text); } }
                    }
                    Rectangle {
                        x: primary-focus.x;
                        width: primary-focus.width; height: parent.height;
                        background: transparent; border-radius: 3px;
                        border-width: primary-focus.has-focus ? 2px : 0px;
                        border-color: Theme.active-frame; accessible-role: none;
                    }
                }
            }
        }
    }
}
