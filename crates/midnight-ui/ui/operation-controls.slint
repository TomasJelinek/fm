import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HintedActionButton } from "hinted-inputs.slint";

export struct OperationRow { identity: string, title: string, detail: string, cancellable: bool }

export component OperationDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> initial-name;
    in property <int> selection-end;
    in property <bool> has-name;
    in property <bool> dangerous;
    in property <string> confirm-text;
    callback confirm(string);
    callback cancel();
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
    public function begin() {
        name.text = root.initial-name;
        if root.has-name { name.focus(); name.set-selection-offsets(0, root.selection-end); }
        else { cancel-button.focus(); }
    }
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            padding: 16px; spacing: 12px;
            Text { text: root.title; font-size: Theme.font-size * 1.2; font-weight: 600; color: root.dangerous ? Theme.error-text : Theme.text; }
            ScrollView {
                vertical-stretch: 1;
                Text { text: root.body; wrap: word-wrap; color: Theme.text; font-size: Theme.font-size; }
            }
            name := LineEdit {
                visible: root.has-name;
                accessible-label: root.title;
                accepted => { if self.text != "" { root.confirm(self.text); } }
            }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                cancel-button := HintedActionButton { text: "Cancel"; hint: "Leave files unchanged (Escape)."; clicked => { root.cancel(); } }
                HintedActionButton {
                    text: root.confirm-text; enabled: !root.has-name || name.text != "";
                    hint: root.dangerous ? "Permanently delete the confirmed targets. This cannot be undone." : root.confirm-text;
                    clicked => { root.confirm(name.text); }
                }
            }
        }
    }
}

export component OperationsBody inherits Rectangle {
    in property <[OperationRow]> rows;
    callback cancel(string);
    callback close();
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: "Operations"; color: Theme.text; font-weight: 600; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for row in root.rows : HorizontalLayout {
                    VerticalLayout {
                        Text { text: row.title; color: Theme.text; wrap: word-wrap; }
                        Text { text: row.detail; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
                    }
                    HintedActionButton { text: "Cancel"; enabled: row.cancellable; hint: "Request cancellation. Completed changes are retained."; clicked => { root.cancel(row.identity); } }
                }
            }
        }
        HintedActionButton { text: "Close"; hint: "Operations continue in the background."; clicked => { root.close(); } }
    }
}
