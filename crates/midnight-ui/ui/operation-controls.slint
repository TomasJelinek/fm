import { HScrollView, VScrollView } from "scroll-view.slint";
import { Theme } from "theme.slint";
import { HintedActionButton, HintedCheckBox } from "hinted-inputs.slint";
import { ThemedLineEdit } from "content-controls.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogText } from "dialog-text.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";


export component OperationDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> policy;
    in property <bool> wait-visible;
    in-out property <bool> wait-checked;
    in property <bool> follow-directory-links-visible;
    in-out property <bool> follow-directory-links-checked: true;
    // The link option's words differ by platform; the presenter sets them.
    in property <string> follow-links-label: "Follow directory links";
    in property <string> follow-links-hint;
    in property <string> initial-name;
    in property <string> input-label;
    in property <int> selection-end;
    in property <bool> has-name;
    in property <bool> dangerous;
    in property <string> confirm-text;
    in property <bool> confirm-enabled: true;
    in-out property <string> value <=> name.text;
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <string> warning;
    in property <bool> option-visible;
    in property <bool> option-enabled: true;
    in-out property <bool> option-checked;
    in property <string> option-label;
    in property <string> option-hint;
    callback confirm(string);
    callback cancel();
    callback move-dialog(length, length);
    // A destructive question about a name (a new empty file over an existing one) is
    // never answered from the name field: Enter there armed it, so a second or held
    // Enter must not replace the file. Only the confirm button itself does. Editing
    // the name lets Enter submit the new name again.
    private property <string> armed-name;
    private property <bool> replace-armed: root.dangerous && root.has-name
        && name.text == root.armed-name;
    changed dangerous => { root.armed-name = root.dangerous && root.has-name ? name.text : ""; }
    // The question names the file, so a new warning means a newly armed name.
    changed warning => { root.armed-name = root.dangerous && root.has-name ? name.text : ""; }
    private property <bool> compact: root.height < 280px;
    // The name field keeps the stock field's 32 px and the theme's control height; a
    // form without a name gives the hidden field no room.
    private property <length> name-height: !root.has-name ? 0px
        : max(32px, Theme.control-height, Theme.font-size + 12px);
    private property <length> regular-row-spacing: root.wait-visible ? 6px : 12px;
    private property <length> row-spacing: root.compact ? 4px : root.regular-row-spacing;
    // What DialogText draws: the compact layout moves the warning into the summary,
    // the regular layout shows it separately above.
    private property <string> summary: (root.compact && root.warning != "" ? root.warning + "\n\n" : "") + root.body;
    pure function form-padding(is-compact: bool) -> length {
        return is-compact || root.wait-visible ? 8px : 16px;
    }
    // The width DialogText draws the summary at: inside the form padding on both
    // sides, the scrollbar overlay the form reserves and DialogText's 16px text inset.
    pure function summary-width(is-compact: bool) -> length {
        return max(1px, root.width - 2 * root.form-padding(is-compact) - FluentScrollMetrics.overlay-size - 16px);
    }
    function reveal-middle(top: length, extent: length) {
        if top < -middle.content-y { middle.content-y = -top; }
        else if top + extent > -middle.content-y + middle.visible-height {
            middle.content-y = middle.visible-height - top - extent;
        }
        middle.content-y = clamp(middle.content-y,
            min(0px, middle.visible-height - middle.content-height), 0px);
    }
    function focus-name() {
        root.reveal-middle(name.y, name.height);
        name.focus();
    }
    function focus-option() {
        root.reveal-middle(option-scroll.y + option.y, option.height);
        option.focus();
    }
    function focus-directory-links() {
        root.reveal-middle(links-scroll.y + follow-links.y, follow-links.height);
        follow-links.focus();
    }
    function focus-wait() {
        root.reveal-middle(wait-scroll.y + wait-option.y, wait-option.height);
        wait-option.focus();
    }
    function reveal-focused() {
        if name.has-focus { root.reveal-middle(name.y, name.height); }
        else if option.has-focus { root.reveal-middle(option-scroll.y + option.y, option.height); }
        else if follow-links.has-focus { root.reveal-middle(links-scroll.y + follow-links.y, follow-links.height); }
        else if wait-option.has-focus { root.reveal-middle(wait-scroll.y + wait-option.y, wait-option.height); }
    }
    function focus-primary() {
        // A Fluent button's zero-width focus point sits at its left edge.
        // Keep keyboard input outside the scrolled content when that edge can
        // be clipped; Slint drops keys before ancestor capture in that case.
        primary-focus.focus();
    }
    // The form's own Tab cycle, in the order the controls are shown: 0 the header's
    // close button, 1 the name, 2 the option, 3 the link option, 4 the wait option,
    // 5 Cancel and 6 the primary action. Hidden and disabled stops are skipped.
    pure function stop-available(stop: int) -> bool {
        return stop == 0 ? header.close-focusable
            : stop == 1 ? root.has-name
            : stop == 2 ? root.option-visible && root.option-enabled
            : stop == 3 ? root.follow-directory-links-visible
            : stop == 4 ? root.wait-visible
            : stop == 5 || (stop == 6 && confirm-button.enabled);
    }
    // The first stop at or after `start`, or -1. Cancel is always a stop.
    pure function stop-from(start: int) -> int {
        return start <= 0 && root.stop-available(0) ? 0
            : start <= 1 && root.stop-available(1) ? 1
            : start <= 2 && root.stop-available(2) ? 2
            : start <= 3 && root.stop-available(3) ? 3
            : start <= 4 && root.stop-available(4) ? 4
            : start <= 5 ? 5
            : start <= 6 && root.stop-available(6) ? 6 : -1;
    }
    // The last stop at or before `end`, or -1.
    pure function stop-until(end: int) -> int {
        return end >= 6 && root.stop-available(6) ? 6
            : end >= 5 ? 5
            : end >= 4 && root.stop-available(4) ? 4
            : end >= 3 && root.stop-available(3) ? 3
            : end >= 2 && root.stop-available(2) ? 2
            : end >= 1 && root.stop-available(1) ? 1
            : end >= 0 && root.stop-available(0) ? 0 : -1;
    }
    pure function focused-stop() -> int {
        return header.close-has-focus ? 0 : name.has-focus ? 1 : option.has-focus ? 2
            : follow-links.has-focus ? 3 : wait-option.has-focus ? 4
            : cancel-button.has-focus ? 5 : primary-focus.has-focus ? 6 : -1;
    }
    function focus-stop(stop: int) {
        if stop == 0 { header.focus-close(); }
        else if stop == 1 { root.focus-name(); }
        else if stop == 2 { root.focus-option(); }
        else if stop == 3 { root.focus-directory-links(); }
        else if stop == 4 { root.focus-wait(); }
        else if stop == 6 { root.focus-primary(); }
        else { cancel-button.focus(); }
    }
    // Tab and Shift+Tab move to the next or previous stop and wrap around.
    function move-focus(forward: bool) {
        let current = root.focused-stop();
        let next = forward ? root.stop-from(current + 1) : root.stop-until(current - 1);
        root.focus-stop(next >= 0 ? next : forward ? root.stop-from(0) : root.stop-until(6));
    }
    // Size the initial presentation from its actual wrapped summary. Resizing
    // remains independent in DialogFrame; editing never recreates the input.
    out property <length> preferred-dialog-height: clamp(
        (root.wait-visible ? 28px : 42px)
        + (root.wait-visible ? max(28px, Theme.font-size + 8px) : max(36px, Theme.font-size * 1.2 + 6px))
        + min(280px, summary-measure.preferred-height)
        + (root.has-name ? max(Theme.control-height, name.preferred-height) + root.regular-row-spacing : 0px)
        + (root.has-name && root.input-label != "" ? Theme.font-size * 1.5 + root.regular-row-spacing : 0px)
        + (root.option-visible ? max(Theme.control-height, option.preferred-height)
            + root.regular-row-spacing + (root.wait-visible ? 0px : 12px) : 0px)
        + (root.follow-directory-links-visible ? max(Theme.control-height, follow-links.preferred-height)
            + root.regular-row-spacing : 0px)
        + (root.wait-visible ? max(Theme.control-height, wait-option.preferred-height) + root.regular-row-spacing : 0px)
        + (root.policy != "" ? policy-measure.preferred-height + root.regular-row-spacing : 0px)
        + max(32px, confirm-button.preferred-height) + (root.wait-visible ? 21px : 36px), 220px, 640px);
    // The dialog height counts the summary at its regular-layout width, a warning
    // included as the compact layout draws it (standing in for the separate warning
    // text). It cannot follow `compact`, which depends on that height.
    summary-measure := Text {
        visible: false; accessible-role: none;
        width: root.summary-width(false);
        text: (root.warning != "" ? root.warning + "\n\n" : "") + root.body;
        font-size: Theme.font-size; wrap: word-wrap;
    }
    // The summary box fits exactly what DialogText draws, in either layout; nothing
    // that decides the dialog height reads this measure.
    drawn-summary := Text {
        visible: false; accessible-role: none;
        width: root.summary-width(root.compact);
        text: root.summary;
        font-size: Theme.font-size; wrap: word-wrap;
    }
    policy-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 48px);
        text: root.policy; font-size: Theme.font-size; wrap: word-wrap;
    }
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
    public function begin() {
        middle.content-y = 0px;
        name.text = root.initial-name;
        if root.has-name { root.focus-name(); name.set-selection-offsets(0, root.selection-end); }
        else { root.focus-primary(); }
    }
    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            // A held key confirms nothing: only a new press answers a question.
            if event.repeat && ((event.text == Key.Return && !cancel-button.has-focus)
                    || (event.text == Key.Space && primary-focus.has-focus)) {
                return accept;
            }
            // Enter confirms from the input, option or primary action. Keep
            // focused Cancel and the header close button's own key handlers.
            if (event.text == Key.Return && (primary-focus.has-focus || (name.has-focus && !root.replace-armed)
                    || option.has-focus || follow-links.has-focus || wait-option.has-focus || confirm-button.has-focus))
                || (event.text == Key.Space && primary-focus.has-focus) {
                if confirm-button.enabled { root.confirm(name.text); }
                return accept;
            }
            // Enter in the name field of an armed replacement waits for the button.
            if event.text == Key.Return && name.has-focus { return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                root.move-focus(!event.modifiers.shift && event.text != Key.Backtab);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: root.form-padding(root.compact); spacing: root.row-spacing;
            header := DialogHeader {
                title: root.title; native-icon: root.native-icon; fallback-icon: root.fallback-icon;
                compact: root.compact || root.wait-visible;
                text-size: Theme.font-size * (root.wait-visible ? 1.0 : 1.2);
                foreground: root.dangerous ? Theme.error-text : Theme.text;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            middle := VScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, form.min-height);
                changed height => { root.reveal-focused(); }
                changed content-height => { root.reveal-focused(); }
                form := VerticalLayout {
                    height: middle.content-height;
                    padding-right: FluentScrollMetrics.overlay-size;
                    spacing: root.row-spacing; alignment: start;
                    if root.warning != "" && !root.compact : Text {
                        text: root.warning; color: Theme.error-text; font-weight: 600;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                    Rectangle {
                        height: min(280px, drawn-summary.preferred-height);
                        background: transparent; clip: true;
                        DialogText {
                            x: 0px;
                            y: 0px; width: parent.width; height: parent.height;
                            text: root.summary;
                            min-height: 0px;
                        }
                    }
                    if root.has-name && root.input-label != "" && !root.compact : Text {
                        text: root.input-label; color: Theme.text; font-size: Theme.font-size;
                    }
                    // The themed field: its selected text uses the theme's selection
                    // colours, which the stock LineEdit does not let a host set.
                    name := ThemedLineEdit {
                        min-height: root.name-height; preferred-height: root.name-height;
                        max-height: root.name-height;
                        visible: root.has-name;
                        accessible-label: root.input-label == "" ? root.title : root.input-label;
                        changed has-focus => { if self.has-focus { root.reveal-middle(self.y, self.height); } }
                        accepted => { if root.confirm-enabled && self.text != "" { root.confirm(self.text); } }
                    }
                    option-scroll := HScrollView {
                        visible: root.option-visible; min-width: 0px;
                        height: root.option-visible ? max(Theme.control-height, option.preferred-height)
                            + (root.wait-visible && self.width >= option.preferred-width ? 0px : FluentScrollMetrics.overlay-size) : 0px;
                        horizontal-scrollbar-policy: as-needed;
                        HorizontalLayout {
                            option := HintedCheckBox {
                                text: root.option-label; hint: root.option-hint;
                                enabled: root.option-visible && root.option-enabled;
                                checked <=> root.option-checked;
                                font-size: Theme.font-size;
                                changed has-focus => { if self.has-focus { root.reveal-middle(option-scroll.y + self.y, self.height); } }
                            }
                        }
                    }
                    links-scroll := HScrollView {
                        visible: root.follow-directory-links-visible; min-width: 0px;
                        height: root.follow-directory-links-visible ? max(Theme.control-height, follow-links.preferred-height)
                            + (self.width >= follow-links.preferred-width ? 0px : FluentScrollMetrics.overlay-size) : 0px;
                        horizontal-scrollbar-policy: as-needed;
                        HorizontalLayout {
                            follow-links := HintedCheckBox {
                                text: root.follow-links-label;
                                hint: root.follow-links-hint;
                                enabled: root.follow-directory-links-visible;
                                checked <=> root.follow-directory-links-checked;
                                font-size: Theme.font-size;
                                changed has-focus => { if self.has-focus { root.reveal-middle(links-scroll.y + self.y, self.height); } }
                            }
                        }
                    }
                    wait-scroll := HScrollView {
                        visible: root.wait-visible; min-width: 0px;
                        height: root.wait-visible ? max(Theme.control-height, wait-option.preferred-height)
                            + (self.width >= wait-option.preferred-width ? 0px : FluentScrollMetrics.overlay-size) : 0px;
                        horizontal-scrollbar-policy: as-needed;
                        HorizontalLayout {
                            wait-option := HintedCheckBox {
                                text: "Wait for other operations to finish";
                                hint: "Wait only for Copy/Move operations already unfinished when you confirm. Later operations and Delete are not included.";
                                enabled: root.wait-visible;
                                checked <=> root.wait-checked;
                                font-size: Theme.font-size;
                                changed has-focus => { if self.has-focus { root.reveal-middle(wait-scroll.y + self.y, self.height); } }
                            }
                        }
                    }
                    if root.policy != "" : Text {
                        text: root.policy; color: Theme.secondary-text;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                cancel-button := HintedActionButton { text: "Cancel"; hint: "Leave files unchanged (Escape)."; clicked => { root.cancel(); } }
                Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    height: max(32px, Theme.control-height + (root.compact ? 12px : 0px), confirm-button.preferred-height);
                    primary-scroll := HScrollView {
                        // Positioned, so that its minimum size stays out of the parent's layout info.
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: as-needed;
                        HorizontalLayout { alignment: end;
                            confirm-button := HintedActionButton {
                                primary: true; destructive: root.dangerous;
                                // The operation's own glyph, as in the dialog header; a
                                // compact form trims the padding that the glyph needs.
                                fallback-icon: root.fallback-icon; compact: root.compact;
                                text: root.confirm-text; enabled: root.confirm-enabled && (!root.has-name || name.text != "");
                                accessible-role: none;
                                hint: !root.dangerous ? root.confirm-text
                                    : root.has-name ? "Replace the existing file with an empty file. The original file is kept in a recovery folder."
                                    : "Permanently delete the confirmed targets. This cannot be undone.";
                                clicked => { primary-focus.focus(); root.confirm(name.text); }
                            }
                        }
                    }
                    primary-focus := FocusScope {
                        x: max(0px, parent.width - confirm-button.width);
                        width: min(parent.width, confirm-button.width); height: parent.height;
                        enabled: confirm-button.enabled;
                        focus-on-click: false; focus-on-tab-navigation: false;
                        // This stationary semantic button owns keyboard focus
                        // and accessibility; the native caption owns pointer input.
                        accessible-role: button;
                        accessible-label: root.confirm-text;
                        accessible-enabled: confirm-button.enabled;
                        accessible-action-default => { if confirm-button.enabled { primary-focus.focus(); root.confirm(name.text); } }
                    }
                    Rectangle {
                        x: primary-focus.x;
                        width: primary-focus.width; height: parent.height;
                        background: transparent; border-radius: 3px;
                        border-width: primary-focus.has-focus ? 2px : 0px;
                        border-color: Theme.active-frame; accessible-role: none;
                    }
                }
            }
        }
    }
}
