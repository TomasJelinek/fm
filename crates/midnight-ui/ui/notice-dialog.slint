import { Theme } from "theme.slint";
import { DialogText } from "dialog-text.slint";
import { DialogHeader } from "dialog-frame.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { HScrollView } from "scroll-view.slint";
import { FallbackIcons } from "action-icons.slint";

export component NoticeDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> folder-path;
    in property <string> details;
    in property <bool> can-authorize;
    // The notice's own actions, one button each below its message; Close then cancels.
    in property <[string]> choices;
    in property <bool> cancel;
    in-out property <bool> details-expanded;
    in property <bool> error;
    in property <int> generation;
    callback copy-details();
    callback authorize-retry();
    callback choose(int);
    callback close();
    callback move-dialog(length, length);
    // The height that shows every row below at its natural size with the regular
    // padding and spacing, details collapsed. It depends only on the width, so
    // EmbeddedNotice sizes its dialog from it.
    out property <length> natural-height: 40px + header.regular-height
        + 12px + body-measure.preferred-height
        + (root.folder-path == "" ? 0px : 12px + root.folder-natural)
        + (root.can-authorize ? 12px + hint-measure.preferred-height : 0px)
        + (root.can-authorize && root.narrow ? 12px + copy-button.preferred-height : 0px)
        + root.choices.length * (12px + copy-button.preferred-height)
        + 12px + root.action-row-height;
    // Below this width the authorization offer is a row of its own.
    private property <bool> narrow: root.width < 500px;
    // The folder box shows its whole wrapped path when the dialog has room: its natural
    // height is the label and the measured path inside the box's padding and border, and
    // it takes the height the dialog has to spare. A smaller dialog keeps at least the
    // old three-line box, whose path then scrolls.
    private property <length> folder-height: min(88px, Theme.font-size * 3 + 18px);
    private property <length> folder-natural: 2px + 16px + 3px + folder-label-measure.preferred-height
        + folder-measure.preferred-height;
    private property <length> action-row-height: max(32px, Theme.control-height, copy-button.preferred-height)
        + (root.narrow ? 14px : 0px);
    // The actions beside Close with their captions, measured in the actions' font: each
    // is its caption, its glyph and 28px of padding, 8px from the next, and Details
    // counts as Hide details, so that showing the details moves nothing. Where they do
    // not fit, they show their glyphs only, as a job window's footer does: each keeps its
    // caption as its accessible label and on its tooltip's first line.
    private property <length> action-pad: Theme.icon-size + 28px + 8px;
    private property <length> caption-actions: (root.details != "" ? hide-caption.preferred-width + root.action-pad : 0px)
        + copy-caption.preferred-width + root.action-pad
        + (root.can-authorize && !root.narrow ? authorize-caption.preferred-width + root.action-pad : 0px);
    // Measured with the regular padding, like natural-height, which depends on the
    // buttons' height: the compact padding would follow the dialog's own height.
    private property <bool> glyph-actions: root.caption-actions
        > root.width - 2 * 20px - close-button.preferred-width;
    private property <bool> compact: root.height < 280px;
    // A short dialog has no room for a details box beside the message and the folder
    // box: shown details follow them in the message's own scrolling text instead, and
    // the buttons below stay in view.
    private property <bool> details-inline: root.compact && root.details-expanded && root.details != "";
    // The details box's natural height; a smaller dialog shrinks it, and it scrolls.
    private property <length> details-height: max(60px, root.height * 0.42);
    private property <string> authorization-hint: "Your operating system will ask for permission to read this folder.";
    // Shared by the two placements of the offer. A component derived from the button
    // would be a second generated copy of the whole button.
    private property <string> authorization-text: "Retry with authorization";
    private property <string> authorization-button-hint: "Request operating-system permission for one folder listing.";
    public function focus-close() { close-button.focus(); }
    init => { close-button.focus(); }
    changed generation => { root.details-expanded = false; close-button.focus(); }
    background: Theme.surface; border-color: Theme.active-frame;
    border-width: 1px; border-radius: 6px;
    // Hidden measures of the wrapped texts at the widths the regular layout gives
    // them: DialogText wraps 16px inside its scroll view, the hint fills the row.
    body-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 56px);
        text: root.body; wrap: word-wrap;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    hint-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 40px);
        text: root.authorization-hint; font-size: Theme.small-font; wrap: word-wrap;
    }
    // The folder path wraps inside the box's 8px padding and DialogText's 16px.
    folder-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 72px);
        text: root.folder-path; wrap: word-wrap;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    folder-label-measure := Text {
        visible: false; accessible-role: none;
        text: "Folder"; font-size: Theme.small-font;
    }
    hide-caption := Text {
        visible: false; accessible-role: none; text: "Hide details";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    copy-caption := Text {
        visible: false; accessible-role: none; text: "Copy details";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    authorize-caption := Text {
        visible: false; accessible-role: none; text: root.authorization-text;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    FocusScope {
        // A key router, not a Tab stop.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 12px : 20px;
            spacing: root.compact ? 8px : 12px;
            header := DialogHeader {
                title: root.title; foreground: root.error ? Theme.error-text : Theme.strong-text;
                error: root.error;
                fallback-icon: FallbackIcons.about;
                text-size: Theme.font-size * 1.25; compact: root.compact;
                close-label: "Close dialog"; close => { root.close(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            // With a folder box the message keeps its own height and the box takes the rest;
            // with the details inline, the message text takes it.
            DialogText {
                text: !root.details-inline ? root.body
                    : root.body + (root.folder-path == "" ? "" : "\n\nFolder: " + root.folder-path)
                        + "\n\n" + root.details;
                min-height: 0px;
                preferred-height: body-measure.preferred-height;
                vertical-stretch: root.folder-path == "" || root.details-inline ? 1 : 0;
            }
            for choice[index] in root.choices: HintedActionButton {
                text: choice; fallback-icon: FallbackIcons.close;
                clicked => { root.choose(index); }
            }
            if root.folder-path != "" && !root.details-inline: Rectangle {
                background: Theme.secondary-surface; border-color: Theme.frame;
                border-width: 1px; border-radius: 3px;
                min-height: min(root.folder-natural, root.folder-height);
                preferred-height: root.folder-natural;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 8px; spacing: 3px;
                    Text { text: "Folder"; color: Theme.secondary-text; font-size: Theme.small-font; }
                    DialogText { text: root.folder-path; vertical-stretch: 1; min-height: 0px; }
                }
            }
            if root.can-authorize: Text {
                text: root.authorization-hint;
                color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap;
            }
            if root.details-expanded && root.details != "" && !root.details-inline: Rectangle {
                background: Theme.secondary-surface; border-color: Theme.frame;
                border-width: 1px; border-radius: 3px;
                // Never taller than its natural height, so the message and folder box keep
                // the room a tall dialog spares; it gives way before the buttons do.
                min-height: 0px; preferred-height: root.details-height;
                max-height: root.details-height; vertical-stretch: 1;
                VerticalLayout {
                    padding: 8px;
                    DialogText { text: root.details; vertical-stretch: 1; min-height: 0px; }
                }
            }
            if root.can-authorize && root.narrow: HintedActionButton {
                text: root.authorization-text; fallback-icon: FallbackIcons.refresh;
                hint: root.authorization-button-hint;
                clicked => { root.authorize-retry(); }
            }
            HorizontalLayout {
                spacing: 8px;
                HScrollView {
                    horizontal-stretch: 1; min-width: 0px;
                    height: root.action-row-height;
                    horizontal-scrollbar-policy: as-needed;
                    HorizontalLayout {
                        alignment: start; spacing: 8px;
                        if root.details != "": HintedActionButton {
                            private property <string> caption: root.details-expanded ? "Hide details" : "Details";
                            text: root.glyph-actions ? "" : self.caption;
                            accessible-label: self.caption;
                            fallback-icon: FallbackIcons.properties;
                            hint: (root.glyph-actions ? self.caption + "\n" : "") + "Show or hide diagnostic details.";
                            clicked => { root.details-expanded = !root.details-expanded; }
                        }
                        copy-button := HintedActionButton {
                            text: root.glyph-actions ? "" : "Copy details";
                            accessible-label: "Copy details";
                            fallback-icon: FallbackIcons.copy;
                            hint: (root.glyph-actions ? "Copy details\n" : "")
                                + "Copy the complete message and diagnostic report to the clipboard.";
                            clicked => { root.copy-details(); }
                        }
                        if root.can-authorize && !root.narrow: HintedActionButton {
                            text: root.glyph-actions ? "" : root.authorization-text;
                            accessible-label: root.authorization-text;
                            fallback-icon: FallbackIcons.refresh;
                            hint: (root.glyph-actions ? root.authorization-text + "\n" : "") + root.authorization-button-hint;
                            clicked => { root.authorize-retry(); }
                        }
                    }
                }
                close-button := HintedActionButton {
                    text: root.cancel ? "Cancel" : "Close"; fallback-icon: FallbackIcons.close;
                    hint: root.cancel ? "Keep everything as it is (Escape)." : "Close this message (Escape).";
                    clicked => { root.close(); }
                }
            }
        }
    }
}
