import { Theme } from "theme.slint";
import { DialogText } from "dialog-text.slint";
import { DialogHeader, DialogWindowStyle } from "dialog-frame.slint";
import { ErrorGlyph } from "error-notice.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { ScrollView } from "std-widgets.slint";
import { FallbackIcons } from "action-icons.slint";

export component NoticeDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <bool> error;
    in property <int> generation;
    callback copy-details();
    callback close();
    callback move-dialog(length, length);
    init => { close-button.focus(); }
    changed generation => { close-button.focus(); }
    background: Theme.surface; border-color: Theme.active-frame;
    border-width: 1px; border-radius: 6px;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.height < 280px ? 8px : 20px; spacing: root.height < 280px ? 4px : 16px;
            DialogHeader {
                title: root.title; foreground: root.error ? Theme.error-text : Theme.strong-text;
                error: root.error;
                fallback-icon: FallbackIcons.about;
                text-size: Theme.font-size * 1.25; compact: root.height < 280px;
                close-label: "Close dialog"; close => { root.close(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            if root.error && DialogWindowStyle.native-titlebar: HorizontalLayout {
                spacing: 8px; cross-axis-alignment: center;
                ErrorGlyph {}
                Text { text: root.title; color: Theme.error-text; font-weight: 600;
                    overflow: elide; horizontal-stretch: 1; min-width: 0px; }
            }
            Rectangle { height: 1px; background: Theme.frame; }
            DialogText { text: root.body; vertical-stretch: 1; min-height: 0px; }
            HorizontalLayout {
                spacing: 8px;
                ScrollView {
                    horizontal-stretch: 1; min-width: 0px;
                    height: max(32px, Theme.control-height, copy-button.preferred-height) + (root.width < 500px ? 14px : 0px);
                    horizontal-scrollbar-policy: as-needed; vertical-scrollbar-policy: always-off;
                    HorizontalLayout {
                        alignment: start;
                copy-button := HintedActionButton {
                    text: "Copy details"; fallback-icon: FallbackIcons.copy; hint: "Copy the complete message, including paths, to the clipboard.";
                    clicked => { root.copy-details(); }
                }
                    }
                }
                close-button := HintedActionButton {
                    text: "Close"; fallback-icon: FallbackIcons.close; hint: "Close this message (Escape).";
                    clicked => { root.close(); }
                }
            }
        }
    }
}
