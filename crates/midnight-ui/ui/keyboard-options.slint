import { TextEdit } from "std-widgets.slint";
import { CompactPicker } from "controls.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { Theme } from "theme.slint";

export component KeyboardOptions inherits VerticalLayout {
    in property <[string]> actions;
    in property <int> selected;
    in property <string> action-id;
    in property <string> bindings;
    in property <string> revision;
    in property <string> scope;
    in property <string> error;
    callback select(int);
    callback apply(string, string);
    callback restore(string);
    callback restore-all();
    spacing: 10px; alignment: start;
    changed action-id => { editor.text = root.bindings; }
    changed revision => { editor.text = root.bindings; }
    init => { editor.text = root.bindings; }
    Text { text: "Action"; color: Theme.text; font-size: Theme.font-size; }
    CompactPicker {
        model: root.actions; current-index: root.selected;
        label: root.selected >= 0 && root.selected < root.actions.length ? root.actions[root.selected] : "";
        accessible-name: "Shortcut action"; show-row-icons: false;
        popup-width: min(640px, root.width);
        hint: "Choose the application action whose shortcuts you want to change.";
        selected(index) => { root.select(index); }
    }
    Text { text: root.scope; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
    editor := TextEdit {
        accessible-label: "Shortcut bindings";
        height: max(72px, Theme.font-size * 3.2);
        font-size: Theme.font-size; wrap: no-wrap;
    }
    Text {
        text: "One shortcut per line, up to four. Example: Ctrl+Alt+Y. Use named keys such as Enter, F2, Digit1 or Plus.";
        color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap;
    }
    if root.error != "" : Text {
        text: root.error; color: Theme.error-text; font-size: Theme.font-size; wrap: word-wrap;
        accessible-label: root.error;
    }
    HorizontalLayout {
        spacing: 8px;
        HintedActionButton {
            text: "Apply shortcut"; hint: "Replace all shortcuts for this action and save the change.";
            clicked => { root.apply(root.action-id, editor.text); }
        }
        HintedActionButton {
            text: "Disable shortcut"; hint: "Remove every shortcut for this action.";
            clicked => { root.apply(root.action-id, ""); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        HintedActionButton {
            text: "Restore default"; hint: "Restore this action's default shortcuts.";
            clicked => { root.restore(root.action-id); }
        }
        HintedActionButton {
            text: "Restore all shortcuts"; hint: "Restore the default shortcuts for every action.";
            clicked => { root.restore-all(); }
        }
    }
}
