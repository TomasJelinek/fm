import { FileListDialog } from "file-list-dialog.slint";
import { ToolWindow } from "tool-window.slint";
import { FallbackIcons } from "action-icons.slint";

// Standalone geometry fixture; production hosts FileListDialog in the main window.
export component FileListWindow inherits ToolWindow {
    title: "Make File List · Midnight Explorer";
    icon: FallbackIcons.make-file-list;
    preferred-width: 720px; preferred-height: 520px;
    in-out property <string> template-text <=> form.template-text;
    in property <[string]> template-history <=> form.template-history;
    in property <[string]> variable-labels <=> form.variable-labels;
    in-out property <int> destination <=> form.destination;
    in-out property <string> destination-path <=> form.destination-path;
    in-out property <bool> append-output <=> form.append-output;
    in property <bool> busy <=> form.busy;
    in property <string> preview-text <=> form.preview-text;
    in property <string> error-text <=> form.error-text;
    in property <string> summary <=> form.summary;
    in property <bool> conflict-pending <=> form.conflict-pending;
    in property <string> conflict-text <=> form.conflict-text;
    in property <string> preview-font-family <=> form.preview-font-family;
    out property <int> template-anchor <=> form.template-anchor;
    out property <int> template-cursor <=> form.template-cursor;
    callback template-edited(string);
    callback insert-variable(int);
    callback select-history(int);
    callback select-preset(int);
    callback browse();
    callback generate();
    callback cancel();
    callback copy-error(string);
    callback confirm();
    request-close => { root.cancel(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    public function begin() { form.begin(); }
    public function focus-template-at(offset: int) { form.focus-template-at(offset); }
    public function submit() { form.submit(); }
    form := FileListDialog {
        width: root.width; height: root.height;
        template-edited(text) => { root.template-edited(text); }
        insert-variable(index) => { root.insert-variable(index); }
        select-history(index) => { root.select-history(index); }
        select-preset(index) => { root.select-preset(index); }
        browse => { root.browse(); }
        generate => { root.generate(); }
        cancel => { root.cancel(); }
        copy-error(text) => { root.copy-error(text); }
        confirm => { root.confirm(); }
    }
}
