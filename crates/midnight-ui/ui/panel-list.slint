import { ScrollView } from "scroll-view.slint";

// Slint 1.18 recognizes virtualized repeaters by the component's original
// name. Inheriting its ListView under a different name loses virtualization.
// Match the SDK ListView shell and export an alias to retain that optimization.
component ListView inherits ScrollView {
    in property <length> row-height;
    // Also draw the bands the viewport cuts at its edges. The thumbnail grid's
    // bands are too tall to leave blank; list views show whole rows only.
    in property <bool> partial-bands;
    callback user-scrolled();

    private property <int> first-complete-band: ceil(-root.content-y / root.row-height);
    private property <int> past-complete-band: floor((root.visible-height - root.content-y) / root.row-height);
    private property <int> first-partial-band: floor(-root.content-y / root.row-height);
    private property <int> past-partial-band: ceil((root.visible-height - root.content-y) / root.row-height);

    private property <bool> align-single-band: !root.partial-bands
        && root.visible-height >= root.row-height
        && root.visible-height < 2 * root.row-height;
    // The band at the viewport midpoint is already materialized. It includes
    // the first and last bands at the native scroll bounds and retains a fully
    // revealed cursor band when one fits.
    private property <int> compact-band: floor((root.visible-height / 2 - root.content-y) / root.row-height);
    out property <length> row-content-y: root.align-single-band
        ? -root.compact-band * root.row-height : root.content-y;
    out property <length> row-y-shift: root.row-content-y - root.content-y;

    pure public function band-visible(band: int) -> bool {
        if root.align-single-band { return band == root.compact-band; }
        if root.partial-bands {
            return band >= root.first-partial-band && band < root.past-partial-band;
        }
        // Use the native clip if even one row is taller than the pane.
        return root.visible-height < root.row-height
            || (band >= root.first-complete-band && band < root.past-complete-band);
    }

    // Explicit navigation can supersede in-flight native wheel or touch motion.
    public function stop-scroll-motion() {
        let position = root.content-y;
        root.content-y = position;
    }

    // Slint's physics binding intercepts plain writes. An immediate animation
    // replaces that binding for explicit writes while native gestures keep
    // their own physics animations.
    animate content-y { duration: 0ms; }

    scrolled => { root.user-scrolled(); }
    accessible-role: list;
    accessible-orientation: vertical;
    @children
}

export { ListView as PanelList }
