import { ScrollView } from "scroll-view.slint";

// Slint 1.18 recognizes virtualized repeaters by the component's original
// name. Inheriting its ListView under a different name loses virtualization.
// Match the SDK ListView shell and export an alias to retain that optimization.
component ListView inherits ScrollView {
    in property <length> row-height;
    // Input that is still moving or holding the list: a native wheel glide,
    // touchpad fingers or momentum, a held button or touch. Rows settle only
    // after it ends.
    in property <bool> interaction-active;
    // Settle on the nearest row once a user scroll has come to rest. The tall
    // bands of the thumbnail grid keep their pixel position instead: rounding
    // them would undo a small gesture.
    in property <bool> settle-rows: true;
    // The system asks for less motion (Windows: animation effects off): the
    // alignment then moves at once.
    in property <bool> reduce-motion;
    // Options › Appearance › Scrolling glide: the alignment's length scale; 0 moves at once.
    in property <float> glide-scale: 1;
    callback user-scrolled();

    // Every band the viewport intersects is drawn, also one cut by an edge, so
    // no offset leaves a blank band (docs/developer/scrolling.md).
    private property <int> first-band: floor(-root.content-y / root.row-height);
    private property <int> past-band: ceil((root.visible-height - root.content-y) / root.row-height);

    pure public function band-visible(band: int) -> bool {
        return band >= root.first-band && band < root.past-band;
    }

    // A user scroll leaves the list unsettled until it rests on a row boundary.
    private property <bool> unsettled;
    private property <bool> settling;
    private property <length> settle-from;
    private property <length> settle-target;
    private property <duration> settle-start;
    // The position at the latest idle check, and whether input scrolled since.
    private property <length> resting-y;
    private property <bool> scrolled-since-check;
    private property <length> lowest: min(0px, root.visible-height - root.content-height);

    pure function nearest-row() -> length {
        let position = clamp(root.content-y, root.lowest, 0px);
        // The exact bottom stays: its last row ends at the bottom edge, and the
        // row cut at the top is drawn.
        return position <= root.lowest ? root.lowest
            : clamp(round(position / root.row-height) * root.row-height, root.lowest, 0px);
    }

    // Stop a running alignment where it is; the idle check aligns afresh.
    function interrupt-settle() {
        if root.settling {
            root.settling = false;
            root.resting-y = root.content-y;
        }
    }

    // The virtualized list refines its content height whenever its rows change;
    // only a change that moves the target restarts the alignment.
    function reconsider-settle() {
        if root.settling && abs(root.nearest-row() - root.settle-target) >= 0.01px {
            root.interrupt-settle();
        }
    }

    // Explicit navigation supersedes in-flight native wheel or touch motion and
    // any pending or running row alignment.
    public function stop-scroll-motion() {
        root.unsettled = false;
        root.settling = false;
        let position = root.content-y;
        root.content-y = position;
    }

    // Slint's physics binding intercepts plain writes. An immediate animation
    // replaces that binding for explicit writes while native gestures keep
    // their own physics animations.
    animate content-y { duration: 0ms; }

    scrolled => {
        root.user-scrolled();
        // New input ends a running alignment where it is.
        root.settling = false;
        root.unsettled = root.settle-rows && root.row-height > 0px;
        root.scrolled-since-check = true;
    }
    changed interaction-active => {
        if root.interaction-active {
            root.interrupt-settle();
        } else {
            // The input that held the list ended: its idle interval starts now.
            root.scrolled-since-check = false;
            root.resting-y = root.content-y;
        }
    }
    changed row-height => { root.reconsider-settle(); }
    changed visible-height => { root.reconsider-settle(); }
    changed content-height => { root.reconsider-settle(); }
    changed settle-rows => {
        if !root.settle-rows { root.interrupt-settle(); root.unsettled = false; }
    }

    idle := Timer {
        interval: 100ms;
        running: root.unsettled && !root.settling && !root.interaction-active;
        triggered => {
            // A whole interval without input or motion: Slint's own wheel easing
            // or fling may still move the list.
            if root.scrolled-since-check || abs(root.content-y - root.resting-y) >= 0.01px {
                root.scrolled-since-check = false;
                root.resting-y = root.content-y;
                return;
            }
            let target = root.nearest-row();
            if abs(target - root.content-y) < 0.01px || root.reduce-motion || root.glide-scale <= 0 {
                root.unsettled = false;
                root.content-y = target;
                return;
            }
            root.settle-from = root.content-y;
            root.settle-target = target;
            root.settle-start = animation-tick();
            root.settling = true;
        }
    }
    // The alignment's frames: the wheel glide's 200 ms ease-out, written on every
    // tick, so a layout pass of the virtualized list that writes the viewport (it
    // would end a property animation) cannot stop it halfway.
    glide := Timer {
        interval: 8ms;
        running: root.settling;
        triggered => {
            // Input in this event-loop turn already ended the alignment.
            if !root.settling || root.interaction-active { return; }
            let progress = root.glide-scale <= 0 ? 1
                : min(1, (animation-tick() - root.settle-start) / (200ms * root.glide-scale));
            if progress >= 1 {
                root.settling = false;
                root.unsettled = false;
                root.content-y = root.settle-target;
                return;
            }
            root.content-y = root.settle-from
                + (root.settle-target - root.settle-from) * (1 - (1 - progress) * (1 - progress));
        }
    }

    accessible-role: list;
    accessible-orientation: vertical;
    @children
}

export { ListView as PanelList }
