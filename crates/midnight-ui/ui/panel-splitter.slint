import { Theme } from "theme.slint";

export component PanelSplitter inherits Rectangle {
    in property <length> available-width;
    in property <length> minimum-pane-width;
    in-out property <float> fraction: 0.5;
    callback centered();
    callback resized();
    callback committed(float);
    private property <bool> dragging;
    private property <float> drag-start-fraction;
    public function center() {
        root.fraction = 0.5; root.centered(); root.committed(root.fraction);
    }
    width: Theme.touch ? 12px : 6px;
    accessible-role: button;
    accessible-label: "Panel splitter";
    accessible-action-default => { root.center(); }
    forward-focus: focus;
    public function adjust(delta: length) {
        if root.available-width > 0px {
            let minimum = min(0.5, root.minimum-pane-width / root.available-width);
            root.fraction = clamp((root.x + delta) / root.available-width,
                minimum, 1 - minimum);
            root.resized();
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2; width: 1px; height: parent.height;
        background: area.has-hover || area.pressed || focus.has-focus
            ? Theme.active-frame : Theme.frame;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text == Key.LeftArrow {
                    root.adjust(-12px); root.committed(root.fraction); return accept;
                }
                if event.text == Key.RightArrow {
                    root.adjust(12px); root.committed(root.fraction); return accept;
                }
                if event.text == Key.Return { root.center(); return accept; }
            }
            reject
        }
        area := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.dragging = true; root.drag-start-fraction = root.fraction;
                }
                if root.dragging && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.dragging = false;
                    if root.fraction != root.drag-start-fraction { root.committed(root.fraction); }
                }
            }
            moved => { if self.pressed { root.adjust(self.mouse-x - self.pressed-x); } }
            clicked => { focus.focus(); }
            double-clicked => { root.center(); }
        }
    }
}
