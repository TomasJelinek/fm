export struct FileRow {
    identity: string,
    tree-depth: int,
    // None, unknown, loading, collapsed, expanded, empty, failed.
    tree-disclosure: int,
    tree-expanded: bool,
    tree-error: string,
    name: string,
    parent-entry: bool,
    prefix-end: int,
    compressed: bool,
    browsable-archive: bool,
    dim-icon: bool,
    size: string,
    size-state: int,
    // Active calculation is independent of retained warning severity.
    size-running: bool,
    size-hint: string,
    warning-revision: string,
    modified-date: string,
    modified-time: string,
    kind: string,
    icon: image,
    directory: bool,
    selected: bool,
    cursor: bool,
    color-rule: bool,
    custom-foreground: bool,
    foreground: color,
    custom-background: bool,
    background: color,
}

// Captured before Flickable can defer a native touch's child pointer-down.
export struct TreePress {
    active: bool,
    cancelled: bool,
    control: bool,
    identity: string,
    disclosure: int,
    expanded: bool,
    context: string,
    view-mode: int,
}
