import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TipBody } from "controls.slint";
import { DetailRow } from "navigation-models.slint";

component DetailField inherits Rectangle {
    in property <DetailRow> field;
    in property <int> revision;
    in property <bool> primary;
    out property <length> natural-width: value.preferred-width + 16px;
    callback copy-field(string);
    private property <string> copy-hint: "Click to copy this value."
        + (field.label == "Name" ? "\nCtrl+click to copy the full path when a native path is available." : "");
    background: area.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.active-frame : transparent;
    accessible-role: button;
    accessible-label: field.label + ": " + field.value + ". Copy to clipboard";
    accessible-description: (field.explanation == "" ? "" : field.explanation + "\n") + root.copy-hint;
    accessible-action-default => { root.copy-field(field.identity); }
    forward-focus: focus;
    value := Text {
        x: 7px; width: max(0px, parent.width - 14px); height: parent.height;
        text: field.value; font-size: Theme.small-font;
        color: root.primary ? Theme.text : Theme.secondary-text;
        vertical-alignment: center; overflow: elide;
    }
    if !root.primary : Rectangle {
        x: 0px; y: 5px; width: 1px; height: max(0px, parent.height - 10px);
        background: Theme.frame;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt
                && !event.modifiers.shift && !event.modifiers.meta
                && (event.text == Key.Return || event.text == Key.Space) {
                root.copy-field(field.identity); return accept;
            }
            reject
        }
        area := TouchArea {
            private property <string> pressed-id;
            private property <int> pressed-revision;
            private property <bool> pressed-full-path;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.pressed-id = field.identity;
                    self.pressed-revision = root.revision;
                    self.pressed-full-path = event.modifiers.control && field.label == "Name";
                } else if event.kind == PointerEventKind.cancel {
                    self.pressed-id = "";
                }
            }
            clicked => {
                if self.pressed-id == field.identity && self.pressed-revision == root.revision {
                    focus.focus();
                    root.copy-field(self.pressed-full-path ? "path:" + self.pressed-id : self.pressed-id);
                }
            }
        }
    }
    Tooltip {
        TipBody {
            text: field.label + ": " + field.value
                + (field.explanation == "" ? "" : "\n" + field.explanation)
                + "\n" + root.copy-hint;
        }
    }
}

// Give the filename (or selection summary) its natural width first. Other
// details use the remainder; their clipping never changes the clipboard value.
export component PanelDetails inherits Rectangle {
    in property <[DetailRow]> model;
    in property <string> free-space;
    callback copy-field(string);
    private property <int> revision;
    private property <length> remaining: max(0px, root.width - primary.width - 2px);
    changed model => { root.revision += 1; }
    height: Theme.status-height;
    background: Theme.secondary-surface;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.frame; }
    primary := DetailField {
        x: 1px; y: 1px; height: root.height - 2px;
        width: root.model.length == 0 ? 0px : min(self.natural-width, max(0px, root.width - 2px));
        visible: root.model.length > 0;
        field: root.model[0]; revision: root.revision; primary: true;
        copy-field(identity) => { root.copy-field(identity); }
    }
    capacity := Rectangle {
        width: root.free-space == "" ? 0px
            : min(root.remaining, min(root.width * 0.38, capacity-text.preferred-width + 16px));
        x: root.width - self.width; y: 1px; height: root.height - 1px;
        clip: true;
        visible: self.width > 16px;
        background: Theme.secondary-surface;
        accessible-role: button;
        accessible-label: root.free-space + ". Copy to clipboard";
        accessible-action-default => { root.copy-field("capacity:" + root.free-space); }
        Rectangle { x: 0px; y: 5px; width: 1px; height: parent.height - 10px; background: Theme.frame; }
        capacity-text := Text {
            x: 8px; width: max(0px, parent.width - 16px); height: parent.height;
            text: root.free-space; font-size: Theme.small-font; color: Theme.secondary-text;
            horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            accessible-role: text; accessible-label: root.free-space;
        }
        TouchArea {
            private property <string> pressed-value;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.pressed-value = root.free-space;
                }
            }
            clicked => {
                if self.pressed-value == root.free-space { root.copy-field("capacity:" + self.pressed-value); }
            }
        }
        Tooltip { TipBody { text: root.free-space + "\nClick to copy this value."; } }
    }
    ScrollView {
        x: primary.x + primary.width; y: 1px;
        width: max(0px, root.remaining - capacity.width); height: parent.height - 2px;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;
        HorizontalLayout {
            spacing: 0px; alignment: start;
            for field[index] in root.model : DetailField {
                visible: index > 0;
                width: index == 0 ? 0px : self.natural-width;
                height: Theme.status-height - 2px;
                field: field; revision: root.revision;
                copy-field(identity) => { root.copy-field(identity); }
            }
        }
    }
}
