import { NavigationButton } from "navigation-controls.slint";
import { DialogHeader } from "dialog-frame.slint";
import { HintedActionButton, HintedComboBox } from "hinted-inputs.slint";
import { VScrollView } from "scroll-view.slint";
import { ListView } from "vlist-view.slint";
import { Theme } from "theme.slint";
import { PathText } from "path-text.slint";
import { Tip, TipBody } from "controls.slint";
import { BookmarkRow } from "navigation-models.slint";
import { ActionIcons, FallbackIcons } from "action-icons.slint";
import { ShortcutHints } from "shortcut-hints.slint";
export component HotPathsDialog inherits Rectangle {
    in property <[BookmarkRow]> model;
    in property <ActionIcons> action-icons;
    in property <string> path;
    in property <string> path-tail;
    private property <int> draft-slot;
    private property <string> selected-identity;
    private property <int> revision;
    callback assign-bookmark(string, int);
    callback remove-bookmark(string);
    callback add-bookmark();
    callback dismiss();
    callback move-dialog(length, length);
    changed model => { root.revision += 1; }
    // The height that shows the whole manager without scrolling, with the regular
    // padding and spacing. It depends only on the width, so EmbeddedHotPaths sizes
    // its dialog from it. (The content's own preferred height would not do: its
    // width follows the padding, and the padding follows the dialog's height.)
    out property <length> natural-height: 32px + header.regular-height + 10px
        + root.list-height + 8px + hint-measure.preferred-height
        + 8px + (root.stacked
            ? max(Theme.control-height, slot-picker.preferred-height) + 8px
                + max(Theme.control-height, apply-button.preferred-height)
            : max(Theme.control-height, slot-picker.preferred-height, apply-button.preferred-height))
        + 8px + current-path.preferred-height
        + 8px + max(Theme.control-height, add-current.preferred-height)
        + 10px + max(Theme.control-height, bookmark-close.preferred-height);
    private property <length> row-height: max(44px, Theme.font-size + Theme.small-font + 12px);
    // No saved path: the hint below is the empty state, not a blank row.
    private property <length> list-height: root.row-height * clamp(root.model.length, 0, 5);
    // Narrow managers put Apply shortcut below the shortcut picker.
    private property <bool> stacked: root.width < max(440px, Theme.font-size * 25);
    private property <string> hint: root.model.length == 0
        ? "Add the current folder to create your first Hot Path."
        : "Select a path to change its numbered shortcut.";
    // Entering the compact layout can clip the focused control; move focus once
    // when the layout changes, never on every resize step inside it.
    private property <bool> compact: root.width < 400px || root.height < 350px;
    changed compact => { if root.compact { bookmark-close.focus(); } }
    public function begin() {
        if root.compact { bookmark-close.focus(); }
        else { slot-picker.focus(); }
    }
    pure function slot-label(slot: int) -> string {
        return ShortcutHints.hint("Hot Path " + (slot == 10 ? 0 : slot), "bookmark.open." + slot);
    }
    function select-bookmark(identity: string, slot: int) {
        root.selected-identity = identity;
        root.draft-slot = slot;
    }
    background: Theme.surface; border-radius: 8px; border-color: Theme.active-frame; border-width: 1px;
    // A hidden measure of the wrapped hint at the width of the regular layout.
    hint-measure := Text {
        visible: false; accessible-role: none;
        width: max(1px, root.width - 32px);
        text: root.hint; font-size: Theme.small-font; wrap: word-wrap;
    }
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.height < 350px ? 6px : 16px;
            spacing: root.height < 350px ? 4px : 10px;
            header := DialogHeader { title: "Manage Hot Paths"; compact: root.height < 350px;
                close-label: "Close dialog"; close => { root.dismiss(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
                fallback-icon: FallbackIcons.bookmarks; }
            VScrollView {
                min-height: 0px; vertical-stretch: 1;
                content-width: self.visible-width;
                // Spare height of a taller dialog stays below the controls instead of
                // opening gaps between them.
                VerticalLayout { spacing: 8px; alignment: start;
                    ListView {
                        height: root.list-height;
                        for bookmark[index] in root.model : Rectangle {
                            height: root.row-height;
                            background: bookmark.identity == root.selected-identity ? Theme.selected-background : row-area.has-hover ? Theme.hover : transparent;
                            border-width: 1px; border-color: bookmark-focus.has-focus ? Theme.active-frame : transparent;
                            accessible-role: button;
                            accessible-label: bookmark.path + (bookmark.slot > 0 ? "\n" + root.slot-label(bookmark.slot) : "");
                            accessible-checkable: true;
                            accessible-checked: bookmark.identity == root.selected-identity;
                            accessible-action-default => { root.select-bookmark(bookmark.identity, bookmark.slot); }
                            forward-focus: bookmark-focus;
                            VerticalLayout {
                                padding-left: 8px; padding-right: Theme.control-height + 8px; spacing: 0px;
                                // Long paths omit their middle: saved folders often share a parent.
                                PathText { text: bookmark.path; tail: bookmark.path-tail; foreground: Theme.text; font-size: Theme.font-size; }
                                Text { text: bookmark.slot > 0 ? root.slot-label(bookmark.slot) : "No numbered shortcut"; color: Theme.secondary-text; font-size: Theme.small-font; vertical-alignment: center; overflow: elide; }
                            }
                            bookmark-focus := FocusScope {
                                width: parent.width; height: parent.height;
                                key-pressed(event) => {
                                    if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta
                                    && (event.text == Key.Return || event.text == Key.Space) {
                                        root.select-bookmark(bookmark.identity, bookmark.slot); return accept;
                                    }
                                    reject
                                }
                                row-area := TouchArea {
                                    Tip { text: bookmark.path; }
                                    width: parent.width; height: parent.height;
                                    private property <string> pressed-id;
                                    private property <int> pressed-revision;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down { self.pressed-id = bookmark.identity; self.pressed-revision = root.revision; }
                                    }
                                    clicked => {
                                        if self.pressed-id == bookmark.identity && self.pressed-revision == root.revision
                                        && root.model[index].identity == self.pressed-id {
                                            bookmark-focus.focus();
                                            root.select-bookmark(self.pressed-id, bookmark.slot);
                                        }
                                    }
                                }
                            }
                            NavigationButton {
                                x: parent.width - self.width; y: (parent.height - self.height) / 2;
                                identity: bookmark.identity; model-revision: root.revision;
                                icon: FallbackIcons.remove-bookmark;
                                native-icon: root.action-icons.remove-bookmark;
                                hint: "Remove Hot Path: " + bookmark.path + "\nThe folder is kept.";
                                clicked => {
                                    if root.selected-identity == bookmark.identity { root.selected-identity = ""; root.draft-slot = 0; }
                                    root.remove-bookmark(bookmark.identity);
                                }
                            }
                        }
                    }
                    Text { text: root.hint; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
                    GridLayout {
                        spacing: 8px;
                        slot-picker := HintedComboBox {
                            row: 0; col: 0; min-width: 0px; horizontal-stretch: 1;
                            accessible-label: "Hot Path shortcut";
                            min-height: Theme.control-height;
                            model: ["No numbered shortcut", root.slot-label(1), root.slot-label(2), root.slot-label(3), root.slot-label(4), root.slot-label(5), root.slot-label(6), root.slot-label(7), root.slot-label(8), root.slot-label(9), root.slot-label(10)];
                            // Selecting a path changes the draft from outside; native
                            // selection would detach a one-way binding.
                            current-index <=> root.draft-slot;
                            hint: "Number for the selected path. Occupied numbers are exchanged; every saved folder is kept. Configure keys in Options → Keyboard.";
                        }
                        apply-button := HintedActionButton {
                            row: root.stacked ? 1 : 0;
                            col: root.stacked ? 0 : 1;
                            horizontal-stretch: 0;
                            text: "Apply shortcut"; enabled: root.selected-identity != ""; min-height: Theme.control-height;
                            hint: "Apply the numbered shortcut to the selected saved path.";
                            clicked => { root.assign-bookmark(root.selected-identity, root.draft-slot); }
                        }
                    }
                    current-path := PathText {
                        text: "Current folder: " + root.path; tail: root.path-tail;
                        foreground: Theme.secondary-text; font-size: Theme.small-font;
                        Tooltip { TipBody { text: root.path; } }
                    }
                    add-current := HintedActionButton {
                        native-icon: root.action-icons.add-bookmark; fallback-icon: FallbackIcons.add-bookmark;
                        text: "Add current"; min-height: Theme.control-height;
                        hint: "Save the current folder once, using the first free numbered shortcut.";
                        clicked => { root.add-bookmark(); }
                    }
                }
            }
            bookmark-close := HintedActionButton {
                text: "Close"; min-height: Theme.control-height;
                native-icon: root.action-icons.close; fallback-icon: FallbackIcons.close;
                hint: "Close Bookmarks and return to the file panel.";
                clicked => { root.dismiss(); }
            }
        }
    }
}
