import { ActionButton } from "action-icons.slint";
import { TextEdit } from "std-widgets.slint";
import { HintedCheckBox, HintedComboBox, HintedLineEdit } from "hinted-inputs.slint";
import { ArgumentEditor } from "argument-editor.slint";
import { UserCommandSettingsView } from "user-command-models.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogText } from "dialog-text.slint";
import { WrappingCheckBox } from "wrapping-check-box.slint";

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    callback edited();
    spacing: 3px;
    Text { text: root.label; color: Theme.text; font-size: Theme.font-size; }
    HintedLineEdit { text <=> root.value; accessible-label: root.label;
        hint: root.label; edited => { root.edited(); } }
}

export component UserCommandForm inherits VerticalLayout {
    in property <bool> narrow;
    callback edited();
    private property <int> script-value;
    spacing: 8px; alignment: start;
    Text { text: "Selected menu item"; color: Theme.strong-text; font-size: Theme.font-size; }
    Field { label: "Command name"; value <=> UserCommandSettingsView.draft.name; edited => { root.edited(); } }
    GridLayout {
        spacing: 8px;
        WrappingCheckBox { row: 0; col: 0; text: "Enabled"; checked <=> UserCommandSettingsView.draft.enabled;
            hint: "Disabled commands stay in the menu settings but cannot run."; toggled => { root.edited(); } }
        HintedComboBox { model: ["Program", "Terminal script (advanced)"]; current-index <=> UserCommandSettingsView.draft.kind;
            row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1; min-width: 0px;
            accessible-label: "Custom Command type"; hint: "Programs receive separate arguments. A terminal runs a script you write.";
            selected(value) => { root.edited(); } }
    }
    if UserCommandSettingsView.draft.kind == 0 : VerticalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Command"; color: Theme.text; font-size: Theme.font-size; }
        GridLayout {
            spacing: 6px;
            HintedLineEdit { text <=> UserCommandSettingsView.draft.executable;
                row: 0; col: 0;
                accessible-label: "Program executable (absolute path)"; hint: "Choose a program or enter its complete path.";
                min-width: 0px; horizontal-stretch: 1;
                edited => { UserCommandSettingsView.draft.executable-edited = true; root.edited(); } }
            ActionButton { text: "Browse…"; accessible-label: "Browse command executable";
                row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
                enabled: !UserCommandSettingsView.busy; clicked => { UserCommandSettingsView.browse(0); } }
        }
        ArgumentEditor {
            narrow: root.narrow;
            values: UserCommandSettingsView.argument-rows; label-prefix: "Command"; command-values: true;
            enabled: !UserCommandSettingsView.busy;
            edit(row, text) => { UserCommandSettingsView.argument(0, row, text); root.edited(); }
            add(text) => { UserCommandSettingsView.argument(1, 0, text); root.edited(); }
            remove(row) => { UserCommandSettingsView.argument(2, row, ""); root.edited(); }
            move(row, direction) => { UserCommandSettingsView.argument(direction < 0 ? -1 : 3, row, ""); root.edited(); }
        }
    }
    if UserCommandSettingsView.draft.kind == 1 : VerticalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Terminal script"; color: Theme.text; font-size: Theme.font-size; }
        HintedComboBox { model: ["PowerShell", "POSIX shell", "Command Prompt"];
            current-index <=> UserCommandSettingsView.draft.shell; accessible-label: "Custom Command shell";
            hint: UserCommandSettingsView.draft.shell == 2
                ? "Command Prompt uses one command line. Inserted values are complete external-program arguments. Keep delayed expansion on. CALL, batch files and nested shells may parse them again; builtins require their own syntax."
                : "Choose the language used by your script."; selected(value) => { root.edited(); } }
        TextEdit { text <=> UserCommandSettingsView.draft.script; accessible-label: "Custom Command script";
            height: max(90px, Theme.font-size * 5); font-size: Theme.font-size;
            edited => { root.edited(); } }
        Text { text: "Script text runs literally. Choose which captured values it needs below.";
            color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
        GridLayout {
            spacing: 6px;
            HintedComboBox { current-index <=> root.script-value; accessible-label: "Terminal script value";
                row: 0; col: 0;
                model: ["Active folder", "Other folder", "File path", "File name", "Name without extension", "Extension"];
                hint: UserCommandSettingsView.draft.shell == 2
                    ? "Insert a complete external-program argument. Do not add quotes around the !ME_*_ARG! reference or use it with CALL. Builtins use raw ME_* values with their own syntax."
                    : "Insert a quoted reference and require its captured value."; min-width: 0px; horizontal-stretch: 1; }
            ActionButton { text: "Insert value"; accessible-label: "Insert terminal script value";
                row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
                clicked => { if UserCommandSettingsView.insert-variable(UserCommandSettingsView.token, UserCommandSettingsView.draft, 2, root.script-value) { root.edited(); } } }
        }
        for label[index] in ["Active folder", "Other folder", "File path", "File name", "Name without extension", "Extension"] : HintedCheckBox {
            text: label;
            checked: index == 0 ? UserCommandSettingsView.draft.active-path : index == 1 ? UserCommandSettingsView.draft.other-path
                : index == 2 ? UserCommandSettingsView.draft.file-path : index == 3 ? UserCommandSettingsView.draft.file-name
                : index == 4 ? UserCommandSettingsView.draft.file-stem : UserCommandSettingsView.draft.file-extension;
            hint: "Require this captured value before the script can run.";
            toggled => {
                if index == 0 { UserCommandSettingsView.draft.active-path = self.checked; }
                else if index == 1 { UserCommandSettingsView.draft.other-path = self.checked; }
                else if index == 2 { UserCommandSettingsView.draft.file-path = self.checked; }
                else if index == 3 { UserCommandSettingsView.draft.file-name = self.checked; }
                else if index == 4 { UserCommandSettingsView.draft.file-stem = self.checked; }
                else { UserCommandSettingsView.draft.file-extension = self.checked; }
                root.edited();
            }
        }
    }
    Text { text: "Initial directory"; color: Theme.text; font-size: Theme.font-size; }
    GridLayout {
        spacing: 6px;
        HintedLineEdit { text <=> UserCommandSettingsView.draft.working-directory; accessible-label: "Working folder";
            row: 0; col: 0;
            hint: "An absolute folder, or a captured folder value."; min-width: 0px; horizontal-stretch: 1;
            edited => { root.edited(); } }
        ActionButton { text: "Browse…"; accessible-label: "Browse working directory";
            row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
            enabled: !UserCommandSettingsView.busy; clicked => { UserCommandSettingsView.browse(1); } }
    }
    GridLayout {
        spacing: 6px;
        ActionButton { row: 0; col: 0; text: "Active folder"; clicked => { UserCommandSettingsView.draft.working-directory = "${active.path}"; root.edited(); } }
        ActionButton { row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1; text: "Other folder"; clicked => { UserCommandSettingsView.draft.working-directory = "${other.path}"; root.edited(); } }
    }
    HintedComboBox { model: ["Run once", "Run for each selected item"]; current-index <=> UserCommandSettingsView.draft.launch;
        accessible-label: "Custom Command execution mode"; hint: "Choose whether to run once or once for every captured selected item.";
        selected(value) => { root.edited(); } }
    Text { text: "Toolbar appearance"; color: Theme.strong-text; font-size: Theme.font-size; }
    Field { label: "Toolbar label (optional)"; value <=> UserCommandSettingsView.draft.toolbar-label; edited => { root.edited(); } }
    GridLayout {
        spacing: 6px;
        HintedLineEdit { text <=> UserCommandSettingsView.draft.icon; accessible-label: "Icon image (optional absolute path)";
            row: 0; col: 0;
            hint: "Choose a PNG or JPEG image. A missing or unsupported image uses the Run icon.";
            min-width: 0px; horizontal-stretch: 1;
            edited => { UserCommandSettingsView.draft.icon-edited = true; root.edited(); } }
        ActionButton { text: "Browse…"; accessible-label: "Browse command icon";
            row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
            enabled: !UserCommandSettingsView.busy; clicked => { UserCommandSettingsView.browse(2); } }
    }
    if UserCommandSettingsView.validation != "" : ErrorNotice { text: UserCommandSettingsView.validation; }
    GridLayout {
        spacing: 6px;
        ActionButton { text: "Update command"; accessible-label: "Apply Custom Command";
            row: 0; col: 0;
            enabled: UserCommandSettingsView.can-apply && !UserCommandSettingsView.busy;
            clicked => { UserCommandSettingsView.apply(UserCommandSettingsView.token, UserCommandSettingsView.draft); } }
        ActionButton { text: "Discard changes"; accessible-label: "Cancel Custom Command draft";
            row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1;
            enabled: UserCommandSettingsView.dirty; clicked => { UserCommandSettingsView.cancel(); } }
        ActionButton { text: "Preview"; accessible-label: "Preview Custom Command";
            row: root.narrow ? 2 : 0; col: root.narrow ? 0 : 2;
            enabled: UserCommandSettingsView.ready && UserCommandSettingsView.can-preview && !UserCommandSettingsView.busy;
            clicked => { UserCommandSettingsView.preview(UserCommandSettingsView.token, UserCommandSettingsView.draft); } }
    }
    if UserCommandSettingsView.preview-text != "" : VerticalLayout {
        spacing: 4px;
        Text { text: "Command preview"; color: Theme.strong-text; font-size: Theme.font-size; }
        DialogText {
            height: max(120px, Theme.font-size * 9);
            text: UserCommandSettingsView.preview-text;
            accessible-role: text;
            accessible-label: "Custom Command preview result";
            foreground: UserCommandSettingsView.preview-failed ? Theme.error-text : Theme.text;
        }
    }
}
