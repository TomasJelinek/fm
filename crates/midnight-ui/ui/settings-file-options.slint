import { Theme } from "theme.slint";
import { Tip } from "controls.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { FallbackIcons } from "action-icons.slint";

// Export/Import configuration in Options: in the footer where they fit, otherwise at
// the end of the General page. The presenter owns this state; choosing files,
// reading, writing and validation happen on backend workers.
export global SettingsFileView {
    // A chooser or settings-file transfer is outstanding; no second one may start.
    in property <bool> busy;
    // An import is being read or staged; OK and Reset wait for it.
    in property <bool> importing;
    // The latest result in this Options session; empty when there is none.
    in property <string> message;
    in property <bool> error;
    // The chosen export destination already exists: Replace or Keep.
    in property <bool> replace-pending;
    callback export-file();
    callback import-file();
    callback replace();
    callback keep();
}

// Export or Import configuration, with the same accessible name in the footer and
// on the General page. The host sets its icon artwork, enablement and action.
export component SettingsFileButton inherits HintedActionButton {
    // Import configuration; otherwise Export configuration.
    in property <bool> import-action;
    in property <bool> icon-only;
    in property <bool> short-label;
    private property <string> full-label: root.import-action ? "Import configuration…" : "Export configuration…";
    accessible-label: root.full-label;
    text: root.icon-only ? "" : !root.short-label ? root.full-label : root.import-action ? "Import…" : "Export…";
    fallback-icon: root.import-action ? FallbackIcons.open-path : FallbackIcons.save-again;
    min-height: Theme.control-height;
    hint: root.import-action
        ? "Replace all settings with a checked settings file. Options previews it; OK saves it and applies its tabs, hot paths and window placement; Cancel keeps your current settings."
        : "Save all settings to a JSON settings file: what OK would save now, including tabs, hot paths, window placement and command history. Unfinished page edits are not included.";
}

// One line above the Options footer; Replace and Keep answer an existing destination.
export component SettingsFileFeedback inherits HorizontalLayout {
    spacing: 8px;
    Text {
        accessible-label: SettingsFileView.error ? "Settings file error" : "Settings file status";
        accessible-value: self.text;
        text: SettingsFileView.message;
        min-width: 0px; horizontal-stretch: 1;
        overflow: elide; vertical-alignment: center;
        font-size: Theme.small-font;
        color: SettingsFileView.error ? Theme.error-text : Theme.text;
        Tip { text: SettingsFileView.message; }
    }
    if SettingsFileView.replace-pending : HintedActionButton {
        text: "Replace"; min-height: Theme.control-height;
        hint: "Replace the existing file with the exported settings. Where the filesystem supports it, the replaced file is kept for recovery.";
        clicked => { SettingsFileView.replace(); }
    }
    if SettingsFileView.replace-pending : HintedActionButton {
        text: "Keep"; min-height: Theme.control-height;
        hint: "Keep the existing file and do not export.";
        clicked => { SettingsFileView.keep(); }
    }
}
