import { ListView } from "scroll-view.slint";
import { Theme } from "theme.slint";
import { PathText } from "path-text.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { FallbackIcons } from "action-icons.slint";
import { ColumnGrip } from "column-grip.slint";
import { SortHeading } from "find-results.slint";

// One search result shown in a panel (Feed to panel).
export struct FeedRow {
    name: string, folder: string, size: string, modified: string,
    directory: bool, selected: bool,
    // The folder's last component with its separator, kept when the path is shortened.
    folder-tail: string,
}

// The search results a panel shows instead of its folder.
export struct FeedView {
    open: bool, title: string, status: string, cursor: int,
}

struct FeedColumnWidths { name: length, folder: length, size: length, modified: length }

// Headers and rows share widths and cell padding, including horizontal scrolling.
component FeedColumns inherits HorizontalLayout {
    in property <FeedRow> entry;
    in property <bool> header;
    in property <FeedColumnWidths> widths;
    callback resize(int, length);
    callback sort(int);
    callback reveal(length, length);
    padding-left: 8px; padding-right: 8px; spacing: 0px; alignment: start;
    pure function column-width(index: int) -> length {
        return index == 0 ? root.widths.name : index == 1 ? root.widths.folder
            : index == 2 ? root.widths.size : root.widths.modified;
    }
    for title[index] in ["Name", "Folder", "Size", "Modified"]: HorizontalLayout {
        padding-right: root.header ? 0px : 10px;
        Rectangle {
            width: root.column-width(index);
            if root.header: SortHeading {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                title: title; align-right: index == 2;
                accessible-label: title + " column";
                sort => { root.sort(index); }
                focused => { root.reveal(self.absolute-position.x - root.absolute-position.x,self.width); }
            }
            if !root.header && index != 1: Text {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: [root.entry.name, root.entry.folder, root.entry.size, root.entry.modified][index];
                font-size: Theme.font-size;
                font-weight: index == 0 && root.entry.directory ? 600 : 400;
                color: root.entry.selected ? Theme.selected-text
                    : index == 0 ? (root.entry.directory ? Theme.directory-text : Theme.text) : Theme.secondary-text;
                vertical-alignment: center; horizontal-alignment: index == 2 ? right : left;
                overflow: elide;
            }
            if !root.header && index == 1: PathText {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: root.entry.folder; tail: root.entry.folder-tail; font-size: Theme.font-size;
                foreground: root.entry.selected ? Theme.selected-text : Theme.secondary-text;
            }
        }
        if root.header: ColumnGrip {
            active: true; title: title; start-width: root.column-width(index);
            resize(width) => { root.resize(index, width); }
        }
    }
}

// Feed to panel: the search results each panel shows over its folder, and what
// the lists ask (each callback's first argument is the panel).
export global FeedPresentation {
    in property <FeedView> left;
    in property <FeedView> right;
    in property <[FeedRow]> left-rows;
    in property <[FeedRow]> right-rows;
    callback click(int, int, bool, bool);
    callback open-row(int, int);
    callback leave(int);
    // The rows a list shows, for its Page Up/Down.
    callback page-rows(int, int);
    // A panel action routed to the search results it shows; or refused there.
    callback action(int, int);
    callback sort(int, int);
    callback refuse(int, string);
}

// A Find's results as a temporary list over a panel. Keys go through the panel's
// shortcut routing, so the configured View, Edit, Copy, Move and Delete keys and
// the function bar act on the selected results.
export component FindFeedPanel inherits Rectangle {
    in property <int> pane;
    in property <bool> active;
    // The panel itself is shown (both panels, or this one alone).
    in property <bool> shown;
    private property <FeedView> view: root.pane == 0 ? FeedPresentation.left : FeedPresentation.right;
    private property <[FeedRow]> rows: root.pane == 0 ? FeedPresentation.left-rows : FeedPresentation.right-rows;
    // Returns whether the key was handled.
    callback key(KeyEvent) -> bool;
    callback activate();
    public function focus-list() { focus.focus(); }
    // The list has the keyboard: its panel's file shortcuts apply to it.
    out property <bool> list-focused: focus.has-focus;
    visible: root.view.open && root.shown;
    background: Theme.pane-background;
    border-width: 1px;
    border-color: root.active ? Theme.active-frame : Theme.frame;
    clip: true;
    accessible-role: AccessibleRole.list;
    accessible-label: root.view.title;
    private property <length> row-height: Theme.row-height;
    private property <int> cursor: root.view.cursor;
    // Each panel retains its widths while showing subsequent feeds.
    private property <FeedColumnWidths> widths: {
        name: Theme.small-font * 14, folder: Theme.small-font * 18,
        size: Theme.small-font * 7, modified: Theme.small-font * 14,
    };
    private property <length> fixed-width: root.widths.name + root.widths.size + root.widths.modified + 56px;
    private property <length> folder-width: max(root.widths.folder, list.visible-width - root.fixed-width);
    private property <FeedColumnWidths> shown-widths: {
        name: root.widths.name, folder: root.folder-width,
        size: root.widths.size, modified: root.widths.modified,
    };
    function resize-column(index: int, width: length) {
        if index == 0 { root.widths.name = width; }
        else if index == 1 { root.widths.folder = width; }
        else if index == 2 { root.widths.size = width; }
        else if index == 3 { root.widths.modified = width; }
    }
    function reveal-column(left: length, width: length) {
        let start = min(0px,list.visible-width - list.content-width);
        if left + list.content-x < 0px { list.content-x = clamp(-left,start,0px); }
        else if left + width + list.content-x > list.visible-width {
            list.content-x = clamp(list.visible-width - left - width,start,0px);
        }
    }
    private property <int> shown-rows: max(1, floor(list.visible-height / root.row-height));
    changed shown-rows => { FeedPresentation.page-rows(root.pane, root.shown-rows); }
    changed cursor => { root.reveal-cursor(); }
    function reveal-cursor() {
        if root.cursor < 0 || root.cursor >= root.rows.length { return; }
        if root.cursor * root.row-height < -list.content-y {
            list.content-y = -root.cursor * root.row-height;
        } else if (root.cursor + 1) * root.row-height > -list.content-y + list.visible-height {
            list.content-y = min(0px, list.visible-height - (root.cursor + 1) * root.row-height);
        }
    }
    // A pointer anywhere on the list makes its panel active.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.activate(); focus.focus(); }
        }
    }
    VerticalLayout {
        padding: 1px;
        Rectangle {
            background: root.active ? Theme.active-header : Theme.header;
            height: max(Theme.control-height, title.preferred-height) + 8px;
            HorizontalLayout {
                padding-left: 8px; padding-right: 4px; spacing: 6px;
                alignment: stretch;
                title := Text {
                    text: root.view.title; color: Theme.strong-text; font-size: Theme.font-size;
                    font-weight: 600; vertical-alignment: center; overflow: elide;
                    horizontal-stretch: 1; min-width: 0px;
                }
                VerticalLayout {
                    alignment: center;
                    HintedActionButton {
                        text: "Go to file"; fallback-icon: FallbackIcons.forward;
                        enabled: root.cursor >= 0 && root.cursor < root.rows.length;
                        hint: "Show the focused result in its folder (Enter).";
                        clicked => { root.activate(); FeedPresentation.action(root.pane, 1); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HintedActionButton {
                        text: "Back to folder"; fallback-icon: FallbackIcons.close;
                        hint: "Leave the search results (Backspace). The panel shows its folder again.";
                        clicked => { FeedPresentation.leave(root.pane); }
                    }
                }
            }
        }
        Flickable {
            height: Theme.column-height;
            content-width: self.width; content-height: self.height;
            interactive: false; mouse-drag-pan-enabled: false;
            Rectangle { width: parent.width; height: parent.height; background: Theme.header; }
            FeedColumns {
                x: list.content-x; width: list.content-width; height: parent.height;
                header: true; widths: root.shown-widths;
                resize(index, width) => { root.resize-column(index, width); }
                sort(column) => { FeedPresentation.sort(root.pane,column); }
                reveal(left, width) => { root.reveal-column(left, width); }
            }
        }
        focus := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if !root.view.open { return reject; }
                if root.key(event) { return accept; }
                reject
            }
            list := ListView {
                content-width: root.fixed-width + root.folder-width;
                accessible-role: AccessibleRole.list; accessible-label: "Search results";
                accessible-item-count: root.rows.length;
                for row[index] in root.rows: Rectangle {
                    width: list.content-width;
                    height: root.row-height;
                    background: root.cursor == index && root.active ? Theme.cursor-background
                        : root.cursor == index ? Theme.inactive-cursor
                        : row.selected ? Theme.selected-background
                        : Math.mod(index, 2) == 1 ? Theme.alternate-row : transparent;
                    border-width: root.cursor == index ? 1px : 0px; border-color: Theme.cursor-edge;
                    accessible-role: list-item;
                    accessible-label: row.name + " · " + row.folder + " · " + row.size + " · " + row.modified;
                    accessible-item-selectable: true; accessible-item-selected: row.selected;
                    accessible-item-index: index;
                    FeedColumns {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        entry: row; widths: root.shown-widths;
                    }
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.activate();
                                focus.focus();
                                FeedPresentation.click(root.pane, index, event.modifiers.control, event.modifiers.shift);
                            }
                        }
                        double-clicked => { FeedPresentation.open-row(root.pane, index); }
                    }
                }
            }
        }
        Rectangle {
            height: Theme.status-height * 2; background: Theme.header;
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: root.view.status; color: Theme.secondary-text; font-size: Theme.small-font;
                vertical-alignment: center; overflow: elide;
            }
        }
    }
}
