import { Theme } from "theme.slint";
import { Tip } from "controls.slint";

// How a directory comparison with subfolders found one row (`FileRow.compare-mark`):
// 1 matches, 2 differs (a folder: something inside differs), 3 exists on this side
// only, 4 not verified; 0 shows nothing. The glyph carries the meaning; colour only
// emphasises it, so every theme and colour vision reads it the same.
export global CompareBadges {
    // The comparison line shown below each panel (equal to that panel's status line
    // while it shows it): a Clear comparison button ends it.
    in property <string> left-note;
    in property <string> right-note;
    // Marks or a result line are shown: Clear comparison has something to clear.
    in property <bool> shown;
    // The Clear comparison button's tooltip, with its current keys.
    in property <string> clear-hint;
    // Clear comparison: the marks leave both panels, the line its panel; the
    // selection stays. False when nothing was shown.
    callback clear() -> bool;
    pure public function note(pane: int) -> string {
        return pane == 0 ? root.left-note : root.right-note;
    }
    pure public function glyph(mark: int) -> string {
        return mark == 1 ? "=" : mark == 2 ? "≠" : mark == 3 ? "+" : mark == 4 ? "?" : "";
    }
    pure public function words(mark: int, directory: bool) -> string {
        return mark == 1 ? (directory ? "Compared: everything inside matches" : "Compared: matches")
            : mark == 2 ? (directory ? "Compared: something inside differs" : "Compared: differs")
            : mark == 3 ? "Compared: exists in this panel only"
            : mark == 4 ? "Compared: could not be compared completely" : "";
    }
}

export component CompareBadge inherits Rectangle {
    in property <int> mark;
    in property <bool> directory;
    // What the comparison found for this row (`FileRow.compare-detail`).
    in property <string> detail;
    // Hovering shows `detail`; off while the row is hidden or touched.
    in property <bool> tips: true;
    private property <length> edge: max(14px, min(22px, Theme.small-font + 4px));
    width: self.edge + 4px; height: self.edge;
    border-radius: 3px;
    border-width: 1px;
    background: root.mark == 2 ? Theme.error-background
        : root.mark == 3 ? Theme.active-header : Theme.secondary-surface;
    border-color: root.mark == 2 ? Theme.error-text : root.mark == 1 ? Theme.frame : Theme.active-frame;
    // The glyph in words, and the tooltip's text (the row's description says it too).
    accessible-role: text;
    accessible-label: CompareBadges.words(root.mark, root.directory);
    accessible-description: root.detail;
    Text {
        text: CompareBadges.glyph(root.mark);
        color: root.mark == 2 ? Theme.error-text : root.mark == 1 ? Theme.muted-text : Theme.strong-text;
        font-size: Theme.small-font; font-weight: root.mark == 1 ? 400 : 700;
        horizontal-alignment: center; vertical-alignment: center;
        accessible-role: none;
    }
    // Over the badge only: the name and the row keep their own tooltips.
    Tip { text: root.tips ? root.detail : ""; }
}
