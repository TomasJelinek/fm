import { WrappingCheckBox } from "wrapping-check-box.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { TipBody } from "controls.slint";
import { ThemedLineEdit } from "content-controls.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { FallbackIcons } from "action-icons.slint";

// Panel choices shared by both panels: Show hidden files (Options › General and
// each panel's View menu) and the Select/Deselect by mask dialog.
export global PanelChoices {
    in-out property <bool> show-hidden-files: true;
    callback show-hidden-files-changed(bool);
    // An empty token means the mask dialog is closed; each opening has a new one.
    in-out property <string> mask-token;
    in-out property <bool> mask-select: true;
    in-out property <string> mask-pattern;
    in-out property <bool> mask-folders;
    in-out property <string> mask-error;
    callback mask-apply(string, string, bool);
    callback mask-dismiss(string);
}

// Select files (keypad +) or Deselect files (keypad −) whose names match masks.
export component MaskSelectionDialog inherits Rectangle {
    in property <bool> input-enabled: true;
    callback apply(string, bool);
    callback cancel();
    callback move-dialog(length, length);
    public function begin() {
        pattern.text = PanelChoices.mask-pattern;
        folders.checked = PanelChoices.mask-folders;
        if root.input-enabled { pattern.focus-value(); pattern.select-all(); }
    }
    private property <bool> compact: root.height < 240px;
    private property <length> field-height: max(32px, Theme.control-height);
    background: Theme.surface; border-radius: 8px;
    border-width: 1px; border-color: Theme.active-frame;
    FocusScope {
        // A key router, not a Tab stop.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.input-enabled && event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 8px : 16px; spacing: root.compact ? 4px : 8px;
            DialogHeader {
                title: PanelChoices.mask-select ? "Select files" : "Deselect files";
                fallback-icon: PanelChoices.mask-select ? FallbackIcons.done : FallbackIcons.close;
                compact: root.compact; enabled: root.input-enabled;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            Text {
                text: PanelChoices.mask-select ? "Select the shown entries whose names match:"
                    : "Deselect the shown entries whose names match:";
                color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
            }
            pattern := ThemedLineEdit {
                enabled: root.input-enabled; accessible-label: "Selection mask";
                min-height: root.field-height; preferred-height: root.field-height;
                min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
                placeholder-text: "*.txt;*.md";
                accepted => { root.apply(pattern.text, folders.checked); }
                Tooltip { TipBody {
                    text: "Masks: * matches any text, ? one character, ; separates masks, | starts exclusions, ;; means a literal semicolon. Example: *.txt;*.md|draft*. Letter case is ignored.";
                } }
            }
            folders := WrappingCheckBox {
                text: "Include folders"; enabled: root.input-enabled;
                min-height: Theme.control-height;
                hint: "Folders whose names match change too. Keypad * then inverts folders as well as files.";
            }
            if PanelChoices.mask-error != "": ErrorNotice { text: PanelChoices.mask-error; }
            Rectangle { vertical-stretch: 1; }
            footer := DialogFooter {
                compact-height: root.compact;
                dismiss-enabled: root.input-enabled;
                dismiss => { root.cancel(); }
                HintedActionButton {
                    text: "OK"; primary: true; enabled: root.input-enabled;
                    min-width: 72px; min-height: Theme.control-height;
                    hint: PanelChoices.mask-select ? "Select the matching entries (Enter)." : "Deselect the matching entries (Enter).";
                    clicked => { root.apply(pattern.text, folders.checked); }
                }
            }
        }
    }
}
