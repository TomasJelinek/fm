import { Theme } from "theme.slint";
import { HintedActionButton, HintedCheckBox, HintedComboBox, HintedLineEdit } from "hinted-inputs.slint";
import { ScrollView } from "std-widgets.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogTabs } from "dialog-tabs.slint";
import { DialogHeader } from "dialog-frame.slint";
import { FallbackIcons } from "action-icons.slint";
import { MetadataFileRow } from "metadata-list.slint";
export { MetadataFileRow }

export struct MetadataDraft {
    read-only: int, hidden: int, system: int, archive: int, compressed: int,
    unix-edit: bool, unix-mode: string,
    created-mode: int, created-text: string,
    modified-mode: int, modified-text: string,
    accessed-mode: int, accessed-text: string,
    case-enabled: bool, case-mode: int, case-scope: int, recursive: bool,
}

component MetadataChoice inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <[string]> choices: ["Leave unchanged", "Set", "Clear"];
    in property <bool> enabled: true;
    in-out property <int> choice;
    callback edited();
    spacing: 12px; cross-axis-alignment: center;
    Text { text: root.label; color: Theme.text; font-size: Theme.font-size; width: max(160px, Theme.font-size * 7); }
    HintedComboBox {
        accessible-label: root.label;
        model: root.choices; current-index <=> root.choice;
        enabled: root.enabled; hint: root.hint;
        horizontal-stretch: 1; min-height: Theme.control-height;
        selected(value) => { root.edited(); }
    }
}

component MetadataButton inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback choose();
    min-width: max(64px, Theme.font-size * 4);
    height: Theme.control-height;
    horizontal-stretch: 1;
    background: root.selected ? Theme.active-header : area.has-hover ? Theme.hover : Theme.secondary-surface;
    border-width: 1px; border-radius: 3px;
    border-color: root.selected || focus.has-focus ? Theme.active-frame : Theme.frame;
    accessible-role: button; accessible-label: root.label;
    accessible-checkable: true; accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.choose(); } }
    forward-focus: focus;
    Text {
        text: root.caption; color: root.enabled ? Theme.text : Theme.muted-text;
        font-size: Theme.font-size; horizontal-alignment: center; vertical-alignment: center;
        font-weight: root.selected ? 600 : 400;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.choose(); return accept; }
            reject
        }
        area := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.choose(); } }
    }
}

component MetadataAttribute inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    in property <[string]> choices: ["Leave", "Set", "Clear"];
    in-out property <int> choice;
    callback edited();
    spacing: 8px; cross-axis-alignment: center;
    Text { text: root.label; color: Theme.text; font-size: Theme.font-size; width: max(125px, Theme.font-size * 6); }
    for caption[index] in root.choices : MetadataButton {
        label: root.label + ": " + caption; caption: caption;
        selected: root.choice == index; enabled: root.enabled;
        choose => { root.choice = index; root.edited(); }
    }
}

component MetadataTime inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled;
    in-out property <int> mode;
    in-out property <string> value;
    callback edited();
    spacing: 8px; cross-axis-alignment: center;
    HintedCheckBox {
        text: root.label; accessible-label: "Change " + root.label;
        checked: root.mode != 0; enabled: root.enabled;
        width: max(150px, Theme.font-size * 8);
        hint: "Enable this field to change its timestamp. Unchecked preserves the native value.";
        toggled => { root.mode = self.checked ? 1 : 0; root.edited(); }
    }
    HintedLineEdit {
        accessible-label: root.label + " timestamp";
        enabled: root.enabled && root.mode != 0; text <=> root.value;
        horizontal-stretch: 1;
        placeholder-text: root.mode == 2 ? "Now (captured at Preview)" : "2026-11-06T12:30:00+01:00";
        hint: "ISO timestamp with an explicit UTC offset or Z. Ambiguous local times are rejected.";
        edited => { root.mode = 1; root.edited(); }
    }
    MetadataButton {
        label: root.label + ": Now"; caption: "Now"; selected: root.mode == 2;
        enabled: root.enabled && root.mode != 0; horizontal-stretch: 0;
        choose => { root.mode = 2; root.value = ""; root.edited(); }
    }
}

export component MetadataDialog inherits Rectangle {
    in property <image> native-icon;
    callback move-dialog(length, length);
    in property <string> token;
    in property <string> revision;
    in property <string> summary;
    in property <string> preview-text;
    in property <[MetadataFileRow]> rows;
    in property <string> list-status;
    in property <bool> preview-current;
    in property <string> error;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> can-windows;
    in property <int> windows-mask;
    in property <bool> can-unix;
    in property <bool> can-compress;
    in property <bool> can-created;
    in property <bool> can-modified;
    in property <bool> can-accessed;
    in property <bool> can-rename;
    callback preview(MetadataDraft);
    callback dirty();
    callback confirm(int);
    callback cancel();
    private property <MetadataDraft> draft;
    private property <int> topic;
    private property <bool> draft-edited: true;
    private property <bool> has-reviewed: false;
    changed ready => { if root.ready { root.draft-edited = false; } }
    changed preview-current => { if root.preview-current { root.draft-edited = false; root.has-reviewed = true; } }
    function edited() { root.draft-edited = true; root.dirty(); }
    public function begin(case-enabled: bool) {
        root.draft = {
            read-only: 0, hidden: 0, system: 0, archive: 0, compressed: 0,
            unix-edit: false, unix-mode: "",
            created-mode: 0, created-text: "", modified-mode: 0, modified-text: "",
            accessed-mode: 0, accessed-text: "",
            case-enabled: case-enabled, case-mode: 0, case-scope: 0, recursive: false,
        };
        root.draft-edited = true;
        root.has-reviewed = false;
        root.topic = case-enabled ? 2 : 0;
        cancel-button.focus();
    }
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px;
    border-radius: 6px;
    forward-focus: scope;
    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.height < 350px ? 6px : 16px; spacing: root.height < 350px ? 4px : 10px;
            DialogHeader { title: "Attributes, times and case"; text-size: Theme.font-size * 1.2;
                fallback-icon: FallbackIcons.attributes; compact: root.height < 350px;
                dragged(dx, dy) => { root.move-dialog(dx, dy); } }
            contents := ScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                horizontal-scrollbar-policy: as-needed;
                content-width: max(self.visible-width, 500px);
                VerticalLayout {
                    spacing: 10px; alignment: start;
            Text { text: root.summary; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
            DialogTabs { labels: ["Attributes", "Times", "Case", "Preview"]; current-index <=> root.topic; }
            VerticalLayout {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    if root.topic == 0 : VerticalLayout {
                        spacing: 10px; alignment: start;
                        if root.can-windows : VerticalLayout {
                            spacing: 8px;
                            MetadataAttribute { label: "Read-only"; choice <=> root.draft.read-only; edited => { root.edited(); } }
                            MetadataAttribute { label: "Hidden"; choice <=> root.draft.hidden; edited => { root.edited(); } }
                            MetadataAttribute { label: "System"; choice <=> root.draft.system; edited => { root.edited(); } }
                            MetadataAttribute { label: "Archive"; choice <=> root.draft.archive; edited => { root.edited(); } }
                        }
                        if root.can-unix : VerticalLayout {
                            spacing: 8px;
                            HintedCheckBox {
                                text: "Set permissions (octal)"; checked <=> root.draft.unix-edit;
                                hint: "Three digits preserve setuid, setgid and sticky bits. Four digits explicitly replace them too.";
                                toggled => { root.edited(); }
                            }
                            HintedLineEdit {
                                accessible-label: "Octal permissions";
                                text <=> root.draft.unix-mode; enabled: root.draft.unix-edit;
                                placeholder-text: "755"; hint: "For example 640, 755 or 2755. Native access checks apply.";
                                edited => { root.edited(); }
                            }
                        }
                        MetadataAttribute {
                            label: "Compression"; enabled: root.can-compress;
                            choices: ["Leave", "Compress", "Uncompress"];
                            choice <=> root.draft.compressed;
                            edited => { root.edited(); }
                        }
                    }
                    if root.topic == 1 : VerticalLayout {
                        spacing: 14px; alignment: start;
                        Text { text: "Enable a field, then enter a date/time with UTC offset or choose Now."; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
                        MetadataTime { label: "Modified"; enabled: root.can-modified; mode <=> root.draft.modified-mode; value <=> root.draft.modified-text; edited => { root.edited(); } }
                        MetadataTime { label: "Created"; enabled: root.can-created; mode <=> root.draft.created-mode; value <=> root.draft.created-text; edited => { root.edited(); } }
                        MetadataTime { label: "Accessed"; enabled: root.can-accessed; mode <=> root.draft.accessed-mode; value <=> root.draft.accessed-text; edited => { root.edited(); } }
                        Text { text: "Now is captured once at Preview for all chosen fields and files. An explicit offset distinguishes repeated daylight-saving hours."; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; }
                    }
                    if root.topic == 2 : VerticalLayout {
                        spacing: 12px; alignment: start;
                        HintedCheckBox {
                            text: "Change filename case"; enabled: root.can-rename;
                            checked <=> root.draft.case-enabled;
                            hint: "Unicode-aware conversion. Existing destination names are never overwritten.";
                            toggled => { root.edited(); }
                        }
                        MetadataChoice {
                            label: "Conversion"; enabled: root.can-rename && root.draft.case-enabled;
                            choices: ["lowercase", "UPPERCASE", "Mixed Case", "Mixed name.lower extension"];
                            choice <=> root.draft.case-mode;
                            hint: "Mixed case starts a word after a space or dot. The last suffix is the extension; dotfiles have no extension.";
                            edited => { root.edited(); }
                        }
                        MetadataChoice {
                            label: "Apply to"; enabled: root.can-rename && root.draft.case-enabled;
                            choices: ["Whole filename", "Base name", "Extension"];
                            choice <=> root.draft.case-scope;
                            hint: "Native filename data outside the chosen component remains unchanged. Invalid Unicode in the chosen component is reported.";
                            edited => { root.edited(); }
                        }
                    }
                    if root.topic == 3 : Text {
                        text: root.preview-text; color: Theme.text;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                }
            }
            HintedCheckBox {
                text: "Include subfolders"; checked <=> root.draft.recursive;
                hint: "Descendants are processed before their parent. Links and mount points are not followed. Large batches can exceed the explicit resource budget.";
                toggled => { root.edited(); }
            }
            Text {
                text: root.busy ? "Preparing preview…" : root.draft-edited ? (root.has-reviewed ? "Draft changed; preview stale. Refresh to see current changes." : "Draft not previewed. Refresh or Preview changes to inspect it.") : root.list-status;
                color: root.draft-edited ? Theme.pending-size : Theme.secondary-text;
                font-size: Theme.small-font; overflow: elide;
            }
            if root.error != "" : ErrorNotice {
                text: root.error;
                min-height: max(56px, Theme.font-size * 2);
                preferred-height: max(80px, Theme.font-size * 2.5);
                max-height: max(100px, Theme.font-size * 3);
            }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                ScrollView {
                    horizontal-stretch: 1; min-width: 0px;
                    height: max(32px, Theme.control-height + (root.width < 600px ? 12px : 0px), refresh-button.preferred-height);
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: always-off;
                    HorizontalLayout { spacing: 8px;
                refresh-button := HintedActionButton {
                    text: "Refresh"; enabled: !root.busy;
                    hint: "Read the captured files again and preview the current draft. This does not apply changes.";
                    clicked => { root.preview(root.draft); }
                }
                HintedActionButton {
                    text: "Preview changes"; enabled: !root.busy;
                    hint: "Validate the draft and review the requested changes before Apply.";
                    clicked => { root.topic = 3; root.preview(root.draft); }
                }
                HintedActionButton {
                    text: "Apply"; enabled: root.ready && !root.busy && !root.draft-edited;
                    hint: "Queue the exact reviewed draft. Conflicts offer Skip, Skip all or Cancel. Completed changes are retained if later steps fail.";
                    clicked => { root.confirm(0); }
                }
                    }
                }
                cancel-button := HintedActionButton {
                    text: "Cancel"; hint: "Close the editor without applying the draft (Escape).";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
