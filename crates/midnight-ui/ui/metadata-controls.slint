import { WrappingCheckBox } from "wrapping-check-box.slint";
import { Theme } from "theme.slint";
import { HintedActionButton, HintedComboBox } from "hinted-inputs.slint";
import { ScrollView } from "scroll-view.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogTabs } from "dialog-tabs.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { DialogText } from "dialog-text.slint";
import { FallbackIcons } from "action-icons.slint";
import { MetadataAttribute } from "metadata-attribute.slint";
import { MetadataTime, MetadataTimeCodec, MetadataTimeDraft } from "metadata-time-field.slint";
import { UnixPermissions } from "unix-permissions.slint";

export struct MetadataDraft {
    read-only: int, hidden: int, system: int, archive: int, compressed: int,
    unix-edit: bool, unix-mode: string, unix-mask: int, unix-value: int,
    created: MetadataTimeDraft, modified: MetadataTimeDraft, accessed: MetadataTimeDraft,
    case-enabled: bool, case-mode: int, case-scope: int, recursive: bool,
}

component MetadataChoice inherits GridLayout {
    in property <string> label;
    in property <string> hint;
    in property <[string]> choices: ["Leave unchanged", "Set", "Clear"];
    in property <bool> enabled: true;
    in-out property <int> choice;
    callback edited();
    in property <bool> narrow;
    spacing: 12px;
    Text { row: 0; col: 0; colspan: root.narrow ? 2 : 1;
        text: root.label; color: Theme.text; font-size: Theme.font-size;
        min-width: 0px; preferred-width: root.narrow ? 0px : max(160px, Theme.font-size * 7);
        horizontal-stretch: root.narrow ? 1 : 0; }
    HintedComboBox {
        row: root.narrow ? 1 : 0; col: root.narrow ? 0 : 1; colspan: root.narrow ? 2 : 1;
        accessible-label: root.label;
        model: root.choices; current-index <=> root.choice;
        enabled: root.enabled; hint: root.hint;
        horizontal-stretch: 1; min-height: Theme.control-height;
        selected(value) => { root.edited(); }
    }
}

export component MetadataDialog inherits Rectangle {
    accessible-role: groupbox; accessible-label: "Attributes, times and case";
    callback move-dialog(length, length);
    in property <string> token;
    in property <string> revision;
    in property <string> summary;
    in property <string> preview-text;
    in property <string> list-status;
    in property <bool> preview-current;
    in property <string> error;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> can-windows;
    in property <int> windows-mask;
    in property <bool> can-unix;
    in property <int> unix-current-mode;
    in property <int> unix-known-mask;
    in property <int> unix-supported-mask;
    in property <bool> can-compress;
    in property <bool> can-created;
    in property <bool> can-modified;
    in property <bool> can-accessed;
    in property <bool> can-rename;
    callback preview(MetadataDraft);
    callback dirty();
    callback confirm(int);
    callback cancel();
    callback dismiss-hints();
    private property <MetadataDraft> draft;
    out property <bool> unix-visible: root.can-unix || root.draft.unix-edit || root.draft.unix-mask != 0;
    private property <int> topic;
    private property <bool> draft-edited: true;
    private property <bool> has-reviewed: false;
    private property <bool> review-requested;
    private property <bool> reviewing;
    private property <string> reviewed-revision;
    private property <bool> narrow-fields: root.width < max(500px, Theme.font-size * 24);
    // A timestamp row holds a label, three fields, two pickers and Now.
    private property <bool> narrow-times: root.width < max(560px, Theme.font-size * 34);
    // A compact viewport can fully clip the focused page field. Keep Escape
    // reachable; Slint drops keyboard events aimed at an invisible item. Act
    // once on entering the compact height, not on every resize step inside it.
    private property <bool> compact-height: root.height < 350px;
    changed compact-height => { if root.compact-height { footer.focus-dismiss(); } }
    changed ready => { if root.ready { root.draft-edited = false; } }
    changed preview-current => {
        if root.preview-current {
            root.draft-edited = false; root.has-reviewed = true;
            if root.review-requested && !root.busy {
                root.review-requested = false;
                root.reviewed-revision = root.revision;
                root.reviewing = true;
                footer.focus-dismiss();
            }
        } else { root.reviewing = false; }
    }
    changed revision => {
        if root.reviewing && root.reviewed-revision != root.revision {
            root.reviewing = false;
        }
    }
    function edited() {
        root.draft-edited = true; root.review-requested = false; root.reviewing = false;
        root.dirty();
    }
    public function begin(case-enabled: bool) {
        root.draft = {
            read-only: 0, hidden: 0, system: 0, archive: 0, compressed: 0,
            unix-edit: false, unix-mode: "", unix-mask: 0, unix-value: 0,
            created: { mode: 0 }, modified: { mode: 0 }, accessed: { mode: 0 },
            case-enabled: case-enabled, case-mode: 0, case-scope: 0, recursive: false,
        };
        root.draft-edited = true;
        root.has-reviewed = false;
        root.review-requested = false; root.reviewing = false; root.reviewed-revision = "";
        root.topic = case-enabled ? 2 : 0;
        footer.focus-dismiss();
    }
    background: Theme.surface; border-color: Theme.active-frame; border-width: 1px;
    border-radius: 6px;
    forward-focus: scope;
    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.height < 350px ? 6px : 16px; spacing: root.height < 350px ? 4px : 10px;
            DialogHeader { title: root.reviewing ? "Review changes" : "Attributes, times and case"; text-size: Theme.font-size * 1.2;
                fallback-icon: FallbackIcons.attributes; compact: root.height < 350px;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); } }
            if root.reviewing : DialogText {
                text: root.summary + "\n\n" + root.preview-text;
                min-height: 0px; vertical-stretch: 1;
            }
            if !root.reviewing : editor-scroll := ScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                horizontal-scrollbar-policy: as-needed;
                content-width: max(self.visible-width, Theme.font-size * 18);
                content-height: max(self.visible-height, fields.preferred-height);
                fields := VerticalLayout {
                    height: editor-scroll.content-height;
                    spacing: 10px; alignment: start;
            Text { text: root.summary; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; min-height: self.preferred-height; vertical-stretch: 0; }
            WrappingCheckBox {
                text: "Include subfolders"; checked <=> root.draft.recursive;
                hint: "Applies to Attributes, Times and Case together. Descendants are processed before their parent. Links and mount points are not followed. Large batches can exceed the explicit resource budget.";
                toggled => { root.edited(); }
            }
            DialogTabs { labels: ["Attributes", "Times", "Case"]; current-index <=> root.topic;
                changing => { root.dismiss-hints(); } }
            VerticalLayout {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    if root.topic == 0 : VerticalLayout {
                        spacing: 10px; alignment: start;
                        if root.can-windows : VerticalLayout {
                            spacing: 6px;
                            MetadataAttribute { label: "Read-only";
                                enabled: mod(root.windows-mask, 2) >= 1;
                                choice <=> root.draft.read-only; edited => { root.edited(); } }
                            MetadataAttribute { label: "Hidden";
                                enabled: mod(floor(root.windows-mask / 2), 2) >= 1;
                                choice <=> root.draft.hidden; edited => { root.edited(); } }
                            MetadataAttribute { label: "System";
                                enabled: mod(floor(root.windows-mask / 4), 2) >= 1;
                                choice <=> root.draft.system; edited => { root.edited(); } }
                            MetadataAttribute { label: "Archive";
                                enabled: mod(floor(root.windows-mask / 32), 2) >= 1;
                                choice <=> root.draft.archive; edited => { root.edited(); } }
                        }
                        if root.unix-visible : UnixPermissions {
                            current-mode: root.unix-current-mode; known-mask: root.unix-known-mask;
                            supported-mask: root.unix-supported-mask;
                            enabled: root.can-unix; busy: root.busy;
                            edit-mask <=> root.draft.unix-mask; edit-value <=> root.draft.unix-value;
                            octal-edit <=> root.draft.unix-edit; octal-mode <=> root.draft.unix-mode;
                            edited => { root.edited(); }
                        }
                        if root.can-windows || root.can-compress : MetadataAttribute {
                            label: "Compression"; enabled: root.can-compress;
                            set-caption: "Compress"; clear-caption: "Uncompress";
                            choice <=> root.draft.compressed;
                            edited => { root.edited(); }
                        }
                    }
                    if root.topic == 1 : VerticalLayout {
                        spacing: 14px; alignment: start;
                        Text { text: "Tick a timestamp to change it, then type its date and time or pick them. Up/Down arrows change the part under the cursor."; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; min-height: self.preferred-height; vertical-stretch: 0; }
                        MetadataTime { narrow: root.narrow-times; label: "Modified"; enabled: root.can-modified; default: MetadataTimeCodec.modified-default; value <=> root.draft.modified; edited => { root.edited(); } }
                        MetadataTime { narrow: root.narrow-times; label: "Created"; enabled: root.can-created; default: MetadataTimeCodec.created-default; value <=> root.draft.created; edited => { root.edited(); } }
                        MetadataTime { narrow: root.narrow-times; label: "Accessed"; enabled: root.can-accessed; default: MetadataTimeCodec.accessed-default; value <=> root.draft.accessed; edited => { root.edited(); } }
                        Text { text: "Times start from the current value. The UTC offset is used exactly as shown; around a daylight-saving change, choose the offset that matches the intended hour. Now uses the moment you review."; color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap; min-height: self.preferred-height; vertical-stretch: 0; }
                    }
                    if root.topic == 2 : VerticalLayout {
                        spacing: 12px; alignment: start;
                        WrappingCheckBox {
                            text: "Change filename case"; enabled: root.can-rename;
                            checked <=> root.draft.case-enabled;
                            hint: "Unicode-aware conversion. Existing destination names are never overwritten.";
                            toggled => { root.edited(); }
                        }
                        MetadataChoice {
                            narrow: root.narrow-fields;
                            label: "Conversion"; enabled: root.can-rename && root.draft.case-enabled && !root.busy;
                            choices: ["lowercase", "UPPERCASE", "Mixed Case", "Mixed name.lower extension"];
                            choice <=> root.draft.case-mode;
                            hint: "Mixed case starts a word after a space or dot. The last suffix is the extension; dotfiles have no extension.";
                            edited => { root.edited(); }
                        }
                        MetadataChoice {
                            narrow: root.narrow-fields;
                            label: "Apply to"; enabled: root.can-rename && root.draft.case-enabled && !root.busy;
                            choices: ["Whole filename", "Base name", "Extension"];
                            choice <=> root.draft.case-scope;
                            hint: "Native filename data outside the chosen component remains unchanged. Invalid Unicode in the chosen component is reported.";
                            edited => { root.edited(); }
                        }
                    }
                }
            }
            Text {
                text: root.busy ? "Checking captured files…" : root.draft-edited ? (root.has-reviewed ? "Draft changed. Review it again before applying." : "Review changes before applying them.") : root.list-status;
                color: root.draft-edited ? Theme.pending-size : Theme.secondary-text;
                font-size: Theme.small-font; overflow: elide;
            }
            if root.error != "" : ErrorNotice {
                text: root.error;
                minimum-notice-height: max(56px, Theme.font-size * 2);
                preferred-notice-height: max(80px, Theme.font-size * 2.5);
                maximum-notice-height: max(100px, Theme.font-size * 3);
            }
                }
            }
            footer := DialogFooter {
                compact-height: root.height < 350px;
                dismiss-hint: "Close the editor without applying the draft (Escape).";
                dismiss => { root.cancel(); }
                if !root.reviewing : HintedActionButton {
                    text: "Review changes"; enabled: !root.busy; primary: true; fallback-icon: FallbackIcons.view;
                    hint: "Check the captured files and exact draft, then review the confirmation before Apply.";
                    clicked => { root.review-requested = true; root.preview(root.draft); }
                }
                // One conditional, with the footer's spacing, instead of one per button.
                if root.reviewing : HorizontalLayout {
                    spacing: 8px;
                    HintedActionButton {
                        text: "Back to editing"; fallback-icon: FallbackIcons.edit;
                        hint: "Keep this draft and return to its editable fields.";
                        clicked => { root.dismiss-hints(); root.reviewing = false; root.review-requested = false; }
                    }
                    HintedActionButton {
                        text: "Apply"; primary: true; fallback-icon: FallbackIcons.done; enabled: root.ready && root.preview-current && !root.busy
                            && !root.draft-edited && root.reviewed-revision == root.revision;
                        hint: "Queue the exact reviewed draft. Conflicts offer Skip, Skip all or Cancel. Completed changes are retained if later steps fail.";
                        clicked => { root.confirm(0); }
                    }
                }
            }
        }
    }
}
