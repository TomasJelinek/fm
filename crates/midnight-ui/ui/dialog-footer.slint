import { HScrollView } from "scroll-view.slint";
import { Theme } from "theme.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { FluentScrollMetrics } from "fluent-scroll-metrics.slint";
import { FallbackIcons } from "action-icons.slint";
import { FooterAction, FooterActions } from "footer-actions.slint";

export { FooterAction }

// Actions use spare width and scroll when necessary. Dismiss remains reachable; a
// tall dialog whose actions do not fit beside it puts it on a second row instead of
// squeezing controls.
//
// A dialog may instead pass its actions as data (`footer-actions`): the footer then shows
// as many as fit whole beside the dismiss button, 8 px apart, and puts the others, in
// their `drop` order, into a More… menu with the same captions, glyphs, shortcuts and
// enabled states. Such a footer never scrolls and never cuts a button. Where that is not
// enough, More…, then the rank 0 actions, then the dismiss button show their glyphs alone,
// and last the rank 0 actions move into More… too (`FooterActions` lists the steps), so no
// action ever leaves the window.
//
// Slint 1.18.1 generator pitfall (E0382 "borrow of moved value `tmp_…`" in the generated
// main.rs): when one binding reads the same non-Copy value (an image such as a
// `FallbackIcons` glyph, or a string property) twice and one of the reads is a branch of
// `?:`, the generator hoists the read into a temporary, moves it in the branch and
// borrows it again at the other read. Minimal pattern, in one `footer-actions` literal:
//     [{ fallback-icon: root.running ? FallbackIcons.close : FallbackIcons.find, … },
//      { fallback-icon: FallbackIcons.find, … }]
// Workaround: read each such value once per literal. Give the second action another
// glyph, or bind each glyph to its own property on the footer element
// (`property <image> run-glyph: root.running ? FallbackIcons.close : FallbackIcons.find;`)
// and read every property once (`fallback-icon: self.run-glyph`).
export component DialogFooter inherits Rectangle {
    // The fitted actions, in their order, and the one chosen (its index there). In the
    // literal a dialog binds here, read no image or string value twice where one read is
    // inside `?:` (the Slint 1.18.1 pitfall above): one property per glyph, each read once.
    in property <[FooterAction]> footer-actions;
    callback footer-action(int);
    // How many fitted actions show as buttons, and how many are in More….
    out property <int> shown-actions: fitted.shown;
    out property <int> overflow-actions: fitted.overflow;
    // Aliases, not copies: the footer is inlined into every dialog, so each
    // forwarded property would be one more generated binding per dialog.
    in property <string> dismiss-text <=> dismiss-button.text;
    in property <string> dismiss-hint <=> dismiss-button.hint;
    in property <image> dismiss-native-icon <=> dismiss-button.native-icon;
    in property <image> dismiss-fallback-icon <=> dismiss-button.fallback-icon;
    in property <bool> dismiss-enabled <=> dismiss-button.enabled;
    in property <bool> compact-height;
    in property <bool> compact-controls;
    in property <bool> fill-actions;
    // The width beside the dismiss button on one row, and the width of `measure-text`
    // in the action font. A dialog leaves out an optional action that would not fit
    // there, so that no button sits half outside the scroller and the footer never
    // takes a second row for an optional action. Neither depends on that row.
    out property <length> inline-room: max(0px, root.width - max(80px, dismiss-button.preferred-width) - 8px);
    in property <string> measure-text;
    out property <length> measured-width: measure.preferred-width;
    callback dismiss <=> dismiss-button.clicked;
    public function focus-dismiss() { dismiss-button.focus(); }
    measure := Text {
        visible: false; text: root.measure-text;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    // Only when the actions at their natural width do not fit beside the dismiss
    // button; a short dialog keeps one row and scrolls its actions instead.
    private property <bool> stacked: !root.compact-height && actions.preferred-width > root.inline-room;
    private property <length> control-height: max(Theme.control-height,
        dismiss-button.preferred-height, actions.preferred-height);
    private property <bool> overflowing: actions.min-width > action-scroll.width;
    private property <length> action-height: root.control-height + (root.overflowing ? FluentScrollMetrics.overlay-size : 0px);
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    height: root.stacked ? root.action-height + 8px + root.control-height : root.action-height;
    action-scroll := HScrollView {
        x: 0px; y: 0px;
        width: root.stacked ? root.width : max(0px, root.width - dismiss-button.width - 8px);
        height: root.action-height;
        content-width: max(self.visible-width, actions.min-width);
        horizontal-scrollbar-policy: as-needed;
        actions := HorizontalLayout {
            y: 0px;
            height: root.control-height;
            spacing: 8px; alignment: root.fill-actions ? stretch : end;
            @children
        }
    }
    // For fitted actions only: the dismiss button's caption measured as the button draws it,
    // so that whether the button shows its glyph alone (their level 3) is decided from its
    // width with the caption, not from the button itself, whose width that choice changes.
    dismiss-measure := Text {
        visible: false; accessible-role: none;
        text: root.footer-actions.length > 0 ? dismiss-button.text : "";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    // Whether the dismiss button draws a glyph (as `ActionButtonContent` chooses it), and
    // its width with its caption (at least 80 px, as placed below) and with its glyph alone.
    private property <bool> dismiss-glyph: dismiss-button.text == "Close" || dismiss-button.fallback-icon.width > 0
        || FallbackIcons.for-label(dismiss-button.text).width > 0 || dismiss-button.native-icon.width > 0;
    private property <length> dismiss-captioned: max(80px, 24px + dismiss-measure.preferred-width
        + (root.dismiss-glyph ? Theme.icon-size + (dismiss-button.text != "" ? 4px : 0px) : 0px));
    private property <length> fitted-room: max(0px, root.width - root.dismiss-captioned - 8px);
    private property <length> fitted-compact-room: !root.dismiss-glyph ? root.fitted-room
        : max(0px, root.width - max(32px, 24px + Theme.icon-size) - 8px);
    // Outside the scrolled row: it fits by construction, its last button 8 px before the
    // dismiss button. Without fitted actions it is empty and takes no room.
    fitted := FooterActions {
        actions: root.footer-actions;
        room: root.fitted-room;
        compact-room: root.fitted-compact-room;
        compact-controls: root.compact-controls;
        // The gap before its first button may lie left of the footer (it fits up to
        // 8 px wider than the room), so its last button ends exactly 8 px before dismiss.
        x: dismiss-button.x - 8px - self.width;
        y: 0px;
        width: self.preferred-width;
        height: root.control-height;
        activated(index) => { root.footer-action(index); }
    }
    dismiss-button := HintedActionButton {
        minimum-control-height: root.compact-controls ? 0px : 32px;
        vertical-padding: root.compact-controls && !Theme.touch ? 4px : 5px;
        x: root.width - self.width; y: root.stacked ? root.action-height + 8px : 0px;
        // Only where fitted actions need it (their level 3); without them, never.
        glyph-only: fitted.compact-dismiss && root.dismiss-glyph;
        width: self.glyph-only ? self.preferred-width : min(root.width, max(80px, self.preferred-width));
        height: root.control-height;
        text: "Cancel"; hint: "Close this dialog (Escape).";
        fallback-icon: FallbackIcons.close;
    }
}
