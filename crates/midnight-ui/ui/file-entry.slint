import { Theme } from "theme.slint";
import { PrefixName } from "panel-search.slint";
import { FileRow } from "file-models.slint";
import { ErrorGlyph } from "error-notice.slint";

// Each cell keeps pointer identity across virtualized rebinding and refreshes.
export component FileEntry inherits Rectangle {
    in property <FileRow> item;
    in property <int> source-index;
    in property <int> view-mode;
    in property <bool> active;
    in property <bool> touch-contact;
    in property <length> size-column-width;
    in property <string> previous-click-identity;
    callback remember-click(string);
    callback row-click(bool, bool);
    callback context-menu(float, float, bool, bool);
    callback open();
    callback begin-drag(string, float, float) -> bool;
    callback drag-moved(float, float);
    callback drag-released(float, float);
    callback drag-cancelled();
    callback hover-changed(string, bool);
    private property <string> hover-identity: pointer.has-hover && root.visible ? item.identity : "";
    changed hover-identity => { root.hover-changed(item.identity, root.hover-identity != ""); }
    private property <color> text-color: item.selected ? Theme.selected-text
        : item.directory ? Theme.directory-text : Theme.text;
    clip: true;
    private property <color> row-color: item.cursor ? (root.active ? Theme.cursor-background : Theme.inactive-cursor)
        : item.selected ? Theme.selected-background
        : (mod(root.source-index, 2) == 0 ? Theme.pane-background : Theme.alternate-row);
    background: root.row-color;
    accessible-role: list-item;
    accessible-label: item.name + (item.kind == "Folder link" ? " · Folder link" : "")
        + (item.compressed ? " · Filesystem compressed" : "")
        + (item.size-state == 3 ? " · Folder size error" : "");
    Rectangle {
        x: 0px; y: 0px; width: item.selected ? 4px : 3px; height: parent.height;
        background: item.selected ? Theme.selected-edge
            : item.cursor && root.active ? Theme.cursor-edge : transparent;
    }
    if item.selected && item.cursor : Rectangle {
        x: 4px; y: 0px; width: parent.width - 4px; height: 1px;
        background: Theme.selected-edge;
    }
    if root.view-mode != 2 : HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        HorizontalLayout {
            spacing: 6px - (Theme.file-icon-size - Theme.icon-size);
            horizontal-stretch: 1; min-width: root.view-mode == 0 ? 120px : 0px;
            Rectangle {
                width: Theme.file-icon-size;
                Image {
                    source: item.icon;
                    width: Theme.file-icon-size; height: Theme.file-icon-size;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
                if item.compressed : Rectangle {
                    x: parent.width - 8px;
                    y: (parent.height + Theme.file-icon-size) / 2 - 8px;
                    width: 9px; height: 9px;
                    background: Theme.pane-background; border-radius: 2px;
                    Text {
                        text: "C"; font-size: 8px; font-weight: 700;
                        color: Theme.compression-mark;
                        horizontal-alignment: center; vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                if root.view-mode == 1 && item.size-state == 3 : ErrorGlyph {
                    width: 12px; height: 12px; x: parent.width - self.width;
                    y: (parent.height - Theme.file-icon-size) / 2;
                    accessible-label: "Folder size error";
                }
            }
            if item.prefix-end > 0 : PrefixName {
                text: item.name; prefix-end: item.prefix-end;
                text-color: root.text-color; row-background: root.row-color;
            }
            if item.prefix-end <= 0 : Text {
                text: item.name; color: root.text-color;
                font-size: Theme.font-size; font-weight: item.selected ? 600 : 400;
                overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
            }
        }
        if root.view-mode == 0 : HorizontalLayout {
            width: root.size-column-width; spacing: 4px; cross-axis-alignment: center;
            if item.size-state == 3 : ErrorGlyph {
                width: max(12px, min(20px, Theme.small-font)); height: self.width;
                accessible-label: "Folder size error";
            }
            Text {
                text: item.size; color: item.size-state == 3 ? Theme.error-text : item.size-state == 1 ? Theme.pending-size : Theme.secondary-text;
                font-weight: item.size-state == 1 ? 600 : 400; font-size: Theme.small-font;
                horizontal-stretch: 1; overflow: elide;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }
        if root.view-mode == 0 : Text {
            text: item.modified; color: Theme.secondary-text; font-size: Theme.small-font;
            width: 132px; overflow: elide; vertical-alignment: center;
        }
    }
    if root.view-mode == 2 : Rectangle {
        Image {
            source: item.icon; width: 72px; height: 72px;
            x: (parent.width - self.width) / 2; y: 12px; image-fit: contain;
        }
        if item.compressed : Text {
            x: parent.width / 2 + 25px; y: 65px; width: 15px; height: 19px;
            text: "C"; color: Theme.compression-mark; font-size: 12px; font-weight: 700;
            accessible-role: none;
        }
        if item.size-state == 3 : ErrorGlyph {
            x: parent.width / 2 + 22px; y: 12px; width: 16px; height: 16px;
            accessible-label: "Folder size error";
        }
        if item.prefix-end > 0 : PrefixName {
            x: 10px; y: 90px; width: parent.width - 20px; height: parent.height - 98px;
            text: item.name; prefix-end: item.prefix-end; wrapped: true;
            text-color: root.text-color; row-background: root.row-color;
        }
        if item.prefix-end <= 0 : Text {
            x: 10px; y: 90px; width: parent.width - 20px; height: parent.height - 98px;
            text: item.name; color: root.text-color; font-size: Theme.font-size;
            font-weight: item.selected ? 600 : 400; wrap: char-wrap; overflow: elide;
            horizontal-alignment: center; vertical-alignment: top;
        }
    }
    pointer := TouchArea {
        private property <string> pressed-identity;
        private property <bool> control-pressed;
        private property <bool> shift-pressed;
        private property <bool> modified-pressed;
        private property <bool> same-target-double;
        private property <bool> right-pressed;
        private property <bool> left-pressed;
        private property <bool> click-completed;
        private property <bool> activation-pending;
        private property <bool> drag-attempted;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.right-pressed = event.button == PointerEventButton.right;
                self.left-pressed = event.button == PointerEventButton.left;
                self.click-completed = false;
                self.activation-pending = false;
                self.drag-attempted = false;
                self.pressed-identity = item.identity;
                self.control-pressed = event.modifiers.control;
                self.shift-pressed = event.modifiers.shift;
                self.modified-pressed = event.modifiers.control
                    || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta;
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if self.drag-attempted {
                    root.drag-released((self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px);
                }
                // Slint emits clicked/double-clicked before pointer-up. Wait for
                // this event so modifiers at either end of the press are checked.
                let valid = !self.drag-attempted && self.left-pressed && self.click-completed && !self.modified-pressed
                    && !event.modifiers.control && !event.modifiers.shift
                    && !event.modifiers.alt && !event.modifiers.meta
                    && self.pressed-identity == item.identity;
                let activate = self.activation-pending && valid;
                root.remember-click(valid ? self.pressed-identity : "");
                self.left-pressed = false;
                self.click-completed = false;
                self.activation-pending = false;
                if activate { root.open(); }
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                if self.right-pressed && self.pressed-identity == item.identity
                    && self.mouse-x >= 0px && self.mouse-x < self.width
                    && self.mouse-y >= 0px && self.mouse-y < self.height {
                    root.context-menu((self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px,
                        self.control-pressed, self.shift-pressed);
                }
                self.right-pressed = false;
            } else if event.kind == PointerEventKind.cancel {
                if self.drag-attempted { root.drag-cancelled(); }
                self.right-pressed = false;
                self.left-pressed = false;
                self.click-completed = false;
                self.activation-pending = false;
                self.pressed-identity = "";
                self.same-target-double = false;
            } else if event.kind == PointerEventKind.move && self.left-pressed {
                self.modified-pressed = self.modified-pressed || event.modifiers.control
                    || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta;
            }
        }
        moved => {
            if self.left-pressed && !root.touch-contact {
                if !self.drag-attempted && self.pressed-identity == item.identity
                    && (abs(self.mouse-x - self.pressed-x) >= 6px
                        || abs(self.mouse-y - self.pressed-y) >= 6px) {
                    self.drag-attempted = true;
                    self.activation-pending = false;
                    self.same-target-double = false;
                    root.remember-click("");
                    root.begin-drag(self.pressed-identity,
                        (self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px);
                }
                if self.drag-attempted {
                    root.drag-moved((self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px);
                }
            }
        }
        clicked => {
            self.click-completed = !self.drag-attempted && self.left-pressed
                && self.pressed-identity == item.identity;
            self.same-target-double = self.pressed-identity == item.identity
                && root.previous-click-identity == self.pressed-identity;
            if self.click-completed {
                root.row-click(self.control-pressed, self.shift-pressed);
            }
        }
        double-clicked => {
            self.activation-pending = self.same-target-double && !self.modified-pressed
                && self.pressed-identity == item.identity;
        }
    }
}
