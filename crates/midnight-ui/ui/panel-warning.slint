import { Theme } from "theme.slint";
import { TipBody } from "controls.slint";
import { TreePress } from "file-models.slint";

// A diagnostic owns its pointer gesture independently of the file row below it.
export component PanelWarning inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> identity;
    in property <string> context;
    in property <string> revision;
    in property <bool> warning;
    in property <TreePress> press;
    callback inspect();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-action-default => { root.inspect(); }
    forward-focus: focus;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.active-frame;
    border-radius: 3px;
    Rectangle {
        width: min(parent.width, parent.height) - 2px; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.warning ? #f4c542 : Theme.error-text;
        Text {
            text: "!"; color: root.warning ? #27210c : Theme.error-background;
            font-size: parent.height * 0.78; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-role: none;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == Key.Return || event.text == Key.Space) {
                root.inspect(); return accept;
            }
            reject
        }
        pointer := TouchArea {
            private property <string> pressed-identity;
            private property <string> pressed-context;
            private property <string> pressed-detail;
            private property <string> pressed-revision;
            private property <bool> armed;
            private property <bool> completed;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.armed = event.button == PointerEventButton.left;
                    self.completed = false;
                    self.pressed-identity = root.press.active ? root.press.identity : root.identity;
                    self.pressed-context = root.press.active ? root.press.context : root.context;
                    self.pressed-detail = root.detail;
                    self.pressed-revision = root.revision;
                } else if event.kind == PointerEventKind.cancel {
                    self.armed = false;
                    self.completed = false;
                } else if event.kind == PointerEventKind.up {
                    let valid = self.armed && self.completed
                        && !(root.press.active && root.press.cancelled)
                        && event.button == PointerEventButton.left
                        && self.pressed-identity == root.identity
                        && self.pressed-context == root.context
                        && self.pressed-detail == root.detail
                        && self.pressed-revision == root.revision
                        && self.mouse-x >= 0px && self.mouse-x < self.width
                        && self.mouse-y >= 0px && self.mouse-y < self.height;
                    self.armed = false;
                    self.completed = false;
                    if valid { focus.focus(); root.inspect(); }
                }
            }
            moved => {
                if abs(self.mouse-x - self.pressed-x) >= 6px
                    || abs(self.mouse-y - self.pressed-y) >= 6px { self.armed = false; }
            }
            clicked => { self.completed = self.armed; }
        }
    }
    Tooltip { TipBody { text: root.detail; } }
}
