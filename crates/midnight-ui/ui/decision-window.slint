import { DialogWindow } from "dialog-window.slint";
import { CopyConflictDialog } from "copy-controls.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";

export component DecisionWindow inherits DialogWindow {
    in property <string> title-text: "Operation decision";
    title: root.title-text;
    in property <string> token;
    in property <string> body;
    in property <string> initial-name;
    in property <string> source-details;
    in property <string> target-details;
    in property <string> warning;
    in property <image> native-icon;
    in property <bool> allow-alternate-name;
    in property <bool> can-replace;
    in property <bool> can-merge;
    in property <bool> failure-mode;
    in property <bool> can-retry;
    in property <bool> can-skip;
    in property <bool> permanent-fallback;
    in property <string> failure-title: "Copy/Move needs attention";
    in property <string> skip-text: "Skip";
    in property <string> skip-hint: "Skip this failed item and continue this job.";
    in property <string> skip-all-text: "Skip all this error type";
    in property <string> skip-all-hint: "Skip later failures of this kind at this step in this job only. Name conflicts still need a separate decision.";
    callback decide(int, string);
    callback later();
    callback request-dismiss();
    request-close => { root.request-dismiss(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    preferred-width: max(700px, Theme.font-size * 38);
    preferred-height: max(500px, Theme.font-size * 25);
    // A failure's actions stay whole side by side: the window is never narrower than
    // Retry, Skip and Skip all with the dialog's 8px padding. Each action is its caption,
    // its glyph and 28px of padding, 8px from the next (ActionButtonContent); each caption
    // is measured on its own, rounded as its button rounds it.
    retry-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Retry";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    skip-caption := Text {
        x: 0px; y: 0px; visible: false; text: root.skip-text;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    skip-all-caption := Text {
        x: 0px; y: 0px; visible: false; text: root.skip-all-text;
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    private property <length> failure-action-pad: Theme.icon-size + 36px;
    fallback-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Permanently delete";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    private property <length> failure-actions: !root.failure-mode ? 0px
        : (root.permanent-fallback ? fallback-caption.preferred-width + root.failure-action-pad : 0px)
            + (root.can-retry ? retry-caption.preferred-width + root.failure-action-pad : 0px)
            + (root.can-skip ? skip-caption.preferred-width + skip-all-caption.preferred-width
                + 2 * root.failure-action-pad : 0px);
    min-width: max(320px, root.failure-actions == 0px ? 0px : root.failure-actions + 8px);
    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        // A key router, not a Tab stop.
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.request-dismiss(); return accept; }
            reject
        }
        if root.warning != "": ErrorNotice {
            x: 0px; y: 0px; width: root.width; height: min(48px, root.height / 4);
            text: root.warning; compact: true;
            minimum-notice-height: 0px; preferred-notice-height: 0px; maximum-notice-height: 48px;
        }
        CopyConflictDialog {
            x: 0px; y: root.warning == "" ? 0px : min(48px, root.height / 4);
            width: root.width; height: max(0px, root.height - self.y);
            preferred-width: 0px; preferred-height: 0px;
            token: root.token; body: root.body; initial-name: root.initial-name;
            source-details: root.source-details; target-details: root.target-details;
            native-icon: root.native-icon; allow-alternate-name: root.allow-alternate-name;
            can-replace: root.can-replace; can-merge: root.can-merge;
            failure-mode: root.failure-mode; can-retry: root.can-retry; can-skip: root.can-skip;
            permanent-fallback: root.permanent-fallback;
            failure-title: root.failure-title; skip-all-text: root.skip-all-text; skip-all-hint: root.skip-all-hint;
            skip-text: root.skip-text; skip-hint: root.skip-hint;
            decide(choice, name) => { root.decide(choice, name); }
            later => { root.later(); }
        }
    }
}
