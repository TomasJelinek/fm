import { Theme } from "theme.slint";
import { TipBody } from "controls.slint";
import { LocationImage } from "action-icons.slint";
import { LocationRole } from "navigation-models.slint";

// Desktop shortcuts show compact drive captions and icon-only special locations.
// The full name, path and available capacity remain available to assistive tools
// and through a plain-text tooltip in both density profiles.
export component CompactLocationButton inherits Rectangle {
    in property <string> label;
    in property <string> compact-label;
    in property <image> icon;
    in property <LocationRole> kind;
    in property <string> identity;
    in property <int> model-revision;
    in property <string> hint;
    in property <bool> selected;
    in property <bool> is-drive;
    private property <bool> numbered-hot-path: root.kind == LocationRole.hot-path && root.compact-label != "";
    callback clicked();
    callback context-menu(float, float, bool, bool);
    width: root.is-drive
        ? max(Theme.touch ? 56px : 46px, caption.preferred-width + (Theme.touch ? 40px : 26px))
        : Theme.tool-width;
    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: focus.has-focus || root.selected ? Theme.active-frame : transparent;
    background: area.pressed || root.selected ? Theme.selected-background
        : area.has-hover ? Theme.hover : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.hint;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    LocationImage {
        visible: !root.numbered-hot-path;
        native-icon: root.icon; kind: root.kind;
        width: root.is-drive ? Theme.file-icon-size : Theme.icon-size;
        height: self.width;
        x: root.is-drive ? (Theme.touch ? 8px : 4px) - (self.width - Theme.icon-size) / 2
            : (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        image-fit: contain;
    }
    caption := Text {
        visible: root.is-drive || root.numbered-hot-path;
        text: root.compact-label;
        x: root.numbered-hot-path ? 0px : Theme.touch ? 32px : 22px;
        width: root.numbered-hot-path ? root.width : max(0px, root.width - self.x - (Theme.touch ? 8px : 4px));
        height: root.height;
        color: Theme.text;
        font-size: Theme.font-size;
        vertical-alignment: center;
        horizontal-alignment: root.numbered-hot-path ? center : left;
        overflow: elide;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
        area := TouchArea {
            private property <string> pressed-identity;
            private property <int> pressed-revision;
            private property <bool> right-pressed;
            private property <bool> control-pressed;
            private property <bool> shift-pressed;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.pressed-identity = root.identity;
                    self.pressed-revision = root.model-revision;
                    self.right-pressed = event.button == PointerEventButton.right;
                    self.control-pressed = event.modifiers.control;
                    self.shift-pressed = event.modifiers.shift;
                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                    if root.is-drive && self.right-pressed && self.pressed-identity == root.identity
                        && self.pressed-revision == root.model-revision
                        && self.mouse-x >= 0px && self.mouse-x < self.width
                        && self.mouse-y >= 0px && self.mouse-y < self.height {
                        root.context-menu((self.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y + self.mouse-y) / 1px,
                            self.control-pressed, self.shift-pressed);
                    }
                    self.right-pressed = false;
                } else if event.kind == PointerEventKind.cancel {
                    self.right-pressed = false;
                    self.pressed-identity = "";
                }
            }
            clicked => {
                if self.pressed-identity == root.identity && self.pressed-revision == root.model-revision {
                    focus.focus(); root.clicked();
                }
            }
        }
    }
    // Tooltip observers must precede accepting input in hit-test order.
    Tooltip { TipBody { text: root.hint; } }
}
