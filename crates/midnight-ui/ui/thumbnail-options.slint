import { HintedActionButton, HintedComboBox } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { WrappingCheckBox } from "wrapping-check-box.slint";

export component ThumbnailOptions inherits VerticalLayout {
    in property <bool> thumbnails-enabled;
    in property <bool> thumbnails-network;
    in property <int> thumbnail-size: 72;
    callback size-changed(int);
    callback changed(bool, bool, int);
    callback clear-cache();
    spacing: 16px; alignment: start;
    WrappingCheckBox {
        text: "Show image and video previews";
        checked: root.thumbnails-enabled; min-height: Theme.control-height;
        hint: "Use installed thumbnail plugins in Thumbnails view. Decoding runs in background workers and results are cached.";
        toggled => { root.changed(self.checked, root.thumbnails-network, 0); }
    }
    WrappingCheckBox {
        text: "Allow previews on network locations";
        checked: root.thumbnails-network; enabled: root.thumbnails-enabled;
        min-height: Theme.control-height;
        hint: "Allow background reads on network or unclassified storage. These reads remain serial.";
        toggled => { root.changed(root.thumbnails-enabled, self.checked, 1); }
    }
    VerticalLayout {
        spacing: 4px;
        Text { text: "Thumbnail size (longest side)"; color: Theme.text; font-size: Theme.font-size; }
        HintedComboBox {
            private property <[int]> sizes: [48, 64, 72, 96, 128, 192, 256];
            accessible-label: "Thumbnail size";
            model: ["48 px", "64 px", "72 px (default)", "96 px", "128 px", "192 px", "256 px"];
            current-index: root.thumbnail-size == 48 ? 0 : root.thumbnail-size == 64 ? 1
                : root.thumbnail-size == 72 ? 2 : root.thumbnail-size == 96 ? 3
                : root.thumbnail-size == 128 ? 4 : root.thumbnail-size == 192 ? 5 : 6;
            min-height: Theme.control-height;
            hint: "Longest side in logical pixels. Images keep their aspect ratio without cropping. Smaller sizes reuse cached images; larger sizes keep the current preview visible while a sharper image is prepared.";
            selected(value) => { root.size-changed(self.sizes[self.current-index]); }
        }
    }
    HintedActionButton {
        text: "Clear thumbnail cache";
        hint: "Remove cached image and video previews immediately in the background. Cancel in Options does not undo cache cleanup. Visible previews can be generated again.";
        clicked => { root.clear-cache(); }
    }
}
