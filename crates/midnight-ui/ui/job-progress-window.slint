import { ScrollView, ProgressIndicator } from "std-widgets.slint";
import { DialogWindow } from "dialog-window.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { Theme } from "theme.slint";
import { FallbackIcons } from "action-icons.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { OperationRow } from "jobs-dialog.slint";
import { OperationSpeedChart } from "operation-speed-chart.slint";

// Copy, Move and Delete share one progress view. Only the operation's data differs.
export component JobProgressWindow inherits DialogWindow {
    in property <OperationRow> job;
    in property <string> close-error;
    in property <bool> cancel-confirmation;
    callback resolve();
    callback copy-details();
    callback set-paused(bool);
    callback show-jobs();
    callback request-dismiss();
    callback confirm-cancel();
    private property <bool> details-visible;
    private property <bool> compact: root.height < 350px;
    title: root.job.title;
    preferred-width: max(640px, Theme.font-size * 34);
    preferred-height: max(420px, Theme.font-size * 24);
    request-close => { root.request-dismiss(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    init => { footer.focus-dismiss(); }
    changed cancel-confirmation => { footer.focus-dismiss(); }
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.request-dismiss(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 6px : 16px; spacing: root.compact ? 4px : 10px;
            DialogHeader {
                title: root.job.title;
                detail: root.job.paused ? (root.job.pause-requested ? "Paused" : "Resuming...")
                    : root.job.pause-requested ? "Pausing..." : root.job.state;
                compact: root.compact; native-icon: root.job.icon;
                fallback-icon: root.job.kind == 1 ? FallbackIcons.delete : FallbackIcons.copy;
                close-label: root.cancel-confirmation ? "Dismiss cancellation question"
                    : root.job.active ? "Cancel operation" : "Close progress";
                close => { root.request-dismiss(); }
            }
            ScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                if root.cancel-confirmation : VerticalLayout {
                    padding-right: 8px; spacing: 10px; alignment: start;
                    Text {
                        text: "Cancel this operation?"; color: Theme.strong-text;
                        font-size: Theme.font-size * 1.2; font-weight: 600; wrap: word-wrap;
                    }
                    Text {
                        text: "This does not undo completed changes.";
                        color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                    }
                    if root.job.current-path != "" : Text {
                        text: root.job.current-path; color: Theme.secondary-text;
                        font-size: Theme.small-font; wrap: char-wrap; min-width: 0px;
                    }
                }
                if !root.cancel-confirmation : VerticalLayout {
                    padding-right: 8px; spacing: 10px; alignment: start;
                    Text {
                        text: root.job.progress-label != "" ? root.job.progress-label : root.job.summary;
                        color: root.job.failed ? Theme.error-text : Theme.strong-text;
                        font-size: root.compact ? Theme.font-size : Theme.font-size * 1.25;
                        overflow: elide;
                    }
                    if root.job.active && !root.job.determinate : ProgressIndicator {
                        accessible-label: "Discovering operation items";
                        indeterminate: !root.job.paused; progress: 0; height: 4px;
                    }
                    if root.job.kind == 0 || root.job.kind == 1 : OperationSpeedChart {
                        chart: root.job.speed-chart; deletion: root.job.kind == 1;
                        overall-progress: true; determinate: root.job.determinate;
                        progress: root.job.progress; progress-label: root.job.progress-label;
                        waiting-label: root.job.discovering ? "Discovering items..."
                            : root.job.paused ? "Paused" : "Waiting for activity";
                        height: max(130px, Theme.font-size * 7.5);
                    }
                    if root.job.current-path != "" : Text {
                        text: root.job.current-path; color: Theme.text; font-size: Theme.font-size;
                        wrap: char-wrap; min-width: 0px;
                    }
                    if root.job.file-determinate : VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.job.file-progress-label; color: Theme.secondary-text;
                            font-size: Theme.small-font; wrap: word-wrap;
                        }
                        ProgressIndicator {
                            accessible-label: "Current file written";
                            progress: root.job.file-progress; height: 8px;
                        }
                    }
                    if root.job.active : Text {
                        text: "Time remaining: " + (root.job.paused ? "Paused"
                            : root.job.eta != "" ? root.job.eta : "Calculating...");
                        color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                    }
                    if root.job.remaining != "" : Text {
                        text: root.job.remaining; color: Theme.text;
                        font-size: Theme.font-size; wrap: word-wrap;
                    }
                    if root.details-visible || root.job.failed : Text {
                        text: root.job.detail; color: root.job.failed ? Theme.error-text : Theme.text;
                        font-size: Theme.small-font; min-width: 0px; wrap: char-wrap;
                    }
                }
            }
            if root.close-error != "" : Text {
                text: root.close-error; color: Theme.error-text;
                font-size: Theme.small-font; wrap: word-wrap;
            }
            footer := DialogFooter {
                compact-height: root.compact;
                dismiss-fallback-icon: root.cancel-confirmation ? FallbackIcons.done : FallbackIcons.close;
                dismiss-text: root.cancel-confirmation ? "Continue"
                    : root.job.active ? "Cancel operation" : "Close";
                dismiss-hint: root.cancel-confirmation ? "Keep the operation in its current running or paused state (Escape)."
                    : root.job.active ? "Ask whether to cancel this operation (Escape)."
                    : "Close this completed operation.";
                dismiss => { root.request-dismiss(); }
                if root.cancel-confirmation : HintedActionButton {
                    text: "Cancel operation"; destructive: true;
                    enabled: root.job.active && root.job.cancellable;
                    hint: "Cancel this operation. Completed changes will remain.";
                    clicked => { root.confirm-cancel(); }
                }
                if !root.cancel-confirmation && root.job.pausable : HintedActionButton {
                    text: root.job.pause-requested ? "Resume" : "Pause";
                    hint: "Pause or resume this operation at a safe file-operation checkpoint.";
                    clicked => { root.set-paused(!root.job.pause-requested); }
                }
                if !root.cancel-confirmation : HintedActionButton {
                    text: root.details-visible ? "Fewer details" : "Details";
                    hint: "Show operation counters, source, destination and diagnostics.";
                    clicked => { root.details-visible = !root.details-visible; }
                }
                if !root.cancel-confirmation : HintedActionButton {
                    text: "Jobs"; hint: "Open the session's job list.";
                    clicked => { root.show-jobs(); }
                }
                if !root.cancel-confirmation && !root.job.active : HintedActionButton {
                    text: "Copy details"; fallback-icon: FallbackIcons.copy;
                    hint: "Copy this operation's full details and retained errors.";
                    clicked => { root.copy-details(); }
                }
                if !root.cancel-confirmation && root.job.attention : HintedActionButton {
                    text: "Resolve"; hint: "Review this operation's pending overwrite or error decision.";
                    clicked => { root.resolve(); }
                }
            }
        }
    }
}
