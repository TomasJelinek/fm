import { ProgressIndicator } from "std-widgets.slint";
import { VScrollView } from "scroll-view.slint";
import { DialogWindow } from "dialog-window.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { Theme } from "theme.slint";
import { FallbackIcons } from "action-icons.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { OperationRow } from "jobs-dialog.slint";
import { OperationSpeedChart } from "operation-speed-chart.slint";
import { JobDetails, JobIssueList } from "job-outcome.slint";

// Copy, Move and Delete share one progress window.
export component JobProgressWindow inherits DialogWindow {
    in property <OperationRow> job;
    in property <string> close-error;
    in property <bool> cancel-confirmation;
    in property <bool> awaiting-copy-confirmation;
    in property <bool> copy-cancel-submitted;
    in property <string> copy-confirmation-token;
    callback resolve();
    callback copy-details();
    callback set-paused(bool);
    callback show-jobs();
    callback request-dismiss();
    callback confirm-cancel(string);
    private property <bool> details-visible;
    private property <bool> compact: root.height < 350px;
    private property <bool> transfer: root.job.kind == 0;
    private property <bool> can-request-cancel: root.job.active && root.job.cancellable;
    private property <bool> cancelling-delete: root.job.kind == 1 && root.job.active && !root.job.cancellable;
    private property <bool> show-actions: !root.cancel-confirmation
        && !root.awaiting-copy-confirmation && !root.copy-cancel-submitted;
    // A finished job shows how it ended instead of its last progress.
    private property <bool> outcome-view: !root.cancel-confirmation && !root.job.active;
    // Copy details and Jobs leave the footer where they would sit half outside its
    // scroller beside the dismiss button (DialogFooter's inline room); Copy details stays
    // longer, and Jobs offers it too. An action is its caption, its glyph and 28px of
    // padding, 8px from the next (ActionButtonContent). Pause and Details count with
    // their longer captions, so that toggling them never moves another action.
    private property <length> action-pad: Theme.icon-size + 28px + 8px;
    private property <length> kept-actions: root.cancel-confirmation ? cancel-caption.preferred-width + root.action-pad
        : !root.show-actions ? 0px
        : (root.job.pausable ? resume-caption.preferred-width + root.action-pad : 0px)
            + details-caption.preferred-width + root.action-pad
            + (root.job.attention ? resolve-caption.preferred-width + root.action-pad : 0px);
    private property <length> action-room: footer.inline-room + 8px;
    // Where even the actions that stay do not fit with their captions, they show their
    // glyphs only, as the Options footer's Export and Import do: each keeps its caption
    // as its accessible label and on its tooltip's first line.
    private property <bool> glyph-actions: root.kept-actions > root.action-room;
    private property <bool> offers-copy-details: root.show-actions && !root.job.active
        && root.kept-actions + copy-caption.preferred-width + root.action-pad <= root.action-room;
    private property <bool> offers-jobs: root.show-actions
        && root.kept-actions + (root.offers-copy-details ? copy-caption.preferred-width + root.action-pad : 0px)
            + jobs-caption.preferred-width + root.action-pad <= root.action-room;
    title: root.job.title;
    preferred-width: max(640px, Theme.font-size * 34);
    preferred-height: root.transfer ? max(380px, Theme.font-size * 22) : max(420px, Theme.font-size * 24);
    // Never narrower than the widest footer: Pause, Details and Resolve as glyphs beside
    // Cancel operation, the longest dismiss caption, inside the padding of a window that
    // is not compact. A glyph is its icon and 24px of padding, 8px from the next.
    min-width: max(320px, 2 * (root.transfer ? 10px : 16px)
        + max(80px, cancel-caption.preferred-width + Theme.icon-size + 28px)
        + 3 * (Theme.icon-size + 24px + 8px));
    request-close => { root.request-dismiss(); }
    public function apply-preferences(scheme: int, density: int, family: string, desktop: int, touch: int) {
        root.apply-tool-theme(scheme, density, family, desktop, touch);
    }
    init => { footer.focus-dismiss(); }
    changed cancel-confirmation => { footer.focus-dismiss(); }
    changed awaiting-copy-confirmation => { footer.focus-dismiss(); }
    changed copy-cancel-submitted => {
        if !root.copy-cancel-submitted { footer.focus-dismiss(); }
    }
    // The footer's captions in the actions' font, each rounded as its button rounds it.
    resume-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Resume";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    details-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Fewer details";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    resolve-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Resolve";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    copy-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Copy details";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    jobs-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Jobs";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    cancel-caption := Text {
        x: 0px; y: 0px; visible: false; text: "Cancel operation";
        font-family: Theme.effective-font-family; font-size: Theme.font-size;
    }
    FocusScope { focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.request-dismiss(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 6px : root.transfer ? 10px : 16px;
            spacing: root.compact ? 4px : root.transfer ? 6px : 10px;
            // The native title bar's close button, Escape and the footer close the
            // window, so the header has no close button of its own.
            DialogHeader {
                title: root.job.title; closable: false;
                enabled: !root.copy-cancel-submitted;
                detail: root.cancelling-delete || !root.job.active ? ""
                    : root.job.paused ? (root.job.pause-requested ? "Paused" : "Resuming...")
                    : root.job.pause-requested ? "Pausing..." : root.job.state;
                compact: root.compact || root.transfer; native-icon: root.job.icon;
                fallback-icon: root.job.kind == 1 ? FallbackIcons.delete : FallbackIcons.copy;
            }
            progress-scroll := VScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, content.preferred-height);
                content := VerticalLayout {
                    x: 0px; y: 0px; width: progress-scroll.visible-width;
                    height: self.preferred-height; spacing: 0px;
                    if root.cancel-confirmation : VerticalLayout {
                        padding-right: 8px; spacing: 10px; alignment: start;
                        Text {
                            text: "Cancel this operation?"; color: Theme.strong-text;
                            font-size: Theme.font-size * 1.2; font-weight: 600; wrap: word-wrap;
                        }
                        Text {
                            text: "This does not undo completed changes.";
                            color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                        }
                        if root.job.current-path != "" : Text {
                            text: root.job.current-path; color: Theme.secondary-text;
                            font-size: Theme.small-font; wrap: char-wrap; min-width: 0px;
                        }
                    }
                    if !root.cancel-confirmation && root.job.active : VerticalLayout {
                        padding-right: 8px; spacing: root.transfer ? 6px : 10px; alignment: start;
                        Text {
                            text: root.job.progress-label != "" ? root.job.progress-label : root.job.summary;
                            color: root.job.failed ? Theme.error-text : Theme.strong-text;
                            font-size: root.compact ? Theme.font-size : Theme.font-size * 1.25;
                            overflow: elide;
                        }
                        // Files and size of a Copy or Move, items of a Delete, once counted.
                        if root.job.transfer-totals != "" : Text {
                            text: root.job.transfer-totals; color: Theme.strong-text;
                            font-size: Theme.font-size; wrap: word-wrap;
                        }
                        // A paused estimate holds still and says so: "About 3 min (paused)".
                        if root.transfer : Text {
                            text: "Time remaining: " + (root.job.eta != "" ? root.job.eta
                                : root.job.paused ? "Paused"
                                : root.job.discovering ? "Discovering items..."
                                : root.job.determinate && !root.job.waiting && !root.job.pause-requested
                                    && root.job.cancellable && !root.job.attention ? "Calculating..." : "Unavailable");
                            color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                        }
                        if !root.job.determinate : ProgressIndicator {
                            accessible-label: root.cancelling-delete ? "Deletion progress"
                                : root.job.activity-label != "" ? root.job.activity-label : "Discovering operation items";
                            indeterminate: !root.job.paused && !root.job.waiting; progress: 0; height: 4px;
                        }
                        if root.transfer || root.job.kind == 1 : OperationSpeedChart {
                            chart: root.transfer ? root.job.transfer-speed-chart : root.job.speed-chart;
                            deletion: root.job.kind == 1;
                            overall-progress: true;
                            determinate: root.job.determinate; progress: root.job.progress;
                            progress-label: root.cancelling-delete ? root.job.summary : root.job.progress-label;
                            waiting-label: root.cancelling-delete ? ""
                                : root.job.activity-label != "" ? root.job.activity-label
                                : root.job.discovering ? "Discovering items..."
                                : root.job.paused ? "Paused" : "Waiting for activity";
                            height: max(130px, Theme.font-size * 7.5);
                        }
                        if root.transfer && root.job.transfer-directory != "" : Text {
                            text: root.job.transfer-directory; color: Theme.secondary-text;
                            font-size: Theme.small-font; overflow: elide; min-width: 0px;
                        }
                        if root.transfer && root.job.transfer-name != "" : HorizontalLayout {
                            spacing: 8px; cross-axis-alignment: center;
                            Text {
                                text: root.job.transfer-name; color: Theme.strong-text;
                                font-size: Theme.font-size; overflow: elide; min-width: 0px;
                                horizontal-stretch: 1;
                            }
                            // A file that takes seconds shows its own progress beside its
                            // name; quick files never do, so the row does not flicker.
                            if root.job.file-percent != "" : HorizontalLayout {
                                spacing: 6px; cross-axis-alignment: center;
                                Rectangle {
                                    accessible-role: progress-indicator;
                                    accessible-label: "Current file progress";
                                    accessible-value: root.job.file-percent;
                                    width: Theme.font-size * 6; height: 6px; border-radius: 3px;
                                    background: Theme.frame.with-alpha(0.35);
                                    Rectangle {
                                        x: 0px; y: 0px; height: parent.height; border-radius: parent.border-radius;
                                        width: parent.width * clamp(root.job.file-progress, 0, 1);
                                        background: root.job.verification-view ? Theme.pending-size : Theme.active-frame;
                                    }
                                }
                                Text {
                                    text: root.job.file-percent; color: Theme.secondary-text;
                                    font-size: Theme.small-font;
                                }
                            }
                        }
                        if root.job.current-path != "" && (!root.transfer
                            || (root.job.transfer-directory == "" && root.job.transfer-name == "")) : Text {
                            text: root.job.current-path; color: Theme.text; font-size: Theme.font-size;
                            wrap: char-wrap; min-width: 0px;
                        }
                        if root.transfer && root.details-visible && root.job.verification-view : OperationSpeedChart {
                            chart: root.job.speed-chart; overall-progress: true; verification-phase: true;
                            determinate: root.job.file-determinate; progress: root.job.file-progress;
                            progress-label: root.job.file-progress-label;
                            waiting-label: root.job.activity-label;
                            height: max(130px, Theme.font-size * 7.5);
                        }
                        if root.job.file-progress-label != "" && (!root.transfer
                            || (root.details-visible && !root.job.verification-view)) : VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.job.file-progress-label; color: Theme.secondary-text;
                                font-size: Theme.small-font; wrap: word-wrap;
                            }
                            if root.job.file-determinate : ProgressIndicator {
                                accessible-label: root.job.file-progress-title != "" ? root.job.file-progress-title : "Current file written";
                                accessible-value: root.job.file-progress-label;
                                progress: root.job.file-progress; height: 8px;
                            }
                        }
                        if !root.transfer && !root.cancelling-delete : Text {
                            text: root.job.eta == "" && root.job.activity-label != ""
                                ? root.job.activity-label
                                : "Time remaining: " + (root.job.eta != "" ? root.job.eta
                                    : root.job.paused ? "Paused" : "Calculating...");
                            color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                        }
                        if root.job.remaining != "" && (!root.transfer || root.details-visible) : Text {
                            text: root.job.remaining; color: Theme.text;
                            font-size: Theme.font-size; wrap: word-wrap;
                        }
                    }
                    // A finished job shows what it did and did not do, not a stale count
                    // of remaining items. Only the error count and rows below are red:
                    // they open an error's path and message.
                    if root.outcome-view : VerticalLayout {
                        padding-right: 8px; spacing: 6px; alignment: start;
                        Text {
                            text: root.job.state; color: Theme.strong-text;
                            font-size: root.compact ? Theme.font-size : Theme.font-size * 1.25;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.job.transfer-outcome != "" ? root.job.transfer-outcome : root.job.summary;
                            color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                        }
                    }
                    // Only errors are listed; informational notes are counted above.
                    if !root.cancel-confirmation && root.job.issue-summary != "" : JobIssueList {
                        padding-top: 8px; padding-right: 8px;
                        issues: root.job.issues; summary: root.job.issue-summary;
                    }
                    if root.details-visible && root.compact && !root.cancel-confirmation : VerticalLayout {
                        padding-top: 8px; padding-right: 8px;
                        Text {
                            text: root.job.progress-detail != "" ? root.job.progress-detail : root.job.detail;
                            color: Theme.text; font-size: Theme.small-font; min-width: 0px; wrap: char-wrap;
                        }
                    }
                }
            }
            // A good part of the window, leaving the content above some room. A
            // small window has no room for both: its details end the scrolled content.
            if root.details-visible && !root.compact && !root.cancel-confirmation : JobDetails {
                height: min(max(Theme.font-size * 6, root.height * 0.38), root.height * 0.45);
                text: root.job.progress-detail != "" ? root.job.progress-detail : root.job.detail;
            }
            if root.awaiting-copy-confirmation || root.copy-cancel-submitted : Text {
                text: root.awaiting-copy-confirmation
                    ? "Waiting for a safe checkpoint..." : "Cancellation requested...";
                color: Theme.secondary-text; font-size: Theme.small-font; wrap: word-wrap;
            }
            if root.close-error != "" : Text {
                text: root.close-error; color: Theme.error-text;
                font-size: Theme.small-font; wrap: word-wrap;
            }
            footer := DialogFooter {
                compact-height: root.compact;
                dismiss-enabled: !root.copy-cancel-submitted;
                dismiss-fallback-icon: root.cancel-confirmation || root.awaiting-copy-confirmation
                    ? FallbackIcons.done : FallbackIcons.close;
                dismiss-text: root.copy-cancel-submitted ? "Cancelling..."
                    : root.cancel-confirmation || root.awaiting-copy-confirmation ? "Continue"
                    : root.can-request-cancel ? "Cancel operation" : "Close";
                dismiss-hint: root.cancel-confirmation ? (root.transfer
                    ? "Release this confirmation pause. A manual pause stays in place (Escape)."
                    : "Keep the operation in its current running or paused state (Escape).")
                    : root.awaiting-copy-confirmation ? "Dismiss the pending confirmation (Escape)."
                    : root.can-request-cancel ? "Ask whether to cancel this operation (Escape)."
                    : root.job.active ? "Close this progress window (Escape)."
                    : "Close this completed operation.";
                dismiss => { root.request-dismiss(); }
                // Each action names its own glyph, so that glyph-only actions stay apart.
                if root.cancel-confirmation : HintedActionButton {
                    private property <string> occurrence;
                    init => { self.occurrence = root.copy-confirmation-token; }
                    text: root.glyph-actions ? "" : "Cancel operation";
                    accessible-label: "Cancel operation";
                    fallback-icon: FallbackIcons.close; destructive: true;
                    enabled: root.job.active && root.job.cancellable;
                    hint: (root.glyph-actions ? "Cancel operation\n" : "")
                        + "Cancel this operation. Completed changes will remain.";
                    clicked => { root.confirm-cancel(self.occurrence); }
                }
                if root.show-actions && root.job.pausable : HintedActionButton {
                    private property <string> caption: root.job.pause-requested ? "Resume" : "Pause";
                    text: root.glyph-actions ? "" : self.caption;
                    accessible-label: self.caption;
                    fallback-icon: root.job.pause-requested ? FallbackIcons.run : FallbackIcons.pause;
                    hint: (root.glyph-actions ? self.caption + "\n" : "")
                        + "Pause or resume this operation at a safe file-operation checkpoint.";
                    clicked => { root.set-paused(!root.job.pause-requested); }
                }
                // One conditional, with the footer's spacing, instead of one per button.
                if root.show-actions : HorizontalLayout {
                    spacing: 8px;
                    HintedActionButton {
                        private property <string> caption: root.details-visible ? "Fewer details" : "Details";
                        text: root.glyph-actions ? "" : self.caption;
                        accessible-label: self.caption;
                        fallback-icon: FallbackIcons.view;
                        hint: (root.glyph-actions ? self.caption + "\n" : "")
                            + (root.details-visible ? "Hide the operation's details."
                                : "Show operation counters, source, destination, diagnostics and notes.");
                        clicked => { root.details-visible = !root.details-visible; }
                    }
                    if root.offers-jobs : HintedActionButton {
                        text: "Jobs"; hint: "Open the session's job list.";
                        clicked => { root.show-jobs(); }
                    }
                }
                if root.offers-copy-details : HintedActionButton {
                    text: "Copy details"; fallback-icon: FallbackIcons.copy;
                    hint: "Copy this operation's full details and retained errors.";
                    clicked => { root.copy-details(); }
                }
                if root.show-actions && root.job.attention : HintedActionButton {
                    text: root.glyph-actions ? "" : "Resolve";
                    accessible-label: "Resolve";
                    // Not Details' eye: beside it, a glyph-only Resolve must look different.
                    fallback-icon: FallbackIcons.edit;
                    hint: (root.glyph-actions ? "Resolve\n" : "")
                        + "Review this operation's pending overwrite or error decision.";
                    clicked => { root.resolve(); }
                }
            }
        }
    }
}
