import { DialogFrame, DialogHeader } from "dialog-frame.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { HintedComboBox, HintedLineEdit } from "hinted-inputs.slint";
import { Theme } from "theme.slint";
import { PathText } from "path-text.slint";
import { TipBody, CompactPicker } from "controls.slint";
import { TabRow, BookmarkRow, NavigationChoiceRow } from "navigation-models.slint";
import { ActionIcons, NativeActionImage, FallbackIcons } from "action-icons.slint";
import { ShortcutHints } from "shortcut-hints.slint";

export component NavigationButton inherits Rectangle {
    in property <image> icon;
    in property <image> native-icon;
    in property <string> label;
    in property <string> hint;
    in property <string> identity;
    in property <int> model-revision;
    in property <string> context;
    in property <string> press-context: root.context;
    in property <bool> press-cancelled;
    in property <bool> enabled: true;
    callback clicked();
    callback middle-clicked();
    width: Theme.touch ? Theme.tool-width : 24px;
    height: Theme.control-height;
    border-radius: 3px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.active-frame : transparent;
    background: area.has-hover && root.enabled ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    NativeActionImage {
        visible: root.label == "";
        native-icon: root.native-icon; fallback-icon: root.icon;
        action-enabled: root.enabled;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    Text {
        visible: root.label != ""; text: root.label; font-size: Theme.font-size;
        color: root.enabled ? Theme.text : Theme.muted-text;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta
                && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked(); return accept;
            }
            reject
        }
        area := TouchArea {
            enabled: root.enabled;
            private property <string> pressed-id;
            private property <int> pressed-revision;
            private property <string> pressed-context;
            private property <bool> middle-pressed;
            private property <bool> left-pressed;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.pressed-id = root.identity; self.pressed-revision = root.model-revision;
                    self.pressed-context = root.press-context;
                    self.middle-pressed = event.button == PointerEventButton.middle;
                    self.left-pressed = event.button == PointerEventButton.left;
                } else if event.kind == PointerEventKind.up
                    && event.button == PointerEventButton.middle && self.middle-pressed {
                    if !root.press-cancelled && self.has-hover && self.pressed-id == root.identity
                        && self.pressed-revision == root.model-revision && self.pressed-context == root.context {
                        root.middle-clicked();
                    }
                    self.middle-pressed = false;
                } else if event.kind == PointerEventKind.cancel {
                    self.pressed-id = ""; self.middle-pressed = false; self.left-pressed = false;
                }
            }
            clicked => {
                if !root.press-cancelled && self.left-pressed && self.pressed-id == root.identity && self.pressed-revision == root.model-revision && self.pressed-context == root.context {
                    focus.focus(); root.clicked();
                }
            }
        }
    }
    Tooltip { TipBody { text: root.hint; } }
}

export component HistoryNavigation inherits Rectangle {
    in property <length> primary-width: Theme.tool-width;
    in property <length> arrow-width: Theme.touch ? 26px : 22px;
    in property <image> icon;
    in property <image> native-icon;
    in property <string> hint;
    in property <[NavigationChoiceRow]> model;
    in property <int> revision;
    in property <string> context;
    in property <string> press-context: root.context;
    in property <bool> press-cancelled;
    in property <length> control-height: Theme.control-height;
    callback step();
    callback selected(string);
    callback dismissed();
    width: root.primary-width + root.arrow-width;
    height: root.control-height;
    background: Theme.surface;
    border-width: 1px; border-radius: 4px; border-color: Theme.frame;
    HorizontalLayout {
        spacing: 0px; cross-axis-alignment: center;
        NavigationButton {
            height: root.control-height; context: root.context; press-context: root.press-context; press-cancelled: root.press-cancelled;
            width: root.primary-width; icon: root.icon; native-icon: root.native-icon;
            hint: root.hint; enabled: root.model.length > 0;
            model-revision: root.revision;
            identity: root.model.length > 0 ? root.model[0].identity : "";
            clicked => { root.step(); }
        }
        CompactPicker {
            path-labels: true;
            height: root.control-height; context: root.context; press-context: root.press-context; press-cancelled: root.press-cancelled;
            width: root.arrow-width; minimum-control-width: 0px;
            framed: false;
            choices: root.model; model-revision: root.revision;
            show-row-icons: false; popup-align-right: true;
            enabled: root.model.length > 0;
            hint: root.hint + "\nChoose a previously visited folder.";
            accessible-name: root.hint + " history";
            popup-width: 500px;
            selected-key(identity) => { root.selected(identity); }
            dismissed => { root.dismissed(); }
        }
    }
    Rectangle {
        x: root.primary-width; y: 4px; width: 1px; height: root.height - 8px;
        background: Theme.frame;
    }
}

export component TabStrip inherits Rectangle {
    in property <[TabRow]> model;
    in property <ActionIcons> action-icons;
    private property <int> revision;
    private property <int> active-index: -1;
    private property <length> minimum-tab-width: Theme.touch ? 88px : 72px;
    private property <length> button-width: Theme.touch ? Theme.tool-width : 24px;
    private property <length> full-room: max(0px, root.width - root.button-width - 2px);
    private property <bool> overflowing: root.model.length * (root.minimum-tab-width + 2px) - 2px > root.full-room;
    private property <length> tab-room: max(0px, root.full-room - (root.overflowing ? 2 * (root.button-width + 2px) : 0px));
    private property <length> tab-width: clamp((root.tab-room - max(0, root.model.length - 1) * 2px)
        / max(1, root.model.length), root.minimum-tab-width, Theme.tab-width);
    private property <length> tabs-width: max(0px, root.model.length * (root.tab-width + 2px) - 2px);
    callback selected(string);
    callback close-tab(string);
    callback new-tab();
    visible: root.model.length > 0;
    height: self.visible ? Theme.control-height : 0px;
    vertical-stretch: 0;
    background: Theme.secondary-surface;
    changed model => { root.revision += 1; root.reveal-active(); }
    changed active-index => { root.reveal-active(); }
    changed tab-width => { root.reveal-active(); }
    function scroll-tabs(direction: int) {
        tabs-scroll.content-x = clamp(tabs-scroll.content-x - direction * (root.tab-width + 2px),
            min(0px, tabs-scroll.visible-width - tabs-scroll.content-width), 0px);
    }
    public function reveal-active() {
        if root.active-index >= 0 && root.active-index < root.model.length {
            if root.active-index * (root.tab-width + 2px) < -tabs-scroll.content-x {
                tabs-scroll.content-x = -root.active-index * (root.tab-width + 2px);
            } else if root.active-index * (root.tab-width + 2px) + root.tab-width
                > -tabs-scroll.content-x + tabs-scroll.visible-width {
                tabs-scroll.content-x = min(0px, tabs-scroll.visible-width
                    - root.active-index * (root.tab-width + 2px) - root.tab-width);
            }
        }
    }
    HorizontalLayout {
        spacing: 2px;
        tabs-scroll := ScrollView {
            min-height: 0px;
            content-height: Theme.control-height;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-width: max(root.tabs-width, self.visible-width);
            changed visible-width => { root.reveal-active(); }
            HorizontalLayout {
                spacing: 2px; alignment: start;
                for tab[index] in root.model : Rectangle {
                    width: root.tab-width;
                    height: Theme.control-height;
                    private property <bool> current-tab: tab.active;
                    init => { if self.current-tab { root.active-index = index; root.reveal-active(); } }
                    changed current-tab => { if self.current-tab { root.active-index = index; root.reveal-active(); } }
                    border-width: 1px; border-radius: 3px;
                    border-color: tab.active || tab-focus.has-focus ? Theme.active-frame : Theme.frame;
                    background: tab.active ? Theme.active-header : tab-area.has-hover ? Theme.hover : Theme.surface;
                    accessible-role: button;
                    accessible-label: tab.label + "\n" + tab.path;
                    accessible-checkable: true; accessible-checked: tab.active;
                    accessible-action-default => { root.selected(tab.identity); }
                    forward-focus: tab-focus;
                    caption := Text {
                        x: 8px; width: parent.width - close.width - 12px; height: parent.height;
                        text: tab.label; color: Theme.text; font-size: Theme.font-size;
                        vertical-alignment: center; overflow: elide;
                    }
                    tab-focus := FocusScope {
                        key-pressed(event) => {
                            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta
                                && (event.text == Key.Return || event.text == Key.Space) {
                                root.selected(tab.identity); return accept;
                            }
                            reject
                        }
                        tab-area := TouchArea {
                            Tooltip { TipBody { text: tab.label + "\n" + tab.path + "\nSelect this folder tab. Middle-click closes it; the last tab stays open."; } }
                            private property <string> pressed-id;
                            private property <int> pressed-revision;
                            private property <bool> middle-pressed;
                            private property <bool> left-pressed;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    self.pressed-id = tab.identity; self.pressed-revision = root.revision;
                                    self.middle-pressed = event.button == PointerEventButton.middle;
                                    self.left-pressed = event.button == PointerEventButton.left;
                                } else if event.kind == PointerEventKind.up
                                    && event.button == PointerEventButton.middle && self.middle-pressed {
                                    if root.model.length > 1 && self.has-hover
                                        && self.pressed-id == tab.identity && self.pressed-revision == root.revision
                                        && root.model[index].identity == self.pressed-id {
                                        root.close-tab(self.pressed-id);
                                    }
                                    self.middle-pressed = false;
                                } else if event.kind == PointerEventKind.cancel {
                                    self.pressed-id = ""; self.middle-pressed = false; self.left-pressed = false;
                                }
                            }
                            clicked => {
                                if self.left-pressed && self.pressed-id == tab.identity && self.pressed-revision == root.revision
                                    && root.model[index].identity == self.pressed-id { root.selected(self.pressed-id); }
                            }
                        }
                    }
                    close := NavigationButton {
                        x: parent.width - self.width;
                        identity: tab.identity; model-revision: root.revision;
                        icon: FallbackIcons.close-tab;
                        native-icon: root.action-icons.close-tab;
                        hint: "Close tab: " + tab.label + "\n" + tab.path + "\n" + ShortcutHints.hint("Close active tab", "tab.close") + ". The last tab stays open.";
                        enabled: root.model.length > 1;
                        clicked => { root.close-tab(tab.identity); }
                        middle-clicked => { root.close-tab(tab.identity); }
                    }
                }
            }
            // Only the unused tail accepts this gesture: tab bodies, close and + retain theirs.
            TouchArea {
                x: root.tabs-width + 2px;
                width: max(0px, tabs-scroll.visible-width - self.x);
                height: Theme.control-height;
                enabled: root.model.length < 32 && !root.overflowing;
                private property <bool> left-pressed;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.left-pressed = event.button == PointerEventButton.left;
                    } else if event.kind == PointerEventKind.cancel {
                        self.left-pressed = false;
                    }
                }
                double-clicked => { if self.left-pressed { root.new-tab(); } }
            }
        }
        if root.overflowing : NavigationButton {
            icon: FallbackIcons.back; native-icon: root.action-icons.back;
            hint: "Scroll tabs left"; enabled: tabs-scroll.content-x < -0.5px;
            clicked => { root.scroll-tabs(-1); }
        }
        if root.overflowing : NavigationButton {
            icon: FallbackIcons.forward; native-icon: root.action-icons.forward;
            hint: "Scroll tabs right";
            enabled: tabs-scroll.content-x > tabs-scroll.visible-width - tabs-scroll.content-width + 0.5px;
            clicked => { root.scroll-tabs(1); }
        }
        NavigationButton {
            icon: FallbackIcons.tab-add; native-icon: root.action-icons.tab-add;
            enabled: root.model.length < 32;
            hint: root.model.length < 32 ? ShortcutHints.hint("Open a new folder tab", "tab.new") : "A panel can have up to 32 folder tabs.";
            clicked => { root.new-tab(); }
        }
    }
}
