import { ThemeColors, ThemePalettes } from "theme-palettes.slint";

// Semantic application colors and geometry. Native widgets follow Palette's
// explicit light/dark scheme; file icons keep their original host colors.
export global Theme {
    in-out property <int> scheme: 0;
    in-out property <int> density: 0;
    in-out property <string> font-family;
    in-out property <int> desktop-font-size: 11;
    in-out property <int> touch-font-size: 15;
    private property <ThemeColors> palette: ThemePalettes.colors(scheme);
    out property <bool> light: palette.light;
    out property <bool> touch: density == 1;
    out property <color> window-background: palette.window-background;
    out property <color> pane-background: palette.pane-background;
    out property <color> alternate-row: palette.alternate-row;
    out property <color> surface: palette.surface;
    out property <color> secondary-surface: palette.secondary-surface;
    out property <color> header: palette.header;
    out property <color> active-header: palette.active-header;
    out property <color> frame: palette.frame;
    out property <color> active-frame: palette.active-frame;
    out property <color> hover: palette.hover;
    out property <color> text: palette.text;
    out property <color> strong-text: palette.strong-text;
    out property <color> secondary-text: palette.secondary-text;
    out property <color> muted-text: palette.muted-text;
    out property <color> pending-size: palette.pending-size;
    out property <color> accent: palette.accent;
    out property <color> directory-text: palette.directory-text;
    out property <color> selected-text: palette.selected-text;
    out property <color> search-match: palette.search-match;
    out property <color> compression-mark: palette.compression-mark;
    out property <color> cursor-background: palette.cursor-background;
    out property <color> inactive-cursor: palette.inactive-cursor;
    out property <color> selected-background: palette.selected-background;
    out property <color> selected-edge: palette.selected-edge;
    out property <color> cursor-edge: palette.cursor-edge;
    out property <color> error-background: palette.error-background;
    out property <color> error-text: palette.error-text;
    out property <color> selection-background: palette.selection-background;
    out property <color> selection-text: palette.selection-text;
    out property <length> row-height: max(touch ? 40px : 22px, font-size + (touch ? 12px : 8px));
    out property <length> control-height: max(touch ? 40px : 24px, font-size + (touch ? 14px : 10px));
    out property <length> tab-width: min(220px, max(110px, font-size * 8 + tool-width));
    out property <length> tool-width: touch ? 40px : 26px;
    // Locations share the navigation toolbar; no separate location band remains.
    out property <length> locations-height: 0px;
    out property <length> toolbar-height: max(touch ? 48px : 34px, control-height + (touch ? 8px : 10px));
    out property <length> path-height: max(touch ? 48px : 32px, control-height + 8px);
    out property <length> column-height: max(touch ? 40px : 24px, small-font + 10px);
    out property <length> status-height: touch ? 36px : 24px;
    out property <length> command-height: bottom-height;
    out property <length> bottom-height: max(touch ? 40px : 22px, font-size + (touch ? 12px : 8px));
    out property <length> window-padding: touch ? 10px : 6px;
    out property <length> gap: touch ? 6px : 4px;
    out property <length> control-padding: touch ? 6px : 3px;
    out property <length> font-size: (touch ? touch-font-size : desktop-font-size) * 1px;
    out property <length> small-font: max(8px, font-size - (touch ? 2px : 1px));
    out property <length> hint-font: max(8px, font-size - (touch ? 3px : 1px));
    out property <length> icon-size: touch ? 20px : 14px;
    // Grow file/drive artwork inside the existing control and row bounds.
    out property <length> file-icon-size: icon-size * 1.1;
    out property <length> picker-location-icon-size: 18px * 1.1;
}
