import { WrappingCheckBox } from "wrapping-check-box.slint";
import { HintedActionButton } from "hinted-inputs.slint";
import { ThemedLineEdit } from "content-controls.slint";
import { Theme } from "theme.slint";
import { ErrorNotice } from "error-notice.slint";
import { DialogHeader } from "dialog-frame.slint";
import { DialogFooter } from "dialog-footer.slint";
import { FallbackIcons } from "action-icons.slint";

// The password of one mounted archive, asked once before an action needs it. The
// Presenter owns the request; the typed text leaves the field only through `submit`
// and is never mirrored into a property.
export global ArchivePasswords {
    // An empty token means the dialog is closed; each opening has a new one.
    in-out property <string> token;
    // The archive's shown name and what entering the password does.
    in-out property <string> archive;
    in-out property <string> purpose;
    // "Wrong password — try again" or another reason; empty while there is none.
    in-out property <string> error;
    // Each refused password counts once, so the dialog selects the text to retype.
    in-out property <int> attempt;
    // A password is being checked: OK waits for the answer.
    in-out property <bool> busy;
    callback submit(string, string);
    callback dismiss(string);
}

export component ArchivePasswordDialog inherits Rectangle {
    in property <bool> input-enabled: true;
    callback submit(string);
    callback cancel();
    callback move-dialog(length, length);
    public function begin() {
        if root.input-enabled { field.focus-value(); }
    }
    private property <bool> compact: root.height < 240px;
    private property <length> field-height: max(32px, Theme.control-height);
    private property <int> attempt: ArchivePasswords.attempt;
    changed attempt => {
        // A refused password stays selected: typing replaces it.
        field.focus-value();
        field.select-all();
    }
    background: Theme.surface; border-radius: 8px;
    border-width: 1px; border-color: Theme.active-frame;
    accessible-role: groupbox;
    accessible-label: "Archive password";
    FocusScope {
        // A key router, not a Tab stop.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.input-enabled && event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            padding: root.compact ? 8px : 16px; spacing: root.compact ? 4px : 8px;
            DialogHeader {
                title: "Archive password";
                fallback-icon: FallbackIcons.properties;
                compact: root.compact; enabled: root.input-enabled;
                close => { root.cancel(); }
                dragged(dx, dy) => { root.move-dialog(dx, dy); }
            }
            Text {
                text: ArchivePasswords.archive + " is password-protected. " + ArchivePasswords.purpose;
                color: Theme.text; font-size: Theme.font-size; wrap: word-wrap;
                accessible-role: text;
            }
            field := ThemedLineEdit {
                enabled: root.input-enabled; clear-button: true;
                accessible-label: "Password";
                accessible-description: ArchivePasswords.error;
                input-type: reveal.checked ? InputType.text : InputType.password;
                min-height: root.field-height; preferred-height: root.field-height;
                min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
                placeholder-text: "Password";
                accepted => { if !ArchivePasswords.busy { root.submit(field.text); } }
            }
            reveal := WrappingCheckBox {
                text: "Show password"; enabled: root.input-enabled;
                min-height: Theme.control-height;
                hint: "Shows the typed password instead of dots.";
                toggled => { field.focus-value(); }
            }
            if ArchivePasswords.error != "": ErrorNotice { text: ArchivePasswords.error; }
            if ArchivePasswords.busy: Text {
                text: "Checking the password…";
                color: Theme.secondary-text; font-size: Theme.font-size; wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            DialogFooter {
                compact-height: root.compact;
                dismiss-enabled: root.input-enabled;
                dismiss => { root.cancel(); }
                HintedActionButton {
                    text: "OK"; primary: true;
                    enabled: root.input-enabled && !ArchivePasswords.busy;
                    min-width: 72px; min-height: Theme.control-height;
                    hint: "Open the archive's protected members with this password (Enter).";
                    clicked => { root.submit(field.text); }
                }
            }
        }
    }
}
