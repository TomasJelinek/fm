import { Button, Palette } from "std-widgets.slint";
import { Theme } from "../../midnight-ui/ui/theme.slint";
import { ActionButton } from "../../midnight-ui/ui/action-icons.slint";
import { HintedActionButton } from "../../midnight-ui/ui/hinted-inputs.slint";
import { WrappingCheckBox } from "../../midnight-ui/ui/wrapping-check-box.slint";
import { CompactPicker } from "../../midnight-ui/ui/controls.slint";
import { ThemedLineEdit, ThemedSpinBox } from "../../midnight-ui/ui/content-controls.slint";

import { PositionBar } from "viewer-position-bar.slint";
import { ViewerFindBar } from "viewer-find-bar.slint";
import { MediaControls, MediaControlsState } from "viewer-media-controls.slint";
export { MediaControlsState }
export struct ViewerRasterTile { image: image, x: float, y: float, width: float, height: float }

// An icon-only action whose tooltip names it and its key. Declared once here: a Tooltip
// written at each use would make the compiler copy the button and a popup into every use.
component TippedActionButton inherits ActionButton {
    in property <string> tip;
    Tooltip { text: @markdown("\{root.tip}"); }
}

export component ViewerWindow inherits Window {
    title: root.caption;
    preferred-width: 1000px; preferred-height: 720px; min-width: 320px; min-height: 200px;
    in property <bool> compact;
    in property <string> caption: "Viewer — Midnight Explorer";
    in property <string> status: "Opening…";
    in property <MediaControlsState> media-controls;
    private property <bool> media-visible: root.media-controls.session != "";
    in property <image> surface;
    in property <bool> tiled;
    in property <bool> retained-raster;
    in property <image> raster-gutter;
    in property <float> raster-gutter-width;
    in property <float> raster-width;
    in property <float> raster-height;
    // Keep the frame's logical viewport while mode controls change the canvas.
    in property <length> raster-viewport-width: canvas.width;
    in property <length> raster-viewport-height: canvas.height;
    // Sub-pixel phase of the canvas origin, within half a physical pixel. Raster
    // images subtract it so that their texels start on whole physical pixels: at
    // a half-pixel origin, rounding noise otherwise lets the software renderer
    // grow an image by one row or column, which repeats a row of texels.
    private property <physical-length> canvas-left: canvas.absolute-position.x;
    private property <physical-length> canvas-top: canvas.absolute-position.y;
    private property <length> canvas-phase-x: (root.canvas-left / 1phx - round(root.canvas-left / 1phx)) * 1phx;
    private property <length> canvas-phase-y: (root.canvas-top / 1phx - round(root.canvas-top / 1phx)) * 1phx;
    in property <float> raster-offset-x;
    in property <float> raster-offset-y;
    in property <int> raster-upload-count;
    // Frame dimensions are physical pixels; the canvas is in logical pixels.
    in property <float> image-viewport-width;
    in property <float> image-viewport-height;
    in property <float> image-pixel-scale: 1;
    in property <bool> image-native-pixels;
    private property <length> image-width: root.image-viewport-width * root.image-pixel-scale * 1px;
    private property <length> image-height: root.image-viewport-height * root.image-pixel-scale * 1px;
    in property <[ViewerRasterTile]> image-tiles;
    in property <float> tile-offset-x;
    in property <float> tile-offset-y;
    in property <int> tile-upload-count;
    in property <string> position-context;
    in property <bool> position-pending;
    in property <string> accessible-text;
    in-out property <color> foreground: #dddddd;
    in-out property <color> background-color: #202020;
    in-out property <color> accent: #8bb7ef;
    // The applied tool theme's text selection, which document pages paint selected
    // text on (the application captures it from the same Theme for their palette).
    out property <color> selection-background: Theme.selection-background;
    in property <float> position;
    in property <float> displayed-position;
    out property <float> vertical-thumb-position: vbar.shown-position;
    out property <length> vertical-bar-left: vbar.absolute-position.x;
    out property <length> vertical-bar-top: vbar.absolute-position.y;
    out property <length> vertical-bar-width: vbar.width;
    out property <length> vertical-bar-height: vbar.height;
    in property <float> vertical-extent: 1;
    in property <float> horizontal-position;
    in property <float> horizontal-extent: 1;
    in property <[string]> modes;
    // Widgets that assign their own value (ComboBox selection, CheckBox toggle,
    // model resets) drop one-way bindings. These stay two-way bound, and Rust
    // re-sets them to the state actually in force after every change.
    in-out property <int> mode-index;
    in-out property <bool> wrap-enabled;
    in property <bool> wrap-available;
    in property <bool> image-mode;
    in property <bool> web-mode;
    in-out property <bool> web-network;
    in-out property <bool> web-scripts;
    in property <bool> web-policy-change-allowed: false;
    // Shown in the page's place when the system refused the HTML viewer's browser its
    // sandbox. The backend decides the text and whether Install… is offered.
    in property <bool> sandbox-notice-visible;
    in property <string> sandbox-notice;
    in property <bool> sandbox-installable;
    in property <bool> sandbox-installing;
    callback install-sandbox-permission();
    in property <bool> source-mode;
    in property <bool> markdown-mode;
    in property <bool> font-available: true;
    in-out property <bool> line-numbers: true;
    in-out property <bool> typography-visible;
    in-out property <string> viewer-font-family: "monospace";
    in property <[string]> font-families: ["sans-serif", "serif", "monospace"];
    in-out property <int> font-family-index: 2;
    in-out property <int> viewer-font-size: 14;
    in-out property <int> markdown-preset;
    in property <bool> narrow-typography: root.compact;
    in property <float> zoom-percent: 100;
    in property <int> document-page;
    in property <int> document-pages;
    // -1 is an ordinary image; document values come only from published frames.
    in property <int> document-layout: -1;
    in-out property <length> ui-font-size: Theme.font-size;
    in-out property <string> ui-font-family: Theme.effective-font-family;
    default-font-size: compact ? min(ui-font-size, 12px) : ui-font-size;
    default-font-family: root.ui-font-family != "" ? root.ui-font-family : "Segoe UI";
    // Keep compact controls readable at the minimum window size. Normal rows
    // follow the selected UI font and the active native widget metrics.
    private property <length> effective-ui-size: root.compact ? min(root.ui-font-size, 12px) : root.ui-font-size;
    private property <length> control-height: max(max(Theme.touch ? 40px : 28px, root.effective-ui-size + 14px),
        max(control-metrics.min-height, control-metrics.preferred-height));
    private property <bool> compact-status: !root.media-visible
        && root.compact && (root.image-mode || root.source-mode);
    private property <bool> stacked-image-footer:
        !root.media-visible && root.image-mode && root.document-page > 0
        && (root.compact || root.width < root.effective-ui-size * 32 + 260px);
    private property <length> status-size: max(11px, root.effective-ui-size - 1px);
    private property <length> status-row-height: max(18px, root.status-size + 6px);
    private property <length> layout-padding: root.compact && root.document-layout >= 0 ? 4px : 6px;
    private property <length> layout-spacing: root.compact && root.document-layout >= 0 ? 2px : 4px;
    private property <length> tool-row-height: max(32px, root.control-height);
    // The window's logical size whenever the viewer applies `compact` (0 before then). The
    // rows are planned from it, not from the window's own size, which depends on them.
    in property <length> available-width;
    in property <length> available-height;
    // Rows of controls between an open Find bar and the text.
    private property <bool> web-row-requested: !root.media-visible && root.web-mode;
    private property <bool> typography-requested: !root.media-visible && !root.image-mode
        && root.font-available && (root.typography-visible || root.markdown-mode || root.source-mode);
    // A window too short for an open Find bar, those rows, the rows below the text and one
    // control height of text hides those rows first: the Find bar, the status and the
    // footer keep their places. The Find bar's Close (and text mode's Aa) brings the rows
    // back, Find or Ctrl+F opens Find again, and the HTML zoom keys keep working.
    private property <bool> find-displaces-rows: find-bar.visible
        && (root.web-row-requested || root.typography-requested)
        && root.available-height > 0px
        && root.available-height < 2 * root.layout-padding
            + find-bar.rows-height(root.available-width - 2 * root.layout-padding)
            + (root.web-row-requested ? root.tool-row-height + root.layout-spacing : 0px)
            + (root.typography-requested ? root.tool-row-height + root.layout-spacing : 0px)
            + 2 * root.control-height + 16px + 3 * root.layout-spacing
            + (root.compact-status ? root.status-row-height + root.layout-spacing : 0px);
    control-metrics := Button { visible: false; text: "Aa"; }
    in-out property <bool> search-visible;
    in-out property <string> query;
    in-out property <bool> case-sensitive;
    in-out property <bool> whole-words;
    in property <bool> whole-words-available;
    out property <length> content-width: canvas.width;
    out property <length> content-height: canvas.height;
    out property <length> content-left: canvas.absolute-position.x;
    out property <length> content-top: canvas.absolute-position.y;
    out property <bool> content-focused: content-focus.has-focus;
    callback media-toggle(string);
    callback media-seek(string, float);
    callback input-key(KeyEvent, bool) -> bool;
    callback scroll(float, float) -> bool;
    // Scrollbar seeks: drag-seek(horizontal, position) arrives between
    // position-drag-began and position-drag-ended, which settles the position.
    callback position-drag-began(bool);
    callback position-drag-ended(bool);
    callback drag-seek(bool, float);
    callback select-point(float, float, bool);
    callback find();
    callback search(bool);
    callback clear-search();
    callback change-mode(int);
    callback change-wrap(bool);
    callback change-case-sensitive(bool);
    callback change-line-numbers(bool);
    callback change-font-family(string);
    callback change-font-size(int);
    callback change-markdown-preset(int);
    callback image-command(int);
    callback image-zoom(float, float, float);
    callback image-drag(float, float);
    callback document-turn(int);
    callback change-document-layout(int);
    callback web-policy(bool, bool);
    callback deliver-output();
    callback frame-presented();
    public function focus-search() {
        if !root.media-visible { root.search-visible = true; find-bar.focus-query(); }
    }
    public function focus-content() { content-focus.focus(); }
    public function apply-palette(light: bool) {
        Theme.font-family = root.ui-font-family;
        Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark;
    }
    public function apply-tool-theme(scheme: int, density: int, family: string, desktop: int, touch: int) {
        Theme.scheme = scheme; Theme.density = density; Theme.font-family = family;
        Theme.desktop-font-size = desktop; Theme.touch-font-size = touch;
        root.ui-font-family = Theme.effective-font-family; root.ui-font-size = Theme.font-size;
        root.foreground = Theme.text; root.background-color = Theme.pane-background; root.accent = Theme.accent;
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    background: Theme.window-background;
    forward-focus: content-focus;
    FocusScope {
        capture-key-pressed(event) => {
            // Only the content surface owns file cycling and scroll shortcuts.
            // Search, buttons and the mode chooser keep native widget keys.
            if root.input-key(event, !content-focus.has-focus) { return accept; }
            reject
        }
        VerticalLayout {
            padding: root.layout-padding;
            spacing: root.layout-spacing;
            find-bar := ViewerFindBar {
                visible: !root.media-visible && root.search-visible && !root.image-mode;
                height: self.visible ? self.preferred-height : 0px;
                font-size: root.effective-ui-size; control-height: root.control-height;
                compact: root.compact; web-mode: root.web-mode;
                closable: root.find-displaces-rows;
                query <=> root.query; case-sensitive <=> root.case-sensitive;
                whole-words <=> root.whole-words;
                whole-words-available: root.whole-words-available;
                search(backwards) => { root.search(backwards); }
                clear-query => { root.clear-search(); }
                case-changed(value) => { root.change-case-sensitive(value); }
                close => { root.search-visible = false; content-focus.focus(); }
            }
            if root.web-row-requested && !root.find-displaces-rows: HorizontalLayout {
                    spacing: 4px; height: root.tool-row-height;
                    WrappingCheckBox { font-size: root.effective-ui-size; control-height: root.control-height; text: "Online"; checked <=> root.web-network; enabled: root.web-policy-change-allowed; horizontal-stretch: 0;
                        accessible-name: "Allow network for this document only";
                        Tooltip { text: root.web-policy-change-allowed
                            ? @markdown("Allow network for this document only. This creates a fresh browser context and removes access to local assets. Turning Online off also disables JavaScript.")
                            : @markdown("Network and JavaScript cannot be enabled for this preview."); }
                        toggled => { root.web-policy(self.checked, root.web-scripts && self.checked); content-focus.focus(); } }
                    WrappingCheckBox { font-size: root.effective-ui-size; control-height: root.control-height; text: root.compact ? "JS" : "JavaScript"; checked <=> root.web-scripts; enabled: root.web-policy-change-allowed && root.web-network; horizontal-stretch: 0;
                        accessible-name: "Allow scripts to read and transmit this document";
                        Tooltip { text: root.web-policy-change-allowed
                            ? @markdown("Allow JavaScript to read and transmit this document. Requires Online. Local assets remain unavailable.")
                            : @markdown("Network and JavaScript cannot be enabled for this preview."); }
                        toggled => { root.web-policy(root.web-network, self.checked); content-focus.focus(); } }
                    Rectangle { horizontal-stretch: 1; }
                    TippedActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact; text: "−"; min-width: 36px; max-width: 36px;
                        accessible-label: "Zoom HTML out"; tip: "Zoom HTML out (Ctrl+-)";
                        clicked => { root.image-command(3); content-focus.focus(); } }
                    Text { text: "\{round(root.zoom-percent)}%"; color: Theme.text; vertical-alignment: center;
                        horizontal-alignment: center; min-width: 52px; max-width: 52px; }
                    TippedActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact; text: "+"; min-width: 36px; max-width: 36px;
                        accessible-label: "Zoom HTML in"; tip: "Zoom HTML in (Ctrl++)";
                        clicked => { root.image-command(2); content-focus.focus(); } }
            }
            if root.typography-requested && !root.find-displaces-rows: HorizontalLayout {
                spacing: 6px; height: root.tool-row-height;
                if root.source-mode: WrappingCheckBox { font-size: root.effective-ui-size; control-height: root.control-height;
                    text: "Lines"; checked <=> root.line-numbers;
                    accessible-name: "Source line numbers";
                    toggled => { root.change-line-numbers(self.checked); content-focus.focus(); }
                }
                if root.markdown-mode: CompactPicker {
                    font-size: root.effective-ui-size; control-height: root.control-height;
                    model: ["GitHub", "Compact", "Comfortable"];
                    min-width: root.narrow-typography ? 95px : 140px;
                    max-width: root.narrow-typography ? 95px : 180px;
                    current-index: root.markdown-preset;
                    label: self.model[root.markdown-preset];
                    accessible-name: "Markdown presentation";
                    selected(index) => { root.markdown-preset = index; root.change-markdown-preset(index); }
                }
                if !root.narrow-typography: Text { text: "Font"; color: Theme.text; vertical-alignment: center; }
                CompactPicker {
                    font-size: root.effective-ui-size; control-height: root.control-height;
                    model: root.font-families;
                    current-index: root.font-family-index;
                    label: root.viewer-font-family;
                    min-width: root.narrow-typography ? 90px : 150px; horizontal-stretch: 1;
                    accessible-name: "Viewer font family";
                    selected(index) => {
                        root.font-family-index = index;
                        root.change-font-family(root.font-families[index]);
                    }
                }
                if !root.narrow-typography: Text { text: "Size"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 0; }
                ThemedSpinBox { value <=> root.viewer-font-size; minimum: 8; maximum: 48;
                    font-size: root.effective-ui-size; control-height: root.control-height;
                    min-width: 85px; max-width: 90px;
                    accessible-label: "Viewer font size";
                    edited(value) => { root.change-font-size(value); } }
            }
            HorizontalLayout {
                spacing: root.media-visible ? 0px : 2px;
                canvas := Rectangle {
                    horizontal-stretch: 1; vertical-stretch: 1; clip: true;
                    background: root.background-color;
                    accessible-role: text;
                    accessible-label: "File content";
                    accessible-value: root.accessible-text;
                    Image {
                        source: root.surface;
                        x: root.media-visible ? 0px : root.image-mode ? (canvas.width - root.image-width) / 2 : -root.canvas-phase-x;
                        y: root.media-visible ? 0px : root.image-mode ? (canvas.height - root.image-height) / 2 : -root.canvas-phase-y;
                        width: root.media-visible ? canvas.width : root.image-mode ? root.image-width : root.raster-viewport-width;
                        height: root.media-visible ? canvas.height : root.image-mode ? root.image-height : root.raster-viewport-height;
                        image-fit: root.media-visible ? contain : fill;
                        visible: !root.tiled && !root.retained-raster;
                    }
                    if root.retained-raster: Rectangle {
                        x: root.raster-gutter-width * root.raster-viewport-width - root.canvas-phase-x;
                        width: canvas.width - self.x; height: canvas.height; clip: true;
                        Image {
                            source: root.surface;
                            x: root.raster-offset-x * root.raster-viewport-width;
                            y: root.raster-offset-y * root.raster-viewport-height - root.canvas-phase-y;
                            width: root.raster-width * root.raster-viewport-width;
                            height: root.raster-height * root.raster-viewport-height;
                            image-fit: fill;
                        }
                    }
                    if root.retained-raster && root.raster-gutter-width > 0: Image {
                        source: root.raster-gutter;
                        x: -root.canvas-phase-x;
                        y: root.raster-offset-y * root.raster-viewport-height - root.canvas-phase-y;
                        width: root.raster-gutter-width * root.raster-viewport-width;
                        height: root.raster-height * root.raster-viewport-height;
                        image-fit: fill;
                    }
                    for tile in root.image-tiles: Image {
                        visible: root.tiled;
                        source: tile.image;
                        x: (canvas.width - root.image-width) / 2 + (tile.x - root.tile-offset-x) * root.image-width;
                        y: (canvas.height - root.image-height) / 2 + (tile.y - root.tile-offset-y) * root.image-height;
                        width: tile.width * root.image-width;
                        height: tile.height * root.image-height;
                        image-fit: fill;
                        image-rendering: root.image-native-pixels ? ImageRendering.pixelated : ImageRendering.smooth;
                    }
                    content-focus := FocusScope {}
                    TouchArea {
                        property <length> previous-x;
                        property <length> previous-y;
                        mouse-cursor: root.media-visible ? MouseCursor.default
                            : root.image-mode ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.text;
                        pointer-event(event) => {
                            if root.web-mode && !root.media-visible { return; }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                content-focus.focus();
                                if root.media-visible { return; }
                                self.previous-x = self.mouse-x;
                                self.previous-y = self.mouse-y;
                                if !root.image-mode { root.select-point(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift); }
                            }
                        }
                        moved => { if self.pressed && !root.web-mode && !root.media-visible {
                            if root.image-mode {
                                root.image-drag((self.mouse-x - self.previous-x) / 1px, (self.mouse-y - self.previous-y) / 1px);
                                self.previous-x = self.mouse-x; self.previous-y = self.mouse-y;
                            } else { root.select-point(self.mouse-x / 1px, self.mouse-y / 1px, true); }
                        } }
                        scroll-event(event) => {
                            if root.media-visible { return reject; }
                            if root.web-mode { return accept; }
                            if root.image-mode && event.modifiers.control {
                                root.image-zoom(event.delta-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                                return accept;
                            }
                            if root.scroll(-event.delta-x / 1px, -event.delta-y / 1px) { return accept; }
                            reject
                        }
                    }
                    // In the page's place. Tab from the content reaches Install…, which
                    // follows the content in the focus order; Return activates it.
                    if root.sandbox-notice-visible: Rectangle {
                        width: max(0px, min(canvas.width - 16px, max(260px, root.effective-ui-size * 34)));
                        height: max(0px, min(canvas.height - 16px, notice-text.height + 28px
                            + (root.sandbox-installable ? root.control-height + 12px : 0px)));
                        x: (canvas.width - self.width) / 2;
                        y: max(8px, (canvas.height - self.height) / 3);
                        clip: true;
                        background: Theme.surface;
                        border-width: 1px; border-color: Theme.frame; border-radius: 6px;
                        notice-text := Text {
                            x: 14px; y: 14px;
                            width: max(0px, parent.width - 28px);
                            height: self.preferred-height;
                            text: root.sandbox-notice; wrap: word-wrap;
                            color: Theme.text; font-size: root.effective-ui-size;
                        }
                        if root.sandbox-installable: HorizontalLayout {
                            x: 14px; y: notice-text.y + notice-text.height + 12px;
                            width: max(0px, parent.width - 28px); height: root.control-height;
                            alignment: start;
                            HintedActionButton {
                                font-size: root.effective-ui-size; control-height: root.control-height;
                                compact: root.compact; primary: true;
                                text: "Install…"; enabled: !root.sandbox-installing;
                                accessible-description: "Install the HTML viewer's AppArmor profile with administrator authorization";
                                hint: "Asks for administrator authorization, then installs the AppArmor profile that lets this installation's HTML viewer use Chromium's sandbox, and opens the page again.";
                                clicked => { root.install-sandbox-permission(); }
                            }
                        }
                    }
                }
                Rectangle {
                    // New page widths and Fit/1:1 keep one physical viewport.
                    // A newly necessary bar must not end a captured drag.
                    min-width: root.media-visible ? 0px : 14px;
                    max-width: self.min-width;
                    vbar := PositionBar { width: parent.width; height: parent.height;
                        context-key: root.position-context;
                        position: root.position; extent: root.vertical-extent; accent: root.accent;
                        visible: !root.media-visible && root.vertical-extent < 1;
                        seek(value) => { root.drag-seek(false, value); }
                        drag-started => { root.position-drag-began(false); }
                        drag-ended => { root.position-drag-ended(false); } }
                }
            }
            HorizontalLayout {
                height: root.media-visible ? 0px : 16px;
                PositionBar { horizontal: true; position: root.horizontal-position; extent: root.horizontal-extent;
                    context-key: root.position-context;
                    visible: !root.media-visible && root.horizontal-extent < 1;
                    accent: root.accent; seek(value) => { root.drag-seek(true, value); }
                    drag-started => { root.position-drag-began(true); }
                    drag-ended => { root.position-drag-ended(true); } }
            }
            if root.media-visible : MediaControls {
                state: root.media-controls;
                compact: root.compact; accent: root.accent;
                font-size: root.effective-ui-size; control-height: root.control-height;
                status-size: root.status-size;
                toggle(session) => { root.media-toggle(session); }
                seek(session, position) => { root.media-seek(session, position); }
            }
            if root.compact-status : Text {
                height: root.status-row-height; text: root.position-pending ? "Loading requested position… · " + root.status : root.status; color: Theme.text;
                font-size: root.status-size; overflow: elide; vertical-alignment: center;
            }
            // Keep width-dependent grid placement out of the window's intrinsic sizing.
            Rectangle {
                min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
                height: root.stacked-image-footer
                    ? (root.document-layout >= 0 ? 3 * root.control-height + 6px
                        : 2 * root.control-height + 3px) : root.control-height;
                HorizontalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    // Width comes only from what the buttons leave over: a longer status (for example
                    // "Loading requested position…") must never push Find, Wrap or Aa sideways.
                    Text { visible: !root.compact-status; min-width: 0px; preferred-width: 0px; max-width: root.compact-status ? 0px : 1000000px; text: root.position-pending ? "Loading requested position… · " + root.status : root.status; color: Theme.text; font-size: root.status-size; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    if !root.media-visible && root.image-mode: GridLayout {
                        spacing: 3px;
                        // Long PDF page counts must not crowd the zoom actions at
                        // the minimum width, regardless of native font metrics.
                        if root.document-page > 0: HorizontalLayout {
                            row: 0; col: 0;
                            height: root.control-height;
                            spacing: 3px;
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 26px : 0px;
                                max-width: root.compact ? 26px : 1000000px;
                                text: "‹";
                                accessible-label: "Previous document page (Ctrl+PageUp)";
                                enabled: root.document-page > 1;
                                clicked => { root.document-turn(-1); content-focus.focus(); }
                            }
                            Text {
                                text: "\{root.document-page} / \{root.document-pages}";
                                accessible-label: "Document page counter";
                                accessible-value: self.text;
                                color: Theme.text;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 26px : 0px;
                                max-width: root.compact ? 26px : 1000000px;
                                text: "›";
                                accessible-label: "Next document page (Ctrl+PageDown)";
                                enabled: root.document-page < root.document-pages;
                                clicked => { root.document-turn(1); content-focus.focus(); }
                            }
                        }
                        if root.document-layout >= 0: HorizontalLayout {
                            row: root.stacked-image-footer ? 1 : 0;
                            col: root.stacked-image-footer ? 0 : 1;
                            height: root.control-height;
                            spacing: 3px;
                            // The acknowledged frame drives the highlight and accessible state.
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                text: "Paged";
                                primary: root.document-layout == 0;
                                accessible-label: "Paged document layout";
                                accessible-checkable: true;
                                accessible-checked: root.document-layout == 0;
                                clicked => { root.change-document-layout(0); content-focus.focus(); }
                            }
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                text: "Continuous";
                                primary: root.document-layout == 1;
                                accessible-label: "Continuous document layout";
                                accessible-checkable: true;
                                accessible-checked: root.document-layout == 1;
                                clicked => { root.change-document-layout(1); content-focus.focus(); }
                            }
                        }
                        HorizontalLayout {
                            row: root.stacked-image-footer ? (root.document-layout >= 0 ? 2 : 1) : 0;
                            col: root.stacked-image-footer || root.document-page == 0 ? 0
                                : root.document-layout >= 0 ? 2 : 1;
                            height: root.control-height;
                            spacing: 3px;
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 34px : 0px;
                                max-width: root.compact ? 34px : 1000000px;
                                text: "Fit"; accessible-label: "Fit image to window";
                                clicked => { root.image-command(0); content-focus.focus(); }
                            }
                            ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 34px : 0px;
                                max-width: root.compact ? 34px : 1000000px;
                                text: "1:1"; accessible-label: "Actual image pixels";
                                clicked => { root.image-command(1); content-focus.focus(); }
                            }
                            TippedActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 26px : 0px;
                                max-width: root.compact ? 26px : 1000000px;
                                text: "−"; accessible-label: "Zoom image out";
                                tip: "Zoom image out (Ctrl+-)";
                                clicked => { root.image-command(3); content-focus.focus(); }
                            }
                            Text {
                                text: "\{round(root.zoom-percent * 10) / 10}%";
                                accessible-label: "Image zoom percentage";
                                accessible-value: self.text;
                                color: Theme.text;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                            TippedActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                                min-width: root.compact ? 26px : 0px;
                                max-width: root.compact ? 26px : 1000000px;
                                text: "+"; accessible-label: "Zoom image in";
                                tip: "Zoom image in (Ctrl++)";
                                clicked => { root.image-command(2); content-focus.focus(); }
                            }
                        }
                    }
                    if !root.media-visible && !root.image-mode: ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                        text: "Find"; horizontal-stretch: 0;
                        clicked => { root.find(); }
                    }
                    if !root.media-visible && !root.image-mode && !root.web-mode: WrappingCheckBox { font-size: root.effective-ui-size; control-height: root.control-height; text: "Wrap"; checked <=> root.wrap-enabled; enabled: root.wrap-available;
                        accessible-name: "Word wrap";
                        toggled => { root.change-wrap(self.checked); content-focus.focus(); } }
                    if !root.media-visible && !root.image-mode && root.font-available && !root.source-mode && !root.markdown-mode: ActionButton { font-size: root.effective-ui-size; control-height: root.control-height; compact: root.compact;
                        text: "Aa"; min-width: 30px; max-width: 38px;
                        accessible-label: "Font and presentation";
                        clicked => {
                            // A row that an open Find bar covers comes back instead of turning off.
                            if !(root.typography-requested && root.find-displaces-rows) {
                                root.typography-visible = !root.typography-visible;
                            }
                            if root.find-displaces-rows { root.search-visible = false; content-focus.focus(); }
                        }
                    }
                    if !root.media-visible && !root.image-mode: CompactPicker { model: root.modes; current-index: root.mode-index;
                        font-size: root.effective-ui-size; control-height: root.control-height;
                        label: root.mode-index >= 0 && root.mode-index < root.modes.length
                            ? root.modes[root.mode-index] : "";
                        accessible-name: "Viewer mode"; width: 130px; popup-above: true;
                        selected(index) => { root.change-mode(index); } }
                }
            }
        }
    }
}
