import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NavigationChoiceRow, LocationRole } from "navigation-models.slint";
import { LocationImage } from "action-icons.slint";
import { TooltipPlacement } from "tooltip-placement.slint";
export { TooltipPlacement }

// Dynamic paths and volume labels remain plain text, including Markdown punctuation.
export component TipBody inherits Rectangle {
    in property <string> text;
    x: 0px; y: 0px;
    width: min(560px, max(120px, content.preferred-width + 20px),
        TooltipPlacement.max-room(TooltipPlacement.cursor-x, TooltipPlacement.surface-width, 14px));
    height: min(content.preferred-height + 16px,
        TooltipPlacement.max-room(TooltipPlacement.cursor-y, TooltipPlacement.surface-height, 18px));
    clip: true;
    background: Theme.surface;
    border-color: Theme.active-frame;
    border-width: 1px;
    border-radius: 4px;
    content := Text {
        x: 10px; y: 8px; width: max(1px, parent.width - 20px);
        text: root.text; color: Theme.text; font-size: Theme.small-font;
        wrap: char-wrap;
        accessible-label: root.text;
    }
}

// Keep the closed control compact while giving full labels a readable popup.
// Only selected() commits: keyboard browsing never overwrites the host's index.
export component CompactPicker inherits Rectangle {
    in property <[string]> model;
    in property <[NavigationChoiceRow]> choices;
    in property <[image]> icons;
    in property <int> model-revision;
    in property <int> current-index: -1;
    in property <string> shortcut-key;
    in property <int> shortcut-index: -1;
    in property <string> label;
    in property <string> hint;
    in property <string> accessible-name;
    in property <image> icon;
    in property <image> native-icon;
    in property <bool> icon-only;
    in property <bool> arrow-trigger-only;
    in property <bool> show-row-icons: true;
    in property <bool> popup-align-right;
    in property <bool> enabled: true;
    in property <bool> framed: true;
    in property <bool> popup-above;
    in property <length> minimum-control-width: 40px;
    in property <length> popup-width: 360px;
    out property <length> compact-width: caption-metrics.preferred-width + 29px
        + (root.has-leading-icon ? Theme.picker-location-icon-size + 4px : 0px);
    private property <int> pending-index: -1;
    private property <bool> expanded;
    private property <bool> has-leading-icon: root.show-row-icons && !root.icon-only && !root.arrow-trigger-only
        && root.current-index >= 0 && (root.choices.length > 0 || root.current-index < root.icons.length);
    private property <bool> arrow-only: !root.icon-only && root.label == "" && !root.has-leading-icon;
    private property <int> item-count: root.choices.length > 0 ? root.choices.length : root.model.length;
    private property <[NavigationChoiceRow]> opened-choices;
    private property <int> opened-revision;
    callback selected(int);
    callback selected-key(string);
    callback dismissed();
    height: Theme.control-height;
    caption-metrics := Text { visible: false; text: root.label; font-size: Theme.font-size; }
    min-width: root.minimum-control-width;
    border-width: 1px;
    border-radius: 4px;
    border-color: focus.has-focus ? Theme.active-frame : root.framed ? Theme.frame : transparent;
    background: area.has-hover && root.enabled ? Theme.hover : root.framed ? Theme.surface : transparent;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 ? root.row-label(root.current-index) : "";
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-expand => { root.open(); }
    changed model => { if root.expanded && root.choices.length == 0 { root.cancel(); } }
    changed model-revision => { if root.expanded { root.cancel(); } }
    changed current-index => { if root.expanded { root.cancel(); } }
    changed enabled => { if !root.enabled && root.expanded { root.cancel(); } }
    pure function row-label(index: int) -> string {
        if index < 0 || index >= root.item-count { return ""; }
        return root.choices.length > 0 ? root.choices[index].label : root.model[index];
    }
    pure function row-key(index: int) -> string {
        return index >= 0 && index < root.choices.length ? root.choices[index].identity : "";
    }
    pure function row-hint(index: int) -> string {
        return root.choices.length > 0 ? root.choices[index].tooltip : root.row-label(index);
    }
    pure function row-icon(index: int) -> image {
        return root.choices.length > 0 ? root.choices[index].icon : root.icons[index];
    }

    public function open() {
        if root.enabled && root.item-count > 0 {
            root.pending-index = min(root.item-count - 1, max(0, root.current-index));
            root.opened-choices = root.choices;
            root.opened-revision = root.model-revision;
            root.expanded = true;
            popup.show();
        }
    }
    function cancel() {
        popup.close();
        root.expanded = false;
        focus.focus();
        root.dismissed();
    }
    function commit(index: int) {
        let key = root.row-key(index);
        if root.opened-revision != root.model-revision
            || (key != "" && (index >= root.opened-choices.length || root.opened-choices[index].identity != key)) {
            root.cancel(); return;
        }
        popup.close();
        root.expanded = false;
        focus.focus();
        if root.enabled && index >= 0 && index < root.item-count {
            if key != "" { root.selected-key(key); } else { root.selected(index); }
        }
    }
    HorizontalLayout {
        padding-left: root.arrow-only ? 0px : root.has-leading-icon ? 5px : 6px;
        padding-right: root.arrow-only ? 0px : root.has-leading-icon ? 5px : 6px;
        spacing: root.arrow-only ? 0px : 4px;
        alignment: root.arrow-only ? center : stretch;
        cross-axis-alignment: center;
        if root.has-leading-icon : LocationImage {
            native-icon: root.row-icon(root.current-index);
            kind: root.choices.length > 0 ? root.choices[root.current-index].kind : LocationRole.drive;
            width: Theme.picker-location-icon-size; height: self.width; image-fit: contain;
        }
        if !root.arrow-only : Rectangle {
            horizontal-stretch: 1; height: root.height;
            Image {
                visible: root.icon-only;
                source: root.native-icon.width > 0 ? root.native-icon : root.icon;
                colorize: root.native-icon.width > 0 ? transparent : Theme.accent;
                width: 18px; height: 18px; image-fit: contain;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            Text {
                visible: !root.icon-only; text: root.label;
                width: parent.width; height: parent.height;
                color: Theme.text; font-size: Theme.font-size;
                vertical-alignment: center; overflow: elide;
            }
        }
        Rectangle {
            width: 9px; height: root.height;
            Image {
                source: @image-url("icons/chevron-down.svg");
                colorize: root.enabled ? Theme.secondary-text : Theme.muted-text;
                width: 9px; height: 6px; image-fit: contain;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " "
                || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.open();
                return accept;
            }
            reject
        }
        area := TouchArea {
            enabled: root.enabled;
            clicked => { focus.focus(); root.open(); }
        }
    }
    Tooltip { TipBody { text: root.hint; } }
    popup := PopupWindow {
        x: clamp(root.absolute-position.x + (root.popup-align-right ? root.width - self.width : 0px),
            8px, max(8px, TooltipPlacement.surface-width - self.width - 8px)) - root.absolute-position.x;
        y: root.popup-above ? -self.height : root.height;
        width: min(max(root.popup-width, root.width), max(1px, TooltipPlacement.surface-width - 16px));
        height: min(360px, root.item-count * Theme.control-height + 10px);
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if root.shortcut-key != "" && event.text == root.shortcut-key
                    && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.shift && !event.modifiers.meta {
                    root.commit(root.shortcut-index);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.pending-index = min(root.item-count - 1, root.pending-index + 1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.pending-index = max(0, root.pending-index - 1);
                    return accept;
                }
                if event.text == Key.Home { root.pending-index = 0; return accept; }
                if event.text == Key.End {
                    root.pending-index = root.item-count - 1;
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.commit(root.pending-index);
                    return accept;
                }
                if event.text == Key.Escape || event.text == Key.Tab {
                    root.cancel(); return accept;
                }
                reject
            }
            Rectangle {
                background: Theme.surface; border-width: 1px;
                border-color: Theme.active-frame; border-radius: 4px;
                ListView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    horizontal-scrollbar-policy: always-off;
                    // Direct ListView children stay virtualized even for a full
                    // installed-font catalog. The host keeps the committed index.
                    content-y: -min(max(0px, root.item-count * Theme.control-height - self.visible-height),
                        max(0, root.pending-index - 5) * Theme.control-height);
                    for value[index] in root.item-count : Rectangle {
                        height: Theme.control-height;
                        background: index == root.pending-index || row-area.has-hover
                            ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: root.row-label(index);
                        accessible-action-default => { root.commit(index); }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: index == root.current-index ? "✓" : "";
                                color: Theme.accent; width: 16px; vertical-alignment: center;
                            }
                            if root.show-row-icons && (root.choices.length > 0 || index < root.icons.length) : LocationImage {
                                native-icon: root.row-icon(index);
                                kind: root.choices.length > 0 ? root.choices[index].kind : LocationRole.drive;
                                width: Theme.picker-location-icon-size; height: self.width;
                            }
                            Text {
                                text: root.row-label(index); color: Theme.text; font-size: Theme.font-size;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                        row-area := TouchArea {
                            private property <string> pressed-key;
                            private property <int> pressed-revision;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    self.pressed-key = root.row-key(index);
                                    self.pressed-revision = root.model-revision;
                                }
                            }
                            clicked => {
                                if self.pressed-key == root.row-key(index) && self.pressed-revision == root.model-revision {
                                    root.commit(index);
                                }
                            }
                        }
                        Tooltip { TipBody { text: root.row-hint(index); } }
                    }
                }
            }
        }
    }
}
