import { HintedActionButton } from "hinted-inputs.slint";
import { ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { CommandMenuBody } from "command-menu.slint";
import { Theme } from "theme.slint";
import { TipBody, CompactPicker, TooltipPlacement } from "controls.slint";
import { CompactLocationButton } from "location-controls.slint";
import { PanelList } from "panel-list.slint";
import { TabRow, BookmarkRow, PathPartRow, DetailRow } from "navigation-models.slint";
import { NavigationChoiceRow, LocationRole } from "navigation-models.slint";
import { ActionIcons, FallbackIcons, NativeActionImage } from "action-icons.slint";
import { TabStrip, BookmarkMenu, HistoryNavigation } from "navigation-controls.slint";
import { PathNavigation } from "path-navigation.slint";
import { PanelDetails } from "panel-details.slint";
import { PanelSplitter } from "panel-splitter.slint";
import { TerminalControl } from "terminal-control.slint";
import { OptionsBody } from "options-dialog.slint";
import { PanelSearch, PrefixName, SearchTextEdit } from "panel-search.slint";
export { Theme }
export { TabRow, BookmarkRow, PathPartRow, DetailRow }
export { ActionIcons, NavigationChoiceRow, LocationRole }
export { SearchTextEdit }
export { TooltipPlacement }

export struct FileRow {
    identity: string,
    name: string,
    prefix-end: int,
    compressed: bool,
    size: string,
    size-state: int,
    size-hint: string,
    modified: string,
    kind: string,
    icon: image,
    directory: bool,
    selected: bool,
    cursor: bool,
}
export struct LocationRow {
    identity: string, kind: LocationRole,
    label: string, compact-label: string, is-drive: bool,
    path: string, tooltip: string, icon: image, selected: bool
}

component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <image> native-icon;
    in property <string> hint;
    callback clicked();
    width: Theme.tool-width; height: Theme.control-height;
    border-radius: 4px;
    background: area.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-action-default => { root.clicked(); }
    Text { visible: root.label != ""; text: root.label; color: Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    NativeActionImage { visible: root.label == ""; native-icon: root.native-icon; fallback-icon: root.icon; width: 18px; height: 18px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; }
    area := TouchArea { clicked => { root.clicked(); } }
    Tooltip { TipBody { text: root.hint; } }
}

// Native buttons enforce a taller minimum; these fixed-height function keys
// share the same focus, pointer and accessibility behavior at either density.
component FunctionButton inherits Rectangle {
    in property <image> native-icon;
    in property <image> fallback-icon;
    in property <string> text;
    in property <string> hint;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.bottom-height;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.active-frame : Theme.frame;
    background: area.has-hover && root.enabled ? Theme.hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.text + (root.enabled ? "" : " — unavailable in read-only stage");
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px; spacing: 4px;
        cross-axis-alignment: center;
        NativeActionImage {
            native-icon: root.native-icon; fallback-icon: root.fallback-icon;
            action-enabled: root.enabled; width: Theme.icon-size; height: Theme.icon-size;
        }
        Text {
            text: root.text; font-size: Theme.font-size;
            color: root.enabled ? Theme.text : Theme.muted-text;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide; horizontal-stretch: 1;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta
                && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked(); return accept;
            }
            reject
        }
        area := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
    }
    Tooltip { TipBody { text: root.hint; } }
}

component FilePane inherits Rectangle {
    in property <ActionIcons> action-icons;
    in property <[NavigationChoiceRow]> choices;
    in property <int> choice-index: -1;
    in property <int> choice-revision;
    in property <bool> active;
    in property <[TabRow]> tabs;
    in property <[BookmarkRow]> bookmarks;
    in property <[NavigationChoiceRow]> hot-path-choices;
    in property <[NavigationChoiceRow]> back-history;
    in property <[NavigationChoiceRow]> forward-history;
    in property <int> history-revision;
    in property <[PathPartRow]> path-parts;
    in property <[DetailRow]> details;
    in property <string> bookmark-name;
    in property <length> viewport-width;
    in property <length> viewport-height;
    in property <string> path;
    in property <[string]> volumes;
    in property <[image]> volume-icons;
    in property <[string]> volume-short-labels;
    in property <[string]> volume-tooltips;
    in property <int> volumes-revision;
    in property <int> volume-index;
    in property <[FileRow]> rows;
    in property <[LocationRow]> locations;
    in property <string> status;
    in property <string> error;
    in property <bool> loading;
    in property <bool> scroll-interaction-active;
    in property <int> cursor-index: -1;
    in property <int> sort-column;
    in property <bool> descending;
    in property <bool> sizes-in-bytes;
    // Keep all three columns inside narrow split panes. Exact byte values remain
    // available in the copyable status field when the list must elide them.
    private property <length> size-column-width: min(
        root.sizes-in-bytes ? max(126px, Theme.small-font * 15) : 78px,
        max(78px, root.width - 310px));
    in-out property <string> search-query;
    in property <string> search-context;
    in property <bool> search-pending;
    in property <int> search-count;
    out property <bool> search-active: search.active;
    out property <string> search-preedit: search.preedit;
    in property <length> row-height: Theme.row-height;
    private property <string> previous-click-identity;
    out property <bool> list-focused: search.has-focus;
    out property <length> list-visible-height: list.visible-height;
    out property <length> list-left: list.absolute-position.x;
    out property <length> list-top: list.absolute-position.y;
    out property <length> list-width: list.width;
    out property <length> path-left: path-input.absolute-position.x;
    out property <length> path-top: path-input.absolute-position.y;
    out property <length> path-width: path-input.width;
    out property <length> path-control-height: path-input.height;
    out property <string> path-draft: path-input.text;
    out property <string> highlighted-path: path-input.highlighted-prefix;
    out property <length> details-top: details-bar.absolute-position.y;
    out property <length> details-left: details-bar.absolute-position.x;
    // Include one adjacent row for the virtualized repeater's boundary cache.
    out property <int> visible-row-start: root.row-height > 0px
        ? max(0, floor(-list.content-y / root.row-height) - 1) : 0;
    out property <int> visible-row-end: root.row-height > 0px
        ? min(root.rows.length, ceil((-list.content-y + list.visible-height) / root.row-height) + 1) : 0;
    callback action(int);
    callback navigate(string);
    callback path-part(string);
    callback path-copy(string);
    callback history-choice(bool, string);
    callback detail-copy(string);
    callback volume(int);
    callback sort(int);
    callback row-click(int, bool, bool);
    callback open(int);
    callback key(int);
    callback bulk-selection(int);
    callback activate();
    callback location(int);
    callback navigation-choice(string);
    callback properties();
    callback folder-sizes();
    callback drive-letter(string) -> bool;
    callback search-edited(string);
    callback files-key(KeyEvent, bool, bool) -> int;
    callback search-backspace(string, int, int) -> SearchTextEdit;
    callback insert-path();
    callback insert-name();
    callback drive-info();
    callback tab-new();
    callback tab-select(string);
    callback tab-close(string);
    callback bookmark-add(string, int);
    callback bookmark-open(string);
    callback bookmark-remove(string);
    background: Theme.pane-background;
    border-color: active ? Theme.active-frame : Theme.frame;
    border-width: 1px;
    border-radius: 5px;

    public function focus-list() { path-input.finish-edit(); search.focus-input(); }
    public function reset-search-context() { search.reset-context(); }
    public function open-volumes() { root.activate(); root.focus-list(); volume-picker.open(); }
    public function open-bookmarks() { bookmarks-menu.open(); }
    changed row-height => { root.reveal-cursor(); }
    public function reveal-cursor() {
        list.cancel-scroll-settle();
        if (root.cursor-index >= 0) {
            if (root.cursor-index * root.row-height < -list.content-y) { list.content-y = -root.cursor-index * root.row-height; }
            else if ((root.cursor-index + 1) * root.row-height > -list.content-y + list.visible-height) {
                list.content-y = min(0px, list.visible-height - (root.cursor-index + 1) * root.row-height);
            }
        }
    }
    function handle-files-key(event: KeyEvent) -> EventResult {
        let action = root.files-key(event, search.active, search.preedit != "");
        if action == 0 { return reject; }
        if action == 2 { path-input.focus-editor(); }
        else if action == 3 { search.clear-query(); }
        else if action == 4 { search.erase-previous(); }
        else if action == 5 { search.clear-query(); root.key(9); }
        return accept;
    }
    VerticalLayout {
        padding: 1px; spacing: 0px;
        Rectangle {
            height: 3px;
            background: root.active ? Theme.active-frame : Theme.frame;
        }
        Rectangle {
            height: Theme.toolbar-height;
            background: root.active ? Theme.active-header : Theme.surface;
            HorizontalLayout {
                padding: 4px; spacing: Theme.touch ? 6px : 4px;
                cross-axis-alignment: center;
                HistoryNavigation {
                    native-icon: root.action-icons.back; icon: FallbackIcons.back;
                    hint: "Back (Alt+Left)"; model: root.back-history; revision: root.history-revision;
                    step => { root.activate(); root.action(0); root.focus-list(); }
                    selected(identity) => { root.activate(); root.history-choice(false, identity); root.focus-list(); }
                    dismissed => { root.focus-list(); }
                }
                HistoryNavigation {
                    native-icon: root.action-icons.forward; icon: FallbackIcons.forward;
                    hint: "Forward (Alt+Right)"; model: root.forward-history; revision: root.history-revision;
                    step => { root.activate(); root.action(1); root.focus-list(); }
                    selected(identity) => { root.activate(); root.history-choice(true, identity); root.focus-list(); }
                    dismissed => { root.focus-list(); }
                }
                Tool { native-icon: root.action-icons.parent; icon: FallbackIcons.parent; hint: "Parent folder (Backspace / Ctrl+Page Up)"; clicked => { root.activate(); root.action(2); } }
                Tool { native-icon: root.action-icons.refresh; icon: FallbackIcons.refresh; hint: "Refresh (Ctrl+F9 / Ctrl+R)"; clicked => { root.activate(); root.action(3); } }
                CompactPicker {
                    width: Theme.touch ? 52px : 44px;
                    icon-only: true; icon: FallbackIcons.bookmarks; native-icon: root.action-icons.bookmarks;
                    choices: root.hot-path-choices; model-revision: root.choice-revision;
                    accessible-name: "Hot Paths"; hint: "Hot Paths\nChoose a saved folder. Ctrl+1…9 / Ctrl+0 opens numbered Hot Paths.";
                    popup-width: 500px; popup-align-right: true;
                    selected-key(identity) => {
                        root.activate();
                        if identity == "manage-hot-paths" { bookmarks-menu.open(); }
                        else { root.bookmark-open(identity); root.focus-list(); }
                    }
                    dismissed => { root.focus-list(); }
                }
                bookmarks-menu := BookmarkMenu {
                    show-trigger: false;
                    action-icons: root.action-icons;
                    model: root.bookmarks; path: root.path; default-name: root.bookmark-name;
                    viewport-width: root.viewport-width; viewport-height: root.viewport-height;
                    opening => { root.activate(); root.focus-list(); }
                    dismissed => { root.focus-list(); }
                    add-bookmark(name, slot) => { root.bookmark-add(name, slot); }
                    open-bookmark(identity) => { root.bookmark-open(identity); root.focus-list(); }
                    remove-bookmark(identity) => { root.bookmark-remove(identity); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: Theme.toolbar-height; background: root.active ? Theme.active-header : Theme.surface;
            HorizontalLayout {
                padding-top: 4px; padding-bottom: 4px;
                padding-left: Theme.touch ? 6px : 4px; padding-right: Theme.touch ? 6px : 4px;
                spacing: Theme.touch ? 6px : 4px;
                cross-axis-alignment: center;
                volume-picker := CompactPicker {
                    width: clamp(self.compact-width, 56px, 190px);
                    popup-width: 540px;
                    model: root.volumes; choices: root.choices;
                    current-index: root.choices.length > 0 ? root.choice-index : root.volume-index;
                    icons: root.volume-icons;
                    model-revision: root.choices.length > 0 ? root.choice-revision : root.volumes-revision;
                    label: root.choice-index >= 0 && root.choice-index < root.choices.length
                        ? root.choices[root.choice-index].compact-label
                        : root.volume-index >= 0 ? root.volume-short-labels[root.volume-index]
                        : "—";
                    hint: root.choice-index >= 0 && root.choice-index < root.choices.length
                        ? root.choices[root.choice-index].tooltip
                        : root.volume-index >= 0
                        ? root.volume-tooltips[root.volume-index] + "\nChoose a drive or volume."
                        : "Choose a drive or volume.";
                    accessible-name: "Drive or volume";
                    shortcut-key: ".";
                    shortcut-index: root.choices.length - 1;
                    selected(index) => { root.activate(); root.volume(index); root.focus-list(); }
                    selected-key(identity) => { root.activate(); root.navigation-choice(identity); root.focus-list(); }
                    dismissed => { root.focus-list(); }
                }
                ScrollView {
                    min-width: 0px;
                    height: Theme.control-height;
                    horizontal-stretch: 1;
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    HorizontalLayout {
                        spacing: 2px; alignment: start;
                        for location-index[index] in root.locations.length : CompactLocationButton {
                            private property <LocationRow> item: root.locations[index];
                            label: self.item.label;
                            compact-label: self.item.compact-label;
                            is-drive: self.item.is-drive;
                            icon: self.item.icon;
                            kind: self.item.kind; identity: self.item.identity;
                            model-revision: root.choice-revision;
                            selected: self.item.selected;
                            hint: self.item.tooltip;
                            clicked => { root.activate(); if self.item.identity != "" { root.navigation-choice(self.item.identity); } else { root.location(index); } root.focus-list(); }
                        }
                    }
                }
            }
        }
        if root.tabs.length > 0 : TabStrip {
            model: root.tabs;
            action-icons: root.action-icons;
            new-tab => { root.activate(); root.tab-new(); root.focus-list(); }
            selected(identity) => { root.activate(); root.tab-select(identity); root.focus-list(); }
            close-tab(identity) => { root.activate(); root.tab-close(identity); root.focus-list(); }
        }
        Rectangle {
            height: Theme.path-height; background: Theme.secondary-surface;
            HorizontalLayout {
                padding-top: Theme.touch ? 4px : Theme.control-padding; padding-bottom: Theme.touch ? 4px : Theme.control-padding;
                padding-left: Theme.control-padding; padding-right: Theme.control-padding;
                spacing: Theme.touch ? 6px : 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    min-height: Theme.control-height;
                    path-input := PathNavigation {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        path: root.path; parts: root.path-parts;
                        hint: "Folder path: " + root.path + "\n" + root.status + (root.loading ? "\nReading folder…" : "") + "\nEdit and press Enter to open a folder. Ctrl+G focuses this field.";
                        navigate(path) => { root.activate(); root.navigate(path); root.focus-list(); }
                        selected-part(identity) => { root.activate(); root.path-part(identity); root.focus-list(); }
                        copy-part(identity) => { root.activate(); root.path-copy(identity); }
                        cancelled => { root.focus-list(); }
                    }
                    search := PanelSearch {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        z: self.active && !path-input.has-focus ? 1 : -1;
                        text <=> root.search-query;
                        pending: root.search-pending; match-count: root.search-count;
                        close-icon: root.action-icons.close;
                        edited(text) => { root.search-edited(text); }
                        handle-key(event) => { return root.handle-files-key(event); }
                        backspace(text, anchor, cursor) => { return root.search-backspace(text, anchor, cursor); }
                    }
                }
                Tool {
                    native-icon: root.action-icons.open-path; icon: FallbackIcons.open-path;
                    hint: path-input.editing ? "Open entered path (Enter)" : "Edit folder path (Ctrl+G)";
                    clicked => { root.activate(); if path-input.editing { root.navigate(path-input.text); root.focus-list(); } else { path-input.focus-editor(); } }
                }
            }
        }
        Rectangle {
            height: Theme.column-height; background: Theme.header;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 8px;
                for title[index] in ["Name", "Size", "Modified"] : Rectangle {
                    horizontal-stretch: index == 0 ? 1 : 0;
                    min-width: index == 0 ? 120px : index == 1 ? root.size-column-width : 132px;
                    preferred-width: index == 0 ? 120px : index == 1 ? root.size-column-width : 132px;
                    HorizontalLayout {
                        spacing: 3px;
                        cross-axis-alignment: center;
                        Text { text: title; color: root.sort-column == index ? Theme.accent : Theme.secondary-text; font-size: Theme.small-font; vertical-alignment: center; horizontal-alignment: index == 1 ? right : left; overflow: elide; horizontal-stretch: 1; }
                        if root.sort-column == index : NativeActionImage {
                            native-icon: root.descending ? root.action-icons.sort-descending : root.action-icons.sort-ascending;
                            fallback-icon: root.descending ? FallbackIcons.sort-descending : FallbackIcons.sort-ascending;
                            width: Theme.icon-size; height: Theme.icon-size;
                        }
                    }
                    accessible-role: button;
                    accessible-label: "Sort by " + title;
                    accessible-action-default => { root.activate(); root.sort(index); }
                    TouchArea { clicked => { root.activate(); root.sort(index); } }
                    Tooltip { TipBody { text: "Sort by " + title + (root.sort-column == index ? (root.descending ? " · descending; click for ascending" : " · ascending; click for descending") : " · click for ascending"); } }
                }
            }
        }
        Rectangle {
            list := PanelList {
                row-height: root.row-height;
                interaction-active: root.scroll-interaction-active;
                for item[index] in root.rows : Rectangle {
                    height: root.row-height;
                    background: item.cursor ? (root.active ? Theme.cursor-background : Theme.inactive-cursor) : item.selected ? Theme.selected-background : (mod(index, 2) == 0 ? Theme.pane-background : Theme.alternate-row);
                    accessible-role: list-item;
                    accessible-label: item.name + (item.kind == "Folder link" ? " · Folder link" : "")
                        + (item.compressed ? " · Filesystem compressed" : "");
                    Rectangle { x: 0px; y: 0px; width: item.selected ? 4px : 3px; height: parent.height; background: item.selected ? Theme.selected-edge : item.cursor && root.active ? Theme.cursor-edge : transparent; }
                    if item.selected && item.cursor : Rectangle {
                        x: 4px; y: 0px; width: parent.width - 4px; height: 1px;
                        background: Theme.selected-edge;
                    }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px - (Theme.file-icon-size - Theme.icon-size);
                            horizontal-stretch: 1; min-width: 120px;
                            Rectangle {
                                width: Theme.file-icon-size;
                                Image {
                                    source: item.icon;
                                    width: Theme.file-icon-size; height: Theme.file-icon-size;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                }
                                if item.compressed : Rectangle {
                                    x: parent.width - 8px;
                                    y: (parent.height + Theme.file-icon-size) / 2 - 8px;
                                    width: 9px; height: 9px;
                                    background: Theme.pane-background;
                                    border-radius: 2px;
                                    Text {
                                        text: "C"; font-size: 8px; font-weight: 700;
                                        color: Theme.compression-mark;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }
                            if item.prefix-end > 0 : PrefixName {
                                text: item.name; prefix-end: item.prefix-end;
                                text-color: item.selected ? Theme.selected-text : item.directory ? Theme.directory-text : Theme.text;
                                row-background: item.cursor ? (root.active ? Theme.cursor-background : Theme.inactive-cursor) : item.selected ? Theme.selected-background : (mod(index, 2) == 0 ? Theme.pane-background : Theme.alternate-row);
                            }
                            if item.prefix-end <= 0 : Text { text: item.name; color: item.selected ? Theme.selected-text : item.directory ? Theme.directory-text : Theme.text; font-size: Theme.font-size; font-weight: item.selected ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        Text { text: item.size; color: item.size-state == 1 ? Theme.pending-size : Theme.secondary-text; font-weight: item.size-state == 1 ? 600 : 400; font-size: Theme.small-font; width: root.size-column-width; overflow: elide; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: item.modified; color: Theme.secondary-text; font-size: Theme.small-font; width: 132px; overflow: elide; vertical-alignment: center; }
                    }
                    TouchArea {
                        private property <string> pressed-identity;
                        private property <bool> control-pressed;
                        private property <bool> shift-pressed;
                        private property <bool> modified-pressed;
                        private property <bool> same-target-double;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left {
                                self.pressed-identity = item.identity;
                                self.control-pressed = event.modifiers.control;
                                self.shift-pressed = event.modifiers.shift;
                                self.modified-pressed = event.modifiers.control
                                    || event.modifiers.shift || event.modifiers.alt;
                            } else if event.kind == PointerEventKind.cancel {
                                self.pressed-identity = "";
                                self.same-target-double = false;
                            }
                        }
                        clicked => {
                            // Slint emits clicked before double-clicked on left release.
                            // Freeze both clicks across virtualized row rebinding and refreshes.
                            self.same-target-double = self.pressed-identity == item.identity
                                && root.previous-click-identity == self.pressed-identity;
                            root.previous-click-identity = self.pressed-identity == item.identity
                                ? self.pressed-identity : "";
                            if self.pressed-identity == item.identity {
                                root.activate();
                                root.focus-list();
                                root.row-click(index, self.control-pressed, self.shift-pressed);
                            }
                        }
                        double-clicked => {
                            if self.same-target-double && !self.modified-pressed
                                && self.pressed-identity == item.identity {
                                root.activate();
                                root.focus-list();
                                root.open(index);
                            }
                        }
                    }
                }
            }
            if root.rows.length == 0 : Text {
                text: root.search-query != "" ? (root.search-pending ? "Searching…" : "No matching names") : root.loading ? "Reading folder…" : "This folder is empty";
                color: Theme.muted-text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        details-bar := PanelDetails { model: root.details; copy-field(identity) => { root.activate(); root.detail-copy(identity); } }
        if root.error != "" : Rectangle {
            height: 44px; background: Theme.error-background;
            Text { x: 10px; width: parent.width - 20px; text: root.error; color: Theme.error-text; font-size: Theme.small-font; wrap: word-wrap; vertical-alignment: center; }
        }
    }
}

export component MainWindow inherits Window {
    in property <ActionIcons> action-icons;
    in property <[NavigationChoiceRow]> navigation-choices;
    in property <int> navigation-revision;
    in property <int> left-navigation-index: -1;
    in property <int> right-navigation-index: -1;
    in property <string> application-version;
