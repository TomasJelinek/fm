                    cwd-scroll := ScrollView {
                        x: 0px; y: 0px;
                        width: command-content.prompt-width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        mouse-drag-pan-enabled: true;
                        content-width: max(self.visible-width, root.command-path-natural-width);
                        content-height: self.visible-height;
                        Rectangle {
                            width: cwd-scroll.content-width; height: cwd-scroll.visible-height;
                            full-cwd := Text {
                                x: 4px; width: self.preferred-width; height: parent.height;
                                text: root.command-prompt; wrap: no-wrap; overflow: clip;
                                color: Theme.secondary-text; font-size: Theme.small-font;
                                vertical-alignment: center;
                                accessible-label: "Working folder: " + root.command-directory;
                            }
                            TouchArea {
                                scroll-event(event) => {
                                    let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                                    if cwd-scroll.content-width > cwd-scroll.visible-width && delta != 0px {
                                        cwd-scroll.content-x = clamp(cwd-scroll.content-x + delta,
                                            min(0px, cwd-scroll.visible-width - cwd-scroll.content-width), 0px);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            Tooltip { TipBody { text: "Working folder: " + root.command-directory + "\nScroll or drag horizontally to view a long path."; } }
                        }
                    }
                    command-slot := Rectangle {
                        x: cwd-scroll.width > 0px ? cwd-scroll.width + command-content.gap : 0px;
                        width: max(0px, parent.width - self.x); height: parent.height; clip: true;
                        command-input := TextInput {
                            private property <length> horizontal-offset;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.horizontal-offset));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: parent.height;
                            color: Theme.text; selection-background-color: Theme.selection-background;
                            selection-foreground-color: Theme.selection-text;
                            vertical-alignment: center; single-line: true;
                            accessible-label: "Command line";
                            cursor-position-changed(position) => {
                                if position.x + self.horizontal-offset < 0px { self.horizontal-offset = -position.x; }
                                else if position.x + self.horizontal-offset > parent.width - self.text-cursor-width {
                                    self.horizontal-offset = parent.width - position.x - self.text-cursor-width;
                                }
                            }
                            edited => { root.command-edited(self.text != ""); }
                            accepted => { if root.submit-command(self.text) { self.text = ""; root.command-edited(false); } }
                            key-pressed(event) => {
                                if event.text == Key.Return && (event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta) { return accept; }
                                if event.text == Key.Escape { root.focus-files(); return accept; }
                                reject
                            }
                        }
                        Tooltip { TipBody { text: root.command-hint + "\nWorking folder: " + root.command-directory + "\nEnter runs the command. Escape returns to the files. Ctrl+Enter appends the focused filename. Ctrl+P inserts the current path. Ctrl+[ / Ctrl+] inserts a panel path."; } }
                    }
                }
                command-history-picker := CompactPicker {
                    width: Theme.touch ? 46px : 34px; minimum-control-width: 0px;
                    choices: root.command-history; model-revision: root.command-history-revision;
                    popup-above: true; popup-width: 620px; popup-align-right: true;
                    show-row-icons: false;
                    enabled: root.command-history.length > 0;
                    accessible-name: "Executed command history";
                    hint: "Executed command history\nPick a command to fill the editor without running it.";
                    selected-key(identity) => { root.command-history-choice(identity); root.focus-command(); }
                    dismissed => { root.focus-command(); }
                }
                HintedActionButton { native-icon: root.action-icons.options; fallback-icon: FallbackIcons.options; text: "Options"; min-height: Theme.control-height; hint: "Panel, appearance and command history preferences."; clicked => { root.show-options(); } }
                HintedActionButton { native-icon: root.action-icons.run; fallback-icon: FallbackIcons.run; text: "Run"; min-height: Theme.control-height; enabled: root.terminal-ready && root.command-text != ""; hint: !root.terminal-available ? "A system terminal is unavailable." : !root.terminal-ready ? "Waiting for the terminal to become ready." : root.command-text == "" ? "Enter a command to run in the active panel’s folder." : "Run with " + root.terminal-choices[root.terminal-index] + "\nWorking folder: " + root.command-directory; clicked => { if root.submit-command(root.command-text) { root.command-text = ""; root.command-edited(false); } root.focus-command(); } }
            }
        }
        HorizontalLayout {
            height: Theme.bottom-height; spacing: 4px;
            for label[index] in ["Help", "Rename", "View", "Edit", "Copy", "Move", "Create dir", "Delete", "User menu", "Menu"] : FunctionButton {
                native-icon: index == 0 ? root.action-icons.help : index == 1 ? root.action-icons.rename
                    : index == 2 ? root.action-icons.view : index == 3 ? root.action-icons.edit
                    : index == 4 ? root.action-icons.copy : index == 5 ? root.action-icons.move-item
                    : index == 6 ? root.action-icons.new-folder : index == 7 ? root.action-icons.delete
                    : index == 8 ? root.action-icons.user-menu : root.action-icons.menu;
                fallback-icon: index == 0 ? FallbackIcons.help : index == 1 ? FallbackIcons.rename
                    : index == 2 ? FallbackIcons.view : index == 3 ? FallbackIcons.edit
                    : index == 4 ? FallbackIcons.copy : index == 5 ? FallbackIcons.move-item
                    : index == 6 ? FallbackIcons.new-folder : index == 7 ? FallbackIcons.delete
                    : index == 8 ? FallbackIcons.user-menu : FallbackIcons.menu;
                text: "F" + (index + 1) + " " + label;
                enabled: index == 0 || index == 8 || index == 9;
                hint: "F" + (index + 1) + " " + label + (index == 0 ? " · keyboard shortcuts and usage help" : index == 8 ? " · commands, properties and folder sizes" : index == 9 ? " · options, refresh, help and exit" : " · unavailable in this read-only stage");
                clicked => { if index == 0 { help.show(); } else if index == 8 { user-menu.show(); } else if index == 9 { main-menu.show(); } }
            }
        }
        if root.desktop-feedback-important && root.desktop-status != "" : Text {
            text: root.desktop-status;
            color: Theme.secondary-text; font-size: Theme.hint-font;
            height: Theme.hint-font * 1.5; overflow: elide;
            accessible-label: root.desktop-status;
            Tooltip { TipBody { text: root.desktop-status; } }
        }
      }
    }
    options := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(root.width - 24px, max(600px, Theme.font-size * 26));
        height: min(root.height - 24px, Theme.touch ? 510px : 420px);
        options-body := OptionsBody {
            action-icons: root.action-icons;
            topic-index <=> root.options-topic-index;
            theme-index: root.theme-index; density-index: root.density-index;
            font-choices: root.font-choices; font-index: root.font-index; font-list-ready: root.font-list-ready;
            desktop-font-size: root.desktop-font-size; touch-font-size: root.touch-font-size;
            preferences-unsaved: root.preferences-unsaved;
            quick-search-filter: root.quick-search-filter; sizes-in-bytes: root.sizes-in-bytes;
            remember-command-history: root.remember-command-history;
            command-history-empty: root.command-history.length == 0;
            preferences-changed(theme, density, field) => { root.preferences-changed(theme, density, field); }
            font-options-changed(family, desktop, touch, field) => { root.font-options-changed(family, desktop, touch, field); }
            search-filter-changed(value) => { root.search-filter-changed(value); }
            sizes-format-changed(value) => { root.sizes-format-changed(value); }
            remember-command-history-changed(value) => { root.remember-command-history-changed(value); }
            command-history-clear => { root.command-history-clear(); }
            close => { options.close(); }
        }
    }
    help := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 620px; height: min(root.height - 40px, Theme.touch ? 600px : 490px);
        Rectangle {
            background: Theme.surface; border-radius: 8px; border-color: Theme.active-frame; border-width: 1px;
            VerticalLayout {
                padding: 20px; spacing: 13px;
                Text { text: "FM keyboard help"; color: Theme.strong-text; font-size: 20px; }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                    spacing: 13px;
                        Text { text: "Tab switches file panels. Ctrl+T opens a folder tab, Ctrl+W closes the active tab, Ctrl+Shift+Tab selects the previous tab; Ctrl+Shift+1…9 selects a numbered tab. Ctrl+Tab focuses the command line and returns to files when pressed again. Ctrl+U swaps panels; drag their divider to resize or double-click to center. Enter or left double click opens a folder or file. Ctrl+click toggles a file, Shift+click selects a range, and Ctrl+Shift+click adds a range. Insert toggles selection and moves to the next file. Space does the same and measures a focused folder in the background; .. is navigation only. In files, Ctrl+A selects all, Ctrl+D clears selection, and Ctrl+I inverts it; editors keep their normal text shortcuts."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Backspace / Ctrl+Page Up opens the parent. Ctrl+Page Down enters a directory. Ctrl+Backspace, Shift+Backspace or Ctrl+\\ opens the root. Alt+Left / Right uses history. Ctrl+F9 / Ctrl+R refreshes. Ctrl+G edits the folder path."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Ctrl+F3 / F4 / F5 / F6 sorts by name / extension / modified time / size. Alt+F1 / F2 chooses the left / right drive. Ctrl+F1 / Ctrl+L shows drive information. Shift+drive letter chooses a Windows drive from a file panel. Alt+Enter shows Properties. Alt+F4 exits."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Ctrl+[ / Ctrl+] inserts the left / right folder path. Ctrl+P inserts the active folder path and Ctrl+Enter appends the focused filename from files or the command editor. Ctrl+Space is reserved for IME. The terminal icon opens an empty interactive terminal without changing the draft; its arrow selects the shell. Right-click a path prefix to copy it. Enter or Run executes a command in the active folder; modified Enter never runs it. The history dropdown fills the editor without executing. Escape returns to files."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Type without Shift in files to search a literal filename prefix, always ignoring case. Colored letters show the matching prefix. Up/Down, Page Up/Down and Home/End move among matches without wrapping. Escape clears search; Backspace removes a whole character cluster. Space edits the active query; Insert ends search and selects. Options can show matches only; hidden selections are cleared. Shift+drive letter still chooses an available Windows drive. Shift-only numbered Hot Paths pause during search or IME composition."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "The star dropdown opens a saved Hot Path or its manager. Ctrl+1…9 / Ctrl+0 or Shift+1…9 / Shift+0 opens a saved Hot Path. Add Alt to open it in the other panel. Assign numbered Hot Paths in their manager; Ctrl+Shift+0 assigns slot 0 and Ctrl+Shift++ adds a bookmark without a shortcut. Ctrl+Shift+1…9 switches folder tabs. These shortcuts apply only while files have focus. Bookmarks are saved for the next launch; folder tabs last for this session."; color: Theme.text; wrap: word-wrap; }
                        Text { text: root.command-hint + ". Clear the command line before changing shell type. Terminal / Terminal (sudo) may be switched for an existing command; sudo prompts only in the external terminal and is never saved."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Ctrl+Shift+F10 / Ctrl+Shift+S measures every folder in the active panel; press again to cancel. Sizes use logical lengths and skip links and special files. Amber means active counting. ≈ marks approximate or partial totals, including inaccessible folders; completed partial totals use ordinary text. Alt+F10 / Ctrl+Q remains reserved for selected-item sizes."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "A small C on a file icon means filesystem compression reported by the host. Archive extensions alone do not set this mark. Sizes remain logical file lengths. Folder-link icons mark directory links or junctions; automatic size scans do not follow them."; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Rename, View, Edit, Copy, Move, Create directory and Delete are unavailable in this read-only stage."; color: Theme.secondary-text; wrap: word-wrap; }
                    }
                }
                HintedActionButton { native-icon: root.action-icons.close; fallback-icon: FallbackIcons.close; text: "Close"; min-height: Theme.control-height; hint: "Close this dialog and return to the file manager."; clicked => { help.close(); } }
            }
        }
    }
    user-menu := PopupWindow {
        x: (root.width - self.width) / 2; y: root.height - self.height - 75px;
        width: min(root.width - 24px, max(340px, Theme.font-size * 18 + 24px));
        height: min(root.height - 90px, max(Theme.touch ? 280px : 220px, Theme.control-height * 5 + 90px));
        CommandMenuBody {
            title: "User menu";
            item-count: 5;
            rows: [
                { native-icon: root.action-icons.terminal, fallback-icon: FallbackIcons.terminal, label: "Command line", hint: "Focus the command editor without running a command. Ctrl+Tab in the editor returns to files." },
                { native-icon: root.action-icons.bookmarks, fallback-icon: FallbackIcons.bookmarks, label: "Bookmarks and Hot Paths", hint: "Save, open or remove a favorite folder. Hot Paths provide ten numbered shortcuts." },
                { native-icon: root.action-icons.properties, fallback-icon: FallbackIcons.properties, label: "Properties · Alt+Enter", hint: "Show Properties for selected items, or the focused file or folder." },
                { native-icon: root.action-icons.folder-sizes, fallback-icon: FallbackIcons.folder-sizes, label: "Calculate / cancel folder sizes", hint: "Measure every folder in the active panel; choose again to cancel (Ctrl+Shift+F10 / Ctrl+Shift+S)." },
                { native-icon: root.action-icons.close, fallback-icon: FallbackIcons.close, label: "Close", hint: "Close this dialog and return to the file manager." },
            ];
            selected(index) => {
                if index == 0 { user-menu.close(); root.focus-command(); }
                if index == 1 { user-menu.close(); if root.active-pane == 0 { left.open-bookmarks(); } else { right.open-bookmarks(); } }
                if index == 2 { user-menu.close(); root.properties(root.active-pane); }
                if index == 3 { user-menu.close(); root.folder-sizes(root.active-pane); }
                if index == 4 { user-menu.close(); }
            }
        }
    }
    main-menu := PopupWindow {
        x: root.width - self.width - 15px; y: root.height - self.height - 75px;
        width: min(root.width - 24px, max(300px, Theme.font-size * 14 + 24px));
        height: min(root.height - 90px, max(Theme.touch ? 330px : 260px, Theme.control-height * 5 + 90px));
        CommandMenuBody {
            title: "Menu";
            item-count: 5;
            rows: [
                { native-icon: root.action-icons.options, fallback-icon: FallbackIcons.options, label: "Options", hint: "Choose the theme, font family, font sizes and compact desktop or larger touch controls." },
                { native-icon: root.action-icons.refresh, fallback-icon: FallbackIcons.refresh, label: "Refresh active folder", hint: "Read the active folder again (Ctrl+F9 / Ctrl+R)." },
                { native-icon: root.action-icons.help, fallback-icon: FallbackIcons.help, label: "Keyboard help · F1", hint: "Show supported keyboard shortcuts and usage help." },
                { native-icon: root.action-icons.about, fallback-icon: FallbackIcons.about, label: "About FM", hint: "Show application and Slint version information." },
                { native-icon: root.action-icons.exit, fallback-icon: FallbackIcons.exit, label: "Exit", hint: "Close the file manager (Alt+F4)." },
            ];
            selected(index) => {
                if index == 0 { main-menu.close(); root.show-options(); }
                if index == 1 { main-menu.close(); root.action(root.active-pane, 3); }
                if index == 2 { main-menu.close(); help.show(); }
                if index == 3 { main-menu.close(); about.show(); }
                if index == 4 { main-menu.close(); root.exit(); }
            }
        }
    }
    message := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 600px; height: 400px;
        Rectangle { background: Theme.surface; border-color: Theme.active-frame; border-width: 1px; border-radius: 6px;
            VerticalLayout { padding: 18px; spacing: 12px;
                Text { text: root.message-title; color: Theme.strong-text; font-size: 18px; wrap: word-wrap; }
                ScrollView { Text { text: root.message-body; color: Theme.text; wrap: word-wrap; width: parent.width; } }
                HintedActionButton { native-icon: root.action-icons.close; fallback-icon: FallbackIcons.close; text: "Close"; min-height: Theme.control-height; hint: "Close this dialog and return to the file manager."; clicked => { message.close(); } }
            }
        }
    }
    about := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 360px; height: Theme.touch ? 320px : 270px;
        Rectangle {
            background: Theme.surface; border-radius: 8px; border-color: Theme.active-frame; border-width: 1px;
            VerticalLayout {
                padding: 18px; spacing: 10px;
                Text { text: "FM · File Manager"; color: Theme.strong-text; font-size: 18px; }
                Text { text: "A focused, two-pane file browser."; color: Theme.secondary-text; }
                AboutSlint {}
                HintedActionButton { native-icon: root.action-icons.close; fallback-icon: FallbackIcons.close; text: "Close"; min-height: Theme.control-height; hint: "Close this dialog and return to the file manager."; clicked => { about.close(); } }
            }
        }
    }
}
